   "whoAdded": 107,
   "subRetorical": "تشابه الأطراف"
  },
  {
   "id": 1120,
   "name": "المراجعة",
   "info": null,
   "whoAdded": 107,
   "subRetorical": "المراجعة"
  },
  {
   "id": 1121,
   "name": "التفات",
   "info": "نوع من الالتفات فيه الجملة الثانية تكون مفسرة للأولى",
   "whoAdded": 107,
   "subRetorical": "التفات تفسيري"
  },
  {
   "id": 1122,
   "name": "التهكم",
   "info": null,
   "whoAdded": 107,
   "subRetorical": "التهكم"
  },
  {
   "id": 1123,
   "name": "تناص",
   "info": "اقتباس بيت من الشعر في القصيدة نفسها.",
   "whoAdded": 107,
   "subRetorical": "تضمين (تناص شعري)"
  },
  {
   "id": 1124,
   "name": "تشبيه",
   "info": "مبناه يكون ليس عاديًّا أو ليس مباشرًا",
   "whoAdded": 107,
   "subRetorical": "تشبيه مطول غريب"
  },
  {
   "id": 1125,
   "name": "استعارة",
   "info": "كالاستعارات الصوفية، مثلًا: أسماء رمز للذات الإلهية وتجلياتها في الوجود.",
   "whoAdded": 107,
   "subRetorical": "استعارة حديثة رمزيّة"
  },
  {
   "id": 1126,
   "name": "استعارة",
   "info": null,
   "whoAdded": 107,
   "subRetorical": "استعارة تمثيلية رمزيّة"
  },
  {
   "id": 1127,
   "name": "استعارة",
   "info": null,
   "whoAdded": 107,
   "subRetorical": "استعارة مركبة رمزيّة"
  },
  {
   "id": 1128,
   "name": "استعارة",
   "info": null,
   "whoAdded": 107,
   "subRetorical": "استعارة قديمة رمزيّة"
  },
  {
   "id": 1129,
   "name": "التلاعب",
   "info": null,
   "whoAdded": 107,
   "subRetorical": "التلاعب بحروف الجرّ"
  },
  {
   "id": 1130,
   "name": "استعارة",
   "info": null,
   "whoAdded": 107,
   "subRetorical": "استعارة فعل رمزيّة"
  },
  {
   "id": 1131,
   "name": "استعارة",
   "info": null,
   "whoAdded": 107,
   "subRetorical": "استعارة فعل مرشحة رمزية"
  },
  {
   "id": 1133,
   "name": "مقابلة",
   "info": "الجملة الثانية معناها هو نفسه أو متمم لمعنى الجملة الأولى.",
   "whoAdded": 107,
   "subRetorical": "مقابلة (موافقة)"
  },
  {
   "id": 1134,
   "name": "جناس",
   "info": "اسم أو كنية ثم لفظة مشتقة منهما بمعنى آخر",
   "whoAdded": 107,
   "subRetorical": "جناس الاشتقاق"
  },
  {
   "id": 1135,
   "name": "استعارة",
   "info": null,
   "whoAdded": 107,
   "subRetorical": "استعارة حديثة رمزية مرشحة"
  },
  {
   "id": 1136,
   "name": "التلاعب",
   "info": null,
   "whoAdded": 107,
   "subRetorical": "التلاعب بالضمائر"
  },
  {
   "id": 1137,
   "name": "التلاعب",
   "info": null,
   "whoAdded": 107,
   "subRetorical": "التلاعب بالكلمات"
  },
  {
   "id": 1138,
   "name": "لزوم ما لا يلزم",
   "info": null,
   "whoAdded": 107,
   "subRetorical": "لزوم ما لا يلزم (أحرف القافية)"
  },
  {
   "id": 1139,
   "name": "استعارة",
   "info": "Double layered metaphor\nراجع البيت السادس في قصيدة رقم 1 لعفيف الدين التلمساني.",
   "whoAdded": 107,
   "subRetorical": "استعارة تمثيلية ثنائية الطبقة"
  },
  {
   "id": 1141,
   "name": "مجاز",
   "info": "اطرب مسمع الفَقر = اطرب مسمع الفقراء = اطرب الفقراء (عفيف الدين التلمساني، قصيدة رقم 1).",
   "whoAdded": 107,
   "subRetorical": "مجاز مرسل مزدوج"
  },
  {
   "id": 1142,
   "name": "الحذف",
   "info": "حذف عبارة من الجملة؛ مثل \"إءذا متنا وكنا ترابًا ذلك رجع بعيد\" [3:50]، حذف منها الفعل \"نرجع\".",
   "whoAdded": 107,
   "subRetorical": "الحذف"
  },
  {
   "id": 1143,
   "name": "طباق",
   "info": "لم أزرها = عادني (بدلًا من لم أزرها - زارني- قصيدة لجميل بثينة)",
   "whoAdded": 107,
   "subRetorical": "طباق سلب في المعنى"
  },
  {
   "id": 1144,
   "name": "تشبيه",
   "info": "مثل تشبيه الناقة بالثور الوحشي أو عبارة \"وما ..... بأفضل\"",
   "whoAdded": 107,
   "subRetorical": "تشبيه مدوّر"
  },
  {
   "id": 1146,
   "name": "تشبيه",
   "info": "بدلًا من \"هي تشبه الظبية\" يأتي التشبيه \"الظبية تشبهها\"",
   "whoAdded": 107,
   "subRetorical": "تشبيه مقلوب"
  },
  {
   "id": 1147,
   "name": "توزيع",
   "info": "تكرار حرف معين في كلّ كلمات البيت أو في أغلبها",
   "whoAdded": 107,
   "subRetorical": "توزيع 1 (على مستوى البيت)"
  },
  {
   "id": 1148,
   "name": "توزيع",
   "info": "حرف يتكرر بشكل بارز في القصيدة",
   "whoAdded": 107,
   "subRetorical": "توزيع 2 (على مستوى القصيدة)"
  },
  {
   "id": 1149,
   "name": "تصريع",
   "info": null,
   "whoAdded": 107,
   "subRetorical": "تصريع"
  },
  {
   "id": 1150,
   "name": "استعارة",
   "info": null,
   "whoAdded": 107,
   "subRetorical": "استعارة فعل مرشحة غريبة"
  },
  {
   "id": 1151,
   "name": "استعارة",
   "info": "العبارة استعارة لكنها في سياق آخر تكون مجازًا مرسلًا. أبو تمام 71 (بيت 2): يد الشتاء.",
   "whoAdded": 107,
   "subRetorical": "استعارة مبنيّة على المجاز المرسل"
  },
  {
   "id": 1153,
   "name": "استعارة",
   "info": "بيت 2، قصيدو 21 لأبي تمّام. خاض الأيام: الخوض استعارة للحرب، ثم استعيرت من الحرب للأيام.",
   "whoAdded": 107,
   "subRetorical": "استعارة فعل مزدوجة"
  },
  {
   "id": 1155,
   "name": "تشبيه",
   "info": "الفرو غِرّ [أبو تمام 21، بيت 5]: يشبه بالغر (الجاهل)، وهي كناية عن الصغير في السنّ.",
   "whoAdded": 107,
   "subRetorical": "تشبيه مبني على الكناية"
  },
  {
   "id": 1156,
   "name": "استعارة",
   "info": "مثل \"افترعتها كفّ حادثة\" (أبو تمام 3: 17): الحادثة افترعتها بكفها",
   "whoAdded": 107,
   "subRetorical": "استعارة مبنيّة على المجاز العقلي"
  },
  {
   "id": 1157,
   "name": "مراعاة النظير",
   "info": null,
   "whoAdded": 107,
   "subRetorical": "مراعاة النظير"
  },
  {
   "id": 1158,
   "name": "استعارة",
   "info": null,
   "whoAdded": 107,
   "subRetorical": "استعارة تمثيلية تعتمد على التورية"
  },
  {
   "id": 1159,
   "name": "مقابلة تضاد",
   "info": "أجبت بالسيف - لم تجب بغير السيف (أبو تمام3:48)",
   "whoAdded": 107,
   "subRetorical": "مقابلة تضاد سلب"
  },
  {
   "id": 1160,
   "name": "مجاز مرسل",
   "info": "قضب تهتز في كثب (القضيب استعارة للقدّ، والكثيب للكفل. جزءان معًا يشيران إلى الكلّ وهو المرأة) [أبو تمام65:3]",
   "whoAdded": 107,
   "subRetorical": "مجاز مرسل مركّب"
  },
  {
   "id": 1161,
   "name": "كلمات مفتاح",
   "info": null,
   "whoAdded": 110,
   "subRetorical": "كلمات مفتاح"
  },
  {
   "id": 1162,
   "name": "استعارة",
   "info": "مثل قصيدة أبي نواس، باب 9، رقم 28، فيها يتخيل الخمرة محبوبة يخطبها ويدفع في سبيلها مهرًا ويحاورها",
   "whoAdded": 107,
   "subRetorical": "استعارة تمثيلية قصصية / خياليّة"
  },
  {
   "id": 1163,
   "name": "تشبيه",
   "info": "مثل قصيدة أبي نواس باب 9، رقم 2، \"الليل والدها\": شبه والد الخمرة بالليل. المشبه هو استعارة.",
   "whoAdded": 107,
   "subRetorical": "تشبيه قصير غريب"
  },
  {
   "id": 1164,
   "name": "تشبيه",
   "info": null,
   "whoAdded": 107,
   "subRetorical": "تشبيه قصير معكوس"
  },
  {
   "id": 1165,
   "name": "تشبيه",
   "info": null,
   "whoAdded": 107,
   "subRetorical": "تشبيه مطول معكوس"
  },
  {
   "id": 1166,
   "name": "تشبيه",
   "info": null,
   "whoAdded": 107,
   "subRetorical": "تشبيه مركب معكوس"
  },
  {
   "id": 1167,
   "name": "تشبيه",
   "info": null,
   "whoAdded": 107,
   "subRetorical": "تشبيه تمثيلي معكوس"
  },
  {
   "id": 1169,
   "name": "كناية",
   "info": "العبارة استعارة، لكن معناها يكون كناية. مثل البيت في معلقة طرفة \"قال حاجزه قدِي\": قال حد السيف: يكفيني من محاولات التمهل التي تطلبها مني. هي استعارة معناها أنّ السيف يستمر في الضرب.",
   "whoAdded": 107,
   "subRetorical": "كناية مبنية على الاستعارة"
  },
  {
   "id": 1170,
   "name": "سجع",
   "info": "هو اشتراك كل كلمة من الشطر الأول مع كلمة تقابلها في الشطر الثاني لها نفس القافية لكنّ وزنها مختلف",
   "whoAdded": 110,
   "subRetorical": "الترصيع ٢"
  },
  {
   "id": 1171,
   "name": "توشيع",
   "info": null,
   "whoAdded": 110,
   "subRetorical": "توشيع"
  },
