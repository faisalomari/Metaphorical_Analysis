  {
   "id": 1095,
   "name": "سجع",
   "info": "أن تتفق اللفظتان الآخرتان من الفاصلتين في التقفية دون الوزن. من الطرف. السجع يكون في الطرف (التقفية) لا في الوزن.",
   "whoAdded": 107,
   "subRetorical": "سجع مطرف"
  },
  {
   "id": 1096,
   "name": "سجع",
   "info": "أن تتفق اللفظتان الآخرتان من الفاصلتين في التقفية والوزن",
   "whoAdded": 107,
   "subRetorical": "سجع موازَن"
  },
  {
   "id": 1097,
   "name": "سجع",
   "info": "أن يكون كل شطر من البيت ذا قافيتين مغايرتين لما في الشطر الآخر",
   "whoAdded": 107,
   "subRetorical": "سجع التشطير"
  },
  {
   "id": 1098,
   "name": "طباق",
   "info": "تأويل العبارتين هو الذي يفهم على أنه طباق. مثل: للرمل الروادف والخصور. شبه الروادف بما عظم من الرمل، والخصور بما لان ودقّ. تفسير التشبيهين هو الذي يحمل معنى الطباق بين الصفتين.",
   "whoAdded": 107,
   "subRetorical": "طباق في المعنى"
  },
  {
   "id": 1099,
   "name": "تشبيه",
   "info": "تشبيه شيئين بشيئين، والصورة المجتمعة للمشبه تشبه بالصورة المجتمعة للمشبه به، والمشبه به فيه وصف مطول.",
   "whoAdded": 107,
   "subRetorical": "تشبيه مركب مطول"
  },
  {
   "id": 1100,
   "name": "تشبيه",
   "info": null,
   "whoAdded": 107,
   "subRetorical": "تشبيه شيئين بشيء واحد"
  },
  {
   "id": 1101,
   "name": "مجاز",
   "info": "معنى الجملة هو نفسه المجاز المرسل. \"كأنّ التي تمري فؤادي بحبها\": معنى الجملة (من شعر بشار) هو \"المحبوبة\". في البيت تشبيه للمحبوبة بالخمرة. الحقيقة أنّ المراد هو رضاب المحبوبة لا المحبوبة نفسها. معنى الجملة هو مجاز مرسل يراد به الرضاب.",
   "whoAdded": 107,
   "subRetorical": "مجاز مرسل يعتمد على المعنى"
  },
  {
   "id": 1102,
   "name": "تشبيه",
   "info": "المشبه به وكأنّه موجود في المشبه. مثل \"كأنّ الثريا في قلائدها\": من بيت لبشار بن برد، قصيدة رقم 26ب، يشبه القلائد بالثريا، لكنه عبر عن ذلك بأنّ الثريا موجودة في القلائد.",
   "whoAdded": 107,
   "subRetorical": "تشبيه مضاف"
  },
  {
   "id": 1103,
   "name": "استعارة",
   "info": null,
   "whoAdded": 107,
   "subRetorical": "استعارة قديمة مرشحة"
  },
  {
   "id": 1104,
   "name": "طباق",
   "info": "مظهر الجملة يوهم بأنّها طباق، لكن إذا دققنا في معاني العبارات، فلا طباق بينها.\nمثل عبارة بشار بن برد: إذا ما جرت سفوح المنايا في متون القرادد. يبدو لأول وهلة أنّ السفوح عكس المتون (الأرض المنخفضة والعالية)، لكن معنى سفوح هو \"ما سال وجرى\".",
   "whoAdded": 107,
   "subRetorical": "طباق يعتمد على التورية"
  },
  {
   "id": 1105,
   "name": "استعارة",
   "info": null,
   "whoAdded": 107,
   "subRetorical": "استعارة فعل مرشحة"
  },
  {
   "id": 1106,
   "name": "استعارة",
   "info": null,
   "whoAdded": 107,
   "subRetorical": "استعارة حديثة مرشحة"
  },
  {
   "id": 1107,
   "name": "أسلوب الحكيم (عام)",
   "info": null,
   "whoAdded": 107,
   "subRetorical": "أسلوب الحكيم"
  },
  {
   "id": 1108,
   "name": "الرثاء",
   "info": null,
   "whoAdded": 107,
   "subRetorical": "بكاء الحسين وآله"
  },
  {
   "id": 1109,
   "name": "تشبيه",
   "info": null,
   "whoAdded": 107,
   "subRetorical": "تشبيه قصير"
  },
  {
   "id": 1110,
   "name": "طباق",
   "info": "مثل بيت لديك الجن ما معناه: الأرض تضحك، والغيث يهملُ\". عبارة يهمل لها معنيان: يسيل المطر، وتبكي العين. هنا يريد المعنيين، لكن الطباق في واحد منهما وهو الثاني.",
   "whoAdded": 107,
   "subRetorical": "طباق غريب"
  },
  {
