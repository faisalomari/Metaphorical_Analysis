 "verses": [
  {
   "verse_index": 1,
   "sadr": "بخالةَ، أو ماء الذُّنابَةِ أو سِوى",
   "ajuz": "مَظِنّةِ كلبٍ، أو مياهِ المواطرِ",
   "text": "بخالةَ، أو ماء الذُّنابَةِ أو سِوى    مَظِنّةِ كلبٍ، أو مياهِ المواطرِ"
  },
  {
   "verse_index": 2,
   "sadr": "ترى الرّاغِبينَ العاكِفينَ ببابهِ،",
   "ajuz": "على كلّ شِيزى أُترِعتَ بالعُراعرِ",
   "text": "ترى الرّاغِبينَ العاكِفينَ ببابهِ،    على كلّ شِيزى أُترِعتَ بالعُراعرِ"
  },
  {
   "verse_index": 3,
   "sadr": "له بفِناء البيتِ سوداءُ فخمةٌ،",
   "ajuz": "تُلّقّمُ أوصالَ الجَزورِ العَراعرِ",
   "text": "له بفِناء البيتِ سوداءُ فخمةٌ،    تُلّقّمُ أوصالَ الجَزورِ العَراعرِ"
  },
  {
   "verse_index": 4,
   "sadr": "بقيّةُ قِدْرٍ من قٌدورٍ تُوُرّثَتْ",
   "ajuz": "لآلِ الجُلاحِ، كابراً بعدَ كابرِ",
   "text": "بقيّةُ قِدْرٍ من قٌدورٍ تُوُرّثَتْ    لآلِ الجُلاحِ، كابراً بعدَ كابرِ"
  },
  {
   "verse_index": 5,
   "sadr": "تظَلّ الإماءُ يَبتدِرنَ قديمَها،",
   "ajuz": "كما ابتدرَتْ سعدٌ مياهَ قُراقرِ",
   "text": "تظَلّ الإماءُ يَبتدِرنَ قديمَها،    كما ابتدرَتْ سعدٌ مياهَ قُراقرِ"
  },
  {
   "verse_index": 6,
   "sadr": "وهم ضربوا أنفَ الفَزاريّ، بعدما",
   "ajuz": "أتاهم بمعقُودٍ من الأمرِ، قاهرِ",
   "text": "وهم ضربوا أنفَ الفَزاريّ، بعدما    أتاهم بمعقُودٍ من الأمرِ، قاهرِ"
  },
  {
   "verse_index": 7,
   "sadr": "أتطمَعُ في وادي القُرى وجِنابه،",
   "ajuz": "وقد مَنَعوا منه جميعَ المعاشرِ؟",
   "text": "أتطمَعُ في وادي القُرى وجِنابه،    وقد مَنَعوا منه جميعَ المعاشرِ؟"
  }
 ],
