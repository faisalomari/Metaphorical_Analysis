 "verses": [
  {
   "verse_index": 1,
   "sadr": "دَنَا سَفَرٌ، والدّارُ تُنْئي وتُصقِبُ\t",
   "ajuz": "ويَنْسَى سُرَاهُ مَن يُعافى ويُصْحَبُ",
   "text": "دَنَا سَفَرٌ، والدّارُ تُنْئي وتُصقِبُ\t    ويَنْسَى سُرَاهُ مَن يُعافى ويُصْحَبُ"
  },
  {
   "verse_index": 2,
   "sadr": "وأَيَّامُنا خُزْرُ العُيونِ عَوابِسٌ\t",
   "ajuz": "إِذَا لَمْ يَخُصْهَا الحَازِمُ المُتَلَبِّبُ",
   "text": "وأَيَّامُنا خُزْرُ العُيونِ عَوابِسٌ\t    إِذَا لَمْ يَخُصْهَا الحَازِمُ المُتَلَبِّبُ"
  },
  {
   "verse_index": 3,
   "sadr": "ولا بُدّ مِن فَرْوٍ إِذَا اجتَابَهُ امْرُؤٌ\t",
   "ajuz": "كَفَى وهو سَامٍ في الصَّنابرِ أَغْلَبُ",
   "text": "ولا بُدّ مِن فَرْوٍ إِذَا اجتَابَهُ امْرُؤٌ\t    كَفَى وهو سَامٍ في الصَّنابرِ أَغْلَبُ"
  },
  {
   "verse_index": 4,
   "sadr": "أَمينُ القُوَى لم تَحْصُصِ الحَرْبُ رَأَسَهُ\t",
   "ajuz": "ولم يَنْضُ عُمْراً، وهو أَشْمَطُ أَشْيَبُ",
   "text": "أَمينُ القُوَى لم تَحْصُصِ الحَرْبُ رَأَسَهُ\t    ولم يَنْضُ عُمْراً، وهو أَشْمَطُ أَشْيَبُ"
  },
  {
   "verse_index": 5,
   "sadr": "يَسُرُّكَ بأْساً وهو غِرٌّ مُغَمَّرٌ",
   "ajuz": "ويُعْتَدُّ للأَيام حينَ يُجرَّبُ",
   "text": "يَسُرُّكَ بأْساً وهو غِرٌّ مُغَمَّرٌ    ويُعْتَدُّ للأَيام حينَ يُجرَّبُ"
  },
  {
   "verse_index": 6,
   "sadr": "تَظَلُّ البلادُ تَرتَمي بضَريبِها\t",
   "ajuz": "وتُشمَل مِن أقطَارِهَا وهوَ يُجْنَبُ",
   "text": "تَظَلُّ البلادُ تَرتَمي بضَريبِها\t    وتُشمَل مِن أقطَارِهَا وهوَ يُجْنَبُ"
  },
  {
   "verse_index": 7,
   "sadr": "إِذَا البَدنُ المقرُورُ أُلْبِسَهُ غَدَا\t",
   "ajuz": "لَهُ رَاشِحٌ مِن تَحْتِهِ يَتَصَبَّبُ",
   "text": "إِذَا البَدنُ المقرُورُ أُلْبِسَهُ غَدَا\t    لَهُ رَاشِحٌ مِن تَحْتِهِ يَتَصَبَّبُ"
  },
  {
   "verse_index": 8,
   "sadr": "إِذَا عَدَّ ذَنْباً ثِقْلَهُ مِنْكِبُ امرِئٍ\t",
   "ajuz": "يقُولُ الحَشَا: إحسَانُهُ حين يُذْنِبُ",
   "text": "إِذَا عَدَّ ذَنْباً ثِقْلَهُ مِنْكِبُ امرِئٍ\t    يقُولُ الحَشَا: إحسَانُهُ حين يُذْنِبُ"
  },
  {
   "verse_index": 9,
   "sadr": "أَثيثٌ إِذَا استَعتَبْتَ مُعْصِفَة ً بهِ",
   "ajuz": "تَملَّأتَ علْماً أَنَّها سَوْفَ تُعْتِبُ",
   "text": "أَثيثٌ إِذَا استَعتَبْتَ مُعْصِفَة ً بهِ    تَملَّأتَ علْماً أَنَّها سَوْفَ تُعْتِبُ"
  },
  {
   "verse_index": 10,
   "sadr": "يَرَاهُ الشَّفِيفُ المُرْثَعِنُّ فينثَني\t",
   "ajuz": "حَسيراً وتَغْشَاه الصِّبَا فتَنَكَّبُ",
   "text": "يَرَاهُ الشَّفِيفُ المُرْثَعِنُّ فينثَني\t    حَسيراً وتَغْشَاه الصِّبَا فتَنَكَّبُ"
  },
  {
   "verse_index": 11,
   "sadr": "إِذا مَا أساءَتْ بالثِّيَابِ فَقَوْلُه\t",
   "ajuz": "لها كُلَّما لاقَتْهُ أَهْلٌ ومَرْحَبُ",
   "text": "إِذا مَا أساءَتْ بالثِّيَابِ فَقَوْلُه\t    لها كُلَّما لاقَتْهُ أَهْلٌ ومَرْحَبُ"
  },
  {
   "verse_index": 12,
   "sadr": "إِذا اليَوْمُ أَمسَى وهْوَ غَضْبَانُ لم يَكُنْ\t",
   "ajuz": "طَوِيلَ مُبَالاة ٍ بهِ حينَ يَغْضَبُ",
   "text": "إِذا اليَوْمُ أَمسَى وهْوَ غَضْبَانُ لم يَكُنْ\t    طَوِيلَ مُبَالاة ٍ بهِ حينَ يَغْضَبُ"
  },
  {
   "verse_index": 13,
   "sadr": "كأَنَّ حَواشِيهِ العُلَى وخُصُورَهُ\t",
   "ajuz": "وما انْحَطَّ منه جَمْرَة ٌ تَتَلهَّبُ",
   "text": "كأَنَّ حَواشِيهِ العُلَى وخُصُورَهُ\t    وما انْحَطَّ منه جَمْرَة ٌ تَتَلهَّبُ"
  },
  {
   "verse_index": 14,
   "sadr": "فَهلْ أَنتَ مُهْدِيهِ بِمثْلِ شَكِيرِه\t",
   "ajuz": "مِنَ الشُّكْرِ يَعْلُو مُصْعِداً ويُصَوِّبُ؟",
   "text": "فَهلْ أَنتَ مُهْدِيهِ بِمثْلِ شَكِيرِه\t    مِنَ الشُّكْرِ يَعْلُو مُصْعِداً ويُصَوِّبُ؟"
  },
  {
   "verse_index": 15,
   "sadr": "لَهُ زِئْبِرٌ يُدْفِي مِن الذَّمِّ كلَّما\t",
   "ajuz": "تَجَلْبَبَهُ في مَحْفِلٍ مُتَجَلْبِبُ",
   "text": "لَهُ زِئْبِرٌ يُدْفِي مِن الذَّمِّ كلَّما\t    تَجَلْبَبَهُ في مَحْفِلٍ مُتَجَلْبِبُ"
  },
  {
   "verse_index": 16,
   "sadr": "فأَنتَ العَلِيمُ الطَّبُ أُيُّ وَصِيَّة ٍ\t",
   "ajuz": "بها كانَ أَوصَى في الثِّيَابِ المُهلَّبُ",
   "text": "فأَنتَ العَلِيمُ الطَّبُ أُيُّ وَصِيَّة ٍ\t    بها كانَ أَوصَى في الثِّيَابِ المُهلَّبُ"
  }
