 "verses": [
  {
   "verse_index": 1,
   "sadr": "لم يَبْقَ لِلصَّيْفِ لا رَسْمٌ ولا طَلَلُ",
   "ajuz": "ولا قَشِيبٌ فَيُسْتَكْسَى ولا سَمَلُ",
   "text": "لم يَبْقَ لِلصَّيْفِ لا رَسْمٌ ولا طَلَلُ    ولا قَشِيبٌ فَيُسْتَكْسَى ولا سَمَلُ"
  },
  {
   "verse_index": 2,
   "sadr": "عَدْلٌ مِنَ الدَّمعِ أنْ يَبكي المَصِيفَ كما\t",
   "ajuz": "يُبْكى الشَّبابُ ويُبْكَى اللَّهْوُ والغَزَلُ",
   "text": "عَدْلٌ مِنَ الدَّمعِ أنْ يَبكي المَصِيفَ كما\t    يُبْكى الشَّبابُ ويُبْكَى اللَّهْوُ والغَزَلُ"
  },
  {
   "verse_index": 3,
   "sadr": "يُمْنَى الزَّمانِ طَوَتْ مَعْرُوفَها وغَدَتْ\t",
   "ajuz": "يُسْراهُ وهْيَ لنا مِنْ بعدِها بَدَلُ",
   "text": "يُمْنَى الزَّمانِ طَوَتْ مَعْرُوفَها وغَدَتْ\t    يُسْراهُ وهْيَ لنا مِنْ بعدِها بَدَلُ"
  },
  {
   "verse_index": 4,
   "sadr": "ما لِلشتاءِ ولا لِلصَّيْفِ مِنْ مَثَل",
   "ajuz": "يَرْضَى به السَّمْعُ إلاَّ الجُودُ والبخلُ",
   "text": "ما لِلشتاءِ ولا لِلصَّيْفِ مِنْ مَثَل    يَرْضَى به السَّمْعُ إلاَّ الجُودُ والبخلُ"
  },
  {
   "verse_index": 5,
   "sadr": "أَما ترى الأرضَ غضبى والحصى قلِقٌ\t",
   "ajuz": "والأفقَ بالحَرجَفِ النكباءِ يقتَتِلُ",
   "text": "أَما ترى الأرضَ غضبى والحصى قلِقٌ\t    والأفقَ بالحَرجَفِ النكباءِ يقتَتِلُ"
  },
  {
   "verse_index": 6,
   "sadr": "مَنْ يَزْعَمُ الصَّيْفَ لم تَذْهَبْ بَشَاشَتُه",
   "ajuz": "فغيرُ ذلكَ أَمسَى يَزعمُ الجَبَلُ",
   "text": "مَنْ يَزْعَمُ الصَّيْفَ لم تَذْهَبْ بَشَاشَتُه    فغيرُ ذلكَ أَمسَى يَزعمُ الجَبَلُ"
  },
  {
   "verse_index": 7,
   "sadr": "غَدَا له مِغْفَرٌ في رأسِهِ يَقَقٌ\t",
   "ajuz": "لا تَهْتِكُ البِيضُ فَوْدَيْهِ ولا الأَسَلُ",
   "text": "غَدَا له مِغْفَرٌ في رأسِهِ يَقَقٌ\t    لا تَهْتِكُ البِيضُ فَوْدَيْهِ ولا الأَسَلُ"
  },
  {
   "verse_index": 8,
   "sadr": "إِذا خُراسانُ عنْ صِنِّبْرِها كَشرَتْ\t",
   "ajuz": "كانَتْ قَتاداً لنا أَنيابُها العُصُلُ",
   "text": "إِذا خُراسانُ عنْ صِنِّبْرِها كَشرَتْ\t    كانَتْ قَتاداً لنا أَنيابُها العُصُلُ"
  },
  {
   "verse_index": 9,
   "sadr": "يُمْسِي ويُضحِي مٌقيماً في مَبَائِتِه\t",
   "ajuz": "وَبَأسُهُ في كُلَى الأَقوامِ مُرْتَحِلُ",
   "text": "يُمْسِي ويُضحِي مٌقيماً في مَبَائِتِه\t    وَبَأسُهُ في كُلَى الأَقوامِ مُرْتَحِلُ"
  },
  {
   "verse_index": 10,
   "sadr": "مَنْ كَانَ يَجهلُ يوماً حَدَّ سَوْرَتهِ\t",
   "ajuz": "في القَريتيْنِ وأَمْرُ الجَوِّ مُكْتَهِلُ",
   "text": "مَنْ كَانَ يَجهلُ يوماً حَدَّ سَوْرَتهِ\t    في القَريتيْنِ وأَمْرُ الجَوِّ مُكْتَهِلُ"
  },
  {
   "verse_index": 11,
   "sadr": "فما الضُّلوعُ ولا الأَحشَاءُ جاهِلَة ٌ\t",
   "ajuz": "ولا الكُلَى أَنَّه المِقْدَامَة ُ البَطَلُ!",
   "text": "فما الضُّلوعُ ولا الأَحشَاءُ جاهِلَة ٌ\t    ولا الكُلَى أَنَّه المِقْدَامَة ُ البَطَلُ!"
  },
  {
   "verse_index": 12,
   "sadr": "هذا ولم يَتَّزِر لِلحرْبِ دَيْدَنَهُ\t",
   "ajuz": "فأَيُّ قِرْنٍ تَرَاهُ حينَ يَشْتَمِلُ؟!",
   "text": "هذا ولم يَتَّزِر لِلحرْبِ دَيْدَنَهُ\t    فأَيُّ قِرْنٍ تَرَاهُ حينَ يَشْتَمِلُ؟!"
  },
  {
   "verse_index": 13,
   "sadr": "إنْ يَسَّرَ اللَّه أَمراً أَثمَرتْ معه\t",
   "ajuz": "مِنْ حيثُ أورَقتِ الحاجاتُ والأَمَلُ",
   "text": "إنْ يَسَّرَ اللَّه أَمراً أَثمَرتْ معه\t    مِنْ حيثُ أورَقتِ الحاجاتُ والأَمَلُ"
  },
  {
   "verse_index": 14,
   "sadr": "فما صِلائيَ إِنْ كانَ الصِّلاءُ بها\t",
   "ajuz": "جَمْرَ الغَضَا الجَزْلِ إلَّا السَّيْرُ والإِبلُ",
   "text": "فما صِلائيَ إِنْ كانَ الصِّلاءُ بها\t    جَمْرَ الغَضَا الجَزْلِ إلَّا السَّيْرُ والإِبلُ"
  },
  {
   "verse_index": 15,
   "sadr": "المُرضِياتُكَ ما أَرغمتَ آنُفَها\t",
   "ajuz": "والهَادِياتُك وهْيَ الشُّرَّدُ الضُّلُلُ",
   "text": "المُرضِياتُكَ ما أَرغمتَ آنُفَها\t    والهَادِياتُك وهْيَ الشُّرَّدُ الضُّلُلُ"
  },
  {
   "verse_index": 16,
   "sadr": "تُقَرِّبُ الشُّقَّة َ القُصْوَى إِذا أَخذَتْ\t",
   "ajuz": "سِلاحَها وَهُو الإرقالُ والرَّمَلُ",
   "text": "تُقَرِّبُ الشُّقَّة َ القُصْوَى إِذا أَخذَتْ\t    سِلاحَها وَهُو الإرقالُ والرَّمَلُ"
  },
  {
   "verse_index": 17,
   "sadr": "إِذَا تَظَلَّمْتَ مِن أَرضٍ فُصِلْتَ بها\t",
   "ajuz": "كَانَتْ هي العِزُّ إِلاَّ أَنَّها ذُلُلُ!",
   "text": "إِذَا تَظَلَّمْتَ مِن أَرضٍ فُصِلْتَ بها\t    كَانَتْ هي العِزُّ إِلاَّ أَنَّها ذُلُلُ!"
  }
 ],
