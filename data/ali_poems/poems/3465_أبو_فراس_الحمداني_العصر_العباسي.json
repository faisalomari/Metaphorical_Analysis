 "verses": [
  {
   "verse_index": 1,
   "sadr": "وَمَا أَنْسَ لَا أَنْسَ يَوْمَ آلْمَغَارِ",
   "ajuz": "مُحَجَّبَةً لَفَظَتْهَا آلْحُجُبْ",
   "text": "وَمَا أَنْسَ لَا أَنْسَ يَوْمَ آلْمَغَارِ    مُحَجَّبَةً لَفَظَتْهَا آلْحُجُبْ"
  },
  {
   "verse_index": 2,
   "sadr": "دَعَاكَ ذَوُوُهَا بِسُوءِ آلْجِوَارِ",
   "ajuz": "لِمَا لا تُرِيدُ، وَمَا لَا تُحِبّْ",
   "text": "دَعَاكَ ذَوُوُهَا بِسُوءِ آلْجِوَارِ    لِمَا لا تُرِيدُ، وَمَا لَا تُحِبّْ"
  },
  {
   "verse_index": 3,
   "sadr": "فَوَافَتْكَ تَرْفُلُ فِي مِرْطِهَا",
   "ajuz": "وَقَدْ رَأَتِ آلْمَوْتَ مِنْ عَنْ كَثَبْ",
   "text": "فَوَافَتْكَ تَرْفُلُ فِي مِرْطِهَا    وَقَدْ رَأَتِ آلْمَوْتَ مِنْ عَنْ كَثَبْ"
  },
  {
   "verse_index": 4,
   "sadr": "وَقَدْ خَلَطَ آلْخَوْفُ لَمّا طَلَعْـ",
   "ajuz": "ـتَ دَلَّ آلْجَمَالِ بِذُلْ آلرُّعُبْ",
   "text": "وَقَدْ خَلَطَ آلْخَوْفُ لَمّا طَلَعْـ    ـتَ دَلَّ آلْجَمَالِ بِذُلْ آلرُّعُبْ"
  },
  {
   "verse_index": 5,
   "sadr": "تُسَارِعُ فِي آلْخَطْوِ لَا خِفَّةً",
   "ajuz": "وَتَهْتَزُّ فِي آلْمَشْيِ لَا مِنْ طَرَبْ",
   "text": "تُسَارِعُ فِي آلْخَطْوِ لَا خِفَّةً    وَتَهْتَزُّ فِي آلْمَشْيِ لَا مِنْ طَرَبْ"
  },
  {
   "verse_index": 6,
   "sadr": "فلمَّـا بَدَتْ لَكَ فَوْقَ آلْبُيُوتِ",
   "ajuz": "بَدَا لَكَ مِنْهُنَّ جَيْشٌَ لَجِبْ",
   "text": "فلمَّـا بَدَتْ لَكَ فَوْقَ آلْبُيُوتِ    بَدَا لَكَ مِنْهُنَّ جَيْشٌَ لَجِبْ"
  },
  {
   "verse_index": 7,
   "sadr": "فَكُنْتَ أَخَاهُنَّ إِذْ لَا أَخٌ",
   "ajuz": "وَكُنْتَ أَبَاهُنَّ إذْ لَيْسَ أَبْ",
   "text": "فَكُنْتَ أَخَاهُنَّ إِذْ لَا أَخٌ    وَكُنْتَ أَبَاهُنَّ إذْ لَيْسَ أَبْ"
  },
  {
   "verse_index": 8,
   "sadr": "وَمَا زِلْتَ، مُذْ كُنْتَ، تُولي آلْجَمِيلَ",
   "ajuz": "وَتَحْمِي آلْحَرِيمَ، وَتَرْعَى آلنِّسَبْ",
   "text": "وَمَا زِلْتَ، مُذْ كُنْتَ، تُولي آلْجَمِيلَ    وَتَحْمِي آلْحَرِيمَ، وَتَرْعَى آلنِّسَبْ"
  },
  {
   "verse_index": 9,
   "sadr": "وَتَغْضَبُ حَتَّى إِذَا مَا مَلَكْتَ",
   "ajuz": "أطَعْتَ آلرِّضَا، وَعَصَيْتَ آلْغَضَبْ",
   "text": "وَتَغْضَبُ حَتَّى إِذَا مَا مَلَكْتَ    أطَعْتَ آلرِّضَا، وَعَصَيْتَ آلْغَضَبْ"
  },
  {
   "verse_index": 10,
   "sadr": "فَوَلّيْنَ عَنْكَ يُفَدّينَهَا،",
   "ajuz": "وَيَرْفَعنَ مِنْ ذَيْلِها مَا آنْسَحَبْ",
   "text": "فَوَلّيْنَ عَنْكَ يُفَدّينَهَا،    وَيَرْفَعنَ مِنْ ذَيْلِها مَا آنْسَحَبْ"
  },
  {
   "verse_index": 11,
   "sadr": "يُنَادِينَ بَيْنَ خِلَالِ آلْبُيُو",
   "ajuz": "تِ: \"لَا يَقطَعِ آللَّهُ نَسْلَ آلْعَرَبْ",
   "text": "يُنَادِينَ بَيْنَ خِلَالِ آلْبُيُو    تِ: \"لَا يَقطَعِ آللَّهُ نَسْلَ آلْعَرَبْ"
  },
  {
   "verse_index": 12,
   "sadr": "أَمَرْتَ -وَأَنْتَ آلْمُطَاعُ آلْكَرِيمُ-",
   "ajuz": "بِبَذْلِ آلْأَمَانِ َوَردِّ آلسَّلَبْ",
   "text": "أَمَرْتَ -وَأَنْتَ آلْمُطَاعُ آلْكَرِيمُ-    بِبَذْلِ آلْأَمَانِ َوَردِّ آلسَّلَبْ"
  },
  {
   "verse_index": 13,
   "sadr": "وَقَدْ رُحْنَ مِنْ مُهَجَاتِ آلْقُلُوبِ",
