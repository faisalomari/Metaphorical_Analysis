  {
   "verse_index": 1,
   "sadr": "قُلْ لأسماء أَنْجِزي الميعادا",
   "ajuz": "وانْظُري أنْ تُزوِّدي منكِ زادا",
   "text": "قُلْ لأسماء أَنْجِزي الميعادا    وانْظُري أنْ تُزوِّدي منكِ زادا"
  },
  {
   "verse_index": 2,
   "sadr": "أَينما كنتِ أو حَلَلتِ بأَرضٍ",
   "ajuz": "أو بلادٍ أَحيَيْتِ تلكَ البلادا",
   "text": "أَينما كنتِ أو حَلَلتِ بأَرضٍ    أو بلادٍ أَحيَيْتِ تلكَ البلادا"
  },
  {
   "verse_index": 3,
   "sadr": "إن تَكُونِي تَرَكْتِ رَبْعَكِ بالشَّأ",
   "ajuz": "مِ وجاوَزْتِ حِمْيرًا ومُرادا",
   "text": "إن تَكُونِي تَرَكْتِ رَبْعَكِ بالشَّأ    مِ وجاوَزْتِ حِمْيرًا ومُرادا"
  },
  {
   "verse_index": 4,
   "sadr": "فارْتَجِي أَن أَكونَ منكِ قريبًا",
   "ajuz": "فاسْألي الصَّادِرِين والوُرَّادا",
   "text": "فارْتَجِي أَن أَكونَ منكِ قريبًا    فاسْألي الصَّادِرِين والوُرَّادا"
  },
  {
   "verse_index": 5,
   "sadr": "وإذا ما رأَيْتِ رَكْبًا مُخِبِّيـ",
   "ajuz": "ـنَ يَقُودونَ مُقْرَباتٍ جِيادا",
   "text": "وإذا ما رأَيْتِ رَكْبًا مُخِبِّيـ    ـنَ يَقُودونَ مُقْرَباتٍ جِيادا"
  },
  {
   "verse_index": 6,
   "sadr": "فَهُمُ صُحْبتِي على أَرْحُلِ المَيْـ",
   "ajuz": "ـسِ يُزَجُّونَ أَيْنُقًا أَفْرادا",
   "text": "فَهُمُ صُحْبتِي على أَرْحُلِ المَيْـ    ـسِ يُزَجُّونَ أَيْنُقًا أَفْرادا"
  },
  {
   "verse_index": 7,
   "sadr": "وإذا ما سَمعتِ من نحوِ أَرضٍ",
   "ajuz": "بِمُحِبٍّ قد ماتَ أَو قِيلَ كادا",
   "text": "وإذا ما سَمعتِ من نحوِ أَرضٍ    بِمُحِبٍّ قد ماتَ أَو قِيلَ كادا"
  },
  {
   "verse_index": 8,
   "sadr": "فاعْلَمِي غيرَ عِلْمِ شَكٍّ بأَنِّي",
   "ajuz": "ذاكِ، وابْكِي لِمُصْفَدٍ أَنْ يُفادى",
