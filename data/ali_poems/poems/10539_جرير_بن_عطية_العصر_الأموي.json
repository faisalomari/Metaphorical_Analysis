   "text": "إِلى اللهِ أَشكو أَنَّ بالغَوْرِ حاجةً    وأُخرى إِذا أَبصرت نجدًا بَدَا ليا"
  },
  {
   "verse_index": 4,
   "sadr": "إِذا ما أَراد الحي أَن يتزايلوا",
   "ajuz": "وحنت جِمال البين حنت جماليا",
   "text": "إِذا ما أَراد الحي أَن يتزايلوا    وحنت جِمال البين حنت جماليا"
  },
  {
   "verse_index": 5,
   "sadr": "أَلا أَيها الوادي الذي ضم سيله",
   "ajuz": "إِلينا نوى ظمياءَ حُيِّيتَ واديا",
   "text": "أَلا أَيها الوادي الذي ضم سيله    إِلينا نوى ظمياءَ حُيِّيتَ واديا"
