   "sadr": "محاسن الدير تسبيحي ومسباحي",
   "ajuz": "وخمره في الدّجى صبحي ومصباحي",
   "text": "محاسن الدير تسبيحي ومسباحي    وخمره في الدّجى صبحي ومصباحي"
  },
  {
   "verse_index": 2,
   "sadr": "أقمت فيه إلى أن صار هيكلُه",
   "ajuz": "بيتي ومفتاحُه للأنس مفتاحي",
   "text": "أقمت فيه إلى أن صار هيكلُه    بيتي ومفتاحُه للأنس مفتاحي"
  },
  {
   "verse_index": 3,
   "sadr": "منادمًا في قلاليه رَهَابِنةً",
   "ajuz": "راحت خلائقهم أصفى من الراح",
   "text": "منادمًا في قلاليه رَهَابِنةً    راحت خلائقهم أصفى من الراح"
  },
  {
   "verse_index": 4,
   "sadr": "قد عدّلوا ثقل أديانٍ ومعرفةٍ",
   "ajuz": "فيهم بخفّة أبدانٍ وأرواح",
   "text": "قد عدّلوا ثقل أديانٍ ومعرفةٍ    فيهم بخفّة أبدانٍ وأرواح"
  },
  {
   "verse_index": 5,
   "sadr": "ووشّحوا غُرر الآداب فلسفة",
   "ajuz": "وحكمة بعلومٍ ذات إيضاح",
   "text": "ووشّحوا غُرر الآداب فلسفة    وحكمة بعلومٍ ذات إيضاح"
  },
  {
   "verse_index": 6,
   "sadr": "في طب بقراط لحنُ الموصلِّي وفي",
   "ajuz": "نحو المبرِّد أشعار الطِّرِمَّاح",
   "text": "في طب بقراط لحنُ الموصلِّي وفي    نحو المبرِّد أشعار الطِّرِمَّاح"
  },
  {
   "verse_index": 7,
   "sadr": "ومنشدٌ حين يبديه المزاج لنا",
   "ajuz": "ألمعُ برقٍ سرى أم ضوء مصباح",
   "text": "ومنشدٌ حين يبديه المزاج لنا    ألمعُ برقٍ سرى أم ضوء مصباح"
  },
  {
   "verse_index": 8,
   "sadr": "وكم حنَنْت إلى حاناته وغدا",
   "ajuz": "شوقي يكاثر أصواتًا بأقداح",
   "text": "وكم حنَنْت إلى حاناته وغدا    شوقي يكاثر أصواتًا بأقداح"
  },
  {
   "verse_index": 9,
   "sadr": "حتى تخمّر خمّاري بمعرفتي",
   "ajuz": "وحَيَّرَتْ مُلَحي في السُّكر ملَّاحي",
   "text": "حتى تخمّر خمّاري بمعرفتي    وحَيَّرَتْ مُلَحي في السُّكر ملَّاحي"
  },
  {
   "verse_index": 10,
   "sadr": "يا دير مرّانَ لا تعدم ضحًى ودجًى",
   "ajuz": "سجال غيثٍ ملثِّ الودقِ سحّام",
   "text": "يا دير مرّانَ لا تعدم ضحًى ودجًى    سجال غيثٍ ملثِّ الودقِ سحّام"
  },
  {
   "verse_index": 11,
   "sadr": "إن تُفْنِ كأسك أكياسي فإنّ بها",
   "ajuz": "يفُلّ جيشَ همومي جيشُ أفراحي",
