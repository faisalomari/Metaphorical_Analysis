  {
   "verse_index": 1,
   "sadr": "عشِقتُ، وإنّني لَفَتًى وَدودُ،",
   "ajuz": "ضَنينًا بالمَوَدّة ما يجودُ",
   "text": "عشِقتُ، وإنّني لَفَتًى وَدودُ،    ضَنينًا بالمَوَدّة ما يجودُ"
  },
  {
   "verse_index": 2,
   "sadr": "مررتُ به فكلّمني بطَرْف",
   "ajuz": "يخيَّل فيه شَيْطانٌ مَريدُ",
   "text": "مررتُ به فكلّمني بطَرْف    يخيَّل فيه شَيْطانٌ مَريدُ"
  },
  {
   "verse_index": 3,
   "sadr": "فقُلتُ له: أتيتُك مستجيرًا",
