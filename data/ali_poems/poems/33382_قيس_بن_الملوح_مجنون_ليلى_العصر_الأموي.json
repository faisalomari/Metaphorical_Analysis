 "verses": [
  {
   "verse_index": 1,
   "sadr": "أيا عمرو كم من مهرة عربية",
   "ajuz": "من الناس قد بُليَتْ بوغْدٍ يقودُها",
   "text": "أيا عمرو كم من مهرة عربية    من الناس قد بُليَتْ بوغْدٍ يقودُها"
  },
  {
   "verse_index": 2,
   "sadr": "يَسوس وما يدري لها من سياسةٍ",
   "ajuz": "يريد بها أشياء ليستْ تريدُها",
   "text": "يَسوس وما يدري لها من سياسةٍ    يريد بها أشياء ليستْ تريدُها"
  },
  {
   "verse_index": 3,
   "sadr": "مُبَتَّلَةُ الأعجازِ زانتْ عقودَها",
   "ajuz": "بأحسنَ مما زيَّنَتْها عقودُها",
   "text": "مُبَتَّلَةُ الأعجازِ زانتْ عقودَها    بأحسنَ مما زيَّنَتْها عقودُها"
  },
  {
   "verse_index": 4,
   "sadr": "خليليّ شُدَّا بالعمامة واحزِما",
   "ajuz": "على كبد قد بان صَدْعًا عمودُها",
   "text": "خليليّ شُدَّا بالعمامة واحزِما    على كبد قد بان صَدْعًا عمودُها"
  },
  {
   "verse_index": 5,
   "sadr": "خليليّ هل ليلى مُؤَدِّيةٌ دَمي",
   "ajuz": "إذا قتلتني أو أميرٌ يُقيدُها",
   "text": "خليليّ هل ليلى مُؤَدِّيةٌ دَمي    إذا قتلتني أو أميرٌ يُقيدُها"
  },
  {
   "verse_index": 6,
   "sadr": "وكيف تُقَاد النفس بالنفس لم تَقُل",
   "ajuz": "قتلتُ، ولم يشهدْ عليها شهودُها",
   "text": "وكيف تُقَاد النفس بالنفس لم تَقُل    قتلتُ، ولم يشهدْ عليها شهودُها"
  },
  {
   "verse_index": 7,
   "sadr": "ولن يلبث الواشون أن يَصْدعوا العصا",
   "ajuz": "إذا لم يكن صُلْبًا على البَرْي عُودُها",
   "text": "ولن يلبث الواشون أن يَصْدعوا العصا    إذا لم يكن صُلْبًا على البَرْي عُودُها"
  },
  {
   "verse_index": 8,
   "sadr": "نظرت إليها نظرة ما يَسُرُّني",
   "ajuz": "بها حُمْرُ أنعام البلاد وسُودُها",
   "text": "نظرت إليها نظرة ما يَسُرُّني    بها حُمْرُ أنعام البلاد وسُودُها"
  },
  {
   "verse_index": 9,
   "sadr": "إذا جئتها وسْط النساءِ منحتُها",
   "ajuz": "صُدودً كأن النفس ليستْ تريدها",
   "text": "إذا جئتها وسْط النساءِ منحتُها    صُدودً كأن النفس ليستْ تريدها"
  },
  {
   "verse_index": 10,
   "sadr": "ولي نظرة بعد الصدود من الهوى",
   "ajuz": "كنظرةِ ثكلى قد أُصيب وحيدها",
   "text": "ولي نظرة بعد الصدود من الهوى    كنظرةِ ثكلى قد أُصيب وحيدها"
  },
  {
   "verse_index": 11,
   "sadr": "فحتى متى هذا الصدودُ إلى متى",
   "ajuz": "لقد شفَّ نفسي هجرُها وصدودُها",
   "text": "فحتى متى هذا الصدودُ إلى متى    لقد شفَّ نفسي هجرُها وصدودُها"
  },
  {
   "verse_index": 12,
   "sadr": "فلو أن ما أبقيت مني مُعَلَّقٌ",
   "ajuz": "بعود ثُمَام ما تأوَّد عودها",
   "text": "فلو أن ما أبقيت مني مُعَلَّقٌ    بعود ثُمَام ما تأوَّد عودها"
  }
