 "verses": [
  {
   "verse_index": 1,
   "sadr": "حَيِّ الدِّيارَ إذ الزَّمانُ زَمانُ",
   "ajuz": "وإذ الشِّباكُ لنا حَرًى ومَعانُ",
   "text": "حَيِّ الدِّيارَ إذ الزَّمانُ زَمانُ    وإذ الشِّباكُ لنا حَرًى ومَعانُ"
  },
  {
   "verse_index": 2,
   "sadr": "يا حَبَّذا سَفَوانُ من متربَّع",
   "ajuz": "ولَرُبّما جمع الهَوى سَفَوانُ",
   "text": "يا حَبَّذا سَفَوانُ من متربَّع    ولَرُبّما جمع الهَوى سَفَوانُ"
  },
  {
   "verse_index": 3,
   "sadr": "وإذا مررتَ على الدِّيار مسلِّما",
   "ajuz": "فلغير دارِ أُميمةَ الهِجْرانُ",
   "text": "وإذا مررتَ على الدِّيار مسلِّما    فلغير دارِ أُميمةَ الهِجْرانُ"
  },
  {
   "verse_index": 4,
   "sadr": "إنّا نسبْنا والمَناسِبُ ظِنّةٌ",
   "ajuz": "حتَّى رُميتِ بنا وأنتِ حَصانُ",
   "text": "إنّا نسبْنا والمَناسِبُ ظِنّةٌ    حتَّى رُميتِ بنا وأنتِ حَصانُ"
  },
  {
   "verse_index": 5,
   "sadr": "لمّا نزعتُ عن الغَواية والصِّبى",
   "ajuz": "وخدتْ بيَ الشَّدَنيَّةُ المِذْعانُ",
   "text": "لمّا نزعتُ عن الغَواية والصِّبى    وخدتْ بيَ الشَّدَنيَّةُ المِذْعانُ"
  },
  {
   "verse_index": 6,
   "sadr": "سُبُطٌ مَشافِرُها دَقيقٌ خَطْمُها",
   "ajuz": "وكأنّ سائرَ خَلْقها بُنْيانُ",
   "text": "سُبُطٌ مَشافِرُها دَقيقٌ خَطْمُها    وكأنّ سائرَ خَلْقها بُنْيانُ"
  },
  {
   "verse_index": 7,
   "sadr": "واحتازها لَوْنٌ جرى في جِلْدها",
   "ajuz": "يَقَقٌ كقِرْطاسِ الوَليد هِجانُ",
   "text": "واحتازها لَوْنٌ جرى في جِلْدها    يَقَقٌ كقِرْطاسِ الوَليد هِجانُ"
  },
  {
   "verse_index": 8,
   "sadr": "وإلى أبي الأُمَناء هارونَ الذي",
   "ajuz": "يحيى بصَوْبِ سَمائه الحَيَوانُ",
   "text": "وإلى أبي الأُمَناء هارونَ الذي    يحيى بصَوْبِ سَمائه الحَيَوانُ"
  },
  {
   "verse_index": 9,
   "sadr": "مَلِكٌ تصوّر في القُلوب مِثالُه",
   "ajuz": "فكأنّما لم يخلُ منه مَكانُ",
   "text": "مَلِكٌ تصوّر في القُلوب مِثالُه    فكأنّما لم يخلُ منه مَكانُ"
  },
  {
   "verse_index": 10,
   "sadr": "ما تنطوي عنه القُلوبُ بفَجْرة",
   "ajuz": "إلّا يكلِّمه بها اللَّحَظانُ",
   "text": "ما تنطوي عنه القُلوبُ بفَجْرة    إلّا يكلِّمه بها اللَّحَظانُ"
  },
  {
   "verse_index": 11,
   "sadr": "فيظَلّ لاستثباته وكأنّه",
   "ajuz": "عَيْنٌ على ما غيّب الكِتْمانُ",
   "text": "فيظَلّ لاستثباته وكأنّه    عَيْنٌ على ما غيّب الكِتْمانُ"
  },
  {
   "verse_index": 12,
   "sadr": "هارونُ ألّفَنا ائتلافَ مَوَدّة",
   "ajuz": "ماتتْ لها الأحقاد والأضغانُ",
   "text": "هارونُ ألّفَنا ائتلافَ مَوَدّة    ماتتْ لها الأحقاد والأضغانُ"
  },
  {
   "verse_index": 13,
   "sadr": "في كلِّ عام غَزْوةٌ ووِفادةٌ",
   "ajuz": "تنبتّ بين نَواهما الأقرانُ",
   "text": "في كلِّ عام غَزْوةٌ ووِفادةٌ    تنبتّ بين نَواهما الأقرانُ"
  },
  {
   "verse_index": 14,
   "sadr": "حَجٌّ وغَزْو مات بينهما الكَرى",
   "ajuz": "باليَعْمَلات شِعارُها الوَخَدانُ",
   "text": "حَجٌّ وغَزْو مات بينهما الكَرى    باليَعْمَلات شِعارُها الوَخَدانُ"
  },
  {
   "verse_index": 15,
   "sadr": "يرمي بهنّ بَساطَ كلِّ تَنوفة",
   "ajuz": "في الله رحّالٌ بها ظعّانٌ",
   "text": "يرمي بهنّ بَساطَ كلِّ تَنوفة    في الله رحّالٌ بها ظعّانٌ"
  },
  {
   "verse_index": 16,
   "sadr": "حتّى إذا واجهْن أقبالَ الصَّفا",
   "ajuz": "حنَّ الحَطيمُ وأطَّتِ الأركانُ",
   "text": "حتّى إذا واجهْن أقبالَ الصَّفا    حنَّ الحَطيمُ وأطَّتِ الأركانُ"
  },
  {
   "verse_index": 17,
   "sadr": "لِأغرَّ ينفرِج الدُّجَى عن وَجْهه",
   "ajuz": "عَدْلُ السِّياسة حُبُّه إيمانُ",
   "text": "لِأغرَّ ينفرِج الدُّجَى عن وَجْهه    عَدْلُ السِّياسة حُبُّه إيمانُ"
  },
  {
   "verse_index": 18,
   "sadr": "يصلَى الهَجيرَ بغُرّةٍ مَهْديّةٍ",
   "ajuz": "لو شاء صان أديمَها الأكنانُ",
   "text": "يصلَى الهَجيرَ بغُرّةٍ مَهْديّةٍ    لو شاء صان أديمَها الأكنانُ"
  },
  {
   "verse_index": 19,
   "sadr": "لكنّه في الله مبتذِلٌ لها",
   "ajuz": "إنّ التَقيّ مسدَّدٌ ومُعانُ",
   "text": "لكنّه في الله مبتذِلٌ لها    إنّ التَقيّ مسدَّدٌ ومُعانُ"
  },
  {
   "verse_index": 20,
   "sadr": "كدّتْ منادَمةُ الدِّماء سُيوفَه",
   "ajuz": "فَلَقَلَّما تحتازها الأجفانُ",
   "text": "كدّتْ منادَمةُ الدِّماء سُيوفَه    فَلَقَلَّما تحتازها الأجفانُ"
  },
  {
   "verse_index": 21,
   "sadr": "حتّى الذي في الرِّحْم لم يك صورةً",
   "ajuz": "لفُؤاده من خَوْفه خَفَقانُ",
   "text": "حتّى الذي في الرِّحْم لم يك صورةً    لفُؤاده من خَوْفه خَفَقانُ"
  },
  {
   "verse_index": 22,
   "sadr": "حَذَرَ امْرِئ نُصرتْ يَداه على العِدى",
   "ajuz": "كالدَّهْر فيه شَراسة ولَيانُ",
   "text": "حَذَرَ امْرِئ نُصرتْ يَداه على العِدى    كالدَّهْر فيه شَراسة ولَيانُ"
  },
  {
   "verse_index": 23,
   "sadr": "متبرِّجُ المعروف عِرّيضُ النَّدى",
   "ajuz": "حَصِرٌ بلا منه فَمٌ ولِسانُ",
   "text": "متبرِّجُ المعروف عِرّيضُ النَّدى    حَصِرٌ بلا منه فَمٌ ولِسانُ"
  },
  {
   "verse_index": 24,
   "sadr": "للجود من كِلْتا يَدَيْه محرِّكٌ",
   "ajuz": "لا يستطيع بُلوغَه الإسكانُ",
   "text": "للجود من كِلْتا يَدَيْه محرِّكٌ    لا يستطيع بُلوغَه الإسكانُ"
  }
