   "text": "يَا أبَا طَلْحَةَ الجَوَادَ أَغِثْنِي    بِسِجَالٍ من سَيْبِكَ المَقْسُوم"
  },
  {
   "verse_index": 2,
   "sadr": "أَحْيِ نَفْسِي فَدتْكَ نَفْسِي فَإِنِّي",
