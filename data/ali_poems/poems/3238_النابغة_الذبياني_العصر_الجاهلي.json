 "verses": [
  {
   "verse_index": 1,
   "sadr": "أتاني أبيتَ اللّعنَ أنكَ لمتَني،",
   "ajuz": "وتلك التي أهتمّ منها وأنْصَبُ",
   "text": "أتاني أبيتَ اللّعنَ أنكَ لمتَني،    وتلك التي أهتمّ منها وأنْصَبُ"
  },
  {
   "verse_index": 2,
   "sadr": "فبتُّ كأن العائداتِ فرشْنَني",
   "ajuz": "هراساً، به يُعلى فراشي ويُقْشَبُ",
   "text": "فبتُّ كأن العائداتِ فرشْنَني    هراساً، به يُعلى فراشي ويُقْشَبُ"
  },
  {
   "verse_index": 3,
   "sadr": "حلفْتُ، فلم أتركْ لنفسكَ ريبةً،",
   "ajuz": "وليس وراء اللهِ للمرء مذهَبُ",
   "text": "حلفْتُ، فلم أتركْ لنفسكَ ريبةً،    وليس وراء اللهِ للمرء مذهَبُ"
  },
  {
   "verse_index": 4,
   "sadr": "لئن كنتَ قد بُلّغتَ عني خيانةً،",
   "ajuz": "لمُبلغُكَ الواشي أغشُّ وأكذَبُ",
   "text": "لئن كنتَ قد بُلّغتَ عني خيانةً،    لمُبلغُكَ الواشي أغشُّ وأكذَبُ"
  },
  {
   "verse_index": 5,
   "sadr": "ولكنني كنت أمرأ لي جانبٌ",
   "ajuz": "من الأرض، فيه مُسترادٌ ومذهَبُ",
   "text": "ولكنني كنت أمرأ لي جانبٌ    من الأرض، فيه مُسترادٌ ومذهَبُ"
  },
  {
   "verse_index": 6,
   "sadr": "ملوكٌ وإخوانٌ، إذا ما أتيتهم،",
   "ajuz": "أُحَكّم في أموالهم، وأُقَرّبُ",
   "text": "ملوكٌ وإخوانٌ، إذا ما أتيتهم،    أُحَكّم في أموالهم، وأُقَرّبُ"
  },
  {
   "verse_index": 7,
   "sadr": "كفعلكَ في قومٍ أراك اصطنعتهم،",
   "ajuz": "فلم ترهم، في شكر ذلك، أذْنَبُوا",
   "text": "كفعلكَ في قومٍ أراك اصطنعتهم،    فلم ترهم، في شكر ذلك، أذْنَبُوا"
  },
  {
   "verse_index": 8,
   "sadr": "فلا تتركني بالوعيد، كأنني",
   "ajuz": "إلى الناس مطليٌّ به القارُ، أجرَبُ",
   "text": "فلا تتركني بالوعيد، كأنني    إلى الناس مطليٌّ به القارُ، أجرَبُ"
  },
  {
   "verse_index": 9,
   "sadr": "ألمْ ترَ أن الله أعطاك سورةً،",
   "ajuz": "ترى كلّ ملكٍ، دونها، يتذبذَبُ",
   "text": "ألمْ ترَ أن الله أعطاك سورةً،    ترى كلّ ملكٍ، دونها، يتذبذَبُ"
  },
  {
   "verse_index": 10,
   "sadr": "فإنكَ شمسٌ، والملوك كواكبٌ،",
   "ajuz": "إذا طلعت لم يبدُ منهنَ كوكَبُ",
   "text": "فإنكَ شمسٌ، والملوك كواكبٌ،    إذا طلعت لم يبدُ منهنَ كوكَبُ"
  },
  {
   "verse_index": 11,
   "sadr": "ولسْتَ بُمستبقٍ أخاً لا تلُمّهُ",
   "ajuz": "على شَعَثٍ، أيُّ الرِّجالِ المُهَذّبُ؟",
   "text": "ولسْتَ بُمستبقٍ أخاً لا تلُمّهُ    على شَعَثٍ، أيُّ الرِّجالِ المُهَذّبُ؟"
  },
  {
   "verse_index": 12,
   "sadr": "فإن أكُ مظلوماً؛ فعبدٌ ظلمتَهُ؛",
   "ajuz": "وإن تكُ ذا عُتبى؛ فمثلُكَ يُعتِبُ",
