 "verses": [
  {
   "verse_index": 1,
   "sadr": "أَشَاقَتْكَ المَعارِفُ والطُّلُولُ",
   "ajuz": "عَفَوْنَ وَخَفَّ مِنْهُنَّ الحُمُولُ",
   "text": "أَشَاقَتْكَ المَعارِفُ والطُّلُولُ    عَفَوْنَ وَخَفَّ مِنْهُنَّ الحُمُولُ"
  },
  {
   "verse_index": 2,
   "sadr": "نَعَمْ فَذَكَرْتُ دُنْيَا قَدْ تَقَضَّتْ",
   "ajuz": "وَأَيُّ نَعِيمِ دُنْيَا لا يَزُولُ",
   "text": "نَعَمْ فَذَكَرْتُ دُنْيَا قَدْ تَقَضَّتْ    وَأَيُّ نَعِيمِ دُنْيَا لا يَزُولُ"
  },
  {
   "verse_index": 3,
   "sadr": "أُسَائِلُ دَارَ بَثْنَةَ أَيْنَ حَلَّتْ",
   "ajuz": "كَأَنَّ الدَّارَ تُخْبِرُ مَا أَقُولُ",
   "text": "أُسَائِلُ دَارَ بَثْنَةَ أَيْنَ حَلَّتْ    كَأَنَّ الدَّارَ تُخْبِرُ مَا أَقُولُ"
  },
  {
   "verse_index": 4,
   "sadr": "فَمَنْ هذا يُبَلِّغُهَا رَسُولًا",
   "ajuz": "كَذَاكَ لِكُلِّ ذِي حَاجٍ رَسُولُ",
   "text": "فَمَنْ هذا يُبَلِّغُهَا رَسُولًا    كَذَاكَ لِكُلِّ ذِي حَاجٍ رَسُولُ"
  },
  {
   "verse_index": 5,
   "sadr": "فَيَسْأَلُهَا وَيَنْظُرُ هَلْ إِلَيْهَا",
   "ajuz": "لِخَلْوَةِ سَاعَةٍ مِنْهَا سَبِيلُ",
   "text": "فَيَسْأَلُهَا وَيَنْظُرُ هَلْ إِلَيْهَا    لِخَلْوَةِ سَاعَةٍ مِنْهَا سَبِيلُ"
  },
  {
   "verse_index": 6,
   "sadr": "وَقُلْتُ لَهَا: اعْتَلَلْتِ بِغَيْرِ ذَنْبٍ",
   "ajuz": "وَشَرُّ النَّاسِ ذُو العِلَلِ البَخِيلُ",
   "text": "وَقُلْتُ لَهَا: اعْتَلَلْتِ بِغَيْرِ ذَنْبٍ    وَشَرُّ النَّاسِ ذُو العِلَلِ البَخِيلُ"
  },
  {
   "verse_index": 7,
   "sadr": "فَفَاتِيني إِلَى حَكَمٍ مِنَ اهْلِي",
   "ajuz": "وَأَهْلِكِ لَا يَحِيفُ وَلَا يَمِيلُ",
   "text": "فَفَاتِيني إِلَى حَكَمٍ مِنَ اهْلِي    وَأَهْلِكِ لَا يَحِيفُ وَلَا يَمِيلُ"
  },
  {
   "verse_index": 8,
   "sadr": "فَقَالَتْ: أَبْتَغِي حَكَمًا مِنَ اهْلِي",
   "ajuz": "وَلَا يَدْرِي بِنَا الوَاشِي المَحُولُ",
   "text": "فَقَالَتْ: أَبْتَغِي حَكَمًا مِنَ اهْلِي    وَلَا يَدْرِي بِنَا الوَاشِي المَحُولُ"
  },
  {
   "verse_index": 9,
   "sadr": "فَوَلَّيْنَا الحُكُومَةَ ذَا سُجُوفٍ",
   "ajuz": "أَخَا دُنْيَا لَهُ طَرْفٌ كَلِيلُ",
   "text": "فَوَلَّيْنَا الحُكُومَةَ ذَا سُجُوفٍ    أَخَا دُنْيَا لَهُ طَرْفٌ كَلِيلُ"
  },
  {
   "verse_index": 10,
   "sadr": "فَقُلْنَا: مَا قَضَيْتَ بِهِ رَضِينَا",
   "ajuz": "وَأَنْتَ بِمَا قَضَيْتَ بِهِ كَفِيلُ",
   "text": "فَقُلْنَا: مَا قَضَيْتَ بِهِ رَضِينَا    وَأَنْتَ بِمَا قَضَيْتَ بِهِ كَفِيلُ"
  },
  {
   "verse_index": 11,
   "sadr": "قَضَاؤُكَ نَافِذٌ فَاحْكُمْ عَلَيْنَا",
   "ajuz": "بِمَا تَهْوَى وَرَأْيُكَ لَا يَفِيلُ",
   "text": "قَضَاؤُكَ نَافِذٌ فَاحْكُمْ عَلَيْنَا    بِمَا تَهْوَى وَرَأْيُكَ لَا يَفِيلُ"
  },
  {
   "verse_index": 12,
   "sadr": "فَقُلْتُ لَهُ: قُتِلْتُ بِغَيْرِ جُرْمٍ",
   "ajuz": "وَغِبُّ الظُّلْمِ مَرْتَعُهُ وَبِيلُ",
   "text": "فَقُلْتُ لَهُ: قُتِلْتُ بِغَيْرِ جُرْمٍ    وَغِبُّ الظُّلْمِ مَرْتَعُهُ وَبِيلُ"
  },
  {
   "verse_index": 13,
   "sadr": "فَسَلْ هذِي: مَتَى تَقْضِي دُيُونِي",
   "ajuz": "وَهَلْ يَقْضِيكَ ذُو العِلَلِ المَطُولُ",
   "text": "فَسَلْ هذِي: مَتَى تَقْضِي دُيُونِي    وَهَلْ يَقْضِيكَ ذُو العِلَلِ المَطُولُ"
  },
  {
   "verse_index": 14,
   "sadr": "فَقَالَتْ: إِنَّ ذَا كّذِبٌ وَبُطْلٌ",
   "ajuz": "وَشَرٌّ مِنْ خُصُومَتِهِ طَوِيلُ",
   "text": "فَقَالَتْ: إِنَّ ذَا كّذِبٌ وَبُطْلٌ    وَشَرٌّ مِنْ خُصُومَتِهِ طَوِيلُ"
  },
  {
   "verse_index": 15,
   "sadr": "أَأَقْتُلُهُ وَمَا لِي مِنْ سِلَاحٍ",
   "ajuz": "وَمَا بِي لَوْ أُقَاتِلُهُ حَوِيلُ",
   "text": "أَأَقْتُلُهُ وَمَا لِي مِنْ سِلَاحٍ    وَمَا بِي لَوْ أُقَاتِلُهُ حَوِيلُ"
  },
  {
   "verse_index": 16,
   "sadr": "وَلَمْ آخُذْ لَهُ مَالًا فَيُلْفَى",
   "ajuz": "لَهُ دَيْنٌ عَلَيَّ كَمَا يَقُولُ",
   "text": "وَلَمْ آخُذْ لَهُ مَالًا فَيُلْفَى    لَهُ دَيْنٌ عَلَيَّ كَمَا يَقُولُ"
  },
  {
   "verse_index": 17,
   "sadr": "وَعِنْدَ أَمِيرِنَا حُكْمٌ وَعَدْلٌ",
   "ajuz": "وَرَأيٌ بَعْدَ ذلِكُمُ أَصِيلُ",
   "text": "وَعِنْدَ أَمِيرِنَا حُكْمٌ وَعَدْلٌ    وَرَأيٌ بَعْدَ ذلِكُمُ أَصِيلُ"
  },
  {
   "verse_index": 18,
   "sadr": "فَقَالَ أَمِيرُنَا: هاتُوا شُهُودًا",
   "ajuz": "فَقُلْتُ: شَهِيدُنَا المَلِكُ الجَلِيلُ",
   "text": "فَقَالَ أَمِيرُنَا: هاتُوا شُهُودًا    فَقُلْتُ: شَهِيدُنَا المَلِكُ الجَلِيلُ"
  },
  {
   "verse_index": 19,
   "sadr": "فَقَالَ يَمِينَهَا وَبِذَاكَ أَقْضِي",
   "ajuz": "وَكُلُّ قَضَائِهِ حَسَنٌ جَمِيلُ",
   "text": "فَقَالَ يَمِينَهَا وَبِذَاكَ أَقْضِي    وَكُلُّ قَضَائِهِ حَسَنٌ جَمِيلُ"
  },
  {
   "verse_index": 20,
   "sadr": "فَبَتَّتْ حَلْفَةً مَا لِي لَدَيْهَا",
   "ajuz": "نَقِيرٌ أَدَّعِيهِ وَلَا فَتِيلُ",
   "text": "فَبَتَّتْ حَلْفَةً مَا لِي لَدَيْهَا    نَقِيرٌ أَدَّعِيهِ وَلَا فَتِيلُ"
  },
  {
   "verse_index": 21,
   "sadr": "فَقُلْتُ لَهَا وَقَدْ غُلِبَ التَّعَزِّي:",
   "ajuz": "أَمَا يُقْضَى لَنَا يَا بَثْنُ سُولُ؟",
   "text": "فَقُلْتُ لَهَا وَقَدْ غُلِبَ التَّعَزِّي:    أَمَا يُقْضَى لَنَا يَا بَثْنُ سُولُ؟"
  },
  {
   "verse_index": 22,
   "sadr": "فَقَالَتْ ثُمَّ زَجَّتْ حَاجِبيَيْهَا",
   "ajuz": "أَطَلْتَ وَلَسْتَ فِي شَيْءٍ تُطِيلُ",
   "text": "فَقَالَتْ ثُمَّ زَجَّتْ حَاجِبيَيْهَا    أَطَلْتَ وَلَسْتَ فِي شَيْءٍ تُطِيلُ"
  },
