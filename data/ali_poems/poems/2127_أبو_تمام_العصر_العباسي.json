 "verses": [
  {
   "verse_index": 1,
   "sadr": "قَدكَ اِتَّئِب أَربَيتَ في الغُلواءِ",
   "ajuz": "كَم تَعذِلونَ وَأَنتُمُ سُجَرائي؟!",
   "text": "قَدكَ اِتَّئِب أَربَيتَ في الغُلواءِ    كَم تَعذِلونَ وَأَنتُمُ سُجَرائي؟!"
  },
  {
   "verse_index": 2,
   "sadr": "لا تَسقِني ماءَ المُلامِ فَإِنَّني",
   "ajuz": "صَبٌّ قَدِ اِستَعذَبتُ ماءَ بُكائي",
   "text": "لا تَسقِني ماءَ المُلامِ فَإِنَّني    صَبٌّ قَدِ اِستَعذَبتُ ماءَ بُكائي"
  },
  {
   "verse_index": 3,
   "sadr": "وَمُعَرَّسٍ لِلغَيثِ تَخفِقُ بَينَهُ",
   "ajuz": "راياتُ كُلِّ دُجُنَّةٍ وَطْفَاءِ",
   "text": "وَمُعَرَّسٍ لِلغَيثِ تَخفِقُ بَينَهُ    راياتُ كُلِّ دُجُنَّةٍ وَطْفَاءِ"
  },
  {
   "verse_index": 4,
   "sadr": "نَشَرَت حَدائِقَهُ فَصِرنَ مَآلِفاً",
   "ajuz": "لِطَرائِفِ الأَنواءِ وَالأَنداءِ",
   "text": "نَشَرَت حَدائِقَهُ فَصِرنَ مَآلِفاً    لِطَرائِفِ الأَنواءِ وَالأَنداءِ"
  },
  {
   "verse_index": 5,
   "sadr": "فَسَقاهُ مِسكَ الطَلِّ كافورُ الصَبا",
   "ajuz": "وَاِنحَلَّ فيهِ خَيطُ كُلِّ سَماءِ",
   "text": "فَسَقاهُ مِسكَ الطَلِّ كافورُ الصَبا    وَاِنحَلَّ فيهِ خَيطُ كُلِّ سَماءِ"
  },
  {
   "verse_index": 6,
   "sadr": "عُنِيَ الرَبيعُ بِرَوضِهِ فَكَأَنَّما",
   "ajuz": "أَهدى إِلَيهِ الوَشيَ مِن صَنعاءِ",
   "text": "عُنِيَ الرَبيعُ بِرَوضِهِ فَكَأَنَّما    أَهدى إِلَيهِ الوَشيَ مِن صَنعاءِ"
  },
  {
   "verse_index": 7,
   "sadr": "صَبَّحتُهُ بِسُلافَةٍ صَبَّحتُها",
   "ajuz": "بِسُلافَةِ الخُلَطاءِ وَالنُّدَمَاءِ",
   "text": "صَبَّحتُهُ بِسُلافَةٍ صَبَّحتُها    بِسُلافَةِ الخُلَطاءِ وَالنُّدَمَاءِ"
  },
  {
   "verse_index": 8,
   "sadr": "بِمُدامَةٍ تَغدو المُنى لِكُؤوسِها",
   "ajuz": "خَوَلاً عَلى السَرّاءِ وَالضََرَّاءِ",
   "text": "بِمُدامَةٍ تَغدو المُنى لِكُؤوسِها    خَوَلاً عَلى السَرّاءِ وَالضََرَّاءِ"
  },
  {
   "verse_index": 9,
   "sadr": "راحٌ إِذا ما الراحُ كُنَّ مَطِيَّها",
   "ajuz": "كانَت مَطايا الشَوقِ في الأَحشاءِ",
   "text": "راحٌ إِذا ما الراحُ كُنَّ مَطِيَّها    كانَت مَطايا الشَوقِ في الأَحشاءِ"
  },
  {
   "verse_index": 10,
   "sadr": "عِنَبِيَّةٌ ذَهَبِيَّةٌ سَكَبَت لَها",
   "ajuz": "ذَهَبَ المَعاني صاغَةُ الشُعَرَاءِ",
   "text": "عِنَبِيَّةٌ ذَهَبِيَّةٌ سَكَبَت لَها    ذَهَبَ المَعاني صاغَةُ الشُعَرَاءِ"
  },
  {
   "verse_index": 11,
   "sadr": "أَكَلَ الزَمانُ لِطولِ مُكثِ بَقائِها",
   "ajuz": "ما كانَ خامَرَها مِنَ الأَقْذاءِ",
   "text": "أَكَلَ الزَمانُ لِطولِ مُكثِ بَقائِها    ما كانَ خامَرَها مِنَ الأَقْذاءِ"
  },
  {
   "verse_index": 12,
   "sadr": "صَعُبَت وَراضَ المَزجُ سَيِّءَ خُلقِها",
   "ajuz": "فَتَعَلَّمَت مِن حُسنِ خُلقِ المَاءِ",
   "text": "صَعُبَت وَراضَ المَزجُ سَيِّءَ خُلقِها    فَتَعَلَّمَت مِن حُسنِ خُلقِ المَاءِ"
  },
  {
   "verse_index": 13,
   "sadr": "خَرقاءُ يَلعَبُ بِالعُقولِ حَبابُها",
   "ajuz": "كَتَلَعُّبِ الأَفعالِ بِالأَسمَاءِ",
   "text": "خَرقاءُ يَلعَبُ بِالعُقولِ حَبابُها    كَتَلَعُّبِ الأَفعالِ بِالأَسمَاءِ"
  },
  {
   "verse_index": 14,
   "sadr": "وَضَعيفَةٌ فَإِذا أَصابَت فُرصَةً",
   "ajuz": "قَتَلَت كَذَلِكَ قُدرَةُ الضُّعَفَاءِ",
   "text": "وَضَعيفَةٌ فَإِذا أَصابَت فُرصَةً    قَتَلَت كَذَلِكَ قُدرَةُ الضُّعَفَاءِ"
  },
  {
   "verse_index": 15,
   "sadr": "جَهمِيَّةُ الأَوصافِ إِلّا أَنَّهُم",
   "ajuz": "قَد لَقَّبوها جَوهَرَ الأَشْيَاءِ",
   "text": "جَهمِيَّةُ الأَوصافِ إِلّا أَنَّهُم    قَد لَقَّبوها جَوهَرَ الأَشْيَاءِ"
  },
  {
   "verse_index": 16,
   "sadr": "وَكَأَنَّ بَهجَتَها وَبَهجَةَ كَأسِها",
   "ajuz": "نارٌ وَنورٌ قُيِّدا بِوِعَاءِ",
   "text": "وَكَأَنَّ بَهجَتَها وَبَهجَةَ كَأسِها    نارٌ وَنورٌ قُيِّدا بِوِعَاءِ"
  },
  {
   "verse_index": 17,
   "sadr": "أَو دُرَّةٌ بَيضاءُ بِكرٌ أُطبِقَت",
   "ajuz": "حَبَلا عَلى ياقوتَةٍ حَمْرَاءِ",
   "text": "أَو دُرَّةٌ بَيضاءُ بِكرٌ أُطبِقَت    حَبَلا عَلى ياقوتَةٍ حَمْرَاءِ"
  },
  {
   "verse_index": 18,
   "sadr": "وَمَسافَةً كَمَسافَةِ الهَجرِ اِرتَقى",
   "ajuz": "في صَدرِ باقي الحُبِّ وَالبُرَحَاءِ",
   "text": "وَمَسافَةً كَمَسافَةِ الهَجرِ اِرتَقى    في صَدرِ باقي الحُبِّ وَالبُرَحَاءِ"
  },
  {
   "verse_index": 19,
   "sadr": "بيدٌ لِنَسلِ العيدِ في أُملودِها",
   "ajuz": "ما اِرتيدَ مِن عيدٍ وَمِن عُدَوَاءِ",
   "text": "بيدٌ لِنَسلِ العيدِ في أُملودِها    ما اِرتيدَ مِن عيدٍ وَمِن عُدَوَاءِ"
  },
  {
   "verse_index": 20,
   "sadr": "مَزَّقتُ ثَوبَ عُكوبِها بِرُكوبِها",
   "ajuz": "وَالنَّارُ تَنبُعُ مِن حَصى المَعْزَاءِ",
   "text": "مَزَّقتُ ثَوبَ عُكوبِها بِرُكوبِها    وَالنَّارُ تَنبُعُ مِن حَصى المَعْزَاءِ"
  },
  {
   "verse_index": 21,
   "sadr": "وَإِلى اِبنِ حَسّانَ اِعتَدَت بي هِمَّةٌ",
   "ajuz": "وَقَفَت عَلَيهِ خُلَّتِي وَإِخَائي",
   "text": "وَإِلى اِبنِ حَسّانَ اِعتَدَت بي هِمَّةٌ    وَقَفَت عَلَيهِ خُلَّتِي وَإِخَائي"
  },
  {
   "verse_index": 22,
   "sadr": "لَمّا رَأَيتُكَ قَد غَذَوتَ مَوَدَّتي",
   "ajuz": "بِالبِشرِ وَاِستَحسَنتَ وَجهَ ثَنَائي",
   "text": "لَمّا رَأَيتُكَ قَد غَذَوتَ مَوَدَّتي    بِالبِشرِ وَاِستَحسَنتَ وَجهَ ثَنَائي"
  },
  {
   "verse_index": 23,
   "sadr": "أَنبَطتُ في قَلبي لِوَأيِكَ مَشرَعاً",
   "ajuz": "ظَلَّت تَحومُ عَلَيهِ طَيرُ رَجَائي",
   "text": "أَنبَطتُ في قَلبي لِوَأيِكَ مَشرَعاً    ظَلَّت تَحومُ عَلَيهِ طَيرُ رَجَائي"
  },
  {
   "verse_index": 24,
   "sadr": "فَثَوَيتُ جاراً لِلحَضيضِ وَهِمَّتي",
   "ajuz": "قَد طُوِّقَت بِكَواكِبِ الجَوْزاءِ",
   "text": "فَثَوَيتُ جاراً لِلحَضيضِ وَهِمَّتي    قَد طُوِّقَت بِكَواكِبِ الجَوْزاءِ"
  },
  {
   "verse_index": 25,
   "sadr": "إيهِ فَدَتكَ مَغارِسي وَمَنابِتي",
   "ajuz": "إِطرَح غَناءَكَ في بُحورِ عَنَائي",
   "text": "إيهِ فَدَتكَ مَغارِسي وَمَنابِتي    إِطرَح غَناءَكَ في بُحورِ عَنَائي"
  },
  {
   "verse_index": 26,
   "sadr": "يَسِّر لِقَولِكَ مَهرَ فِعلِكَ إِنَّهُ",
   "ajuz": "يَنوي اِفتِضاضَ صَنيعَةٍ عَذرَاءِ",
   "text": "يَسِّر لِقَولِكَ مَهرَ فِعلِكَ إِنَّهُ    يَنوي اِفتِضاضَ صَنيعَةٍ عَذرَاءِ"
  },
  {
   "verse_index": 27,
   "sadr": "وَإِلى مُحَمَّدٍ اِبتَعَثتُ قَصائِدي",
   "ajuz": "وَرَفَعتُ لِلمُستَنشِدينَ لِوَائي",
   "text": "وَإِلى مُحَمَّدٍ اِبتَعَثتُ قَصائِدي    وَرَفَعتُ لِلمُستَنشِدينَ لِوَائي"
  },
  {
   "verse_index": 28,
   "sadr": "وَإِذا تَشاجَرَتِ الخُطوبُ قَرَيتَها",
   "ajuz": "جَدَلاً يَفُلُّ مَضارِبَ الأَعْداءِ",
   "text": "وَإِذا تَشاجَرَتِ الخُطوبُ قَرَيتَها    جَدَلاً يَفُلُّ مَضارِبَ الأَعْداءِ"
  },
  {
   "verse_index": 29,
   "sadr": "يا غايَةَ الأُدَباءِ وَالظُرَفاءِ بَل",
