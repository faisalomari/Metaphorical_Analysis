 "verses": [
  {
   "verse_index": 1,
   "sadr": "يَقولُ أَمِيرٌ غَادِرٌ جِدُّ غَادِرٍ",
   "ajuz": "أَلا كُنتَ قاتَلْتَ الشَّهِيدَ ابْنَ فاطِمَه",
   "text": "يَقولُ أَمِيرٌ غَادِرٌ جِدُّ غَادِرٍ    أَلا كُنتَ قاتَلْتَ الشَّهِيدَ ابْنَ فاطِمَه"
  },
  {
   "verse_index": 2,
   "sadr": "وَنَفْسي عَلَى خذلانِهِ وَاعْتِزالِهِ",
   "ajuz": "وَبَيعَةِ هذا الناكِثِ العَهْد لائِمَه",
   "text": "وَنَفْسي عَلَى خذلانِهِ وَاعْتِزالِهِ    وَبَيعَةِ هذا الناكِثِ العَهْد لائِمَه"
  },
  {
   "verse_index": 3,
   "sadr": "فَوا نَدَمي أَلا أَكونَ نَصَرتُهُ",
   "ajuz": "أَلا كُلُّ نَفسٍ لا تُسَدَّدُ نادِمَه",
   "text": "فَوا نَدَمي أَلا أَكونَ نَصَرتُهُ    أَلا كُلُّ نَفسٍ لا تُسَدَّدُ نادِمَه"
  },
  {
   "verse_index": 4,
   "sadr": "وَإِنّي لأَنّي لَمْ أَكُنْ مِنْ حُماتِهِ",
   "ajuz": "لذو حسرَةٍ ما إِن تُفارِق لازِمَه",
   "text": "وَإِنّي لأَنّي لَمْ أَكُنْ مِنْ حُماتِهِ    لذو حسرَةٍ ما إِن تُفارِق لازِمَه"
  },
  {
   "verse_index": 5,
   "sadr": "سَقى اللَّهُ أَرواحَ الَّذينَ تَأَزَّروا",
   "ajuz": "عَلى نَصرِهِ سُقيا مِنَ الغَيثِ دائِمَه",
   "text": "سَقى اللَّهُ أَرواحَ الَّذينَ تَأَزَّروا    عَلى نَصرِهِ سُقيا مِنَ الغَيثِ دائِمَه"
  },
  {
   "verse_index": 6,
   "sadr": "وَقَفْتُ عَلى أَجداثِهِم وَمَحالِهِم",
   "ajuz": "فَكادَ الحَشا يَنقَضُّ وَالعَينُ ساجِمَه",
   "text": "وَقَفْتُ عَلى أَجداثِهِم وَمَحالِهِم    فَكادَ الحَشا يَنقَضُّ وَالعَينُ ساجِمَه"
  },
  {
   "verse_index": 7,
   "sadr": "لَعَمري لَقَد كانوا مَصاليتَ في الوَغى",
   "ajuz": "سِراعًا إِلى الهَيجا حُماةً خَضارِمَه",
   "text": "لَعَمري لَقَد كانوا مَصاليتَ في الوَغى    سِراعًا إِلى الهَيجا حُماةً خَضارِمَه"
  },
  {
   "verse_index": 8,
   "sadr": "تَآسَوا عَلى نَصرِ ابنِ بِنتِ نَبِيِّهِم",
   "ajuz": "بِأَسيافِهِم آسادَ غيلٍ ضَراغِمَه",
   "text": "تَآسَوا عَلى نَصرِ ابنِ بِنتِ نَبِيِّهِم    بِأَسيافِهِم آسادَ غيلٍ ضَراغِمَه"
  },
  {
   "verse_index": 9,
   "sadr": "فَإِن يُقتَلوا فَكُلُّ نَفسٍ تَقِيَّةٍ",
   "ajuz": "عَلى الأَرضِ قَد أَضحَت لِذلِكَ واجِمَه",
   "text": "فَإِن يُقتَلوا فَكُلُّ نَفسٍ تَقِيَّةٍ    عَلى الأَرضِ قَد أَضحَت لِذلِكَ واجِمَه"
  },
  {
   "verse_index": 10,
   "sadr": "وَما إِن رَأى الراؤونَ أَفضَلَ مِنهُم",
   "ajuz": "لَدى المَوتِ ساداتٍ وَزهرًا قماقِمَه",
   "text": "وَما إِن رَأى الراؤونَ أَفضَلَ مِنهُم    لَدى المَوتِ ساداتٍ وَزهرًا قماقِمَه"
  },
  {
   "verse_index": 11,
   "sadr": "أَتَقتُلُهُم ظُلمًا وَتَرجو وِدادَنا",
   "ajuz": "فَدَع خُطَّةً لَيسَت لَنا بِمُلائِمَه",
   "text": "أَتَقتُلُهُم ظُلمًا وَتَرجو وِدادَنا    فَدَع خُطَّةً لَيسَت لَنا بِمُلائِمَه"
  },
  {
   "verse_index": 12,
   "sadr": "لَعَمري لَقَد راغَمتُمُونا بِقَتلِهِم",
   "ajuz": "فَكَم ناقِمٍ مِنّا عَلَيكُم وَناقِمَه",
   "text": "لَعَمري لَقَد راغَمتُمُونا بِقَتلِهِم    فَكَم ناقِمٍ مِنّا عَلَيكُم وَناقِمَه"
  },
  {
   "verse_index": 13,
   "sadr": "أَهمُّ مرارًا أَن أَسيرَ بِجَحفَلٍ",
   "ajuz": "إِلى فِئَةٍ زاغَت عَنِ الحَقِّ ظالِمَه",
   "text": "أَهمُّ مرارًا أَن أَسيرَ بِجَحفَلٍ    إِلى فِئَةٍ زاغَت عَنِ الحَقِّ ظالِمَه"
  },
  {
   "verse_index": 14,
   "sadr": "فَكُفّوا وَإِلا زُرتُكُم في كَتائِبٍ",
   "ajuz": "أَشَدَّ عَلَيكُم مِن زُحوفِ الدَّيالِمَه",
   "text": "فَكُفّوا وَإِلا زُرتُكُم في كَتائِبٍ    أَشَدَّ عَلَيكُم مِن زُحوفِ الدَّيالِمَه"
  }
