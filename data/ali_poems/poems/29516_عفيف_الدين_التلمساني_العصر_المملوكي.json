 "verses": [
  {
   "verse_index": 1,
   "sadr": "مَنَعَتْهَا الصِّفَاتُ وَالأَسْمَاءُ",
   "ajuz": "أَن تُرَى دُونَ بُرْقُعٍ أَسْمَاءُ",
   "text": "مَنَعَتْهَا الصِّفَاتُ وَالأَسْمَاءُ    أَن تُرَى دُونَ بُرْقُعٍ أَسْمَاءُ"
  },
  {
   "verse_index": 2,
   "sadr": "قَدْ ضَلَلْنَا بِشَعْرِهَا وَهْوَ مِنْهَا",
   "ajuz": "وَهَدَتْنَا بِهَا لَهَا الأَضْوَاءُ",
   "text": "قَدْ ضَلَلْنَا بِشَعْرِهَا وَهْوَ مِنْهَا    وَهَدَتْنَا بِهَا لَهَا الأَضْوَاءُ"
  },
  {
   "verse_index": 3,
   "sadr": "كَيْفَ بتْنَا مِنَ الظَّمَا نَتَشَاكَى",
   "ajuz": "يَا لِقَوْمِي وَفى الرِّحالِ المَاءُ",
   "text": "كَيْفَ بتْنَا مِنَ الظَّمَا نَتَشَاكَى    يَا لِقَوْمِي وَفى الرِّحالِ المَاءُ"
  },
  {
   "verse_index": 4,
   "sadr": "كَمْ بَكَيْنَا حُزْنًا بمَنْ لَوْ عَرَفْنَا",
   "ajuz": "كَانَ مِنْ شِدَّةِ السُّرُورِ البُكَاءُ",
   "text": "كَمْ بَكَيْنَا حُزْنًا بمَنْ لَوْ عَرَفْنَا    كَانَ مِنْ شِدَّةِ السُّرُورِ البُكَاءُ"
  },
  {
   "verse_index": 5,
   "sadr": "نحْنُ قَوْمٌ مِتْنَا وذلِكَ شَرطٌ",
   "ajuz": "فِي هَوَاها فَلْيَيْئس الأحْيَاءُ",
   "text": "نحْنُ قَوْمٌ مِتْنَا وذلِكَ شَرطٌ    فِي هَوَاها فَلْيَيْئس الأحْيَاءُ"
  },
  {
   "verse_index": 6,
   "sadr": "وَأَقامَتْ نُفوسَنَا فِي حِمَاهَا",
   "ajuz": "لا بِنَا بَلْ بِهَا لِيَصْفُو الصَّفَاءُ",
   "text": "وَأَقامَتْ نُفوسَنَا فِي حِمَاهَا    لا بِنَا بَلْ بِهَا لِيَصْفُو الصَّفَاءُ"
  },
  {
   "verse_index": 7,
   "sadr": "فَالمُلَبِّي إذَا دَعَتْ هِي مِنَّا",
   "ajuz": "وَمُجِيبُوهَا بِهَا الأَصْدَاءُ",
   "text": "فَالمُلَبِّي إذَا دَعَتْ هِي مِنَّا    وَمُجِيبُوهَا بِهَا الأَصْدَاءُ"
  },
  {
   "verse_index": 8,
   "sadr": "يَا أَبَا الخَيْرِ قُمْ لَكَ الخَيْرُ فَاطْرِبْ",
   "ajuz": "مَسْمَعَ الفَقْرِ مِنْكَ ذَاكَ الغِنَاءُ",
   "text": "يَا أَبَا الخَيْرِ قُمْ لَكَ الخَيْرُ فَاطْرِبْ    مَسْمَعَ الفَقْرِ مِنْكَ ذَاكَ الغِنَاءُ"
  },
  {
   "verse_index": 9,
   "sadr": "لَا تَفُتْ كَاسَكَ التَّي مِنْ لَمَاهَا",
   "ajuz": "هِي فِيها تَنَافَسَ النُّدَمَاءُ",
   "text": "لَا تَفُتْ كَاسَكَ التَّي مِنْ لَمَاهَا    هِي فِيها تَنَافَسَ النُّدَمَاءُ"
  },
  {
   "verse_index": 10,
   "sadr": "لَمْ أَقُلْ قَدْ عَدَتْكَ كَأسُكَ لكِنْ",
   "ajuz": "رُبَّمَا طَوَّحَتْ بِكَ الصَّهْبَاءُ",
   "text": "لَمْ أَقُلْ قَدْ عَدَتْكَ كَأسُكَ لكِنْ    رُبَّمَا طَوَّحَتْ بِكَ الصَّهْبَاءُ"
  },
  {
   "verse_index": 11,
   "sadr": "إنَّما يَشْرَبُ التي تَسْلُبُ العَقْلَ",
   "ajuz": "نَدَامَى هُمُ لَهَا أَكْفَاءُ",
   "text": "إنَّما يَشْرَبُ التي تَسْلُبُ العَقْلَ    نَدَامَى هُمُ لَهَا أَكْفَاءُ"
  },
  {
   "verse_index": 12,
   "sadr": "أَسْكَرُوهَا بِهِمْ كَمَا أَسْكَرَتْهُمْ",
   "ajuz": "فِي ابْتِدَاهُمْ بِهَا فَتَمَّ الوَفَاءُ",
   "text": "أَسْكَرُوهَا بِهِمْ كَمَا أَسْكَرَتْهُمْ    فِي ابْتِدَاهُمْ بِهَا فَتَمَّ الوَفَاءُ"
  },
  {
   "verse_index": 13,
   "sadr": "فَجَزَاءٌ مِنْهَا وَمِنْهُمْ وِفَاقٌ",
   "ajuz": "وَوِفَاقٌ مِنْهَا وَمِنْهُمْ جَزَاءُ",
   "text": "فَجَزَاءٌ مِنْهَا وَمِنْهُمْ وِفَاقٌ    وَوِفَاقٌ مِنْهَا وَمِنْهُمْ جَزَاءُ"
  },
  {
   "verse_index": 14,
   "sadr": "قَدْ تَسَمَّتْ بِهِمْ وَليسُوا سِوَاهُا",
   "ajuz": "فَالمُسَمَّى أُولئكَ الأَسْمَاءُ",
