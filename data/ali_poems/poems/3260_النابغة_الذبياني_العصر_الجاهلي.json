 "verses": [
  {
   "verse_index": 1,
   "sadr": "أهاجَكَ، منْ سعداكَ، مَغنى المعاهدِ",
   "ajuz": "بروضةِ نُعميّ، فذاتِ الأساودِ",
   "text": "أهاجَكَ، منْ سعداكَ، مَغنى المعاهدِ    بروضةِ نُعميّ، فذاتِ الأساودِ"
  },
  {
   "verse_index": 2,
   "sadr": "تَعاورها الأرواحُ ينسفنَ تُرْبها،",
   "ajuz": "وكلُّ مُلِثٍّ ذي أهاضيبَ، راعِدِ",
   "text": "تَعاورها الأرواحُ ينسفنَ تُرْبها،    وكلُّ مُلِثٍّ ذي أهاضيبَ، راعِدِ"
  },
  {
   "verse_index": 3,
   "sadr": "بها كلّ ذَيّالٍ وخَنساءَ تَرعَوي",
   "ajuz": "إلى كلّ رَجّافٍ، من الرّملِ، فارِدِ",
   "text": "بها كلّ ذَيّالٍ وخَنساءَ تَرعَوي    إلى كلّ رَجّافٍ، من الرّملِ، فارِدِ"
  },
  {
   "verse_index": 4,
   "sadr": "عهدتُ بها سُعدى، وسُعدى غريرةٌ",
   "ajuz": "عَرُوبٌ، تهادى في جَوارٍ خرائدِ",
   "text": "عهدتُ بها سُعدى، وسُعدى غريرةٌ    عَرُوبٌ، تهادى في جَوارٍ خرائدِ"
  },
  {
   "verse_index": 5,
   "sadr": "لعمري، لَنِعْمَ الحيّ صَبّحَ سربَنا",
   "ajuz": "وأبياتَنا، يوماً، بذاتِ المَراودِ",
   "text": "لعمري، لَنِعْمَ الحيّ صَبّحَ سربَنا    وأبياتَنا، يوماً، بذاتِ المَراودِ"
  },
  {
   "verse_index": 6,
   "sadr": "يقودُهُمُ النّعمانُ منهُ بمُحصَفٍ",
   "ajuz": "وكيدٍ يغُمّ الخارِجيَّ، مُناجِدِ",
   "text": "يقودُهُمُ النّعمانُ منهُ بمُحصَفٍ    وكيدٍ يغُمّ الخارِجيَّ، مُناجِدِ"
  },
  {
   "verse_index": 7,
   "sadr": "وشيمَةِ لا وانٍ، ولا واهنِ القُوى،",
   "ajuz": "وجَدّ، إذا خابَ المُفيدونَ، صاعدِ",
   "text": "وشيمَةِ لا وانٍ، ولا واهنِ القُوى،    وجَدّ، إذا خابَ المُفيدونَ، صاعدِ"
  },
  {
   "verse_index": 8,
   "sadr": "فآبَ بأبكارٍ وعُونٍ عقائِلٍ،",
   "ajuz": "أوانِسَ يَحْميها امرُؤٌ غيرُ زاهدِ",
   "text": "فآبَ بأبكارٍ وعُونٍ عقائِلٍ،    أوانِسَ يَحْميها امرُؤٌ غيرُ زاهدِ"
  },
  {
   "verse_index": 9,
   "sadr": "يُخَطّطنَ بالعيدانِ في كلّ مَقْعدٍ،",
   "ajuz": "ويخبأنَ رُمّانَ الثُّدِيّ النّواهِدِ",
   "text": "يُخَطّطنَ بالعيدانِ في كلّ مَقْعدٍ،    ويخبأنَ رُمّانَ الثُّدِيّ النّواهِدِ"
  },
  {
   "verse_index": 10,
   "sadr": "ويضربْنَ بالأيدي وراء براغِزٍ،",
   "ajuz": "حِسَانِ الوُجوهِ، كالظّباء العواقدِ",
   "text": "ويضربْنَ بالأيدي وراء براغِزٍ،    حِسَانِ الوُجوهِ، كالظّباء العواقدِ"
  },
  {
   "verse_index": 11,
   "sadr": "غرائِرُ لم يَلْقَيْنَ بأساء قبلها،",
   "ajuz": "لدى ابنِ الجُلاحِ، ما يثقنَ بوافِدِ",
   "text": "غرائِرُ لم يَلْقَيْنَ بأساء قبلها،    لدى ابنِ الجُلاحِ، ما يثقنَ بوافِدِ"
  },
  {
   "verse_index": 12,
   "sadr": "أصابَ بني غَيظٍ، فأضحَوا عبادُهُ،",
   "ajuz": "وجلّلها نُعمى على غيرِ واحِدِ",
   "text": "أصابَ بني غَيظٍ، فأضحَوا عبادُهُ،    وجلّلها نُعمى على غيرِ واحِدِ"
  },
  {
   "verse_index": 13,
   "sadr": "فلا بُدَّ من عَوْجاء تَهوي براكِبٍ،",
   "ajuz": "إلى ابنِ الجُلاح، سَيرُها اللّيلَ قاصدِ",
   "text": "فلا بُدَّ من عَوْجاء تَهوي براكِبٍ،    إلى ابنِ الجُلاح، سَيرُها اللّيلَ قاصدِ"
  },
  {
   "verse_index": 14,
   "sadr": "تَخُبّ إلى النّعمانِ، حتى تَنالَهُ،",
   "ajuz": "فِدىً لكَ من ربِّ طريفي، وتالدِي",
   "text": "تَخُبّ إلى النّعمانِ، حتى تَنالَهُ،    فِدىً لكَ من ربِّ طريفي، وتالدِي"
  },
  {
   "verse_index": 15,
   "sadr": "فسكّنتَ نفسي، بعدما طارَ روحُها،",
   "ajuz": "وألبسَتَني نُعمَى، ولستُ بشاهدِ",
   "text": "فسكّنتَ نفسي، بعدما طارَ روحُها،    وألبسَتَني نُعمَى، ولستُ بشاهدِ"
  },
  {
   "verse_index": 16,
   "sadr": "وكنتُ امرأ لا أمدَحُ الدّهرَ سُوقَةً،",
   "ajuz": "فلستُ، على خَيرٍ أتاك، بحاسدِ",
   "text": "وكنتُ امرأ لا أمدَحُ الدّهرَ سُوقَةً،    فلستُ، على خَيرٍ أتاك، بحاسدِ"
  },
  {
   "verse_index": 17,
   "sadr": "سَبقْتَ الرّجالَ الباهشينَ إلى العُلى،",
   "ajuz": "كسَبقِ الجوادِ اصطادَ قبل الطّواردِ",
   "text": "سَبقْتَ الرّجالَ الباهشينَ إلى العُلى،    كسَبقِ الجوادِ اصطادَ قبل الطّواردِ"
  },
  {
   "verse_index": 18,
   "sadr": "عَلوتَ مَعَدّاً نائلاً ونكايَةً،",
   "ajuz": "فأنتَ، لغَيثِ الحمدِ، أوّلُ رائدِ",
   "text": "عَلوتَ مَعَدّاً نائلاً ونكايَةً،    فأنتَ، لغَيثِ الحمدِ، أوّلُ رائدِ"
  }
 ],
