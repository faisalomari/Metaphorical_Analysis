   "text": "نَفَى عَنْ عَيْنِكَ الأَرَقُ الهُجُوعَا    وَهَمٌّ يَمْتَرِي مِنْها الدُّمُوعَا"
  },
  {
   "verse_index": 2,
   "sadr": "دَخِيلٌ في الفُؤَادِ يَهِيجُ سُقْمًا",
   "ajuz": "وَحُزْنًا كانَ من جَذَلٍ مَنُوعًا",
   "text": "دَخِيلٌ في الفُؤَادِ يَهِيجُ سُقْمًا    وَحُزْنًا كانَ من جَذَلٍ مَنُوعًا"
  },
  {
   "verse_index": 3,
   "sadr": "وَتَوْكَافُ الدُّمُوعِ على اكْتِئَابٍ",
