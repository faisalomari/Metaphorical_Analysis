 "verses": [
  {
   "verse_index": 1,
   "sadr": "شجاني وأَضناني تذكُّرُ مَن أَهوَى",
   "ajuz": "فأَلبسني ثَوْبًا من الضُّرّ ما يُبلَى",
   "text": "شجاني وأَضناني تذكُّرُ مَن أَهوَى    فأَلبسني ثَوْبًا من الضُّرّ ما يُبلَى"
  },
  {
   "verse_index": 2,
   "sadr": "يدُلّ على ما في الضَّمير من الفَتَى",
   "ajuz": "تقلُّبُ عَيْنَيْه إِلى شَخْصِ مَنْ يهوَى",
   "text": "يدُلّ على ما في الضَّمير من الفَتَى    تقلُّبُ عَيْنَيْه إِلى شَخْصِ مَنْ يهوَى"
  },
  {
   "verse_index": 3,
   "sadr": "وما كلُّ مَن يَهْوَى هَوًى وهو صادقٌ",
   "ajuz": "أَخو الحِبّ نِضْوٌ لا يموت ولا يحيَى",
   "text": "وما كلُّ مَن يَهْوَى هَوًى وهو صادقٌ    أَخو الحِبّ نِضْوٌ لا يموت ولا يحيَى"
  },
  {
   "verse_index": 4,
   "sadr": "خطبْنا إِلى الدِّهْقان بعضَ بَناته",
   "ajuz": "فزوّجَنا منهنّ في خِدْره الكُبْرَى",
   "text": "خطبْنا إِلى الدِّهْقان بعضَ بَناته    فزوّجَنا منهنّ في خِدْره الكُبْرَى"
  },
  {
   "verse_index": 5,
   "sadr": "وما زال يُغلي مَهْرَها ونزيده",
   "ajuz": "إِلى أَن بلغْنا منه غايَتَه القُصْوَى",
   "text": "وما زال يُغلي مَهْرَها ونزيده    إِلى أَن بلغْنا منه غايَتَه القُصْوَى"
  },
  {
   "verse_index": 6,
   "sadr": "رَحيقًا أَبوها الماءُ والكَرْمُ أُمُّها",
   "ajuz": "وحاضنُها حَرُّ الهَجير إِذا يحمَى",
   "text": "رَحيقًا أَبوها الماءُ والكَرْمُ أُمُّها    وحاضنُها حَرُّ الهَجير إِذا يحمَى"
  },
  {
   "verse_index": 7,
   "sadr": "مَساكِنُها دَنٌّ به القارُ مُشعِرًا",
   "ajuz": "إِذا برزتْ منه فليس لها مَثْوَى",
   "text": "مَساكِنُها دَنٌّ به القارُ مُشعِرًا    إِذا برزتْ منه فليس لها مَثْوَى"
  },
  {
   "verse_index": 8,
   "sadr": "مَسيحيّةُ الأَنساب مسلِمةُ القُرَى",
   "ajuz": "شَآميّةُ المَغْدَى عِراقيّةُ المَنْشا",
   "text": "مَسيحيّةُ الأَنساب مسلِمةُ القُرَى    شَآميّةُ المَغْدَى عِراقيّةُ المَنْشا"
  },
  {
   "verse_index": 9,
   "sadr": "مَجوسيّةٌ قد خالفتْ أَهْلَ دِينها",
   "ajuz": "لبِغْضتها النارَ التي عندهم تُذكَى",
   "text": "مَجوسيّةٌ قد خالفتْ أَهْلَ دِينها    لبِغْضتها النارَ التي عندهم تُذكَى"
  },
  {
   "verse_index": 10,
   "sadr": "رأَت عندنا ضَوْءَ السِّراج فراعها",
   "ajuz": "فما سكنتْ حتّى أَمرْنا به يُطفَى",
   "text": "رأَت عندنا ضَوْءَ السِّراج فراعها    فما سكنتْ حتّى أَمرْنا به يُطفَى"
  },
  {
   "verse_index": 11,
   "sadr": "وبِتْنا نراها في النَّدامَى أَسيرةً",
