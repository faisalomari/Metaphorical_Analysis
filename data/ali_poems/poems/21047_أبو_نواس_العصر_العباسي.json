  },
  {
   "verse_index": 13,
   "sadr": "أُميتتْ بلَذّات الكُؤوس نُفوسُهم",
   "ajuz": "فأَنفُسُهم أَحيا وأَجسادُهم مَوْتَى",
   "text": "أُميتتْ بلَذّات الكُؤوس نُفوسُهم    فأَنفُسُهم أَحيا وأَجسادُهم مَوْتَى"
  },
  {
   "verse_index": 14,
   "sadr": "وساقٍ غَريرِ الدَّلّ والطَّرْفُ فاترٌ",
   "ajuz": "رَبيبِ مُلوكٍ كان والدُه كِسْرَى",
   "text": "وساقٍ غَريرِ الدَّلّ والطَّرْفُ فاترٌ    رَبيبِ مُلوكٍ كان والدُه كِسْرَى"
  },
  {
   "verse_index": 15,
   "sadr": "حثثْنا مغنِّينا على شُرْبِ كَأْسه",
