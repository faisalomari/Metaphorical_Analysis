 "verses": [
  {
   "verse_index": 1,
   "sadr": "يَقُولُ الأطِبّاءُ المُداوُونَ إذ خَشوا",
   "ajuz": "عَوَارِضَ مِنْ أدْوَاءِ داءٍ يُصِيبُهَا",
   "text": "يَقُولُ الأطِبّاءُ المُداوُونَ إذ خَشوا    عَوَارِضَ مِنْ أدْوَاءِ داءٍ يُصِيبُهَا"
  },
  {
   "verse_index": 2,
   "sadr": "وَظَبْيَةُ دائي، وَالشّفَاءُ لِقَاؤهَا،\t",
   "ajuz": "وَهَلْ أنَا مَدْعُوٌّ لِنَفْسِي طَبيبُها",
   "text": "وَظَبْيَةُ دائي، وَالشّفَاءُ لِقَاؤهَا،\t    وَهَلْ أنَا مَدْعُوٌّ لِنَفْسِي طَبيبُها"
  },
  {
   "verse_index": 3,
   "sadr": "وَكُومٍ مَهَارِيسِ العَشَاءِ مُرَاحَةٍ",
   "ajuz": "عَلَيْنَا أتَاهَا بَعْدَ هَدْءٍ خَبيبُها",
   "text": "وَكُومٍ مَهَارِيسِ العَشَاءِ مُرَاحَةٍ    عَلَيْنَا أتَاهَا بَعْدَ هَدْءٍ خَبيبُها"
  },
  {
   "verse_index": 4,
   "sadr": "محَا كُلَّ مَعرُوفٍ منَ الدّارِ بَعْدَنَا\t",
   "ajuz": "دَوَالِحُ رَوْحَاتِ الصَّبَا وَجَنوبُها",
   "text": "محَا كُلَّ مَعرُوفٍ منَ الدّارِ بَعْدَنَا\t    دَوَالِحُ رَوْحَاتِ الصَّبَا وَجَنوبُها"
  },
  {
   "verse_index": 5,
   "sadr": "وكائِنْ أتَتْهَا للشَّمَالِ هَدِيّةٌ",
   "ajuz": "منَ التُّرْبِ من أنْقاءِ وَهْبٍ غرِيبُها",
   "text": "وكائِنْ أتَتْهَا للشَّمَالِ هَدِيّةٌ    منَ التُّرْبِ من أنْقاءِ وَهْبٍ غرِيبُها"
  },
  {
   "verse_index": 6,
   "sadr": "وَثِقْتُ إذا لاقَتْ بِلالاً مَطِيّتي،",
   "ajuz": "لهَا بالغِنى إنْ لمْ تُصِبْها شَعُوبُها",
   "text": "وَثِقْتُ إذا لاقَتْ بِلالاً مَطِيّتي،    لهَا بالغِنى إنْ لمْ تُصِبْها شَعُوبُها"
  },
  {
   "verse_index": 7,
   "sadr": "تَمَطّتْ بِرَحْلي وَهْيَ رَهْبٌ رَذِيّةٌ",
   "ajuz": "إلَيْكَ مِنَ الدَّهْنا أتاكَ خَبيبُها",
   "text": "تَمَطّتْ بِرَحْلي وَهْيَ رَهْبٌ رَذِيّةٌ    إلَيْكَ مِنَ الدَّهْنا أتاكَ خَبيبُها"
  },
  {
   "verse_index": 8,
   "sadr": "فَما يَهتَدي بالعَينِ مِنْ نَاظِرٍ بهَا،",
   "ajuz": "وَلَكِنّمَا تَهْدِي العُيُونَ قُلُوبُها",
   "text": "فَما يَهتَدي بالعَينِ مِنْ نَاظِرٍ بهَا،    وَلَكِنّمَا تَهْدِي العُيُونَ قُلُوبُها"
  },
  {
   "verse_index": 9,
   "sadr": "وكانَتْ قَناةُ الدِّينِ عَوْجَاءَ عندنا،",
   "ajuz": "فَجاءَ بِلالٌ فاستَقامَتْ كُعُوبُها",
   "text": "وكانَتْ قَناةُ الدِّينِ عَوْجَاءَ عندنا،    فَجاءَ بِلالٌ فاستَقامَتْ كُعُوبُها"
  },
  {
   "verse_index": 10,
   "sadr": "فَلَمّا رَأوْا سَيْفَيْ بِلالٍ تَفَرّقَتْ",
   "ajuz": "شَياطِينُ أقْوَامٍ وَمَاتَتْ ذُنُوبُها",
   "text": "فَلَمّا رَأوْا سَيْفَيْ بِلالٍ تَفَرّقَتْ    شَياطِينُ أقْوَامٍ وَمَاتَتْ ذُنُوبُها"
  },
  {
   "verse_index": 11,
   "sadr": "فَكَمْ مِنْ عَدُوٍّ يا بِلالُ خَسأتَهُ",
   "ajuz": "فأغْضَتْ لَهُ عَينٌ على مَا يَرِيبُها",
   "text": "فَكَمْ مِنْ عَدُوٍّ يا بِلالُ خَسأتَهُ    فأغْضَتْ لَهُ عَينٌ على مَا يَرِيبُها"
  },
  {
   "verse_index": 12,
   "sadr": "رَأيْتُ بِلالاً يَشْتَرِي بِتِلادِهِ",
   "ajuz": "مَكَارِمَ أخْلاقٍ عِظَامٍ رَغِيبُها",
   "text": "رَأيْتُ بِلالاً يَشْتَرِي بِتِلادِهِ    مَكَارِمَ أخْلاقٍ عِظَامٍ رَغِيبُها"
  },
  {
   "verse_index": 13,
   "sadr": "وَيَوْمٍ تُرَى جَوْزَاؤهُ قَد كَفَيتَهُ",
   "ajuz": "بِطَعْنٍ وَضَرْبٍ حينَ ثَابَ عَكوبُها",
   "text": "وَيَوْمٍ تُرَى جَوْزَاؤهُ قَد كَفَيتَهُ    بِطَعْنٍ وَضَرْبٍ حينَ ثَابَ عَكوبُها"
  },
  {
   "verse_index": 14,
   "sadr": "أبَتْ لِبِلالٍ عُصْبَةٌ أشْعَرِيّةٌ،",
   "ajuz": "إذا فَزِعَتْ كانَتْ سَرِيعاً رُكُوبُها",
   "text": "أبَتْ لِبِلالٍ عُصْبَةٌ أشْعَرِيّةٌ،    إذا فَزِعَتْ كانَتْ سَرِيعاً رُكُوبُها"
  },
  {
   "verse_index": 15,
   "sadr": "سَرِيعٌ إلى كَفّيْ بِلالٍ، إذا دَعَا،",
   "ajuz": "مِنَ اليَمَنِ الشُّبّانُ مِنها وَشِيبُها",
   "text": "سَرِيعٌ إلى كَفّيْ بِلالٍ، إذا دَعَا،    مِنَ اليَمَنِ الشُّبّانُ مِنها وَشِيبُها"
  },
  {
   "verse_index": 16,
   "sadr": "وَما دَعَوةٌ تَدْعو بِلالاً إلى القِرَى",
   "ajuz": "وَلا الطّعْنِ يَوْمَ الرّوْعِ إلاّ يُجيبُها",
   "text": "وَما دَعَوةٌ تَدْعو بِلالاً إلى القِرَى    وَلا الطّعْنِ يَوْمَ الرّوْعِ إلاّ يُجيبُها"
  },
  {
   "verse_index": 17,
   "sadr": "سَرِيعٌ إلى هَذِي وَهَذِي قِيَامُهُ،",
   "ajuz": "إذا صَدَقَتْ نَفْس الجَبَانِ كَذوبُها",
   "text": "سَرِيعٌ إلى هَذِي وَهَذِي قِيَامُهُ،    إذا صَدَقَتْ نَفْس الجَبَانِ كَذوبُها"
  },
  {
   "verse_index": 18,
   "sadr": "كَما كان يَستَحيِي أبُوهُ إذا دَعَا",
   "ajuz": "لَهُ مُستَغيثٌ حِينَ هَرَّ كَليبُها",
   "text": "كَما كان يَستَحيِي أبُوهُ إذا دَعَا    لَهُ مُستَغيثٌ حِينَ هَرَّ كَليبُها"
  },
  {
   "verse_index": 19,
   "sadr": "يَكُرّ وَرَاءَ المُسْتَغيثِ إذا دَعَا",
   "ajuz": "بِنَفْسٍ وَقُورٍ لا يُخافُ وَجِيبُها",
   "text": "يَكُرّ وَرَاءَ المُسْتَغيثِ إذا دَعَا    بِنَفْسٍ وَقُورٍ لا يُخافُ وَجِيبُها"
  },
  {
   "verse_index": 20,
   "sadr": "من القَوْمِ يَستَحمي إذا حَمِس الوَغى",
   "ajuz": "لهاماتِ كُلاّحِ الرّجَالِ ضَرُوبُها",
   "text": "من القَوْمِ يَستَحمي إذا حَمِس الوَغى    لهاماتِ كُلاّحِ الرّجَالِ ضَرُوبُها"
  },
  {
   "verse_index": 21,
   "sadr": "وَجَدْنا لَكُمْ دَلْواً شَديداً رِشاؤها،",
   "ajuz": "تَضِيمُ دِلاءَ المُسْتَقينَ ذَنُوبُها",
   "text": "وَجَدْنا لَكُمْ دَلْواً شَديداً رِشاؤها،    تَضِيمُ دِلاءَ المُسْتَقينَ ذَنُوبُها"
  }
