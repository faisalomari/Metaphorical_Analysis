 "verses": [
  {
   "verse_index": 1,
   "sadr": "رأيتُ أَبَا زُرَارةَ قَالَ يَوْمًا",
   "ajuz": "لِحَاجِبِهِ وَفِي يَدِهِ الحُسَامُ",
   "text": "رأيتُ أَبَا زُرَارةَ قَالَ يَوْمًا    لِحَاجِبِهِ وَفِي يَدِهِ الحُسَامُ"
  },
  {
   "verse_index": 2,
   "sadr": "لَئِنْ وُضِعَ الخِوَانُ وَلَاحَ شَخْصٌ",
   "ajuz": "لأَخْتَطِفَنَّ رأْسَكَ والسّلَامُ",
   "text": "لَئِنْ وُضِعَ الخِوَانُ وَلَاحَ شَخْصٌ    لأَخْتَطِفَنَّ رأْسَكَ والسّلَامُ"
  },
  {
   "verse_index": 3,
   "sadr": "فقَال: سِوَى أَبِيكَ فَذَاكَ شَيْخٌ",
   "ajuz": "بَغِيضٌ لَيْسَ يرْدَعُه الكَلَامُ",
   "text": "فقَال: سِوَى أَبِيكَ فَذَاكَ شَيْخٌ    بَغِيضٌ لَيْسَ يرْدَعُه الكَلَامُ"
  },
  {
   "verse_index": 4,
   "sadr": "فَقَام، وقال من حَنَقٍ، إلَيْهِ",
   "ajuz": "بِبَيْت لَمْ يردْ فيه القِيَامُ",
   "text": "فَقَام، وقال من حَنَقٍ، إلَيْهِ    بِبَيْت لَمْ يردْ فيه القِيَامُ"
  },
  {
   "verse_index": 5,
   "sadr": "أَبِي وابْنَا أَبِي والكَلْبُ عِنْدِي",
   "ajuz": "بِمَنْزِلَةٍ إذَا حَضَرَ الطّعَامُ",
   "text": "أَبِي وابْنَا أَبِي والكَلْبُ عِنْدِي    بِمَنْزِلَةٍ إذَا حَضَرَ الطّعَامُ"
  },
  {
   "verse_index": 6,
   "sadr": "وقال لَهُ: أَبِنْ لِي يَا ابْنَ كَلْبٍ",
   "ajuz": "عَلَى خَبَري أُصَادَرُ أَم أُضَامُ",
   "text": "وقال لَهُ: أَبِنْ لِي يَا ابْنَ كَلْبٍ    عَلَى خَبَري أُصَادَرُ أَم أُضَامُ"
  },
  {
   "verse_index": 7,
   "sadr": "إذا حَضَرَ الطَعَامُ فَلَا حُقُوقٌ",
   "ajuz": "عَلَيَّ لِوَالِدَيَّ ولَا ذِمَامُ",
   "text": "إذا حَضَرَ الطَعَامُ فَلَا حُقُوقٌ    عَلَيَّ لِوَالِدَيَّ ولَا ذِمَامُ"
  },
  {
   "verse_index": 8,
   "sadr": "فَما في الأرض أَقبَحُ من خِوَانٍ",
   "ajuz": "عليْه الخُبْزُ يَحْضرُهُ الزِّحَامُ",
   "text": "فَما في الأرض أَقبَحُ من خِوَانٍ    عليْه الخُبْزُ يَحْضرُهُ الزِّحَامُ"
  }
