 "verses": [
  {
   "verse_index": 1,
   "sadr": "أَما يسُرّك أَنّ الأَرْض زهراءُ",
   "ajuz": "والخَمْرُ مُمكِنةٌ شمطاءُ عذراءُ",
   "text": "أَما يسُرّك أَنّ الأَرْض زهراءُ    والخَمْرُ مُمكِنةٌ شمطاءُ عذراءُ"
  },
  {
   "verse_index": 2,
   "sadr": "ما في قُعودك عُذْرٌ عن معتَّقة",
   "ajuz": "أَللَّيْلُ والدُها والأُمُّ خضراءُ",
   "text": "ما في قُعودك عُذْرٌ عن معتَّقة    أَللَّيْلُ والدُها والأُمُّ خضراءُ"
  },
  {
   "verse_index": 3,
   "sadr": "بادِرْ فإِنّ جِنان الكَرْخ مُؤنِقةٌ",
   "ajuz": "لم تلتقِفْها يَدٌ للحَرْب غبراءُ",
   "text": "بادِرْ فإِنّ جِنان الكَرْخ مُؤنِقةٌ    لم تلتقِفْها يَدٌ للحَرْب غبراءُ"
  },
  {
   "verse_index": 4,
   "sadr": "فيها من الطَّيْر أَصنافٌ مشتَّتةٌ",
   "ajuz": "ما بينهنّ وبين الماء شحناءُ",
   "text": "فيها من الطَّيْر أَصنافٌ مشتَّتةٌ    ما بينهنّ وبين الماء شحناءُ"
  },
  {
   "verse_index": 5,
   "sadr": "إِذا تغنَّين لم يُبقِين جانحةً",
   "ajuz": "إِلّا بها طَرَبٌ يُشْفَى به الداءُ",
   "text": "إِذا تغنَّين لم يُبقِين جانحةً    إِلّا بها طَرَبٌ يُشْفَى به الداءُ"
  },
  {
   "verse_index": 6,
   "sadr": "يا رُبَّ مَنْزِلِ خمّار أَطفتُ به",
   "ajuz": "واللَّيْلُ حُلّتُه كالقار سوداءُ",
   "text": "يا رُبَّ مَنْزِلِ خمّار أَطفتُ به    واللَّيْلُ حُلّتُه كالقار سوداءُ"
  },
  {
   "verse_index": 7,
   "sadr": "فقام ذو وَفْرَة من بَطْن مَضْجَعه",
   "ajuz": "يميل من سُكْره والعَيْنُ وسناءُ",
   "text": "فقام ذو وَفْرَة من بَطْن مَضْجَعه    يميل من سُكْره والعَيْنُ وسناءُ"
  },
  {
   "verse_index": 8,
   "sadr": "فقال: مَن أَنت؟ في رِفْق فقُلْتُ له:",
   "ajuz": "بعضُ الكِرام ولي في النَّعْت أَسماءُ",
   "text": "فقال: مَن أَنت؟ في رِفْق فقُلْتُ له:    بعضُ الكِرام ولي في النَّعْت أَسماءُ"
  },
  {
   "verse_index": 9,
   "sadr": "وقُلتُ: إِنّي نحوتُ الخَمْرَ أَخطُبها",
   "ajuz": "قال: الدَّرَاهمَ! هل للمَهْر إِبْطاءُ ؟",
   "text": "وقُلتُ: إِنّي نحوتُ الخَمْرَ أَخطُبها    قال: الدَّرَاهمَ! هل للمَهْر إِبْطاءُ ؟"
  },
  {
   "verse_index": 10,
   "sadr": "لمّا تبيّن أَنّي غيرُ ذي عَدَم",
   "ajuz": "وليس لي شُغُلٌ عنها وإِمضاءُ",
   "text": "لمّا تبيّن أَنّي غيرُ ذي عَدَم    وليس لي شُغُلٌ عنها وإِمضاءُ"
  },
  {
   "verse_index": 11,
   "sadr": "أَتى بها قَهْوةً كالمِسْك صافيةً",
   "ajuz": "كدَمْعة منحتْها الخَدَّ مرهاءُ",
   "text": "أَتى بها قَهْوةً كالمِسْك صافيةً    كدَمْعة منحتْها الخَدَّ مرهاءُ"
  },
  {
   "verse_index": 12,
   "sadr": "ما زال تاجرُها يسقي وأَشرَبها",
   "ajuz": "وعندنا كاعبٌ بيضاءُ حسناءُ",
   "text": "ما زال تاجرُها يسقي وأَشرَبها    وعندنا كاعبٌ بيضاءُ حسناءُ"
  },
  {
   "verse_index": 13,
   "sadr": "هِرْكَوْلةٌ فُتُقٌ لعّابةٌ نَطِقٌ",
   "ajuz": "قُوهيّةُ الجِسْمِ حَشْوَ الدِّرْع لفّاءُ",
   "text": "هِرْكَوْلةٌ فُتُقٌ لعّابةٌ نَطِقٌ    قُوهيّةُ الجِسْمِ حَشْوَ الدِّرْع لفّاءُ"
  },
  {
   "verse_index": 14,
   "sadr": "كم قد تغنّتْ ولا لَوْمٌ يُلِمّ بنا:",
   "ajuz": "دعْ عنك لَوْمي فإِنّ اللَّوْم إِغراءُ",
