 "verses": [
  {
   "verse_index": 1,
   "sadr": "يا دار ميّة بالعلياء، فالسندِ",
   "ajuz": "أقوَتْ، وطال عليها سالف الأبدِ",
   "text": "يا دار ميّة بالعلياء، فالسندِ    أقوَتْ، وطال عليها سالف الأبدِ"
  },
  {
   "verse_index": 2,
   "sadr": "وقفت فيها أُصيلاناً أُسائِلها،",
   "ajuz": "عَيّتْ جواباً، وما بالربع من أحدِ",
   "text": "وقفت فيها أُصيلاناً أُسائِلها،    عَيّتْ جواباً، وما بالربع من أحدِ"
  },
  {
   "verse_index": 3,
   "sadr": "إلا الأواريَّ لأياً ما أُبيّنها،",
   "ajuz": "والنؤي كالحوض بالمظلومة الجلدِ",
   "text": "إلا الأواريَّ لأياً ما أُبيّنها،    والنؤي كالحوض بالمظلومة الجلدِ"
  },
  {
   "verse_index": 4,
   "sadr": "ردّت عليه أُقاصيه، ولبّده",
   "ajuz": "ضرب الوليدة بالمسحاة في الثأدِ",
   "text": "ردّت عليه أُقاصيه، ولبّده    ضرب الوليدة بالمسحاة في الثأدِ"
  },
  {
   "verse_index": 5,
   "sadr": "خلّت سبيل أتِيٍّ كانَ يحبسهُ،",
   "ajuz": "ورفّعتهُ إلى السّجفَيْن ، فالنّضَدِ",
   "text": "خلّت سبيل أتِيٍّ كانَ يحبسهُ،    ورفّعتهُ إلى السّجفَيْن ، فالنّضَدِ"
  },
  {
   "verse_index": 6,
   "sadr": "أمست خلاء ، وأمسى أهلها احتملوا",
   "ajuz": "أخنى عليها الذي أخنى على لُبَدِ",
   "text": "أمست خلاء ، وأمسى أهلها احتملوا    أخنى عليها الذي أخنى على لُبَدِ"
  },
  {
   "verse_index": 7,
   "sadr": "فعَدّ عَمّا ترى ، إذ لا ارتجاع له،",
   "ajuz": "وانمِ القُتُودَ على عَيْرانة ٍ أُجُدِ",
   "text": "فعَدّ عَمّا ترى ، إذ لا ارتجاع له،    وانمِ القُتُودَ على عَيْرانة ٍ أُجُدِ"
  },
  {
   "verse_index": 8,
   "sadr": "مقذوفة ٍ بدخيس النحض، بازِلُها",
   "ajuz": "له صريفٌ، صريف القَعْوِ بالمسَدِ",
   "text": "مقذوفة ٍ بدخيس النحض، بازِلُها    له صريفٌ، صريف القَعْوِ بالمسَدِ"
  },
  {
   "verse_index": 9,
   "sadr": "كأن رحلي، وقد زال النهار بنا،",
   "ajuz": "يوم الجليل، على مستأنسٍ وحدِ",
   "text": "كأن رحلي، وقد زال النهار بنا،    يوم الجليل، على مستأنسٍ وحدِ"
  },
  {
   "verse_index": 10,
   "sadr": "من وحش وَجرة َ ، مَوشيٍّ أكارعُهُ ،",
   "ajuz": "طاوي المصير، كسيف الصيقل الفَرَدِ",
   "text": "من وحش وَجرة َ ، مَوشيٍّ أكارعُهُ ،    طاوي المصير، كسيف الصيقل الفَرَدِ"
  },
  {
   "verse_index": 11,
   "sadr": "سرَتْ عليه ، من الجوزاء ، سارية ٌ،",
   "ajuz": "تُزجي الشّمال عليه جامد البَرَدِ",
   "text": "سرَتْ عليه ، من الجوزاء ، سارية ٌ،    تُزجي الشّمال عليه جامد البَرَدِ"
  },
  {
   "verse_index": 12,
   "sadr": "فارتاع من صوت كلّابٍ ، فبات له",
   "ajuz": "طوع الشوامت من خوفٍ ومن صَرَدِ",
   "text": "فارتاع من صوت كلّابٍ ، فبات له    طوع الشوامت من خوفٍ ومن صَرَدِ"
  },
  {
   "verse_index": 13,
   "sadr": "فبثّهنّ عليه، واستمرّ به",
   "ajuz": "صُمْعُ الكعوبِ بريئاتٌ من الحَرَدِ",
   "text": "فبثّهنّ عليه، واستمرّ به    صُمْعُ الكعوبِ بريئاتٌ من الحَرَدِ"
  },
  {
   "verse_index": 14,
   "sadr": "وكان ((ضُمْران)) منه حيث يوزعهُ،",
   "ajuz": "طعن المُعارك عند المُحجر النّجُدِ",
   "text": "وكان ((ضُمْران)) منه حيث يوزعهُ،    طعن المُعارك عند المُحجر النّجُدِ"
  },
  {
   "verse_index": 15,
   "sadr": "شكّ الفَريصةَ بالمِدرى، فأنفَذَها،",
   "ajuz": "طعْنَ المُبيطرِ، إذ يَشفي من العَضَدِ",
   "text": "شكّ الفَريصةَ بالمِدرى، فأنفَذَها،    طعْنَ المُبيطرِ، إذ يَشفي من العَضَدِ"
  },
  {
   "verse_index": 16,
   "sadr": "كأنّه، خارجاً من جنب صفحته،",
   "ajuz": "سفّودُ شَرْبٍ نسوهُ عند مُفتأدِ",
   "text": "كأنّه، خارجاً من جنب صفحته،    سفّودُ شَرْبٍ نسوهُ عند مُفتأدِ"
  },
  {
   "verse_index": 17,
   "sadr": "فظلّ يعجمُ أعلى الرّوق، منقبضاً،",
   "ajuz": "في حالك اللون صَدقٍ ، غير ذي أوَدِ",
   "text": "فظلّ يعجمُ أعلى الرّوق، منقبضاً،    في حالك اللون صَدقٍ ، غير ذي أوَدِ"
  },
  {
   "verse_index": 18,
   "sadr": "لما رأى ((واشقٌ)) إقعاص صاحبهِ ،",
   "ajuz": "ولا سبيل إلى عقلٍ، ولا قودِ",
   "text": "لما رأى ((واشقٌ)) إقعاص صاحبهِ ،    ولا سبيل إلى عقلٍ، ولا قودِ"
  },
  {
   "verse_index": 19,
   "sadr": "قالت له النفس: إني لا أرى طمعاً ،",
   "ajuz": "وإن مولاك لم يسلم، ولم يصدِ",
   "text": "قالت له النفس: إني لا أرى طمعاً ،    وإن مولاك لم يسلم، ولم يصدِ"
  },
  {
   "verse_index": 20,
   "sadr": "فتلك تُبْلغني النعمانَ ، إن له",
   "ajuz": "فضلاً على الناس في الأدنى ، وفي البَعَدِ",
   "text": "فتلك تُبْلغني النعمانَ ، إن له    فضلاً على الناس في الأدنى ، وفي البَعَدِ"
