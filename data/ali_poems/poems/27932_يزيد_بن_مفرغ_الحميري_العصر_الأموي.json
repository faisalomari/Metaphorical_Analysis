 "verses": [
  {
   "verse_index": 1,
   "sadr": "دارَ سَلْمى بالخَبْتِ ذي الأَطْلالِ",
   "ajuz": "كيف نَوْمُ الأَسيرِ في الأَغْلالِ",
   "text": "دارَ سَلْمى بالخَبْتِ ذي الأَطْلالِ    كيف نَوْمُ الأَسيرِ في الأَغْلالِ"
  },
  {
   "verse_index": 2,
   "sadr": "أَينَ منّي السَّلامُ مِنْ بَعْدِ نَأْيٍ",
   "ajuz": "فارْجعِي لي تَحِيَّتي وسُؤالي",
   "text": "أَينَ منّي السَّلامُ مِنْ بَعْدِ نَأْيٍ    فارْجعِي لي تَحِيَّتي وسُؤالي"
  },
  {
   "verse_index": 3,
   "sadr": "أَيْنَ مِنّي نَجائِبي وجِيادي",
   "ajuz": "وغَزالي، سَقى الإِلهُ غزالي",
   "text": "أَيْنَ مِنّي نَجائِبي وجِيادي    وغَزالي، سَقى الإِلهُ غزالي"
  },
  {
   "verse_index": 4,
   "sadr": "أَينَ لا أَينَ جُنَّتي وسِلاحي",
   "ajuz": "ومَطايا سَيَّرْتُها لارتحالي",
   "text": "أَينَ لا أَينَ جُنَّتي وسِلاحي    ومَطايا سَيَّرْتُها لارتحالي"
  },
  {
   "verse_index": 5,
   "sadr": "هَدَمَ الدَّهْرُ عَرشَنا فتَداعى",
   "ajuz": "فَبَلِينا إِذ كُلُّ شيءٍ بالِ",
   "text": "هَدَمَ الدَّهْرُ عَرشَنا فتَداعى    فَبَلِينا إِذ كُلُّ شيءٍ بالِ"
  },
  {
   "verse_index": 6,
   "sadr": "إِذ دَعانا زَوالُهُ فأَجَبْنا",
   "ajuz": "كُلُّ دُنْيا ونِعْمَةٍ لِزَوالِ",
   "text": "إِذ دَعانا زَوالُهُ فأَجَبْنا    كُلُّ دُنْيا ونِعْمَةٍ لِزَوالِ"
  },
  {
   "verse_index": 7,
   "sadr": "أَمْ قَضَيْنا حاجاتِنا فإِلى المَوْ",
   "ajuz": "تِ مَصيرُ المُلوكِ والأَقْيالِ",
   "text": "أَمْ قَضَيْنا حاجاتِنا فإِلى المَوْ    تِ مَصيرُ المُلوكِ والأَقْيالِ"
  },
  {
   "verse_index": 8,
   "sadr": "لا وَصَوْمي لرَبِّنا وزَكاتي",
   "ajuz": "وصَلاتي أَدْعو بِها وابتهالي",
   "text": "لا وَصَوْمي لرَبِّنا وزَكاتي    وصَلاتي أَدْعو بِها وابتهالي"
  },
  {
   "verse_index": 9,
   "sadr": "ما أَتَيْتُ الغَداةَ أَمْرًا دَنِيًّا",
   "ajuz": "ولدى اللهِ كابِرُ الأَعْمال",
   "text": "ما أَتَيْتُ الغَداةَ أَمْرًا دَنِيًّا    ولدى اللهِ كابِرُ الأَعْمال"
  },
  {
   "verse_index": 10,
   "sadr": "أَيُّها المالِكُ المُرَهِّبُ بالقَتْـ",
   "ajuz": "ـلِ بَلَغْتَ النَّكالَ كلَّ النَّكالِ",
   "text": "أَيُّها المالِكُ المُرَهِّبُ بالقَتْـ    ـلِ بَلَغْتَ النَّكالَ كلَّ النَّكالِ"
  },
  {
   "verse_index": 11,
   "sadr": "فاخْشَ نارًا تَشْوي الوجوهَ ويومًا",
   "ajuz": "يَقْذِفُ النّاسَ بالدَّواهي الثِّقالِ",
   "text": "فاخْشَ نارًا تَشْوي الوجوهَ ويومًا    يَقْذِفُ النّاسَ بالدَّواهي الثِّقالِ"
  },
  {
   "verse_index": 12,
   "sadr": "قد تعَدَّيْتَ في القِصاصِ وأَدْرَكْـ",
   "ajuz": "ـتَ ذُحولًا لِمَعْشَرٍ أَقْتالِ",
   "text": "قد تعَدَّيْتَ في القِصاصِ وأَدْرَكْـ    ـتَ ذُحولًا لِمَعْشَرٍ أَقْتالِ"
  },
  {
   "verse_index": 13,
   "sadr": "وكَسَرْتَ السِّنَّ الصَّحيحةَ مِنِّي",
   "ajuz": "لا تُذِلَّنْ فَمُنْكَرٌ إِذلالي",
   "text": "وكَسَرْتَ السِّنَّ الصَّحيحةَ مِنِّي    لا تُذِلَّنْ فَمُنْكَرٌ إِذلالي"
  },
  {
   "verse_index": 14,
   "sadr": "وقَرَنْتُمْ معَ الخَنازيرِ هِرًّا",
   "ajuz": "وَيَميني مَغْلولَةٌ وشِمالي",
   "text": "وقَرَنْتُمْ معَ الخَنازيرِ هِرًّا    وَيَميني مَغْلولَةٌ وشِمالي"
  },
  {
   "verse_index": 15,
   "sadr": "وكلابًا يَنْهَشْنَني مِنْ وَرائي",
   "ajuz": "عَجِبَ النَّاسُ ما لَهُنَّ ومَالي",
   "text": "وكلابًا يَنْهَشْنَني مِنْ وَرائي    عَجِبَ النَّاسُ ما لَهُنَّ ومَالي"
  },
  {
   "verse_index": 16,
   "sadr": "وأَطَلْتُمْ معَ العُقوبَةِ سَجْني",
   "ajuz": "فكم السَّجْنُ أَو مَتى إِرْسالي",
   "text": "وأَطَلْتُمْ معَ العُقوبَةِ سَجْني    فكم السَّجْنُ أَو مَتى إِرْسالي"
  },
  {
   "verse_index": 17,
   "sadr": "يَغْسِلُ الماءُ ما صَنَعْتَ وقَوْلي",
   "ajuz": "راسخٌ منكَ في العِظام البَوالي",
   "text": "يَغْسِلُ الماءُ ما صَنَعْتَ وقَوْلي    راسخٌ منكَ في العِظام البَوالي"
  },
  {
   "verse_index": 18,
   "sadr": "لو قَبِلْتَ الفِداءَ أَو رُمْتَ مالي",
   "ajuz": "قلتُ: خُذْهُ، فِداءُ نَفْسيَ مالي",
   "text": "لو قَبِلْتَ الفِداءَ أَو رُمْتَ مالي    قلتُ: خُذْهُ، فِداءُ نَفْسيَ مالي"
  },
  {
   "verse_index": 19,
   "sadr": "لو بِغَيري من مَعْشَرٍ لَعِبَ الدَّهْـ",
   "ajuz": "ـرُ لما ذمَّ نُصْرَتي واحْتيالي",
   "text": "لو بِغَيري من مَعْشَرٍ لَعِبَ الدَّهْـ    ـرُ لما ذمَّ نُصْرَتي واحْتيالي"
  },
  {
   "verse_index": 20,
   "sadr": "كم بَكاني من صاحِبٍ وخَليلٍ",
   "ajuz": "حافِظِ الغَيْبِ حامدٍ للخِصالِ",
   "text": "كم بَكاني من صاحِبٍ وخَليلٍ    حافِظِ الغَيْبِ حامدٍ للخِصالِ"
  },
  {
   "verse_index": 21,
   "sadr": "ليتَ أَنّي كنتُ الحَليفَ لِلَخْمٍ",
