   "text": "كنتُ مِنْهُمْ ما حَرَّموا فَحَرامٌ    لم يُرامُوا وحِلُّهُمْ مِنْ حَلالي"
  },
  {
   "verse_index": 29,
   "sadr": "وذَوو المَجْدِ مِنْ خُزاعَةَ كانوا",
   "ajuz": "أَهلَ وُدّي في الخِصبِ والإِمْحالِ",
   "text": "وذَوو المَجْدِ مِنْ خُزاعَةَ كانوا    أَهلَ وُدّي في الخِصبِ والإِمْحالِ"
  },
  {
   "verse_index": 30,
   "sadr": "خَذَلوني وهُمْ لِذاكَ دَعَوْني",
   "ajuz": "ليسَ حامي الذِّمارِ بالخَذّالِ",
   "text": "خَذَلوني وهُمْ لِذاكَ دَعَوْني    ليسَ حامي الذِّمارِ بالخَذّالِ"
  },
  {
   "verse_index": 31,
   "sadr": "لا تَدَعْني فِداكَ أَهْلي ومالي",
   "ajuz": "إِنَّ حَبْلَيْكَ مِنْ مَتينِ الحِبالِ",
   "text": "لا تَدَعْني فِداكَ أَهْلي ومالي    إِنَّ حَبْلَيْكَ مِنْ مَتينِ الحِبالِ"
  },
  {
   "verse_index": 32,
   "sadr": "حَسْرَتا إِذْ أَطَعْتُ أَمْرَ غُواتي",
   "ajuz": "وعَصَيْتُ النَّصيحَ ضَلَّ ضَلالي",
