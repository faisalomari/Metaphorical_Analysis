   "text": "ليتَ أَنّي كنتُ الحَليفَ لِلَخْمٍ    وجُذامٍ أَو طَيّءِ الأَجْبَالِ"
  },
  {
   "verse_index": 22,
   "sadr": "بَدَلًا مِنْ عِصابَةٍ من قُرَيْشٍ",
   "ajuz": "أَسْلَموني للخَصْمِ عندَ النِّضالِ",
   "text": "بَدَلًا مِنْ عِصابَةٍ من قُرَيْشٍ    أَسْلَموني للخَصْمِ عندَ النِّضالِ"
  },
  {
   "verse_index": 23,
   "sadr": "البَهاليلُ من بني عَبْدِ شَمْسٍ",
   "ajuz": "فَضَلُوا النّاسَ بالعُلا والفَعالِ",
   "text": "البَهاليلُ من بني عَبْدِ شَمْسٍ    فَضَلُوا النّاسَ بالعُلا والفَعالِ"
  },
  {
   "verse_index": 24,
   "sadr": "وبني التَّيْمِ تَيْمِ مُرَّةَ لَمّا",
   "ajuz": "لمَعَ المَوْتُ في ظِلالِ العَوالي",
   "text": "وبني التَّيْمِ تَيْمِ مُرَّةَ لَمّا    لمَعَ المَوْتُ في ظِلالِ العَوالي"
  },
  {
   "verse_index": 25,
   "sadr": "مَنَعوا البَيْتَ بَيْتَ مَكَّةَ ذا الحِجْـ",
   "ajuz": "ـرِ إِذِ الطَّيْرُ عُكَّفٌ في الظِّلالِ",
   "text": "مَنَعوا البَيْتَ بَيْتَ مَكَّةَ ذا الحِجْـ    ـرِ إِذِ الطَّيْرُ عُكَّفٌ في الظِّلالِ"
  },
  {
   "verse_index": 26,
   "sadr": "والبَهاليلُ خالدٌ وسَعيدٌ",
   "ajuz": "شَمْسُ دَجْنٍ وَوُضَّحٌ كالهِلالِ",
   "text": "والبَهاليلُ خالدٌ وسَعيدٌ    شَمْسُ دَجْنٍ وَوُضَّحٌ كالهِلالِ"
  },
  {
   "verse_index": 27,
   "sadr": "في الأَروماتِ والذُّرا من بَني العِيـ",
   "ajuz": "ـصِ قُرومٌ إِذا تُعَدُّ المَعالي",
   "text": "في الأَروماتِ والذُّرا من بَني العِيـ    ـصِ قُرومٌ إِذا تُعَدُّ المَعالي"
  },
  {
   "verse_index": 28,
   "sadr": "كنتُ مِنْهُمْ ما حَرَّموا فَحَرامٌ",
