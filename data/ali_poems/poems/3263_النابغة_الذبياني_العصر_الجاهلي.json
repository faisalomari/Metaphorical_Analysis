   "element": "التفات",
   "subtype": "التفات",
   "theme": "الاعتذار",
   "analysis": "",
   "raw_key": 2487
  },
  {
   "span_text": "ألِكْني وصَبّحَهُ فُلْجٌ،",
   "verse_index": "18,19,19",
   "element": "مجاز",
   "subtype": "مجاز عقلي",
   "theme": "الاعتذار",
   "analysis": "",
   "raw_key": 2488
  },
  {
   "span_text": "وصَبّحَهُ فُلْجٌ،",
   "verse_index": "19,19",
   "element": "مجاز",
   "subtype": "مجاز عقلي",
   "theme": "المدح",
   "analysis": "",
   "raw_key": 2489
  },
  {
   "span_text": "وهَمّينِ: همّاً",
   "verse_index": "1,1",
   "element": "تكرار (عام)",
   "subtype": "ترديد",
   "theme": "المدح",
   "analysis": "",
   "raw_key": 2500
  },
  {
   "span_text": "مُستكنّاً وظاهراً",
   "verse_index": "1,1",
   "element": "طباق",
   "subtype": "طباق إيجاب",
   "theme": "المدح",
   "analysis": "",
   "raw_key": 2502
  },
  {
   "span_text": "وَوِرْدَ هُمومٍ لم يَجِدْنَ مَصادِرا",
   "verse_index": "2,2,2,2,2",
   "element": "استعارة",
   "subtype": "استعارة تمثيلية",
   "theme": "المدح",
   "analysis": "",
   "raw_key": 2496
  },
  {
   "span_text": "وَوِرْدَ مَصادِرا",
   "verse_index": "2,2",
   "element": "طباق",
   "subtype": "طباق إيجاب",
   "theme": "المدح",
   "analysis": "",
   "raw_key": 2499
  },
  {
   "span_text": "وهل وجدَتْ قبلي على الدّهرِ قادراً؟",
