   "element": "استعارة",
   "subtype": "استعارة فعل",
   "theme": "المدح",
   "analysis": "",
   "raw_key": 2448
  },
  {
   "span_text": "جَدُّ النّاسِ يظلعُ،",
   "verse_index": "7,7,7",
   "element": "استعارة",
   "subtype": "استعارة فعل",
   "theme": "المدح",
   "analysis": "",
   "raw_key": 2452
  },
  {
