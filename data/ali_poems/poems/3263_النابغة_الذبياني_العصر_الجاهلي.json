  {
   "verse_index": 1,
   "sadr": "كتمتُك ليلاً بالجسُومَينِ ساهِراً،",
   "ajuz": "وهَمّينِ: همّاً مُستكنّاً وظاهراً",
   "text": "كتمتُك ليلاً بالجسُومَينِ ساهِراً،    وهَمّينِ: همّاً مُستكنّاً وظاهراً"
  },
  {
   "verse_index": 2,
   "sadr": "أحاديثَ نَفسٍ تشتكي ما يَريبُها،",
   "ajuz": "وَوِرْدَ هُمومٍ لم يَجِدْنَ مَصادِرا",
   "text": "أحاديثَ نَفسٍ تشتكي ما يَريبُها،    وَوِرْدَ هُمومٍ لم يَجِدْنَ مَصادِرا"
  },
  {
   "verse_index": 3,
   "sadr": "تُكَلّفُني أن يفعلَ الدّهرُ همّها،",
   "ajuz": "وهل وجدَتْ قبلي على الدّهرِ قادراً؟",
   "text": "تُكَلّفُني أن يفعلَ الدّهرُ همّها،    وهل وجدَتْ قبلي على الدّهرِ قادراً؟"
  },
  {
   "verse_index": 4,
   "sadr": "ألم تَرَ خيرَ النّاسِ أصبحَ نعشُهُ",
   "ajuz": "على فِتيّةٍ، قد جاوزَ الحيّ، سائِرا",
   "text": "ألم تَرَ خيرَ النّاسِ أصبحَ نعشُهُ    على فِتيّةٍ، قد جاوزَ الحيّ، سائِرا"
  },
  {
   "verse_index": 5,
   "sadr": "ونحنُ لديهِ، نسألُ الله خُلْدَهُ،",
   "ajuz": "يَرُدّ لنا مُلكاً، وللأرضِ، عامراً",
   "text": "ونحنُ لديهِ، نسألُ الله خُلْدَهُ،    يَرُدّ لنا مُلكاً، وللأرضِ، عامراً"
  },
  {
   "verse_index": 6,
   "sadr": "ونحنُ نُرَجّي الخُلدَ إن فازَ قِدحُنا،",
   "ajuz": "ونَرْهَبُ قِدْحَ الموتِ إن جاء قامِرا",
   "text": "ونحنُ نُرَجّي الخُلدَ إن فازَ قِدحُنا،    ونَرْهَبُ قِدْحَ الموتِ إن جاء قامِرا"
  },
  {
   "verse_index": 7,
   "sadr": "لكَ الخيرُ إنْ وارَتْ بك الأرضُ واحداً",
   "ajuz": "وأصبحَ جَدُّ النّاسِ يظلعُ، عاثِراً",
   "text": "لكَ الخيرُ إنْ وارَتْ بك الأرضُ واحداً    وأصبحَ جَدُّ النّاسِ يظلعُ، عاثِراً"
  },
  {
   "verse_index": 8,
   "sadr": "ورُدّتْ مطايا الرّاغبينَ، وعُرّيَتْ",
   "ajuz": "جِيادُكَ، لا يُحفي لها الدّهرُ حافِرا",
   "text": "ورُدّتْ مطايا الرّاغبينَ، وعُرّيَتْ    جِيادُكَ، لا يُحفي لها الدّهرُ حافِرا"
  },
  {
   "verse_index": 9,
   "sadr": "رأيتُكَ ترعاني بعينٍ بَصيرةٍ،",
