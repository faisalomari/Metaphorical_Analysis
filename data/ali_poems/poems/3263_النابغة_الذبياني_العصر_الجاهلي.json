   "span_text": "ألِكْني إلى النّعمانِ",
   "verse_index": "18,18,18",
   "element": "كناية",
   "subtype": "كناية",
   "theme": "الاعتذار",
   "analysis": "",
   "raw_key": 2484
  },
  {
   "span_text": "ألِكْني إلى النّعمانِ حيثُ لَقيتَهُ، إذا ما لَقينا من مَعَدٍّ مُسافِرَا",
