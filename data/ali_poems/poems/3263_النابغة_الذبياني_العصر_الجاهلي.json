  },
  {
   "verse_index": 15,
   "sadr": "تَزِلّ الوُعُولُ العُصْمُ عن قُذُفاتِهِ،",
   "ajuz": "وتُضحي ذُراهُ، بالسّحابِ، كوافِرَا",
   "text": "تَزِلّ الوُعُولُ العُصْمُ عن قُذُفاتِهِ،    وتُضحي ذُراهُ، بالسّحابِ، كوافِرَا"
