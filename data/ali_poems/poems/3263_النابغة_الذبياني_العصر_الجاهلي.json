   "element": "استعارة",
   "subtype": "استعارة فعل",
   "theme": "المدح",
   "analysis": "",
   "raw_key": 2493
  },
  {
   "span_text": "قد جاوزَ الحيّ، سائِرا",
   "verse_index": "4,4,4,4",
   "element": "كناية",
   "subtype": "كناية",
   "theme": "المدح",
   "analysis": "",
   "raw_key": 2443
  },
  {
