   "text": "رأيتُكَ ترعاني بعينٍ بَصيرةٍ،    وتبعثُ حُرّاساً عليَّ وناظِرًا"
  },
  {
   "verse_index": 10,
   "sadr": "وذلكَ من قولٍ أتاكَ أقولُهُ،",
   "ajuz": "ومن دَسّ أعدائي إليكَ المآبِرا",
   "text": "وذلكَ من قولٍ أتاكَ أقولُهُ،    ومن دَسّ أعدائي إليكَ المآبِرا"
  },
  {
   "verse_index": 11,
   "sadr": "فآليتُ لا آتيكَ، إن جئتُ، مجرمًا،",
   "ajuz": "ولا أبتغي جاراً، سواكَ، مُجاورِا",
   "text": "فآليتُ لا آتيكَ، إن جئتُ، مجرمًا،    ولا أبتغي جاراً، سواكَ، مُجاورِا"
  },
  {
   "verse_index": 12,
   "sadr": "فأهلي فِداءٌ لامرئٍ، إن أتيتُهُ",
   "ajuz": "تَقَبّلَ معرُوفي، وسَدّ المفاقِرَا",
   "text": "فأهلي فِداءٌ لامرئٍ، إن أتيتُهُ    تَقَبّلَ معرُوفي، وسَدّ المفاقِرَا"
  },
  {
   "verse_index": 13,
