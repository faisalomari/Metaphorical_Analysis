 "verses": [
  {
   "verse_index": 1,
   "sadr": "كليني لهمُّ، يا أُميمة، ناصبِ،",
   "ajuz": "وليلٍ أُقاسيهِ، بطيءِ الكواكبِ",
   "text": "كليني لهمُّ، يا أُميمة، ناصبِ،    وليلٍ أُقاسيهِ، بطيءِ الكواكبِ"
  },
  {
   "verse_index": 2,
   "sadr": "تطاول حتى قُلتُ ليس بمُنقضٍ،",
   "ajuz": "وليس الذي يرعى النجومَ بآئِبِ",
   "text": "تطاول حتى قُلتُ ليس بمُنقضٍ،    وليس الذي يرعى النجومَ بآئِبِ"
  },
  {
   "verse_index": 3,
   "sadr": "وصدرٍ أراح اللّيل عازب همّهِ،",
   "ajuz": "تضاعف فيه الحزن من كل جانب",
   "text": "وصدرٍ أراح اللّيل عازب همّهِ،    تضاعف فيه الحزن من كل جانب"
  },
  {
   "verse_index": 4,
   "sadr": "عليَّ لعمروٍ نعمةٌ، بعد نعمةٍ",
   "ajuz": "لوالده، ليست بذات عقاربِ",
   "text": "عليَّ لعمروٍ نعمةٌ، بعد نعمةٍ    لوالده، ليست بذات عقاربِ"
  },
  {
   "verse_index": 5,
   "sadr": "حلفتُ يميناً غيرَ ذي مثنويّةٍ،",
   "ajuz": "ولا عِلْمَ، إلا حُسنُ ظنٍّ بصاحبِ",
   "text": "حلفتُ يميناً غيرَ ذي مثنويّةٍ،    ولا عِلْمَ، إلا حُسنُ ظنٍّ بصاحبِ"
  },
  {
   "verse_index": 6,
   "sadr": "لئن كان للقبرين: قبرٍ بجلْقٍ،",
   "ajuz": "وقبرٍ بصيداء، الذي عند حارِبِ",
   "text": "لئن كان للقبرين: قبرٍ بجلْقٍ،    وقبرٍ بصيداء، الذي عند حارِبِ"
  },
  {
   "verse_index": 7,
   "sadr": "وللحارث الجفنيّ، سيّدِ قومهِ،",
   "ajuz": "ليلتمسن بالجيشِ دار المُحارِبِ",
   "text": "وللحارث الجفنيّ، سيّدِ قومهِ،    ليلتمسن بالجيشِ دار المُحارِبِ"
  },
  {
   "verse_index": 8,
   "sadr": "وثقتُ له بالنّصرِ، إذ قيل قد غزت",
   "ajuz": "كتائبُ من غسّان، غيرُ أشائِبِ",
   "text": "وثقتُ له بالنّصرِ، إذ قيل قد غزت    كتائبُ من غسّان، غيرُ أشائِبِ"
  },
  {
   "verse_index": 9,
   "sadr": "بنو عَمّه دنيا، وعمرو بن عامرِ،",
   "ajuz": "أُولئكَ قومٌ، بأسهم غيرُ كاذبِ",
   "text": "بنو عَمّه دنيا، وعمرو بن عامرِ،    أُولئكَ قومٌ، بأسهم غيرُ كاذبِ"
  },
  {
   "verse_index": 10,
   "sadr": "إذا ما غزّوْا بالجيشِ، حلّق فوقهم",
   "ajuz": "عصائبُ طيرٍ، تهتدي بعصائبِ",
   "text": "إذا ما غزّوْا بالجيشِ، حلّق فوقهم    عصائبُ طيرٍ، تهتدي بعصائبِ"
  },
  {
   "verse_index": 11,
   "sadr": "يصاحبنهم، حتى يُغرن مُغارهم",
   "ajuz": "من الضّارياتِ، بالدّماء، الدّوارِبِ",
   "text": "يصاحبنهم، حتى يُغرن مُغارهم    من الضّارياتِ، بالدّماء، الدّوارِبِ"
  },
  {
   "verse_index": 12,
   "sadr": "تراهنّ خلف القومِ خُرزاً عُيونُها،",
   "ajuz": "جلوسَ الشيوخِ في ثيابِ المرانِبِ",
   "text": "تراهنّ خلف القومِ خُرزاً عُيونُها،    جلوسَ الشيوخِ في ثيابِ المرانِبِ"
  },
  {
   "verse_index": 13,
   "sadr": "جوانحَ، قد أيقنَّ أن قبيلَه،",
   "ajuz": "إذا ما التقى الجمعان، أوّلُ غالبِ",
   "text": "جوانحَ، قد أيقنَّ أن قبيلَه،    إذا ما التقى الجمعان، أوّلُ غالبِ"
  },
  {
   "verse_index": 14,
   "sadr": "لهنّ عليهم عادةٌ قد عرفنها،",
   "ajuz": "إذا عُرض الخطّيّ فوق الكواثبِ",
   "text": "لهنّ عليهم عادةٌ قد عرفنها،    إذا عُرض الخطّيّ فوق الكواثبِ"
  },
  {
   "verse_index": 15,
   "sadr": "على عارفاتٍ للطّعان، عوابسٍ،",
   "ajuz": "بهنّ كُلُومٌ بين دامٍ وجالِبِ",
   "text": "على عارفاتٍ للطّعان، عوابسٍ،    بهنّ كُلُومٌ بين دامٍ وجالِبِ"
  },
  {
   "verse_index": 16,
   "sadr": "إذا استُنزِلوا عنهنّ للطّعن أرقلوا،",
   "ajuz": "إلى الموت، إرقالَ الجمال المصاعبِ",
   "text": "إذا استُنزِلوا عنهنّ للطّعن أرقلوا،    إلى الموت، إرقالَ الجمال المصاعبِ"
  },
  {
   "verse_index": 17,
   "sadr": "فهم يتساقون المنيّة بينهم،",
   "ajuz": "بأيديهم بيضٌ، رقاق المضارِبِ",
   "text": "فهم يتساقون المنيّة بينهم،    بأيديهم بيضٌ، رقاق المضارِبِ"
  },
  {
   "verse_index": 18,
   "sadr": "يطيرُ فضاضاً بينها كلُّ قونسٍ،",
   "ajuz": "ويتبعها منهم فراشُ الحواجِبِ",
   "text": "يطيرُ فضاضاً بينها كلُّ قونسٍ،    ويتبعها منهم فراشُ الحواجِبِ"
  },
  {
   "verse_index": 19,
   "sadr": "ولا عيب فيهم غيرَ أنّ سُيوفهم،",
   "ajuz": "بهنّ فلولٌ من قراعِ الكتائِبِ",
   "text": "ولا عيب فيهم غيرَ أنّ سُيوفهم،    بهنّ فلولٌ من قراعِ الكتائِبِ"
  },
  {
   "verse_index": 20,
   "sadr": "تورّثن من أزمان يوم حليمةٍ،",
   "ajuz": "إلى اليومِ قد جُربن كلَّ التّجارِبِ",
   "text": "تورّثن من أزمان يوم حليمةٍ،    إلى اليومِ قد جُربن كلَّ التّجارِبِ"
  },
  {
   "verse_index": 21,
   "sadr": "تقُدّ السّلُوقيَّ المضاعف نسجه،",
   "ajuz": "وتوقد بالصُّفّاحِ نار الحباحِبِ",
   "text": "تقُدّ السّلُوقيَّ المضاعف نسجه،    وتوقد بالصُّفّاحِ نار الحباحِبِ"
  },
  {
   "verse_index": 22,
   "sadr": "بضربٍ يُزيل الهام عن سكناته،",
   "ajuz": "وطعنٍ كإيزاغ المخاضِ الضّواربِ",
   "text": "بضربٍ يُزيل الهام عن سكناته،    وطعنٍ كإيزاغ المخاضِ الضّواربِ"
  },
  {
   "verse_index": 23,
   "sadr": "لهم شيمةٌ، لم يعطها الله غيرهم،",
   "ajuz": "من الجود، والأحلام غيرُ عَوازِبِ",
   "text": "لهم شيمةٌ، لم يعطها الله غيرهم،    من الجود، والأحلام غيرُ عَوازِبِ"
  },
  {
   "verse_index": 24,
   "sadr": "مجلّتهم ذات الإله، ودينهم",
   "ajuz": "قويمٌ، فما يرجون غيرَ العواقِبِ",
   "text": "مجلّتهم ذات الإله، ودينهم    قويمٌ، فما يرجون غيرَ العواقِبِ"
  },
  {
   "verse_index": 25,
   "sadr": "رقاق النّعال، طيّبٌ حُجُزاتهم،",
   "ajuz": "يُحيّوْن بالرّيحان، يوم السّباسِبِ",
   "text": "رقاق النّعال، طيّبٌ حُجُزاتهم،    يُحيّوْن بالرّيحان، يوم السّباسِبِ"
  },
  {
   "verse_index": 26,
   "sadr": "تُحيّيهم بيضُ الولائد بينهم،",
   "ajuz": "وأكسيةُ الاضريج فوق المشاجِبِ",
   "text": "تُحيّيهم بيضُ الولائد بينهم،    وأكسيةُ الاضريج فوق المشاجِبِ"
  },
  {
   "verse_index": 27,
   "sadr": "يصونون أجساداً، قديماً نعيمها،",
   "ajuz": "بخالصة الأردانِ، خضر المناكِبِ",
   "text": "يصونون أجساداً، قديماً نعيمها،    بخالصة الأردانِ، خضر المناكِبِ"
  },
  {
   "verse_index": 28,
   "sadr": "ولا يحسبون الخيرَ لا شرَّ بعده،",
   "ajuz": "ولا يحسبون الشرّ ضربة لازبِ",
   "text": "ولا يحسبون الخيرَ لا شرَّ بعده،    ولا يحسبون الشرّ ضربة لازبِ"
  },
  {
   "verse_index": 29,
   "sadr": "حبوتُ بها غسّان إذ كنت لاحقاً",
   "ajuz": "بقومي، وإذْ أعيَتْ عليَّ مذاهبي",
   "text": "حبوتُ بها غسّان إذ كنت لاحقاً    بقومي، وإذْ أعيَتْ عليَّ مذاهبي"
  }
