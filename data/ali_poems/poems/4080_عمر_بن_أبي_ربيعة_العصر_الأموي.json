 "verses": [
  {
   "verse_index": 1,
   "sadr": "جرى ناصحٌ بالوُدِّ بيني وبينها",
   "ajuz": "فقرَّبني يومَ الحِصابِ إلى قتلي",
   "text": "جرى ناصحٌ بالوُدِّ بيني وبينها    فقرَّبني يومَ الحِصابِ إلى قتلي"
  },
  {
   "verse_index": 2,
   "sadr": "فطارتْ بحدٍّ منْ فؤادي وقارنتْ",
   "ajuz": "قريبتُها حَبْلَ الصّفاءِ إلى حبلي",
   "text": "فطارتْ بحدٍّ منْ فؤادي وقارنتْ    قريبتُها حَبْلَ الصّفاءِ إلى حبلي"
  },
  {
   "verse_index": 3,
   "sadr": "فما أَنْسَ مِلْأشْياءِ لا أَنْسَ موقِفي",
   "ajuz": "وموْقِفَها وَهْنًا بقارِعَةِ النّخْلِ",
   "text": "فما أَنْسَ مِلْأشْياءِ لا أَنْسَ موقِفي    وموْقِفَها وَهْنًا بقارِعَةِ النّخْلِ"
  },
  {
   "verse_index": 4,
   "sadr": "فلمّا تواقَفْنا عرفْتُ الّذي بها",
   "ajuz": "كمثْلِ الّذي بي حَذْوَك النّعلَ بالنَّعْلِ",
   "text": "فلمّا تواقَفْنا عرفْتُ الّذي بها    كمثْلِ الّذي بي حَذْوَك النّعلَ بالنَّعْلِ"
  },
  {
   "verse_index": 5,
   "sadr": "فعاجتْ بأمْثالِ الظّباءِ نواعمٍ",
   "ajuz": "إلى موقفٍ بينَ الحَجونِ إلى النّخْلِ",
   "text": "فعاجتْ بأمْثالِ الظّباءِ نواعمٍ    إلى موقفٍ بينَ الحَجونِ إلى النّخْلِ"
  },
  {
   "verse_index": 6,
   "sadr": "فقالتْ لِأتْرابٍ لها شَبَهِ الدّمى",
   "ajuz": "أطلْنَ التّمنّي والوُقوفُ على شُغْلي",
   "text": "فقالتْ لِأتْرابٍ لها شَبَهِ الدّمى    أطلْنَ التّمنّي والوُقوفُ على شُغْلي"
  },
  {
   "verse_index": 7,
   "sadr": "وقالتْ لهنَّ ارْجَعْنَ شيئًا لعلَّنا",
   "ajuz": "نعاتبُ هذا أوْ يُراجعُ في وَصْلِ",
   "text": "وقالتْ لهنَّ ارْجَعْنَ شيئًا لعلَّنا    نعاتبُ هذا أوْ يُراجعُ في وَصْلِ"
  },
  {
   "verse_index": 8,
   "sadr": "فَقُلْنَ لها هذا عِشاءٌ وأهْلُنا",
   "ajuz": "قريبٌ ألمّا تسْأمي مركبَ البغْلِ؟",
   "text": "فَقُلْنَ لها هذا عِشاءٌ وأهْلُنا    قريبٌ ألمّا تسْأمي مركبَ البغْلِ؟"
  },
  {
   "verse_index": 9,
   "sadr": "فقالتْ فما شئتُنَّ قُلْنَ لها انْزلي",
   "ajuz": "فللأرض خيرٌ منْ وقوفٍ على رحْلِ",
   "text": "فقالتْ فما شئتُنَّ قُلْنَ لها انْزلي    فللأرض خيرٌ منْ وقوفٍ على رحْلِ"
  },
  {
   "verse_index": 10,
   "sadr": "وَقُمْنَ إليها كالدُّمى فاكْتَنَفْنَها",
   "ajuz": "وكُلٌّ يُفدّى بالمودّةِ والأهْلِ",
   "text": "وَقُمْنَ إليها كالدُّمى فاكْتَنَفْنَها    وكُلٌّ يُفدّى بالمودّةِ والأهْلِ"
  },
  {
   "verse_index": 11,
   "sadr": "نجومٌ دراريٌّ تكنَّفْنَ صورةً",
   "ajuz": "منَ البدرِ وافتْ غيرُ هوجٍ ولا نُكْلِ",
   "text": "نجومٌ دراريٌّ تكنَّفْنَ صورةً    منَ البدرِ وافتْ غيرُ هوجٍ ولا نُكْلِ"
  },
  {
   "verse_index": 12,
   "sadr": "فسلَّمْتُ واسْتأْنسْتُ خيفةَ أنْ يرى",
   "ajuz": "عدّوٌ مكاني أوْ يرى كاشحٌ فعلي",
   "text": "فسلَّمْتُ واسْتأْنسْتُ خيفةَ أنْ يرى    عدّوٌ مكاني أوْ يرى كاشحٌ فعلي"
  },
  {
   "verse_index": 13,
   "sadr": "فقالتْ وأرْخَتْ جانبَ السّتْرِ إنّما",
   "ajuz": "معي فتحدَّثْ غيرَ ذي رِقْبَةٍ أهلي",
   "text": "فقالتْ وأرْخَتْ جانبَ السّتْرِ إنّما    معي فتحدَّثْ غيرَ ذي رِقْبَةٍ أهلي"
  },
  {
   "verse_index": 14,
   "sadr": "فقلتُ لها ما بي لهم من ترقِّبٍ",
   "ajuz": "ولكنّ سرّي ليسَ يحمله مثلي",
   "text": "فقلتُ لها ما بي لهم من ترقِّبٍ    ولكنّ سرّي ليسَ يحمله مثلي"
  },
  {
   "verse_index": 15,
   "sadr": "فلمّا اقتصرنا دونَهنّ حديثَنا",
   "ajuz": "وهُنّ طبيباتٌ بحاجةِ ذي التَّبْلِ",
   "text": "فلمّا اقتصرنا دونَهنّ حديثَنا    وهُنّ طبيباتٌ بحاجةِ ذي التَّبْلِ"
  },
  {
   "verse_index": 16,
   "sadr": "عرفنَ الّذي تهوى فقُلْنَ لها ائذني",
   "ajuz": "نطف ساعةً في طيب ليلٍ وفي سهلِ",
   "text": "عرفنَ الّذي تهوى فقُلْنَ لها ائذني    نطف ساعةً في طيب ليلٍ وفي سهلِ"
  },
  {
   "verse_index": 17,
   "sadr": "فقالتْ فلا تلبثْنَ قلْنَ تحدَّثي",
   "ajuz": "أتيناكِ، وانسبْنَ انسيابِ مهى الرّملِ",
   "text": "فقالتْ فلا تلبثْنَ قلْنَ تحدَّثي    أتيناكِ، وانسبْنَ انسيابِ مهى الرّملِ"
  },
  {
   "verse_index": 18,
   "sadr": "فَقُمْنَ وقدْ أَفْهمْنَ ذا اللّبِّ أنما",
   "ajuz": "فَعَلْنَ الّذي يفعلنَ في ذاك من أجلي",
   "text": "فَقُمْنَ وقدْ أَفْهمْنَ ذا اللّبِّ أنما    فَعَلْنَ الّذي يفعلنَ في ذاك من أجلي"
  },
  {
   "verse_index": 19,
   "sadr": "وباتتْ تَمُجُّ المِسْكَ في فيَّ غادةٌ",
   "ajuz": "بعيدةُ مهوى القُرطِ صامتةُ الحَجْلِ",
   "text": "وباتتْ تَمُجُّ المِسْكَ في فيَّ غادةٌ    بعيدةُ مهوى القُرطِ صامتةُ الحَجْلِ"
  },
  {
   "verse_index": 20,
   "sadr": "تُقَلِّبُ عَيْنَيْ ظبيةٍ ترتعي الخلا",
   "ajuz": "وتحنو على رخْصِ الشّوى أغْيدٍ طَفْلِ",
   "text": "تُقَلِّبُ عَيْنَيْ ظبيةٍ ترتعي الخلا    وتحنو على رخْصِ الشّوى أغْيدٍ طَفْلِ"
  },
  {
   "verse_index": 21,
   "sadr": "وتفترُّ عن كالاقحوانِ بروضةٍ",
   "ajuz": "جَلَتْهُ الصّبا والمستهلُّ منَ الوَبْلِ",
   "text": "وتفترُّ عن كالاقحوانِ بروضةٍ    جَلَتْهُ الصّبا والمستهلُّ منَ الوَبْلِ"
  },
  {
   "verse_index": 22,
   "sadr": "أهيمُ بها في كلِّ مُمْسًى ومصبحٍ",
   "ajuz": "وأكثرُ دعواها إذا خَدِرَتْ رجْلي",
   "text": "أهيمُ بها في كلِّ مُمْسًى ومصبحٍ    وأكثرُ دعواها إذا خَدِرَتْ رجْلي"
  }
