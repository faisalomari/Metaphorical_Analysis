 "verses": [
  {
   "verse_index": 1,
   "sadr": "أفَرْخ الزِّنْجِ طال بِك البَلاء\t",
   "ajuz": "وَسَاء بِك الـمُقدّمُ والْوراء",
   "text": "أفَرْخ الزِّنْجِ طال بِك البَلاء\t    وَسَاء بِك الـمُقدّمُ والْوراء"
  },
  {
   "verse_index": 2,
   "sadr": "تنِيكُ وتَسْتنيكُ، وما لهذا\t",
   "ajuz": "وهَذا إِذْ جَمَعْتَهُمَا دَوَاء",
   "text": "تنِيكُ وتَسْتنيكُ، وما لهذا\t    وهَذا إِذْ جَمَعْتَهُمَا دَوَاء"
  },
  {
   "verse_index": 3,
   "sadr": "بَكيْتَ خِلاف كِنْدِيرٍ عَليهِ\t",
   "ajuz": "وَهَلْ يُغْنِي من الحَرَبِ البُكاء",
   "text": "بَكيْتَ خِلاف كِنْدِيرٍ عَليهِ\t    وَهَلْ يُغْنِي من الحَرَبِ البُكاء"
  },
  {
   "verse_index": 4,
   "sadr": "فحَدِّثْنِي فقدْ نُقِّصْتَ عُمْراً\t",
   "ajuz": "وَكِنْدِيراً أقلَّ فتًى تشاء",
   "text": "فحَدِّثْنِي فقدْ نُقِّصْتَ عُمْراً\t    وَكِنْدِيراً أقلَّ فتًى تشاء"
  },
  {
   "verse_index": 5,
   "sadr": "كفى شُغْلاً تتبُّعُ كُلِّ أيْرٍ\t",
   "ajuz": "أصَابك في استِك الدَّاءُ الْعياء",
   "text": "كفى شُغْلاً تتبُّعُ كُلِّ أيْرٍ\t    أصَابك في استِك الدَّاءُ الْعياء"
  },
  {
   "verse_index": 6,
   "sadr": "أمَا في كُربُحٍ ونَوَى لقَاطٍ\t",
   "ajuz": "وأبعارٍ تُجمِّعُهَا عزاء",
   "text": "أمَا في كُربُحٍ ونَوَى لقَاطٍ\t    وأبعارٍ تُجمِّعُهَا عزاء"
  },
  {
   "verse_index": 7,
   "sadr": "تُشَاغِلُ آكِلَ التَّمْرِ انتجاعاً\t",
   "ajuz": "وتُكْدي حين يَسْمَعُك الرِّعَاء",
   "text": "تُشَاغِلُ آكِلَ التَّمْرِ انتجاعاً\t    وتُكْدي حين يَسْمَعُك الرِّعَاء"
  },
  {
   "verse_index": 8,
   "sadr": "وَعِنْدِي منْ أبِيك الوَغْدِ عِلْمٌ\t",
   "ajuz": "وَمِنْ أُمٍّ بِهَا جَمَحَ الْفتاءُ",
   "text": "وَعِنْدِي منْ أبِيك الوَغْدِ عِلْمٌ\t    وَمِنْ أُمٍّ بِهَا جَمَحَ الْفتاءُ"
  },
  {
   "verse_index": 9,
   "sadr": "أبُوك إِذا غدَا خِنْزيرُ وَحْشٍ\t",
   "ajuz": "وأمُّكَ كلْبَة ٌ فِيهَا بَذاءُ",
   "text": "أبُوك إِذا غدَا خِنْزيرُ وَحْشٍ\t    وأمُّكَ كلْبَة ٌ فِيهَا بَذاءُ"
  },
  {
   "verse_index": 10,
   "sadr": "فمَا يَأتِيك منْ هَذا وَهَذا\t",
   "ajuz": "إِذا اجْتمَعَا وضمَّهُمَا الفضاءُ",
   "text": "فمَا يَأتِيك منْ هَذا وَهَذا\t    إِذا اجْتمَعَا وضمَّهُمَا الفضاءُ"
  },
  {
   "verse_index": 11,
   "sadr": "ألا إِنَّ اللئِيمَ أباً قديماً\t",
   "ajuz": "وَأمّاتٍ إِذا ذُكرَ النِّسَاء",
   "text": "ألا إِنَّ اللئِيمَ أباً قديماً\t    وَأمّاتٍ إِذا ذُكرَ النِّسَاء"
  },
  {
   "verse_index": 12,
   "sadr": "نتيجٌ بَيْن خِنْزيرٍ وكلْبٍ\t",
   "ajuz": "يَرَى أنَّ الكِمَارَ لهُ شِفاءُ",
   "text": "نتيجٌ بَيْن خِنْزيرٍ وكلْبٍ\t    يَرَى أنَّ الكِمَارَ لهُ شِفاءُ"
  },
  {
   "verse_index": 13,
   "sadr": "أفرْخَ الزِّنْج كيْف نطقْتَ باسْمِي\t",
   "ajuz": "وأنْت مُخنَّثٌ فِيك الْتِواءُ",
   "text": "أفرْخَ الزِّنْج كيْف نطقْتَ باسْمِي\t    وأنْت مُخنَّثٌ فِيك الْتِواءُ"
  },
  {
   "verse_index": 14,
   "sadr": "رَضِيتَ بأَنْ تُناك أبَا بَناتٍ\t",
   "ajuz": "وَليسَ لمنْ يُناكُ أباً حياء",
   "text": "رَضِيتَ بأَنْ تُناك أبَا بَناتٍ\t    وَليسَ لمنْ يُناكُ أباً حياء"
  },
  {
   "verse_index": 15,
   "sadr": "وقَدْ قامَتْ على أمٍّ وأخْتٍ\t",
   "ajuz": "شُهُود حين لقَّاهَا الزِّناءُ",
   "text": "وقَدْ قامَتْ على أمٍّ وأخْتٍ\t    شُهُود حين لقَّاهَا الزِّناءُ"
  },
  {
   "verse_index": 16,
   "sadr": "إِذا نِيكت حُشيْشة ُ صَاحَ ديكٌ\t",
   "ajuz": "وَصَوّت في اسْتِ أمِّك بَبّغاءُ",
   "text": "إِذا نِيكت حُشيْشة ُ صَاحَ ديكٌ\t    وَصَوّت في اسْتِ أمِّك بَبّغاءُ"
  },
  {
   "verse_index": 17,
   "sadr": "فدَعْ شَتْمَ الأَكَارِم، فِيهِ لَهْوٌ\t",
   "ajuz": "ولَكنْ غِبُّهُ أَيَهٌ ودَاء",
   "text": "فدَعْ شَتْمَ الأَكَارِم، فِيهِ لَهْوٌ\t    ولَكنْ غِبُّهُ أَيَهٌ ودَاء"
  },
  {
   "verse_index": 18,
   "sadr": "لأُمِّكَ مَصْرَعٌ في كُلِّ حَيِّ\t",
   "ajuz": "وَخُشَّة ُ هَمُّهَا فِيكَ الكِرَاء",
   "text": "لأُمِّكَ مَصْرَعٌ في كُلِّ حَيِّ\t    وَخُشَّة ُ هَمُّهَا فِيكَ الكِرَاء"
  },
  {
   "verse_index": 19,
   "sadr": "وَقَد تَجِرَتْ بِأخْتِكُمُ «غَنِيٌّ»\t",
   "ajuz": "فَمَا خَسِرَ التِّجَارُ وَلاَ أَسَاءوا",
   "text": "وَقَد تَجِرَتْ بِأخْتِكُمُ «غَنِيٌّ»\t    فَمَا خَسِرَ التِّجَارُ وَلاَ أَسَاءوا"
  },
  {
   "verse_index": 20,
   "sadr": "أصَابُوا صِهْرَ زنْجيٍّ دَعيٍّ\t",
