 "verses": [
  {
   "verse_index": 1,
   "sadr": "إنِّي ببابِكَ لا وُدَّي يقربني",
   "ajuz": "ولا أبي شافِعٌ عندي ولا نسبي",
   "text": "إنِّي ببابِكَ لا وُدَّي يقربني    ولا أبي شافِعٌ عندي ولا نسبي"
  },
  {
   "verse_index": 2,
   "sadr": "إنْ كانَ عرفُك مذخورًا لذي سَبَبٍ",
   "ajuz": "فاضْمُمْ يديكَ على حرٍّ أخي سَببِ",
   "text": "إنْ كانَ عرفُك مذخورًا لذي سَبَبٍ    فاضْمُمْ يديكَ على حرٍّ أخي سَببِ"
  },
  {
   "verse_index": 3,
   "sadr": "أوْ كُنْتَ وافقته يومًا على نَسَبٍ",
   "ajuz": "فاضْمُمْ يديكَ فإِّني لَسْتُ بالعَربي",
   "text": "أوْ كُنْتَ وافقته يومًا على نَسَبٍ    فاضْمُمْ يديكَ فإِّني لَسْتُ بالعَربي"
  },
  {
   "verse_index": 4,
   "sadr": "إنِّي امْرؤٌ بازِلٌ في ذروَتَي شَرَفٍ",
   "ajuz": "لقيصَرٍ ولِكِسْرى محتدي وأبي",
   "text": "إنِّي امْرؤٌ بازِلٌ في ذروَتَي شَرَفٍ    لقيصَرٍ ولِكِسْرى محتدي وأبي"
  },
  {
   "verse_index": 5,
   "sadr": "حَرْفٌ أمُونٌ ورَأْيٌ غيرُ مُشْتَرَكٍ",
   "ajuz": "وصارِمٌ من سيوفِ الهِنْدِ ذو شَطَبِ",
   "text": "حَرْفٌ أمُونٌ ورَأْيٌ غيرُ مُشْتَرَكٍ    وصارِمٌ من سيوفِ الهِنْدِ ذو شَطَبِ"
  },
  {
   "verse_index": 6,
   "sadr": "خوَّاضُ ليْل تهابُ الجنُّ لجتَه",
   "ajuz": "وينطوي جَيْشُها عَنْ جيشهِ اللَّجِبِ",
   "text": "خوَّاضُ ليْل تهابُ الجنُّ لجتَه    وينطوي جَيْشُها عَنْ جيشهِ اللَّجِبِ"
  },
  {
   "verse_index": 7,
   "sadr": "ما الشَّنْفَرى وسليكٌ في مغَيّبةٍ",
   "ajuz": "إلَّا رضيعا لبانٍ في حمى أَشِبِ",
   "text": "ما الشَّنْفَرى وسليكٌ في مغَيّبةٍ    إلَّا رضيعا لبانٍ في حمى أَشِبِ"
  },
  {
   "verse_index": 8,
   "sadr": "واللهِ ربِّ النبي المصطفى قَسَمًا",
   "ajuz": "بَرًّا وحقِ مِنًى والبيْتِ ذي الحجبِ",
   "text": "واللهِ ربِّ النبي المصطفى قَسَمًا    بَرًّا وحقِ مِنًى والبيْتِ ذي الحجبِ"
  },
  {
   "verse_index": 9,
   "sadr": "والخمسةِ الغرِّ أصْحاب الكساءِ مَعًا",
   "ajuz": "خير البرِيَّةِ من عُجْمٍ ومن عَرَبِ",
   "text": "والخمسةِ الغرِّ أصْحاب الكساءِ مَعًا    خير البرِيَّةِ من عُجْمٍ ومن عَرَبِ"
  },
  {
   "verse_index": 10,
   "sadr": "ما شِدَّةُ الحِرْصِ من شَأْني ولا طَلبي",
   "ajuz": "ولا المكاسِبُ من هَمِّي ولا أَرَبي",
   "text": "ما شِدَّةُ الحِرْصِ من شَأْني ولا طَلبي    ولا المكاسِبُ من هَمِّي ولا أَرَبي"
  },
  {
   "verse_index": 11,
   "sadr": "لكِنْ نوائِبُ نابتني وحادِثَةٌ",
   "ajuz": "والدَّهْرُ يَطْرُقُ بالأَحْداثِ والنُّوَبِ",
   "text": "لكِنْ نوائِبُ نابتني وحادِثَةٌ    والدَّهْرُ يَطْرُقُ بالأَحْداثِ والنُّوَبِ"
  },
  {
   "verse_index": 12,
   "sadr": "وليس يَعْرِفُ لي قَدْري ولا أدبي",
   "ajuz": "إلَّا امْرؤٌ كانَ ذا قَدْرٍ وذا أدَبِ",
   "text": "وليس يَعْرِفُ لي قَدْري ولا أدبي    إلَّا امْرؤٌ كانَ ذا قَدْرٍ وذا أدَبِ"
  },
  {
   "verse_index": 13,
   "sadr": "لا يَفْتننَّكَ شكري إنْ ظَفِرْتَ بهِ",
   "ajuz": "فإنَّها فُرْصَةٌ وافَتْكَ من كَثَبِ",
   "text": "لا يَفْتننَّكَ شكري إنْ ظَفِرْتَ بهِ    فإنَّها فُرْصَةٌ وافَتْكَ من كَثَبِ"
  },
  {
   "verse_index": 14,
   "sadr": "واعْلَمْ بأَنَّكَ ما أوْدَعْتَ من حَسَنٍ",
   "ajuz": "عندي ففي حَسَنٍ أنْقى من الذَّهَب",
