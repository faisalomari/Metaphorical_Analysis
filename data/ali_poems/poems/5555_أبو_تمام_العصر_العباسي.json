 "verses": [
  {
   "verse_index": 1,
   "sadr": "أَفِيكمْ فَتًى حَيُّ فَيُخْبِرُنِي عَنِّي",
   "ajuz": "بِما شَرِبَتْ مَشْروبَة ُ الرَّاحِ مِنْ ذِهْني ؟",
   "text": "أَفِيكمْ فَتًى حَيُّ فَيُخْبِرُنِي عَنِّي    بِما شَرِبَتْ مَشْروبَة ُ الرَّاحِ مِنْ ذِهْني ؟"
  },
  {
   "verse_index": 2,
   "sadr": "غَدَتْ وهْيَ أَوْلى مِنْ فُؤَادي بِعَزْمَتي",
   "ajuz": "ورُحْتُ بما في الدَّنِّ أَوْلَى مِن الدَّنِّ",
   "text": "غَدَتْ وهْيَ أَوْلى مِنْ فُؤَادي بِعَزْمَتي    ورُحْتُ بما في الدَّنِّ أَوْلَى مِن الدَّنِّ"
  },
  {
   "verse_index": 3,
   "sadr": "لقَدْ تَركَتْنِي كأْسُها وَحَقِيقَتي",
   "ajuz": "مُحَالٌ وحَقٌّ مِنْ فِعَاليَ كالظَّنِّ",
   "text": "لقَدْ تَركَتْنِي كأْسُها وَحَقِيقَتي    مُحَالٌ وحَقٌّ مِنْ فِعَاليَ كالظَّنِّ"
  },
  {
   "verse_index": 4,
   "sadr": "هي اخْتَدَعَتْني والغَمَامُ ولم أَكُنْ",
   "ajuz": "بأَوَّلَ مَنْ أَهدَى التَّغَافُلَ لِلدَّجْنِ",
   "text": "هي اخْتَدَعَتْني والغَمَامُ ولم أَكُنْ    بأَوَّلَ مَنْ أَهدَى التَّغَافُلَ لِلدَّجْنِ"
  },
  {
   "verse_index": 5,
   "sadr": "إِذا اشتَعَلَتْ في الطّاسِ والكاسِ نارُها",
   "ajuz": "صَلِيتُ بها مِنْ رَاحَتَيْ ناعِمٍ لَدْنِ",
   "text": "إِذا اشتَعَلَتْ في الطّاسِ والكاسِ نارُها    صَلِيتُ بها مِنْ رَاحَتَيْ ناعِمٍ لَدْنِ"
  },
  {
   "verse_index": 6,
   "sadr": "قَرِينُ الصِّبا في وَجنَتَيْهِ مَلاحَة ٌ",
   "ajuz": "ذَكَرْتُ بها أَيَّامَ يُوسُفَ في الحُسْنِ",
   "text": "قَرِينُ الصِّبا في وَجنَتَيْهِ مَلاحَة ٌ    ذَكَرْتُ بها أَيَّامَ يُوسُفَ في الحُسْنِ"
  },
  {
   "verse_index": 7,
   "sadr": "إِذا نَحْنُ أَوْمَأْنَا إِليهِ أَدَارَها",
   "ajuz": "سُلافاً كماءِ الجَفْنِ وَهْيَ مِنَ الجِفْنِ",
   "text": "إِذا نَحْنُ أَوْمَأْنَا إِليهِ أَدَارَها    سُلافاً كماءِ الجَفْنِ وَهْيَ مِنَ الجِفْنِ"
  },
  {
   "verse_index": 8,
   "sadr": "تُقَلِّبُ رُوحَ المَرءِ في كلِّ وِجْهَة ٍ",
   "ajuz": "وتَدْخُلُ مِنْهُ حيثُ شاءَت بلا إِذْنِ",
   "text": "تُقَلِّبُ رُوحَ المَرءِ في كلِّ وِجْهَة ٍ    وتَدْخُلُ مِنْهُ حيثُ شاءَت بلا إِذْنِ"
  },
  {
   "verse_index": 9,
   "sadr": "ومُسْمِعُنَا طَفْلُ الأَنامِلِ عندَه",
   "ajuz": "لنَا كلُّ نَوْعٍ مِنْ قِرَى العَيْنِ والأُذْنِ",
   "text": "ومُسْمِعُنَا طَفْلُ الأَنامِلِ عندَه    لنَا كلُّ نَوْعٍ مِنْ قِرَى العَيْنِ والأُذْنِ"
  },
  {
   "verse_index": 10,
   "sadr": "لنا وَتَرٌ منه إِذا ما استَحثَّه",
   "ajuz": "فَصيحٌ ولَحْنٌ في أَمانٍ مِنَ اللَّحْنِ",
   "text": "لنا وَتَرٌ منه إِذا ما استَحثَّه    فَصيحٌ ولَحْنٌ في أَمانٍ مِنَ اللَّحْنِ"
  },
  {
   "verse_index": 11,
   "sadr": "وفي رَوْضَة ٍ نَبْتِيَّة ً صَبَغتْ لها",
   "ajuz": "جَدَاوِلَها أَنْوَارُها صِبْغَة َ الدُّهْنِ",
   "text": "وفي رَوْضَة ٍ نَبْتِيَّة ً صَبَغتْ لها    جَدَاوِلَها أَنْوَارُها صِبْغَة َ الدُّهْنِ"
  },
  {
   "verse_index": 12,
   "sadr": "ظَلِلْنَا بها في جَنَّة ٍ غَابَ نَحْسُها",
   "ajuz": "تُذَّكِّرُنا جَنَّاتُها جَنَّةَ العَدْنِ",
   "text": "ظَلِلْنَا بها في جَنَّة ٍ غَابَ نَحْسُها    تُذَّكِّرُنا جَنَّاتُها جَنَّةَ العَدْنِ"
  },
  {
   "verse_index": 13,
   "sadr": "نَعِمْنَا بِها في بَيْتِ أَرْوَعَ ماجدٍ",
   "ajuz": "مِنَ القَوْمِ آب لِلدَّناءَة ِ والأَفْنِ",
   "text": "نَعِمْنَا بِها في بَيْتِ أَرْوَعَ ماجدٍ    مِنَ القَوْمِ آب لِلدَّناءَة ِ والأَفْنِ"
  },
  {
   "verse_index": 14,
   "sadr": "فَتىً شُقَّ مِنْ عُودِ المَحَامِدِ عُودُه",
   "ajuz": "كَما اِشتَقَّ مُسموهُ لَهُ اِسماً مِنَ الحُسنِ",
   "text": "فَتىً شُقَّ مِنْ عُودِ المَحَامِدِ عُودُه    كَما اِشتَقَّ مُسموهُ لَهُ اِسماً مِنَ الحُسنِ"
  }
