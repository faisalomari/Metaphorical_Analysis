 "verses": [
  {
   "verse_index": 1,
   "sadr": "قالوا: السَّلامُ عليكِ يا أطلالُ",
   "ajuz": "قُلْتُ: السَّلامُ على المحيلِ مُحالُ",
   "text": "قالوا: السَّلامُ عليكِ يا أطلالُ    قُلْتُ: السَّلامُ على المحيلِ مُحالُ"
  },
  {
   "verse_index": 2,
   "sadr": "عاجَ الشَّقِيُّ مرادُهُ دِمَنُ البِلى",
   "ajuz": "ومَرادُ عيني قُبَّةٌ وحِجالُ",
   "text": "عاجَ الشَّقِيُّ مرادُهُ دِمَنُ البِلى    ومَرادُ عيني قُبَّةٌ وحِجالُ"
  },
  {
   "verse_index": 3,
   "sadr": "لأُغادِيَنَّ الرَّاحَ وهِيَ زُلالُ",
   "ajuz": "ولأطرقَنَّ البَيْتَ فيهِ غَزالُ",
   "text": "لأُغادِيَنَّ الرَّاحَ وهِيَ زُلالُ    ولأطرقَنَّ البَيْتَ فيهِ غَزالُ"
  },
  {
   "verse_index": 4,
   "sadr": "ولأتْرُكَنَّ حَليلَها وبقلْبِهِ",
   "ajuz": "حُرَقٌ وحَشْوُ فؤَادِه بلبالُ",
   "text": "ولأتْرُكَنَّ حَليلَها وبقلْبِهِ    حُرَقٌ وحَشْوُ فؤَادِه بلبالُ"
  },
  {
   "verse_index": 5,
   "sadr": "وليَشْفِيَنْ قَلبي فمٌ وجَنى يَدٍ",
   "ajuz": "وكلاهُما لي بارِدٌ سلْسالُ",
   "text": "وليَشْفِيَنْ قَلبي فمٌ وجَنى يَدٍ    وكلاهُما لي بارِدٌ سلْسالُ"
  },
  {
   "verse_index": 6,
   "sadr": "يا ذا الغنى والبُخل ما لَكَ من غِنًى",
   "ajuz": "وكَذاكَ يا ذا المالِ ما لَكَ مالُ",
   "text": "يا ذا الغنى والبُخل ما لَكَ من غِنًى    وكَذاكَ يا ذا المالِ ما لَكَ مالُ"
  },
  {
   "verse_index": 7,
   "sadr": "أطْلِقْ يَديكَ فإنَّ بينَ يديكَ ما",
   "ajuz": "يُرْديهما ووراءَ حالِكَ حالُ",
   "text": "أطْلِقْ يَديكَ فإنَّ بينَ يديكَ ما    يُرْديهما ووراءَ حالِكَ حالُ"
  },
  {
   "verse_index": 8,
   "sadr": "قَدْ تَسْلَمُ الأوكالُ وهي مواكِلٌ",
   "ajuz": "للتَّرهاتِ وتُقْتَلُ الأبْطالُ",
   "text": "قَدْ تَسْلَمُ الأوكالُ وهي مواكِلٌ    للتَّرهاتِ وتُقْتَلُ الأبْطالُ"
  },
  {
   "verse_index": 9,
   "sadr": "ورجالُ هذي النَّائِباتِ وإنْ رَأَوْا",
   "ajuz": "شَظَفًا من الأيَّامِ فهيَ رِجالُ",
   "text": "ورجالُ هذي النَّائِباتِ وإنْ رَأَوْا    شَظَفًا من الأيَّامِ فهيَ رِجالُ"
  }
 ],
