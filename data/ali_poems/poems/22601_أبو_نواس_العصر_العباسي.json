 "verses": [
  {
   "verse_index": 1,
   "sadr": "دَعِ الرَّبْعَ ما للرَّبْع فِيَّ نَصيبُ",
   "ajuz": "وما إِن سبتْني زَيْنَبٌ ولَعوبُ",
   "text": "دَعِ الرَّبْعَ ما للرَّبْع فِيَّ نَصيبُ    وما إِن سبتْني زَيْنَبٌ ولَعوبُ"
  },
  {
   "verse_index": 2,
   "sadr": "ولكن سبتْني البابِليّةُ إِنّها",
   "ajuz": "لِمثْلِيَ في طُول الحَياة سَلوبُ",
   "text": "ولكن سبتْني البابِليّةُ إِنّها    لِمثْلِيَ في طُول الحَياة سَلوبُ"
  },
  {
   "verse_index": 3,
   "sadr": "جفا الماءُ عنها في المِزاج لأَنّها",
   "ajuz": "خَيالٌ لها بين العِظام دَبيبُ",
   "text": "جفا الماءُ عنها في المِزاج لأَنّها    خَيالٌ لها بين العِظام دَبيبُ"
  },
  {
   "verse_index": 4,
   "sadr": "إِذا ذاقها مَن ذاقها حلّقتْ به",
   "ajuz": "فليس له عَقْلٌ يُعَدّ أَريبُ",
   "text": "إِذا ذاقها مَن ذاقها حلّقتْ به    فليس له عَقْلٌ يُعَدّ أَريبُ"
  },
  {
   "verse_index": 5,
   "sadr": "ولَيْلةِ دَجْنٍ قد سرَيْتُ بفِتْيةٍ",
   "ajuz": "تنازِعنا نحو المُدام قُلوبُ",
   "text": "ولَيْلةِ دَجْنٍ قد سرَيْتُ بفِتْيةٍ    تنازِعنا نحو المُدام قُلوبُ"
  },
  {
   "verse_index": 6,
   "sadr": "إِلى بَيْتِ خمّارٍ ودونَ مَحَلّه",
   "ajuz": "قُصورٌ مُنيفاتٌ لنا ودُروبُ",
   "text": "إِلى بَيْتِ خمّارٍ ودونَ مَحَلّه    قُصورٌ مُنيفاتٌ لنا ودُروبُ"
  },
  {
   "verse_index": 7,
   "sadr": "ففُزّع في إِدلاجنا بعد هَجْعةٍ",
   "ajuz": "وليس سِوَى ذي الكِبْرِياءِ رَقيبُ",
   "text": "ففُزّع في إِدلاجنا بعد هَجْعةٍ    وليس سِوَى ذي الكِبْرِياءِ رَقيبُ"
  },
  {
   "verse_index": 8,
   "sadr": "تناوم خَوْفًا أَن يكون سِعايةً",
   "ajuz": "وعاوده بعد الرُّقاد وَجيبُ",
   "text": "تناوم خَوْفًا أَن يكون سِعايةً    وعاوده بعد الرُّقاد وَجيبُ"
  },
  {
   "verse_index": 9,
   "sadr": "فلمّا دعَوْنا باسمه طار ذُعْرُهُ",
   "ajuz": "وأَيقن أَنّ الرَّحْلَ منه خَصيبُ",
   "text": "فلمّا دعَوْنا باسمه طار ذُعْرُهُ    وأَيقن أَنّ الرَّحْلَ منه خَصيبُ"
  },
  {
   "verse_index": 10,
   "sadr": "وبادر نحو الباب سَعْيًا ملبِّيًا",
   "ajuz": "له طَرَبٌ بالزائرين عَجيبُ",
   "text": "وبادر نحو الباب سَعْيًا ملبِّيًا    له طَرَبٌ بالزائرين عَجيبُ"
  },
  {
   "verse_index": 11,
   "sadr": "فأَطلق عن نابَيْه وانكبّ ساجدًا",
   "ajuz": "لنا وهْو فيما قد يظُنّ مُصيبُ",
   "text": "فأَطلق عن نابَيْه وانكبّ ساجدًا    لنا وهْو فيما قد يظُنّ مُصيبُ"
  },
  {
   "verse_index": 12,
   "sadr": "وقال: ادخُلوا! حُيِّيتُمُ من عِصابةٍ!",
   "ajuz": "فمَنْزِلُكم سَهْلٌ لديّ رَحيبُ",
   "text": "وقال: ادخُلوا! حُيِّيتُمُ من عِصابةٍ!    فمَنْزِلُكم سَهْلٌ لديّ رَحيبُ"
  },
  {
   "verse_index": 13,
   "sadr": "وقام بمِصْباحٍ له فأَناره",
   "ajuz": "وكلُّ الذي يُهوَى لديه قَريبُ",
   "text": "وقام بمِصْباحٍ له فأَناره    وكلُّ الذي يُهوَى لديه قَريبُ"
  },
  {
   "verse_index": 14,
   "sadr": "وقُلْنا: أَرِحْنا هاتِ إِن كنتَ بائعًا",
   "ajuz": "فإِنّ الدُّجى عن مُلْكه سَيَغيبُ!",
   "text": "وقُلْنا: أَرِحْنا هاتِ إِن كنتَ بائعًا    فإِنّ الدُّجى عن مُلْكه سَيَغيبُ!"
  },
  {
   "verse_index": 15,
   "sadr": "فأَبدى لنا صَهْباءَ تَمَّ شَبابُها",
   "ajuz": "لها رَوْعةٌ محمودةٌ ووُثوبُ",
   "text": "فأَبدى لنا صَهْباءَ تَمَّ شَبابُها    لها رَوْعةٌ محمودةٌ ووُثوبُ"
  },
  {
   "verse_index": 16,
   "sadr": "فلمّا اجتلاها للنِّكاح بدا لها",
   "ajuz": "عَبيرُ نَسيمٍ ساطعٌ ولَهيبُ",
   "text": "فلمّا اجتلاها للنِّكاح بدا لها    عَبيرُ نَسيمٍ ساطعٌ ولَهيبُ"
  },
  {
   "verse_index": 17,
   "sadr": "فجاء بها تحدو بها ذاتُ مِزْهَرٍ",
   "ajuz": "يتوق إِليها الناظرون رَبيبُ",
   "text": "فجاء بها تحدو بها ذاتُ مِزْهَرٍ    يتوق إِليها الناظرون رَبيبُ"
  },
  {
   "verse_index": 18,
   "sadr": "كَثيبٌ علاه غُصْنُ بانٍ إِذا مشَى",
   "ajuz": "تكاد له صُمُّ الجِبال تُنيبُ",
   "text": "كَثيبٌ علاه غُصْنُ بانٍ إِذا مشَى    تكاد له صُمُّ الجِبال تُنيبُ"
  },
  {
   "verse_index": 19,
   "sadr": "وأَقبل محسودُ الجَمال مقرطَقٌ",
   "ajuz": "غَريبُ النُّهَى لا عَيْبَ فيه أَريبُ",
   "text": "وأَقبل محسودُ الجَمال مقرطَقٌ    غَريبُ النُّهَى لا عَيْبَ فيه أَريبُ"
  },
  {
   "verse_index": 20,
   "sadr": "يشُمّ النَّدامى الوَرْدَ من وَجَناته",
   "ajuz": "فليس به غيرُ المَلاحة طِيبُ",
   "text": "يشُمّ النَّدامى الوَرْدَ من وَجَناته    فليس به غيرُ المَلاحة طِيبُ"
  },
  {
   "verse_index": 21,
   "sadr": "فما زال يسقينا بكَأْسٍ مُجِدّةٍ",
   "ajuz": "تُولّي وأُخرَى بعد ذاك تؤوبُ",
   "text": "فما زال يسقينا بكَأْسٍ مُجِدّةٍ    تُولّي وأُخرَى بعد ذاك تؤوبُ"
  },
  {
   "verse_index": 22,
   "sadr": "وغَنّى لنا صَوْتًا بحُسْنِ ترجُّعٍ:",
   "ajuz": "سرى البَرْقُ غَرْبيًّا فحنّ غَريبُ",
   "text": "وغَنّى لنا صَوْتًا بحُسْنِ ترجُّعٍ:    سرى البَرْقُ غَرْبيًّا فحنّ غَريبُ"
  },
  {
   "verse_index": 23,
   "sadr": "فمَنْ كان منّا عاشقًا فاض دَمْعُه",
   "ajuz": "وعاوده بعد السُّرور نَحيبُ",
   "text": "فمَنْ كان منّا عاشقًا فاض دَمْعُه    وعاوده بعد السُّرور نَحيبُ"
  },
  {
   "verse_index": 24,
   "sadr": "فمِن بين مسرورٍ وباكٍ من الهَوَى",
   "ajuz": "وقد لاح من ثَوْب الظَّلام غُيوبُ",
   "text": "فمِن بين مسرورٍ وباكٍ من الهَوَى    وقد لاح من ثَوْب الظَّلام غُيوبُ"
  },
  {
   "verse_index": 25,
   "sadr": "وقد غابتْ الشِّعْرَى العَبورُ وأَقبلتْ",
