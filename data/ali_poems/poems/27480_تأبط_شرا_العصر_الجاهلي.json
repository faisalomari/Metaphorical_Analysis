 "verses": [
  {
   "verse_index": 1,
   "sadr": "إنَّ بِالشَّعْبِ الَّذي دُونَ سَلْعٍ",
   "ajuz": "لَقَتيلًا دَمُهُ ما يُطَلُ",
   "text": "إنَّ بِالشَّعْبِ الَّذي دُونَ سَلْعٍ    لَقَتيلًا دَمُهُ ما يُطَلُ"
  },
  {
   "verse_index": 2,
   "sadr": "خَلَّفَ العِبْءَ عَلَيَّ وَوَلَّى",
   "ajuz": "أنا بِالعِبْءِ لَهُ مُسْتَقِلُّ",
   "text": "خَلَّفَ العِبْءَ عَلَيَّ وَوَلَّى    أنا بِالعِبْءِ لَهُ مُسْتَقِلُّ"
  },
  {
   "verse_index": 3,
   "sadr": "وَوَراءَ الثَّأْرِ مِنِّي ابْنُ أُخْتٍ",
   "ajuz": "مَصِعٌ عُقْدَتُهُ ما تُحَلُّ",
   "text": "وَوَراءَ الثَّأْرِ مِنِّي ابْنُ أُخْتٍ    مَصِعٌ عُقْدَتُهُ ما تُحَلُّ"
  },
  {
   "verse_index": 4,
   "sadr": "مُطْرِقٌ يَرْشَحُ سَمًّا كَما أَطْـ",
   "ajuz": "ـرَقَ أَفْعَى يَنْفِثُ السَّمَّ صِلُ",
   "text": "مُطْرِقٌ يَرْشَحُ سَمًّا كَما أَطْـ    ـرَقَ أَفْعَى يَنْفِثُ السَّمَّ صِلُ"
  },
  {
   "verse_index": 5,
   "sadr": "خَبَرٌ ما نابَنا مُصْمَئِلٌّ",
   "ajuz": "جَلَّ حَتَّى دَقَّ فِيهِ الأَجَلُ",
   "text": "خَبَرٌ ما نابَنا مُصْمَئِلٌّ    جَلَّ حَتَّى دَقَّ فِيهِ الأَجَلُ"
  },
  {
   "verse_index": 6,
   "sadr": "بَزَّنِي الدَّهْرُ وَكانَ غَشُومًا",
   "ajuz": "بِأَبِيٍّ جارُهُ ما يُذَلُّ",
   "text": "بَزَّنِي الدَّهْرُ وَكانَ غَشُومًا    بِأَبِيٍّ جارُهُ ما يُذَلُّ"
  },
  {
   "verse_index": 7,
   "sadr": "شامِسٌ في الْقُرِّ حَتَّى إذا ما",
   "ajuz": "ذَكَتِ الشِّعْرَى فَبَرْدٌ وَظِلُّ",
   "text": "شامِسٌ في الْقُرِّ حَتَّى إذا ما    ذَكَتِ الشِّعْرَى فَبَرْدٌ وَظِلُّ"
  },
  {
   "verse_index": 8,
   "sadr": "يابِسُ الجَنْبَيْنِ مِنء غَيْرِ بُؤْسٍ",
   "ajuz": "وَنَدِيُّ الكَفَّيْنِ شَهْمٌ مُدِلُّ",
   "text": "يابِسُ الجَنْبَيْنِ مِنء غَيْرِ بُؤْسٍ    وَنَدِيُّ الكَفَّيْنِ شَهْمٌ مُدِلُّ"
  },
  {
   "verse_index": 9,
   "sadr": "ظاعِنٌ بِالحَزْمِ حَتَّى إذا ما",
   "ajuz": "حَلَّ حَلَّ الْحَزْمُ حَيْثُ يَحلُّ",
   "text": "ظاعِنٌ بِالحَزْمِ حَتَّى إذا ما    حَلَّ حَلَّ الْحَزْمُ حَيْثُ يَحلُّ"
  },
  {
   "verse_index": 10,
   "sadr": "غَيْثُ مُزْنٍ غامِرٌ حَيْثُ يُجْدي",
   "ajuz": "وَإذا يَسْطو فَلَيْثٌ أَبَلُّ",
   "text": "غَيْثُ مُزْنٍ غامِرٌ حَيْثُ يُجْدي    وَإذا يَسْطو فَلَيْثٌ أَبَلُّ"
  },
  {
   "verse_index": 11,
   "sadr": "مُسْبِلٌ في الْحَيِّ أَحْوى رِفَلٌّ",
   "ajuz": "وَإذا يَغْزو فَسِمْعٌ أَزَلُّ",
   "text": "مُسْبِلٌ في الْحَيِّ أَحْوى رِفَلٌّ    وَإذا يَغْزو فَسِمْعٌ أَزَلُّ"
  },
  {
   "verse_index": 12,
   "sadr": "وَلَهُ طَعْمانِ أَرْيٌ وَشَرْيٌ",
   "ajuz": "وَكِلا الطَّعْمَيْنِ قَدْ ذاقَ كُلُّ",
   "text": "وَلَهُ طَعْمانِ أَرْيٌ وَشَرْيٌ    وَكِلا الطَّعْمَيْنِ قَدْ ذاقَ كُلُّ"
  },
  {
   "verse_index": 13,
   "sadr": "يَرْكَبُ الْهَوْلَ وَحيدًا وَلا يَصْـ",
   "ajuz": "ـحَبُهُ إلَّا اليَمانِي الأَفَلُّ",
   "text": "يَرْكَبُ الْهَوْلَ وَحيدًا وَلا يَصْـ    ـحَبُهُ إلَّا اليَمانِي الأَفَلُّ"
  },
  {
   "verse_index": 14,
   "sadr": "وَفُتُوٍّ هَجَّرُوا ثُمَّ أَسْرَوْا",
   "ajuz": "لَيْلَهُمْ حَتَّى إذا انْجابَ حَلُّوا",
   "text": "وَفُتُوٍّ هَجَّرُوا ثُمَّ أَسْرَوْا    لَيْلَهُمْ حَتَّى إذا انْجابَ حَلُّوا"
  },
  {
   "verse_index": 15,
   "sadr": "كُلُّ ماضٍ قَدْ تَرَدَّى بِماضٍ",
   "ajuz": "كَسَنا البَرْقِ إذا ما يُسَلُّ",
   "text": "كُلُّ ماضٍ قَدْ تَرَدَّى بِماضٍ    كَسَنا البَرْقِ إذا ما يُسَلُّ"
  },
  {
   "verse_index": 16,
   "sadr": "فَادَّرَكْنا الثَّأْرَ مِنْهُمْ وَلَمَّا",
   "ajuz": "يَنْجُ مِلْحَيَّيْنِ إلَّا الأَقَلُّ",
   "text": "فَادَّرَكْنا الثَّأْرَ مِنْهُمْ وَلَمَّا    يَنْجُ مِلْحَيَّيْنِ إلَّا الأَقَلُّ"
  },
  {
   "verse_index": 17,
   "sadr": "فَاحْتَسَوْا أنْفاسَ نَوْمٍ فَلَمَّا",
   "ajuz": "هَوَّمُوا رُعْتَهُمُ فَاشْمَعَلُّوا",
   "text": "فَاحْتَسَوْا أنْفاسَ نَوْمٍ فَلَمَّا    هَوَّمُوا رُعْتَهُمُ فَاشْمَعَلُّوا"
  },
  {
   "verse_index": 18,
   "sadr": "فَلَئِنْ فَلَّتْ هُذَيْلٌ شَباهٌ",
   "ajuz": "لَبِما كانَ هُذَيْلًا يَفُلُّ",
   "text": "فَلَئِنْ فَلَّتْ هُذَيْلٌ شَباهٌ    لَبِما كانَ هُذَيْلًا يَفُلُّ"
  },
  {
   "verse_index": 19,
   "sadr": "وَبِما أَبْرَكَها في مُناخٍ",
   "ajuz": "جَعْجَعٍ يَنْقَبُ فيهِ الأَظَلُّ",
   "text": "وَبِما أَبْرَكَها في مُناخٍ    جَعْجَعٍ يَنْقَبُ فيهِ الأَظَلُّ"
  },
  {
   "verse_index": 20,
   "sadr": "وَبِما صَبَّحَها في ذَراها",
   "ajuz": "مِنْهُ بَعْدَ الْقَتْلِ نَهْبٌ وَشَلُّ",
   "text": "وَبِما صَبَّحَها في ذَراها    مِنْهُ بَعْدَ الْقَتْلِ نَهْبٌ وَشَلُّ"
  },
  {
   "verse_index": 21,
   "sadr": "صَلِيتْ مِنِّي هُذَيْلٌ بِخِرْقٍ",
   "ajuz": "لا يَمَلُّ الشَّرَّ حَتَّى يَمَلُّوا",
   "text": "صَلِيتْ مِنِّي هُذَيْلٌ بِخِرْقٍ    لا يَمَلُّ الشَّرَّ حَتَّى يَمَلُّوا"
  },
  {
   "verse_index": 22,
   "sadr": "يُنْهِلُ الصَّعْدَةَ حَتَّى إذا ما",
   "ajuz": "نَهِلَتْ كانَ لَها مِنْهُ عَلُّ",
   "text": "يُنْهِلُ الصَّعْدَةَ حَتَّى إذا ما    نَهِلَتْ كانَ لَها مِنْهُ عَلُّ"
  },
  {
   "verse_index": 23,
   "sadr": "حَلَّتِ الخَمْرُ وَكانَتْ حَرامًا",
   "ajuz": "وَبِلَأْيٍ ما أَلَمَّتْ تَحِلُّ",
   "text": "حَلَّتِ الخَمْرُ وَكانَتْ حَرامًا    وَبِلَأْيٍ ما أَلَمَّتْ تَحِلُّ"
  },
  {
   "verse_index": 24,
   "sadr": "فَاسْقِنيها يا سَوادَ بْنِ عَمْرٍو",
   "ajuz": "إنَّ جِسْمي بَعْدَ خالي لَخَلُّ",
   "text": "فَاسْقِنيها يا سَوادَ بْنِ عَمْرٍو    إنَّ جِسْمي بَعْدَ خالي لَخَلُّ"
  },
  {
   "verse_index": 25,
   "sadr": "تَضْحَكُ الضَّبْعُ لِقَتْلَى هُذَيْلٍ",
   "ajuz": "وَتَرى الذِّئْبَ لَها يَسْتَهِلُّ",
   "text": "تَضْحَكُ الضَّبْعُ لِقَتْلَى هُذَيْلٍ    وَتَرى الذِّئْبَ لَها يَسْتَهِلُّ"
  },
  {
   "verse_index": 26,
   "sadr": "وَعِتاقُ الطَّيْرِ تَغْدو بِطانًا",
   "ajuz": "تَتَخَطَّاهُمْ فَما تَسْتَقِلُّ",
   "text": "وَعِتاقُ الطَّيْرِ تَغْدو بِطانًا    تَتَخَطَّاهُمْ فَما تَسْتَقِلُّ"
  }
