   "text": "أنْسى عليًّا وتَفنيدَ الغُواةِ له    وفي غَدٍ يُعْرَفُ الأفَّاكُ والأَشِرُ"
  },
  {
   "verse_index": 19,
   "sadr": "مَنْ ذا الذي كَلَّمَتْهُ البيدُ والشَّجَرُ؟",
