 "verses": [
  {
   "verse_index": 1,
   "sadr": "ما أنْتِ منِّي وَلَا رَبْعاكِ لي وَطَرُ",
   "ajuz": "الهَمُّ أمْلَكُ بي والشَّوْقُ والفِكَرُ",
   "text": "ما أنْتِ منِّي وَلَا رَبْعاكِ لي وَطَرُ    الهَمُّ أمْلَكُ بي والشَّوْقُ والفِكَرُ"
  },
  {
   "verse_index": 2,
   "sadr": "وراعَها أنَّ دَمْعًا فاضَ مُنْتَثِرًا",
   "ajuz": "لا أوْ تَرى كَبِدي لِلْحُزْنِ تَنْتَثِرُ",
   "text": "وراعَها أنَّ دَمْعًا فاضَ مُنْتَثِرًا    لا أوْ تَرى كَبِدي لِلْحُزْنِ تَنْتَثِرُ"
  },
  {
   "verse_index": 3,
   "sadr": "أيْنَ الحُسَيْنُ وقَتْلى من بَني حَسَنٍ",
   "ajuz": "وجَعْفَرٍ وعَقيلٍ غالَهُمْ غَمِرُ",
   "text": "أيْنَ الحُسَيْنُ وقَتْلى من بَني حَسَنٍ    وجَعْفَرٍ وعَقيلٍ غالَهُمْ غَمِرُ"
  },
  {
   "verse_index": 4,
   "sadr": "قَتْلى يَحِنُّ إليها البَيْتُ والحَجَرُ",
   "ajuz": "شَوْقًا، وتبكيهُمُ الآياتُ والسُّوَرُ",
   "text": "قَتْلى يَحِنُّ إليها البَيْتُ والحَجَرُ    شَوْقًا، وتبكيهُمُ الآياتُ والسُّوَرُ"
  },
  {
   "verse_index": 5,
   "sadr": "ماتَ الحُسَيْنُ بأيْدٍ في مغائظها",
   "ajuz": "طولٌ عليه وفي إشْفاقها قِصَرُ",
   "text": "ماتَ الحُسَيْنُ بأيْدٍ في مغائظها    طولٌ عليه وفي إشْفاقها قِصَرُ"
  },
  {
   "verse_index": 6,
   "sadr": "لا دَرَّ دَرُّ الأعادي عِنْدَما وَتَرُوا",
   "ajuz": "ودَرَّ دَرُّكِ ما تَحْوِينَ يا حُفَرُ",
   "text": "لا دَرَّ دَرُّ الأعادي عِنْدَما وَتَرُوا    ودَرَّ دَرُّكِ ما تَحْوِينَ يا حُفَرُ"
  },
  {
   "verse_index": 7,
   "sadr": "لمَّا رَأَوا طُرُقاتِ الصَّبْرِ مُعْرِضَةً",
   "ajuz": "إلى لِقاءٍ ولقيا رَحْمَةٍ صَبَرُوا",
   "text": "لمَّا رَأَوا طُرُقاتِ الصَّبْرِ مُعْرِضَةً    إلى لِقاءٍ ولقيا رَحْمَةٍ صَبَرُوا"
  },
  {
   "verse_index": 8,
   "sadr": "قالوا لأنْفُسِهِمْ: يا حَبَّذا نَهَلٌ",
   "ajuz": "مُحَمَّدٌ وعَليٌّ بَعْدَهُ صَدَرُ",
   "text": "قالوا لأنْفُسِهِمْ: يا حَبَّذا نَهَلٌ    مُحَمَّدٌ وعَليٌّ بَعْدَهُ صَدَرُ"
  },
  {
   "verse_index": 9,
   "sadr": "رِدُوا هَنيئًا مريئًا آلَ فاطِمَةٍ",
   "ajuz": "حَوْضَ الرَّدَى فارْتَضوا بالقَتْلِ واصْطَبِروا",
   "text": "رِدُوا هَنيئًا مريئًا آلَ فاطِمَةٍ    حَوْضَ الرَّدَى فارْتَضوا بالقَتْلِ واصْطَبِروا"
  },
  {
   "verse_index": 10,
   "sadr": "الحَوْضُ حَوْضُهُمُ، والجدُّ جَدُّهُمُ",
   "ajuz": "وعِنْدَ رَبِّهِمُ في خَلْقِهِ غِيَرُ",
   "text": "الحَوْضُ حَوْضُهُمُ، والجدُّ جَدُّهُمُ    وعِنْدَ رَبِّهِمُ في خَلْقِهِ غِيَرُ"
  },
  {
   "verse_index": 11,
   "sadr": "[أبْكيكُمُ يا بَني التَّقْوى وأُعْوِلُكُمْ",
   "ajuz": "وأشْرَبُ الصَّبْرَ وهو الصَّابُ والصَّبرُ]",
   "text": "[أبْكيكُمُ يا بَني التَّقْوى وأُعْوِلُكُمْ    وأشْرَبُ الصَّبْرَ وهو الصَّابُ والصَّبرُ]"
  },
  {
   "verse_index": 12,
   "sadr": "أبْكيكُمُ يا بَني بِنْتِ الرَّسُولِ ولا",
   "ajuz": "عَفَتْ مَحَلَّكُمُ الأنْواءُ والمَطَرُ",
   "text": "أبْكيكُمُ يا بَني بِنْتِ الرَّسُولِ ولا    عَفَتْ مَحَلَّكُمُ الأنْواءُ والمَطَرُ"
  },
  {
   "verse_index": 13,
   "sadr": "مالي فَراغٌ إلى عُثْمانَ أنْدُبُهُ",
   "ajuz": "ولا شَجاني أبُو بَكْرٍ ولا عُمَرُ",
   "text": "مالي فَراغٌ إلى عُثْمانَ أنْدُبُهُ    ولا شَجاني أبُو بَكْرٍ ولا عُمَرُ"
  },
  {
   "verse_index": 14,
   "sadr": "لَكُم عَدِيٌّ وتَيْمٌ، بَلْ أَزِيدُكُمُ",
   "ajuz": "أُمَيَّةً، ولنا الأَعْلامُ والغُرَرُ",
   "text": "لَكُم عَدِيٌّ وتَيْمٌ، بَلْ أَزِيدُكُمُ    أُمَيَّةً، ولنا الأَعْلامُ والغُرَرُ"
  },
  {
   "verse_index": 15,
   "sadr": "في كُلِّ يَوْمٍ لقَلبي مِنْ تَذَكُّرِهمْ",
   "ajuz": "تَغْرِيبةٌ وَلِدَمْعي مِنْهُمُ سَفَرُ",
   "text": "في كُلِّ يَوْمٍ لقَلبي مِنْ تَذَكُّرِهمْ    تَغْرِيبةٌ وَلِدَمْعي مِنْهُمُ سَفَرُ"
  },
  {
   "verse_index": 16,
   "sadr": "مَوْتًا وقَتْلًا بهاماتٍ مُفَلَّقَةٍ",
   "ajuz": "مِنْ هاشِمٍ غابَ عَنْها النَّصْرُ والظَّفَرُ",
   "text": "مَوْتًا وقَتْلًا بهاماتٍ مُفَلَّقَةٍ    مِنْ هاشِمٍ غابَ عَنْها النَّصْرُ والظَّفَرُ"
  },
  {
   "verse_index": 17,
   "sadr": "كفى بانَّ أنَاةَ اللهِ واقِعَةٌ",
