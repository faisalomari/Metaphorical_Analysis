 "verses": [
  {
   "verse_index": 1,
   "sadr": "[وإِنِّي لَمُقْتَادٌ جَوَادِي، وقَاذِفٌ",
   "ajuz": "بِهِ وبِنَفْسي العَامَ إِحْدَى المَقَاذِفِ]",
   "text": "[وإِنِّي لَمُقْتَادٌ جَوَادِي، وقَاذِفٌ    بِهِ وبِنَفْسي العَامَ إِحْدَى المَقَاذِفِ]"
  },
  {
   "verse_index": 2,
   "sadr": "[لِأَكسِبَ مَالًا، أَوْ أَؤُولَ إِلى غِنًى",
   "ajuz": "مِنَ اللَّهِ يَكْفِينِي عُدَاةَ الخَلَائِفِ]",
   "text": "[لِأَكسِبَ مَالًا، أَوْ أَؤُولَ إِلى غِنًى    مِنَ اللَّهِ يَكْفِينِي عُدَاةَ الخَلَائِفِ]"
  },
  {
   "verse_index": 3,
   "sadr": "[مَخَافَة َ دُنْيَا رَثَّةٍ أَنْ تُمِيلَني",
   "ajuz": "كَمَا مَالَ فِيهَا الهَالِكُ المُتَجَانِفُ]",
   "text": "[مَخَافَة َ دُنْيَا رَثَّةٍ أَنْ تُمِيلَني    كَمَا مَالَ فِيهَا الهَالِكُ المُتَجَانِفُ]"
  },
  {
   "verse_index": 4,
   "sadr": "فَيَارَبِّ إنْ حَانَتْ وَفَاتي فَلَا تَكُنْ",
   "ajuz": "عَلى شَرْجَعٍ يُعْلَى بِدُكْنِ المَطَارِفِ",
   "text": "فَيَارَبِّ إنْ حَانَتْ وَفَاتي فَلَا تَكُنْ    عَلى شَرْجَعٍ يُعْلَى بِدُكْنِ المَطَارِفِ"
  },
  {
   "verse_index": 5,
   "sadr": "وَلكِنْ أَحِنْ يَوْمِي شَهِيدًا وَعُقْبَةً",
   "ajuz": "يُصَابُونَ في فَجٍّ مِنَ الأَرْضِ خَائِفِ",
   "text": "وَلكِنْ أَحِنْ يَوْمِي شَهِيدًا وَعُقْبَةً    يُصَابُونَ في فَجٍّ مِنَ الأَرْضِ خَائِفِ"
  },
  {
   "verse_index": 6,
   "sadr": "[عَصَائِبُ مِنْ شَتَّى، يُؤَلِّفُ بَيْنَهُمْ",
   "ajuz": "هُدَى اللهِ، نَزَّالُونَ عِنْدَ المَوَاقِفِ]",
   "text": "[عَصَائِبُ مِنْ شَتَّى، يُؤَلِّفُ بَيْنَهُمْ    هُدَى اللهِ، نَزَّالُونَ عِنْدَ المَوَاقِفِ]"
  },
  {
   "verse_index": 7,
   "sadr": "إِذَا فَارَقُوا دُنْيَاهُمُ فَارَقُوا الأَذَى",
   "ajuz": "وصَارُوا إِلى مَوْعُودِ مَا في المَصَاحِفِ",
   "text": "إِذَا فَارَقُوا دُنْيَاهُمُ فَارَقُوا الأَذَى    وصَارُوا إِلى مَوْعُودِ مَا في المَصَاحِفِ"
  },
  {
   "verse_index": 8,
   "sadr": "[فَأُقْتَلَ قَعْصًا، ثُمَّ يُرْمَى بِأَعْظُمِي",
   "ajuz": "كَضِغْثِ الخَلَى بَيْنَ الرِّيَاحِ العَوَاصِفِ]",
   "text": "[فَأُقْتَلَ قَعْصًا، ثُمَّ يُرْمَى بِأَعْظُمِي    كَضِغْثِ الخَلَى بَيْنَ الرِّيَاحِ العَوَاصِفِ]"
  },
  {
   "verse_index": 9,
   "sadr": "ويُصْبِحَ قَبْرِي بَطْنَ نَسْرٍ مَقِيلُهُ",
   "ajuz": "بِجَوِّ السَّمَاءِ في نُسُورٍ عَوَائِفِ",
   "text": "ويُصْبِحَ قَبْرِي بَطْنَ نَسْرٍ مَقِيلُهُ    بِجَوِّ السَّمَاءِ في نُسُورٍ عَوَائِفِ"
  }
 ],
