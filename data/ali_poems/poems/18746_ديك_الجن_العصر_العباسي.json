 "verses": [
  {
   "verse_index": 1,
   "sadr": "ليْتني لَمْ أكُنْ لِعَطْفِكِ نِلْتُ",
   "ajuz": "وإلى ذَلك الوِصالِ وَصَلْتُ",
   "text": "ليْتني لَمْ أكُنْ لِعَطْفِكِ نِلْتُ    وإلى ذَلك الوِصالِ وَصَلْتُ"
  },
  {
   "verse_index": 2,
   "sadr": "فالَّذِي مِنِّيَ اشْتَمَلْتِ عَليه",
   "ajuz": "ألِعارٍ ما قد عليهِ اشْتمَلْتُ",
   "text": "فالَّذِي مِنِّيَ اشْتَمَلْتِ عَليه    ألِعارٍ ما قد عليهِ اشْتمَلْتُ"
  },
  {
   "verse_index": 3,
   "sadr": "قال ذو الجهْلِ قد حَلُمْتَ ولا",
   "ajuz": "أعْلَمُ أنِّي حَلُمْتُ حَتَّى جَهِلْتُ",
   "text": "قال ذو الجهْلِ قد حَلُمْتَ ولا    أعْلَمُ أنِّي حَلُمْتُ حَتَّى جَهِلْتُ"
  },
  {
   "verse_index": 4,
   "sadr": "لائمٌ لي بِجَهْلِهِ وَلماذا",
   "ajuz": "أنا وَحْدِي أحْبَبْتُ ثُمَّ قَتَلْتُ",
   "text": "لائمٌ لي بِجَهْلِهِ وَلماذا    أنا وَحْدِي أحْبَبْتُ ثُمَّ قَتَلْتُ"
  },
  {
   "verse_index": 5,
   "sadr": "سَوْفَ آسى طولَ الحَياةِ وأبْكيكِ",
   "ajuz": "على ما فَعَلْتِ لا ما فَعَلْتُ",
   "text": "سَوْفَ آسى طولَ الحَياةِ وأبْكيكِ    على ما فَعَلْتِ لا ما فَعَلْتُ"
  }
 ],
