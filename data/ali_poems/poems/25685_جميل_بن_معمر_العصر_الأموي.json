 "verses": [
  {
   "verse_index": 1,
   "sadr": "لقَدْ أوْرَثَتْ قلبي وكانَ مُصَحَّحًا",
   "ajuz": "بُثَيْنَةُ صَدْعًا يَوْمَ طارَ رِداؤُها",
   "text": "لقَدْ أوْرَثَتْ قلبي وكانَ مُصَحَّحًا    بُثَيْنَةُ صَدْعًا يَوْمَ طارَ رِداؤُها"
  },
  {
   "verse_index": 2,
   "sadr": "إذا خَطَرَتْ مِنْ ذِكْرِ بَثْنَةَ خَطرةٌ",
   "ajuz": "عَصَتْني شُؤونُ العَيْنِ فانْهَلَّ ماؤها",
   "text": "إذا خَطَرَتْ مِنْ ذِكْرِ بَثْنَةَ خَطرةٌ    عَصَتْني شُؤونُ العَيْنِ فانْهَلَّ ماؤها"
  },
  {
   "verse_index": 3,
   "sadr": "فإنْ لمْ أزُرها عادَني الشَّوْقُ والهوى",
   "ajuz": "وعاودَ قَلْبي مِنْ بُثَيْنَةَ داؤُها",
   "text": "فإنْ لمْ أزُرها عادَني الشَّوْقُ والهوى    وعاودَ قَلْبي مِنْ بُثَيْنَةَ داؤُها"
  },
  {
   "verse_index": 4,
   "sadr": "وكيفَ بِنَفْسٍ أنْتِ هيَّجْتِ سُقْمَها",
   "ajuz": "ويُمنَعُ منها يا بُثَينُ شِفاؤها",
   "text": "وكيفَ بِنَفْسٍ أنْتِ هيَّجْتِ سُقْمَها    ويُمنَعُ منها يا بُثَينُ شِفاؤها"
  },
  {
   "verse_index": 5,
   "sadr": "لقدْ كُنْتُ أرجو أنْ تَجودي بنائلٍ",
   "ajuz": "فَأَخْلَفَ نَفْسي منْ جَداكِ رَجاؤُها",
   "text": "لقدْ كُنْتُ أرجو أنْ تَجودي بنائلٍ    فَأَخْلَفَ نَفْسي منْ جَداكِ رَجاؤُها"
  },
  {
   "verse_index": 6,
   "sadr": "فلوْ أنَّ نفسي يا بُثينُ تُطيعُني",
   "ajuz": "لقدْ طالَ عَنكمْ صَبْرُها وعَزاؤها",
   "text": "فلوْ أنَّ نفسي يا بُثينُ تُطيعُني    لقدْ طالَ عَنكمْ صَبْرُها وعَزاؤها"
  },
  {
   "verse_index": 7,
   "sadr": "ولكِنْ عَصَتني واستَبَدَّتْ لإمرها",
   "ajuz": "فأنتِ هَواها يا بُثَيْنُ وشاؤُها",
   "text": "ولكِنْ عَصَتني واستَبَدَّتْ لإمرها    فأنتِ هَواها يا بُثَيْنُ وشاؤُها"
  },
  {
   "verse_index": 8,
   "sadr": "فَأحْيِي هَداكَ اللهُ نَفْسًا مَريضَةً",
   "ajuz": "طَويلًا بِكُمْ تَهْيامُها وعَناؤها",
   "text": "فَأحْيِي هَداكَ اللهُ نَفْسًا مَريضَةً    طَويلًا بِكُمْ تَهْيامُها وعَناؤها"
  },
  {
   "verse_index": 9,
   "sadr": "وكمْ وَاعَدَتْنا مِنْ مَواعِدَ لو وَفَتْ",
   "ajuz": "بِوَأْيٍ فلمْ تُنْجَزْ قليلٍ غَناؤُها",
   "text": "وكمْ وَاعَدَتْنا مِنْ مَواعِدَ لو وَفَتْ    بِوَأْيٍ فلمْ تُنْجَزْ قليلٍ غَناؤُها"
  },
  {
   "verse_index": 10,
   "sadr": "وكمْ لي عليها منْ دُيونٍ كثيرَةٍ",
   "ajuz": "طَويلٌ تَقاضِيها بَطيءٌ قَضاؤها",
   "text": "وكمْ لي عليها منْ دُيونٍ كثيرَةٍ    طَويلٌ تَقاضِيها بَطيءٌ قَضاؤها"
  },
  {
   "verse_index": 11,
   "sadr": "تَجودُ بِهِ في النَّومِ غَيْرِ مُصَرَّدٍ",
   "ajuz": "وَيُحزِنُ أيْقاظًا علَيْها عَطاؤُها",
   "text": "تَجودُ بِهِ في النَّومِ غَيْرِ مُصَرَّدٍ    وَيُحزِنُ أيْقاظًا علَيْها عَطاؤُها"
  },
  {
   "verse_index": 12,
   "sadr": "إذا قُلْتُ قَدْ جادتْ لنا بِنَوالِها",
   "ajuz": "أبَتْ ثمّ قالَتْ خُطَّةٌ لا أشاؤُها",
   "text": "إذا قُلْتُ قَدْ جادتْ لنا بِنَوالِها    أبَتْ ثمّ قالَتْ خُطَّةٌ لا أشاؤُها"
  },
  {
   "verse_index": 13,
   "sadr": "أعاذِلتي فيها لَكِ الوَيْلُ أقْصِري",
   "ajuz": "منَ اللَّومِ عنّي اليَومَ أنْتِ فِداؤُها",
   "text": "أعاذِلتي فيها لَكِ الوَيْلُ أقْصِري    منَ اللَّومِ عنّي اليَومَ أنْتِ فِداؤُها"
  },
  {
   "verse_index": 14,
   "sadr": "فما ظَبْيَةٌ أدْماءُ لاحِقَةٌ الحَشا",
   "ajuz": "بصحراءِ قَوٍّ أفردَتْها ظِباؤها",
   "text": "فما ظَبْيَةٌ أدْماءُ لاحِقَةٌ الحَشا    بصحراءِ قَوٍّ أفردَتْها ظِباؤها"
  },
  {
   "verse_index": 15,
   "sadr": "تُراعي قَليلًا ثُمَّ تَحْنو إلى طَلَا",
   "ajuz": "إذا ما دعتهُ والبُغامُ دُعاؤُها",
   "text": "تُراعي قَليلًا ثُمَّ تَحْنو إلى طَلَا    إذا ما دعتهُ والبُغامُ دُعاؤُها"
  },
  {
   "verse_index": 16,
   "sadr": "بِأحْسَنَ مِنْها مُقْلَةً ومُقَلَّدًا",
   "ajuz": "إذا جُلِيَتْ لم يُستطاعُ اجْتِلاؤُها",
   "text": "بِأحْسَنَ مِنْها مُقْلَةً ومُقَلَّدًا    إذا جُلِيَتْ لم يُستطاعُ اجْتِلاؤُها"
  },
  {
   "verse_index": 17,
   "sadr": "وتَبْسِمُ عنْ غُرٍّ عِذابٍ كأنَّها",
   "ajuz": "أقاحٍ حَكَتْها يَوْمَ دَجْنٍ سَمَاؤها",
   "text": "وتَبْسِمُ عنْ غُرٍّ عِذابٍ كأنَّها    أقاحٍ حَكَتْها يَوْمَ دَجْنٍ سَمَاؤها"
  },
  {
   "verse_index": 18,
   "sadr": "إذا اندَفَعَتْ تَمْشي الهُوينى كأنَّها",
   "ajuz": "قَناةٌ تَعَلَّتْ لِينُها واستِواؤُها",
   "text": "إذا اندَفَعَتْ تَمْشي الهُوينى كأنَّها    قَناةٌ تَعَلَّتْ لِينُها واستِواؤُها"
  },
  {
   "verse_index": 19,
   "sadr": "إذا قَعَدتْ في البيتِ يُشْرِقُ بَيْتُها",
   "ajuz": "وإنْ بَرَزَتْ يَزْدادُ حُسْنًا فِناؤُها",
   "text": "إذا قَعَدتْ في البيتِ يُشْرِقُ بَيْتُها    وإنْ بَرَزَتْ يَزْدادُ حُسْنًا فِناؤُها"
  },
  {
   "verse_index": 20,
   "sadr": "قَطُوفٌ أَلوفٌ لِلْحِجالِ يَزينُها",
   "ajuz": "معَ الدَّلِّ منها جِسْمُها وحَياؤُها",
   "text": "قَطُوفٌ أَلوفٌ لِلْحِجالِ يَزينُها    معَ الدَّلِّ منها جِسْمُها وحَياؤُها"
  },
  {
   "verse_index": 21,
   "sadr": "مُنَعَّمَةٌ لَيْسَتْ بِسَوْداءَ سَلْفَعٍ",
   "ajuz": "طَويلٌ لِجيرانِ البُيُوتِ نِداؤُها",
   "text": "مُنَعَّمَةٌ لَيْسَتْ بِسَوْداءَ سَلْفَعٍ    طَويلٌ لِجيرانِ البُيُوتِ نِداؤُها"
  },
  {
   "verse_index": 22,
   "sadr": "فَدَتْكِ مِن النّسْوانِ كلُّ شَريرَةٍ",
   "ajuz": "صَخُوبٍ كَثيرٍ فُحْشُها وبَذاؤُها",
   "text": "فَدَتْكِ مِن النّسْوانِ كلُّ شَريرَةٍ    صَخُوبٍ كَثيرٍ فُحْشُها وبَذاؤُها"
  },
  {
   "verse_index": 23,
   "sadr": "فَهذا ثَنائي إنْ نَأَتْ وإذا دَنَتْ",
   "ajuz": "فَكيْفَ عَلَيْنا لَيْتَ شِعْري ثَناؤُها",
   "text": "فَهذا ثَنائي إنْ نَأَتْ وإذا دَنَتْ    فَكيْفَ عَلَيْنا لَيْتَ شِعْري ثَناؤُها"
  }
