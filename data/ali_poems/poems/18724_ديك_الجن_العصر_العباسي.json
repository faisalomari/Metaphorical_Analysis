   "text": "آمَنُ مَنْ كانَ لصَرْفِ الرَّدى    أنْزَلَها مِنْ جَوِّها مُنْزِلُ"
  },
  {
   "verse_index": 12,
   "sadr": "والدَّهْرُ لا يَحْجُبُهُ مانِعٌ",
   "ajuz": "يَحْجُبُهُ العامِلُ والمُنْصُلُ",
