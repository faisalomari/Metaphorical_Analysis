 "verses": [
  {
   "verse_index": 1,
   "sadr": "نَغْفُلُ والأَيَّامُ لا تَغْفُلُ",
   "ajuz": "ولا لنا من زَمَنٍ مَوئِلُ",
   "text": "نَغْفُلُ والأَيَّامُ لا تَغْفُلُ    ولا لنا من زَمَنٍ مَوئِلُ"
  },
  {
   "verse_index": 2,
   "sadr": "والدَّهْرُ لَا يَسلَمُ من صَرْفِهِ",
   "ajuz": "أعْصَمُ في القُنَّةِ مُسْتَوْعِلُ",
   "text": "والدَّهْرُ لَا يَسلَمُ من صَرْفِهِ    أعْصَمُ في القُنَّةِ مُسْتَوْعِلُ"
  },
  {
   "verse_index": 3,
   "sadr": "يَتخِذُ الشِّعْرى شِعارًا لَهُ",
   "ajuz": "كأنَّما الأُفْقُ لهُ مَنْزِلُ",
   "text": "يَتخِذُ الشِّعْرى شِعارًا لَهُ    كأنَّما الأُفْقُ لهُ مَنْزِلُ"
  },
  {
   "verse_index": 4,
   "sadr": "كأنَّهُ بَيْنَ شَناظِيرِها",
   "ajuz": "بارِقَةٌ تَكْمُنُ أوْ تَمْثُلُ",
   "text": "كأنَّهُ بَيْنَ شَناظِيرِها    بارِقَةٌ تَكْمُنُ أوْ تَمْثُلُ"
  },
  {
   "verse_index": 5,
   "sadr": "ولا حَبَابٌ صَلَتانُ السُّرَى",
   "ajuz": "أرْفَمُ لا يَفْرَقُ ما يَجْهَلُ",
   "text": "ولا حَبَابٌ صَلَتانُ السُّرَى    أرْفَمُ لا يَفْرَقُ ما يَجْهَلُ"
  },
  {
   "verse_index": 6,
   "sadr": "نَضْنَاضُ فَيْفَاءَ يُرَى أنَّهُ",
   "ajuz": "بالرَّمْلِ غانٍ وَهوَ المُرْمِلُ",
   "text": "نَضْنَاضُ فَيْفَاءَ يُرَى أنَّهُ    بالرَّمْلِ غانٍ وَهوَ المُرْمِلُ"
  },
  {
   "verse_index": 7,
   "sadr": "يَطْلُبُ مِنْ فَاجِئَةٍ مَعْقِلًا",
   "ajuz": "وهو لما يَطلُبُ لا يَعْقِلُ",
   "text": "يَطْلُبُ مِنْ فَاجِئَةٍ مَعْقِلًا    وهو لما يَطلُبُ لا يَعْقِلُ"
  },
  {
   "verse_index": 8,
   "sadr": "والدَّهْرُ لا يَأْمَنُ من صَرْفِهِ",
   "ajuz": "مُسَرْبَلٌ بالسَّرْدِ مُسْتَبْسِلُ",
   "text": "والدَّهْرُ لا يَأْمَنُ من صَرْفِهِ    مُسَرْبَلٌ بالسَّرْدِ مُسْتَبْسِلُ"
  },
  {
   "verse_index": 9,
   "sadr": "ولا عَقَنْبَاةُ السُّلامى لها",
   "ajuz": "في كُلِّ أُفْقٍ عَلَقٌ مُهْمَلُ",
   "text": "ولا عَقَنْبَاةُ السُّلامى لها    في كُلِّ أُفْقٍ عَلَقٌ مُهْمَلُ"
  },
  {
   "verse_index": 10,
   "sadr": "فَتْخَاءُ في الجَوِّ خُدارِيَّةٌ",
