 "verses": [
  {
   "verse_index": 1,
   "sadr": "أُعَالِجُ مِنْ نَفْسِي بَقايا حُشاشَةٍ",
   "ajuz": "على رَمَقٍ والعائداتُ تعودُ",
   "text": "أُعَالِجُ مِنْ نَفْسِي بَقايا حُشاشَةٍ    على رَمَقٍ والعائداتُ تعودُ"
  },
  {
   "verse_index": 2,
   "sadr": "فإِنْ ذُكِرَتْ لُبنى هَشَشْتُ لِذِكرها",
   "ajuz": "كما هَشَّ للثَّدِي الدَّرورِ وَلِيدُ",
   "text": "فإِنْ ذُكِرَتْ لُبنى هَشَشْتُ لِذِكرها    كما هَشَّ للثَّدِي الدَّرورِ وَلِيدُ"
  },
  {
   "verse_index": 3,
   "sadr": "أُجِيبُ بِلُبْنى مَنْ دَعانِي تَجَلُّدًا",
   "ajuz": "وَبِي زَفَراتٌ تَنْجَلِي وَتَعُودُ",
   "text": "أُجِيبُ بِلُبْنى مَنْ دَعانِي تَجَلُّدًا    وَبِي زَفَراتٌ تَنْجَلِي وَتَعُودُ"
  },
  {
   "verse_index": 4,
   "sadr": "تُعِيدُ إِلى رُوحِي الحَيَاةَ وإِنَّنِي",
   "ajuz": "بِنَفْسِي لو عايَنْتَنِي لأَجْوَدُ",
   "text": "تُعِيدُ إِلى رُوحِي الحَيَاةَ وإِنَّنِي    بِنَفْسِي لو عايَنْتَنِي لأَجْوَدُ"
  },
  {
   "verse_index": 5,
   "sadr": "أَلا لَيْتَ أَيّامًا مضين تَعودُ",
   "ajuz": "فإِنْ عُدْنَ يومًا إنَّني لَسَعِيدُ",
   "text": "أَلا لَيْتَ أَيّامًا مضين تَعودُ    فإِنْ عُدْنَ يومًا إنَّني لَسَعِيدُ"
  },
  {
   "verse_index": 6,
   "sadr": "سَقى دارَ لُبْنى حيث حَلَّتْ وَخَيَّمَتْ",
   "ajuz": "مِنَ الأَرْضِ مُنْهَلُّ الغَمامِ رَعيدُ",
   "text": "سَقى دارَ لُبْنى حيث حَلَّتْ وَخَيَّمَتْ    مِنَ الأَرْضِ مُنْهَلُّ الغَمامِ رَعيدُ"
  },
  {
   "verse_index": 7,
   "sadr": "على كُلِّ حالٍ إِنْ دَنَتْ أَو تَباعَدَتْ",
   "ajuz": "فإِنْ تَدْنُ مِنَّا فالدُّنُوُّ مَزِيدُ",
   "text": "على كُلِّ حالٍ إِنْ دَنَتْ أَو تَباعَدَتْ    فإِنْ تَدْنُ مِنَّا فالدُّنُوُّ مَزِيدُ"
  },
  {
   "verse_index": 8,
   "sadr": "فَلا اليأْسُ يُسْلِيني وَلا القُرْبُ نافِعِي",
   "ajuz": "وَلُبْنى مَنُوع ما تَكادُ تَجُودُ",
   "text": "فَلا اليأْسُ يُسْلِيني وَلا القُرْبُ نافِعِي    وَلُبْنى مَنُوع ما تَكادُ تَجُودُ"
  },
  {
   "verse_index": 9,
   "sadr": "كأَنِّي مِنْ لُبْنى سليمٌ مُسَهَّدٌ",
   "ajuz": "يَظَلُّ على أَيْدِي الرِّجالِ يُمِيدُ",
   "text": "كأَنِّي مِنْ لُبْنى سليمٌ مُسَهَّدٌ    يَظَلُّ على أَيْدِي الرِّجالِ يُمِيدُ"
  },
  {
   "verse_index": 10,
   "sadr": "رَمَتْنِي لُبَيْنى في الفُؤادِ بِسَهْمِها",
   "ajuz": "وَسَهْمُ لبينى للفُؤادِ صَيُودُ",
   "text": "رَمَتْنِي لُبَيْنى في الفُؤادِ بِسَهْمِها    وَسَهْمُ لبينى للفُؤادِ صَيُودُ"
  },
  {
   "verse_index": 11,
   "sadr": "سَلا كُلُّ ذِي شجوٍ علمتُ مكانَهُ",
   "ajuz": "وقلبي للبنى ما حيَيتُ ودودُ",
   "text": "سَلا كُلُّ ذِي شجوٍ علمتُ مكانَهُ    وقلبي للبنى ما حيَيتُ ودودُ"
  },
  {
   "verse_index": 12,
   "sadr": "وقائلةٍ: قد ماتَ، أَو هو مَيِّتٌ",
   "ajuz": "وللنَّفْسِ مِنِّي أَنْ تَفِيضَ رَصِيدُ",
   "text": "وقائلةٍ: قد ماتَ، أَو هو مَيِّتٌ    وللنَّفْسِ مِنِّي أَنْ تَفِيضَ رَصِيدُ"
  },
  {
   "verse_index": 13,
