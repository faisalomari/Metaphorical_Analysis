 "verses": [
  {
   "verse_index": 1,
   "sadr": "أَلَمْ يَأْنِ تَرْكي لا عَليَّ ولا لِيَا",
   "ajuz": "وعَزْمِي على ما فيهِ إِصلاحُ حالِيَا؟",
   "text": "أَلَمْ يَأْنِ تَرْكي لا عَليَّ ولا لِيَا    وعَزْمِي على ما فيهِ إِصلاحُ حالِيَا؟"
  },
  {
   "verse_index": 2,
   "sadr": "وَقَدْ نالَ منِّي الشَّيْبُ وابيضَّ مَفْرِقي",
   "ajuz": "وغَالَتْ سَوَادِي شُهْبَة ٌ في قَذَالِيا!",
   "text": "وَقَدْ نالَ منِّي الشَّيْبُ وابيضَّ مَفْرِقي    وغَالَتْ سَوَادِي شُهْبَة ٌ في قَذَالِيا!"
  },
  {
   "verse_index": 3,
   "sadr": "وحالَتْ بيَ الحَالاتُ عَمّا عَهِدْتُها",
   "ajuz": "بِكَرِّ اللَّيالي واللَّيالي كَماهِيَا!",
   "text": "وحالَتْ بيَ الحَالاتُ عَمّا عَهِدْتُها    بِكَرِّ اللَّيالي واللَّيالي كَماهِيَا!"
  },
  {
   "verse_index": 4,
   "sadr": "أُصَوِّتُ بالدُّنيا وليسَتْ تُجِيبُني",
   "ajuz": "أُحاوِلُ أَنْ أَبقَى وكيفَ بَقَائِيَا؟",
   "text": "أُصَوِّتُ بالدُّنيا وليسَتْ تُجِيبُني    أُحاوِلُ أَنْ أَبقَى وكيفَ بَقَائِيَا؟"
  },
  {
   "verse_index": 5,
   "sadr": "وما تَبْرَحُ الأَيَّامُ تَحْذِفُ مُدّتي",
   "ajuz": "بعَدِّ حِسابٍ لا كَعَدِّ حِسَابِيَا",
   "text": "وما تَبْرَحُ الأَيَّامُ تَحْذِفُ مُدّتي    بعَدِّ حِسابٍ لا كَعَدِّ حِسَابِيَا"
  },
  {
   "verse_index": 6,
   "sadr": "لِتَمْحُوَ آثارِي وتُخْلِقَ جِدَّتي",
   "ajuz": "وتُخْليَ مِنْ رَبْعي بِكُرْهٍ مَكانِيَا",
   "text": "لِتَمْحُوَ آثارِي وتُخْلِقَ جِدَّتي    وتُخْليَ مِنْ رَبْعي بِكُرْهٍ مَكانِيَا"
  },
  {
   "verse_index": 7,
   "sadr": "كما فَعَلَتْ قَبْلي بِطَسْمٍ وجُرْهُمٍ",
   "ajuz": "وَآلِ ثَمُودٍ بعدَ عادِ بنِ عَادِيا",
   "text": "كما فَعَلَتْ قَبْلي بِطَسْمٍ وجُرْهُمٍ    وَآلِ ثَمُودٍ بعدَ عادِ بنِ عَادِيا"
  },
  {
   "verse_index": 8,
   "sadr": "وأَبقَى صَرِيعاً بينَ أَهْلي جَنَازَة ً",
   "ajuz": "وَيَحْوِي ذَوُو المِيراثِ خالِصَ مَالِيَا",
   "text": "وأَبقَى صَرِيعاً بينَ أَهْلي جَنَازَة ً    وَيَحْوِي ذَوُو المِيراثِ خالِصَ مَالِيَا"
  },
  {
   "verse_index": 9,
   "sadr": "أَقُولُ لِنَفْسي حينَ مالَتْ بِصَغْوها",
   "ajuz": "إِلى خَطَرات قَدْ نَتَجْنَ أَمانِيَا",
   "text": "أَقُولُ لِنَفْسي حينَ مالَتْ بِصَغْوها    إِلى خَطَرات قَدْ نَتَجْنَ أَمانِيَا"
  },
  {
   "verse_index": 10,
   "sadr": "أَليسَ اللَّيالي غاصِباتي بِمُهجتي",
   "ajuz": "كما غَصَبَتْ قَبْلي القرونُ الخَوالِيَا؟",
   "text": "أَليسَ اللَّيالي غاصِباتي بِمُهجتي    كما غَصَبَتْ قَبْلي القرونُ الخَوالِيَا؟"
  },
  {
   "verse_index": 11,
   "sadr": "ومُسْكِنَتي لَحْداً لَدَى حُفْرة ٍ بها",
   "ajuz": "يَطُولُ إِلى أُخْرى اللّيالي ثَوائِيَا؟",
   "text": "ومُسْكِنَتي لَحْداً لَدَى حُفْرة ٍ بها    يَطُولُ إِلى أُخْرى اللّيالي ثَوائِيَا؟"
  },
  {
   "verse_index": 12,
   "sadr": "كمَا أَسكَنَتْ سَاماً وحاماً ويافثًا",
   "ajuz": "ونُوحًا وَمَنْ أَضحى بمكَّة َ ثَاوِيَا؟",
   "text": "كمَا أَسكَنَتْ سَاماً وحاماً ويافثًا    ونُوحًا وَمَنْ أَضحى بمكَّة َ ثَاوِيَا؟"
  },
  {
   "verse_index": 13,
   "sadr": "فقَدْ أَنِسَتْ بالمَوْتِ نَفْسي لأَنَّني",
   "ajuz": "رَأَيْتُ المَنايا يَخْتَرِمْنَ حَيَاتِيَا",
   "text": "فقَدْ أَنِسَتْ بالمَوْتِ نَفْسي لأَنَّني    رَأَيْتُ المَنايا يَخْتَرِمْنَ حَيَاتِيَا"
  },
  {
   "verse_index": 14,
   "sadr": "فيا لَيْتَني مِنْ بَعْدِ مَوْتي ومَبْعثي",
   "ajuz": "أَكونُ رُفاتاً لا عَليَّ ولا لِيَا",
   "text": "فيا لَيْتَني مِنْ بَعْدِ مَوْتي ومَبْعثي    أَكونُ رُفاتاً لا عَليَّ ولا لِيَا"
  },
  {
   "verse_index": 15,
   "sadr": "أَخافُ إِلاهِي ثُمَّ أَرجو نَوالَه",
   "ajuz": "ولكنَّ خَوْفِي قاهِرٌ لِرَجَائِيَا!",
   "text": "أَخافُ إِلاهِي ثُمَّ أَرجو نَوالَه    ولكنَّ خَوْفِي قاهِرٌ لِرَجَائِيَا!"
  },
  {
   "verse_index": 16,
   "sadr": "ولوْلا رَجائي واتِّكالي على الذي",
   "ajuz": "تَوَحَّدَ لي بالصُّنْعِ كَهْلاً وناشِيَا",
   "text": "ولوْلا رَجائي واتِّكالي على الذي    تَوَحَّدَ لي بالصُّنْعِ كَهْلاً وناشِيَا"
  },
  {
   "verse_index": 17,
   "sadr": "لَما سَاغَ لي عَذْبٌ مِنَ الماءِ بارِدٌ",
   "ajuz": "ولا طابَ لي عَيْشٌ ولا زِلْتُ باكِيَا",
   "text": "لَما سَاغَ لي عَذْبٌ مِنَ الماءِ بارِدٌ    ولا طابَ لي عَيْشٌ ولا زِلْتُ باكِيَا"
  },
  {
   "verse_index": 18,
   "sadr": "على إِثْرِ ما قَدْ كانَ مِنّي صَبَابَة ً",
   "ajuz": "لياليَ فيها كنتُ للَّهِ عاصِيَا",
   "text": "على إِثْرِ ما قَدْ كانَ مِنّي صَبَابَة ً    لياليَ فيها كنتُ للَّهِ عاصِيَا"
  },
  {
   "verse_index": 19,
   "sadr": "فإِِني جَدِيرٌ أَنْ أَخافَ وأَتَّقي",
   "ajuz": "وإِنْ كُُنْتُ لم أُشرِكْ بِذِي العَرْشِ ثانِيَا",
   "text": "فإِِني جَدِيرٌ أَنْ أَخافَ وأَتَّقي    وإِنْ كُُنْتُ لم أُشرِكْ بِذِي العَرْشِ ثانِيَا"
  },
  {
   "verse_index": 20,
   "sadr": "وأَدَّخِرَ التَّقْوى بِمَجْهُودِ طَاقَتي",
   "ajuz": "وأَرْكَبَ في رُشْدِي خِلافَ هَوائِيَا",
   "text": "وأَدَّخِرَ التَّقْوى بِمَجْهُودِ طَاقَتي    وأَرْكَبَ في رُشْدِي خِلافَ هَوائِيَا"
  }
