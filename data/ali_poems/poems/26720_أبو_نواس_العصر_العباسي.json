 "verses": [
  {
   "verse_index": 1,
   "sadr": "وخمّارةٍ للَّهْو فيها بَقِيّةٌ",
   "ajuz": "إِليها ثَلاثًا نحو حانتها سِرْنا",
   "text": "وخمّارةٍ للَّهْو فيها بَقِيّةٌ    إِليها ثَلاثًا نحو حانتها سِرْنا"
  },
  {
   "verse_index": 2,
   "sadr": "وللَّيْل حِلْبابٌ علينا وحَوْلَنا",
   "ajuz": "فمَا إِن تَرى إِنْسًا لدينا ولا جِنّا",
   "text": "وللَّيْل حِلْبابٌ علينا وحَوْلَنا    فمَا إِن تَرى إِنْسًا لدينا ولا جِنّا"
  },
  {
   "verse_index": 3,
   "sadr": "يسايِرنا إِلّا سَماءً نُجومُها",
   "ajuz": "معلَّقةٌ فيها إِلى حيثُ وجّهْنا",
   "text": "يسايِرنا إِلّا سَماءً نُجومُها    معلَّقةٌ فيها إِلى حيثُ وجّهْنا"
  },
  {
   "verse_index": 4,
   "sadr": "إِلى أَن طرقْنا بابَها بعد هَجْعةٍ",
   "ajuz": "فقالتْ: مَن الطُّرّاقُ؟ قُلْنا لها: إِنّا",
   "text": "إِلى أَن طرقْنا بابَها بعد هَجْعةٍ    فقالتْ: مَن الطُّرّاقُ؟ قُلْنا لها: إِنّا"
  },
  {
   "verse_index": 5,
   "sadr": "شَبابٌ تَعارَفْنا ببابكِ لَم نكُنْ",
   "ajuz": "نروح بما رُحْنا إِليكِ فأَدلجْنا",
   "text": "شَبابٌ تَعارَفْنا ببابكِ لَم نكُنْ    نروح بما رُحْنا إِليكِ فأَدلجْنا"
  },
  {
   "verse_index": 6,
   "sadr": "فإِن لم تُجيبينا تبدّد شَمْلُنا",
   "ajuz": "وإِن تجمَعينا بالمُدام تواصلْنا",
   "text": "فإِن لم تُجيبينا تبدّد شَمْلُنا    وإِن تجمَعينا بالمُدام تواصلْنا"
  },
  {
   "verse_index": 7,
   "sadr": "فقالتْ لنا: أَهْلًا وسَهْلًا ومَرْحبًا",
   "ajuz": "بفِتْيانِ صِدْقٍ ما أَرَى بهمُ أَفْنا",
   "text": "فقالتْ لنا: أَهْلًا وسَهْلًا ومَرْحبًا    بفِتْيانِ صِدْقٍ ما أَرَى بهمُ أَفْنا"
  },
  {
   "verse_index": 8,
   "sadr": "دخلْنا عليها واثقين بجودها",
   "ajuz": "فلمّا رأَتْنا كفّرتْ ثُمَّ حيّتْنا",
   "text": "دخلْنا عليها واثقين بجودها    فلمّا رأَتْنا كفّرتْ ثُمَّ حيّتْنا"
  },
  {
   "verse_index": 9,
   "sadr": "فقُلْنا لها: كيلي حِسابًا مقوَّمًا",
   "ajuz": "دَواريقَ خَمْرٍ ما نقصْتِ وما زِدْنا!",
   "text": "فقُلْنا لها: كيلي حِسابًا مقوَّمًا    دَواريقَ خَمْرٍ ما نقصْتِ وما زِدْنا!"
  },
  {
   "verse_index": 10,
   "sadr": "فجاءتْ بها كالشَّمْس يحكي شُعاعُها",
   "ajuz": "شُعاعَ الثُّرَيّا في الزُّجاج لنا حُسْنا",
   "text": "فجاءتْ بها كالشَّمْس يحكي شُعاعُها    شُعاعَ الثُّرَيّا في الزُّجاج لنا حُسْنا"
  },
  {
   "verse_index": 11,
   "sadr": "فقُلْنا لها: ما الاسْمُ والسِّعْرُ؟ بيِّني",
   "ajuz": "لنا سِعْرَها حتّى نزورَكِ ما عِشْنا!",
   "text": "فقُلْنا لها: ما الاسْمُ والسِّعْرُ؟ بيِّني    لنا سِعْرَها حتّى نزورَكِ ما عِشْنا!"
  },
  {
   "verse_index": 12,
   "sadr": "فقالتْ لنا: مَيْجونُ إِسْمي وسِعْرُها",
   "ajuz": "ثَلاثٌ بتِسْعٍ هكذا غَيْرَكم بِعْنا",
   "text": "فقالتْ لنا: مَيْجونُ إِسْمي وسِعْرُها    ثَلاثٌ بتِسْعٍ هكذا غَيْرَكم بِعْنا"
  },
  {
   "verse_index": 13,
   "sadr": "ولمّا تولَّى اللَّيْلُ أَو كاد أَقبلتْ",
   "ajuz": "إِلينا بميزانٍ لِننقُدَها الوَزْنا",
   "text": "ولمّا تولَّى اللَّيْلُ أَو كاد أَقبلتْ    إِلينا بميزانٍ لِننقُدَها الوَزْنا"
  },
  {
   "verse_index": 14,
   "sadr": "فقُلْنا لها: جِئْنا وفي المال قِلّةٌ",
   "ajuz": "فهل لكِ في أَن تقبَلي بَعْضَنا رَهْنا؟",
   "text": "فقُلْنا لها: جِئْنا وفي المال قِلّةٌ    فهل لكِ في أَن تقبَلي بَعْضَنا رَهْنا؟"
  },
  {
   "verse_index": 15,
