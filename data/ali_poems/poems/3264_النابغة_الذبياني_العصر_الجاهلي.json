  {
   "verse_index": 1,
   "sadr": "ودّعْ أُمامةَ، والتّوديعُ تعذيرُ،",
   "ajuz": "وما وَداعُكَ مَنْ قَفّتْ به العِيرُ",
   "text": "ودّعْ أُمامةَ، والتّوديعُ تعذيرُ،    وما وَداعُكَ مَنْ قَفّتْ به العِيرُ"
  },
  {
   "verse_index": 2,
   "sadr": "وما رأيتُكَ إلا نظرةً عرضت،",
   "ajuz": "يومَ النِّمارةِ، والمأمورُ مأمورُ",
   "text": "وما رأيتُكَ إلا نظرةً عرضت،    يومَ النِّمارةِ، والمأمورُ مأمورُ"
  },
  {
   "verse_index": 3,
   "sadr": "إن القُفولَ إلى حيٍّ، وإن بَعُدوا،",
   "ajuz": "أمسَوا، ودونَهُمُ ثَهْلانُ فالنِّيرُ",
   "text": "إن القُفولَ إلى حيٍّ، وإن بَعُدوا،    أمسَوا، ودونَهُمُ ثَهْلانُ فالنِّيرُ"
  },
  {
   "verse_index": 4,
   "sadr": "هل تُبَلّغنيهمُ حرفٌ مُصَرّمَةٌ،",
   "ajuz": "أُجْدُ الفّقارِ، وإدلاجٌ وتهجيرُ",
   "text": "هل تُبَلّغنيهمُ حرفٌ مُصَرّمَةٌ،    أُجْدُ الفّقارِ، وإدلاجٌ وتهجيرُ"
  },
  {
   "verse_index": 5,
   "sadr": "قد عُرّيتْ نصفَ حولٍ أشهراً جُدُداً",
   "ajuz": "يسفي، على رحلها، بالحيرَة، المورُ",
   "text": "قد عُرّيتْ نصفَ حولٍ أشهراً جُدُداً    يسفي، على رحلها، بالحيرَة، المورُ"
  },
  {
   "verse_index": 6,
   "sadr": "وقارَفَتْ، وهْيَ لم تجرَبْ، وباعَ لها",
   "ajuz": "من الفصافصِ، بالنُّمِّيّ، سِفسيرُ",
   "text": "وقارَفَتْ، وهْيَ لم تجرَبْ، وباعَ لها    من الفصافصِ، بالنُّمِّيّ، سِفسيرُ"
  },
  {
   "verse_index": 7,
   "sadr": "ليست ترى حولها إلفاً، وراكِبُها",
   "ajuz": "نشوانُ، في جَوّةِ الباغوثِ، مخمورُ",
   "text": "ليست ترى حولها إلفاً، وراكِبُها    نشوانُ، في جَوّةِ الباغوثِ، مخمورُ"
  },
  {
   "verse_index": 8,
   "sadr": "تُلقي الإوَزّينَ، في أكنافِ دارتها،",
   "ajuz": "بَيْضًا، وبين يديها التّبنُ منشورُ",
   "text": "تُلقي الإوَزّينَ، في أكنافِ دارتها،    بَيْضًا، وبين يديها التّبنُ منشورُ"
  },
  {
   "verse_index": 9,
   "sadr": "لولا الهُمامُ الذي تُرْجى نوافِلُهُ،",
   "ajuz": "لَقالَ راكبُها في عُصْبَةٍ: سيروُا",
   "text": "لولا الهُمامُ الذي تُرْجى نوافِلُهُ،    لَقالَ راكبُها في عُصْبَةٍ: سيروُا"
  },
  {
   "verse_index": 10,
   "sadr": "كأنها خاضِبٌ أظلافهُ، لَهِقٌ،",
   "ajuz": "قَهْدُ الإهابِ، ترَبّتْه الزّنانيرُ",
   "text": "كأنها خاضِبٌ أظلافهُ، لَهِقٌ،    قَهْدُ الإهابِ، ترَبّتْه الزّنانيرُ"
  },
  {
   "verse_index": 11,
   "sadr": "أصاخَ من نبأةٍ، أصغى لها أُذُناً،",
   "ajuz": "صِماخُها، بدخيسِ الرّوْقِ، مستورُ",
   "text": "أصاخَ من نبأةٍ، أصغى لها أُذُناً،    صِماخُها، بدخيسِ الرّوْقِ، مستورُ"
  },
  {
   "verse_index": 12,
   "sadr": "من حِسّ أطلسَ، تسعى تحته شِرَعٌ",
   "ajuz": "كأنّ أحناكها السّفلى مآشيرُ",
   "text": "من حِسّ أطلسَ، تسعى تحته شِرَعٌ    كأنّ أحناكها السّفلى مآشيرُ"
