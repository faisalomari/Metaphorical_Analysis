 "verses": [
  {
   "verse_index": 1,
   "sadr": "إذا جَارَيْتَ في خُلُقٍ دَنِيئاً",
   "ajuz": "فأَنتَ ومَنْ تُجَارِيه سَواءُ",
   "text": "إذا جَارَيْتَ في خُلُقٍ دَنِيئاً    فأَنتَ ومَنْ تُجَارِيه سَواءُ"
  },
  {
   "verse_index": 2,
   "sadr": "رَأيْتُ الحُرَّ يَجْتَنِبُ المَخَازِي\t",
   "ajuz": "ويَحْمِيهِ عنِ الغَدْرِ الوَفاءُ",
   "text": "رَأيْتُ الحُرَّ يَجْتَنِبُ المَخَازِي\t    ويَحْمِيهِ عنِ الغَدْرِ الوَفاءُ"
  },
  {
   "verse_index": 3,
   "sadr": "وما مِنْ شِدَّة ٍ إلاَّ سَيأْتي\t",
   "ajuz": "لَها مِنْ بعدِ شِدَّتها رَخاءُ",
   "text": "وما مِنْ شِدَّة ٍ إلاَّ سَيأْتي\t    لَها مِنْ بعدِ شِدَّتها رَخاءُ"
  },
  {
   "verse_index": 4,
   "sadr": "لَقَدْ جَرَّبْتُ هذا الدَّهْرَ حتَّى\t",
   "ajuz": "أفادَتْني التَّجارِبُ والعَناءُ",
   "text": "لَقَدْ جَرَّبْتُ هذا الدَّهْرَ حتَّى\t    أفادَتْني التَّجارِبُ والعَناءُ"
  },
  {
   "verse_index": 5,
   "sadr": "إذا ما رأْسُ أهلِ البَيْتِ وَلَّى\t",
   "ajuz": "بَدا لهمُ مِنَ الناسِ الجَفاءُ",
   "text": "إذا ما رأْسُ أهلِ البَيْتِ وَلَّى\t    بَدا لهمُ مِنَ الناسِ الجَفاءُ"
  },
  {
   "verse_index": 6,
   "sadr": "يَعِيش المَرْءُ ما استحيَى بِخَيرٍ\t",
   "ajuz": "ويَبْقى العُودُ ما بَقِيَ اللِّحَاءُ",
   "text": "يَعِيش المَرْءُ ما استحيَى بِخَيرٍ\t    ويَبْقى العُودُ ما بَقِيَ اللِّحَاءُ"
  },
  {
   "verse_index": 7,
   "sadr": "فَلا واللهِ ما في العَيْشِ خَيْرٌ\t",
   "ajuz": "ولا الدُّنيا إذا ذَهبَ الحَياءُ",
   "text": "فَلا واللهِ ما في العَيْشِ خَيْرٌ\t    ولا الدُّنيا إذا ذَهبَ الحَياءُ"
  },
  {
   "verse_index": 8,
   "sadr": "إذا لم تَخْشَ عاقِبة َ اللَّيالي\t",
   "ajuz": "ولَمْ تستَحْي فافعَلْ ما تَشاءُ",
   "text": "إذا لم تَخْشَ عاقِبة َ اللَّيالي\t    ولَمْ تستَحْي فافعَلْ ما تَشاءُ"
  },
  {
   "verse_index": 9,
   "sadr": "لئيمُ الفِعْلِ مِنْ قَوْمٍ كِرامٍ\t",
   "ajuz": "لهُ مِنْ بينهمْ أبداً عُوَاءُ",
   "text": "لئيمُ الفِعْلِ مِنْ قَوْمٍ كِرامٍ\t    لهُ مِنْ بينهمْ أبداً عُوَاءُ"
  }
 ],
