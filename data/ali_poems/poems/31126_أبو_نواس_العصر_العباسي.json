 "verses": [
  {
   "verse_index": 1,
   "sadr": "فديتُ مَنْ تمّ فيه الظَّرْفُ والأَدَبُ",
   "ajuz": "ومَنْ يتيه إذا ما مسّه الطَّرَبُ",
   "text": "فديتُ مَنْ تمّ فيه الظَّرْفُ والأَدَبُ    ومَنْ يتيه إذا ما مسّه الطَّرَبُ"
  },
  {
   "verse_index": 2,
   "sadr": "ما صار طَرْفي إلى تحصيلِ صورته",
   "ajuz": "إلّا تداخلني من حُسْنها عَجَبُ",
   "text": "ما صار طَرْفي إلى تحصيلِ صورته    إلّا تداخلني من حُسْنها عَجَبُ"
  },
  {
   "verse_index": 3,
   "sadr": "ورِدْفُه في قَضيب فوقه قَمَرٌ",
   "ajuz": "من نورِ خَدَّيْه ماءُ الحُسْن ينسكِبُ",
   "text": "ورِدْفُه في قَضيب فوقه قَمَرٌ    من نورِ خَدَّيْه ماءُ الحُسْن ينسكِبُ"
  },
  {
   "verse_index": 4,
   "sadr": "نَفْسي فِداؤك، يا مَنْ لا أبوح به!",
   "ajuz": "علِقتُ منك بحَبْل ليس ينقضِبُ",
   "text": "نَفْسي فِداؤك، يا مَنْ لا أبوح به!    علِقتُ منك بحَبْل ليس ينقضِبُ"
  },
  {
   "verse_index": 5,
   "sadr": "كم ساعةٍ منك خطّتْها مَلائكةٌ",
   "ajuz": "أَزهو على الناس بالذَّنْب الذي كتبوا",
   "text": "كم ساعةٍ منك خطّتْها مَلائكةٌ    أَزهو على الناس بالذَّنْب الذي كتبوا"
  },
  {
   "verse_index": 6,
   "sadr": "لم يُلهِني عنك ساقٍ أَهْيَفٌ غَنِجٌ",
   "ajuz": "مقوَّرُ الرِّدْف في أَحْشائه قَبَبُ",
   "text": "لم يُلهِني عنك ساقٍ أَهْيَفٌ غَنِجٌ    مقوَّرُ الرِّدْف في أَحْشائه قَبَبُ"
  },
  {
   "verse_index": 7,
   "sadr": "كأنّما البَدْرُ يمشي في قَراطِقه",
   "ajuz": "إلى بني الأَصْفَرِ الصُّهْبان ينتسِبُ",
   "text": "كأنّما البَدْرُ يمشي في قَراطِقه    إلى بني الأَصْفَرِ الصُّهْبان ينتسِبُ"
  },
  {
   "verse_index": 8,
   "sadr": "يُديرُ راحًا أبوها الكَرْمُ زوّجها",
   "ajuz": "من ابنِ غادية إذ أُمُّها العِنَبُ",
   "text": "يُديرُ راحًا أبوها الكَرْمُ زوّجها    من ابنِ غادية إذ أُمُّها العِنَبُ"
  },
  {
   "verse_index": 9,
   "sadr": "ولّى فغنّى لنا والنأْيُ منتحِبٌ:",
   "ajuz": "((أزائرٌ أنت؟ لا بل أنت مجتنِبُ))",
   "text": "ولّى فغنّى لنا والنأْيُ منتحِبٌ:    ((أزائرٌ أنت؟ لا بل أنت مجتنِبُ))"
  }
 ],
