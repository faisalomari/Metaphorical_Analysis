 "verses": [
  {
   "verse_index": 1,
   "sadr": "تجهَّزْ طال في النَّصَبِ الثَّواءُ\t",
   "ajuz": "ومُنْتظَرُ الثَّقِيلِ عَلَيَّ داءُ",
   "text": "تجهَّزْ طال في النَّصَبِ الثَّواءُ\t    ومُنْتظَرُ الثَّقِيلِ عَلَيَّ داءُ"
  },
  {
   "verse_index": 2,
   "sadr": "تركْتُ رِياضة النَّوْكَى قدِيماً\t",
   "ajuz": "فإنَّ رياضة النَّوكى عياءُ",
   "text": "تركْتُ رِياضة النَّوْكَى قدِيماً\t    فإنَّ رياضة النَّوكى عياءُ"
  },
  {
   "verse_index": 3,
   "sadr": "إذا ما سامنِي الخُلطاء خسْفاً",
   "ajuz": "أبيْتُ ورُبَّما نفع الإِباءُ",
   "text": "إذا ما سامنِي الخُلطاء خسْفاً    أبيْتُ ورُبَّما نفع الإِباءُ"
  },
  {
   "verse_index": 4,
   "sadr": "وإِغْضائِي علَى البزْلاء وهْنٌ\t",
   "ajuz": "ووجْه سبِيلِها رحْبٌ فضاءُ",
   "text": "وإِغْضائِي علَى البزْلاء وهْنٌ\t    ووجْه سبِيلِها رحْبٌ فضاءُ"
  },
  {
   "verse_index": 5,
   "sadr": "قَضَيْتُ لُبانَةٌ ونسأتُ أخرى",
   "ajuz": "ولِلْحاجاتِ وَرْدٌ وانقِضاءُ",
   "text": "قَضَيْتُ لُبانَةٌ ونسأتُ أخرى    ولِلْحاجاتِ وَرْدٌ وانقِضاءُ"
  },
  {
   "verse_index": 6,
   "sadr": "علَى عيْنيْ ((أبِي أيُّوب)) مِنِّي\t",
   "ajuz": "غِطاءٌ سوْف ينْكشِفُ الغِطاءُ",
   "text": "علَى عيْنيْ ((أبِي أيُّوب)) مِنِّي\t    غِطاءٌ سوْف ينْكشِفُ الغِطاءُ"
  },
  {
   "verse_index": 7,
   "sadr": "جفانِي إِذْ نزلْت عليْهِ ضَيْفاً\t",
   "ajuz": "وللِضَّيْفِ الكرامة ُ والحِباءُ",
   "text": "جفانِي إِذْ نزلْت عليْهِ ضَيْفاً\t    وللِضَّيْفِ الكرامة ُ والحِباءُ"
  },
  {
   "verse_index": 8,
   "sadr": "غداً يتعلَّمُ الفجْفاج أنِّي\t",
   "ajuz": "أسُودُ إِذا غضِبْتُ ولا أُساءُ",
