  },
  {
   "verse_index": 14,
   "sadr": "وَقَدْ عرَّضْنَ لي وَاللهُ دُونِي\t",
   "ajuz": "أعُوذُ بِهِ إِذَا عَرَضَ البَلَاءُ",
   "text": "وَقَدْ عرَّضْنَ لي وَاللهُ دُونِي\t    أعُوذُ بِهِ إِذَا عَرَضَ البَلَاءُ"
  },
  {
   "verse_index": 15,
   "sadr": "ولَوْلَا الْقَائِمُ المَهْدِي فِينَا\t",
