   "text": "نأتْ سلْمى وشطََّ بها التَّنائي\t    وقامتْ دُونَها حَكَمٌ وحَاءُ"
  },
  {
   "verse_index": 11,
   "sadr": "وأقْعَدَنِي عن الغُرِّ الغَوَانِي\t",
