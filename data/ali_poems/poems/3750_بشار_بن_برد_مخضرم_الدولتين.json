   "text": "فسِرْ فِي النَّاسِ من جارٍ لئِيم\t    إِذا .........رِضاءُ"
  },
  {
   "verse_index": 10,
   "sadr": "نأتْ سلْمى وشطََّ بها التَّنائي\t",
