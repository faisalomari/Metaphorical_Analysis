   "text": "وكمْ مِنْ هاجِرٍ لِفتاة ِ قوْم\t    وبْينهُما إذا التقيا صفاءُ"
  },
  {
   "verse_index": 20,
   "sadr": "وغَضاتُ الشَّبابِ من العذارَى\t",
