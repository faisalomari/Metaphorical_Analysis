 "verses": [
  {
   "verse_index": 1,
   "sadr": "لقد طال في رَسْمِ الدِّيار بُكائي",
   "ajuz": "وقد طال تَرْدادي بها وعَنائي",
   "text": "لقد طال في رَسْمِ الدِّيار بُكائي    وقد طال تَرْدادي بها وعَنائي"
  },
  {
   "verse_index": 2,
   "sadr": "كأنِّي مُريغٌ في الدِّيار طَريدةً",
   "ajuz": "أراها أمامي تارةً وورائي",
   "text": "كأنِّي مُريغٌ في الدِّيار طَريدةً    أراها أمامي تارةً وورائي"
  },
  {
   "verse_index": 3,
   "sadr": "فلمّا بدا لي اليَأْسُ عدَّيْتُ ناقتي",
   "ajuz": "عن الدار واستولى عليّ عَزائي",
   "text": "فلمّا بدا لي اليَأْسُ عدَّيْتُ ناقتي    عن الدار واستولى عليّ عَزائي"
  },
  {
   "verse_index": 4,
   "sadr": "إلى بَيْتِ حانٍ لا تهِرُّ كِلابُه",
   "ajuz": "عليّ ولا يُنكِرن طولَ ثَوائي",
   "text": "إلى بَيْتِ حانٍ لا تهِرُّ كِلابُه    عليّ ولا يُنكِرن طولَ ثَوائي"
  },
  {
   "verse_index": 5,
   "sadr": "فما رِمتُه حتّى أتى دون ما حوَتْ",
   "ajuz": "يَمينِيَ حتَّى رَيْطتي وحِذائي",
   "text": "فما رِمتُه حتّى أتى دون ما حوَتْ    يَمينِيَ حتَّى رَيْطتي وحِذائي"
  },
  {
   "verse_index": 6,
   "sadr": "فإن تكن الصَّهْباءُ أوْدتْ بتالدي",
   "ajuz": "فلم تُنسِني أُكْرومتي وحَيائي",
   "text": "فإن تكن الصَّهْباءُ أوْدتْ بتالدي    فلم تُنسِني أُكْرومتي وحَيائي"
  },
  {
   "verse_index": 7,
   "sadr": "وكَأْسٍ كمِصْباحِ السَّماء شرِبتُها",
   "ajuz": "على قُبْلة أو مَوْعِدٍ بلِقاءِ",
   "text": "وكَأْسٍ كمِصْباحِ السَّماء شرِبتُها    على قُبْلة أو مَوْعِدٍ بلِقاءِ"
  },
  {
   "verse_index": 8,
   "sadr": "أتتْ دونها الأيّامُ حتّى كأنّها",
   "ajuz": "تساقُطُ نور من فُتوق سَماءِ",
   "text": "أتتْ دونها الأيّامُ حتّى كأنّها    تساقُطُ نور من فُتوق سَماءِ"
  },
  {
   "verse_index": 9,
   "sadr": "ترى ضَوْءَها من ظاهِر الكَأْس ساطعًا",
   "ajuz": "عليك ولو غطَّيْتَها بغِطاءِ",
   "text": "ترى ضَوْءَها من ظاهِر الكَأْس ساطعًا    عليك ولو غطَّيْتَها بغِطاءِ"
  },
  {
   "verse_index": 10,
   "sadr": "تبارك مَن ساس الأُمورَ بقُدْرة",
   "ajuz": "وفضّل هارونًا على الخُلَفاءِ",
   "text": "تبارك مَن ساس الأُمورَ بقُدْرة    وفضّل هارونًا على الخُلَفاءِ"
  },
  {
   "verse_index": 11,
   "sadr": "نعيش بخَيْرٍ ما انطوَيْنا على التُّقى",
   "ajuz": "وما ساس دُنْيانا أبُو الأُمَناءِ",
   "text": "نعيش بخَيْرٍ ما انطوَيْنا على التُّقى    وما ساس دُنْيانا أبُو الأُمَناءِ"
  },
  {
   "verse_index": 12,
   "sadr": "إمامٌ يخاف اللهَ حتّى كأنّما",
