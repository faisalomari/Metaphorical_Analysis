 "verses": [
  {
   "verse_index": 1,
   "sadr": "دعانا أبو عَمْرٍو عميرُ بنُ جَعْفَرٍ",
   "ajuz": "على لَحْمِ ديكٍ دَعوَةً بَعْدَ مَوْعِدِ",
   "text": "دعانا أبو عَمْرٍو عميرُ بنُ جَعْفَرٍ    على لَحْمِ ديكٍ دَعوَةً بَعْدَ مَوْعِدِ"
  },
  {
   "verse_index": 2,
   "sadr": "فَقَدَّمَ ديكًا عُدَّ دَهْرًا ذملّقًا",
   "ajuz": "مؤَنِّسَ أبْياتٍ مُؤَذِّنَ مَسْجِدِ",
   "text": "فَقَدَّمَ ديكًا عُدَّ دَهْرًا ذملّقًا    مؤَنِّسَ أبْياتٍ مُؤَذِّنَ مَسْجِدِ"
  },
  {
   "verse_index": 3,
   "sadr": "يُحَدِّثنا عَنْ قوم هُودٍ وصالِحٍ",
   "ajuz": "وأغرب ما لاقاهُ عمرو بن مرثدِ",
   "text": "يُحَدِّثنا عَنْ قوم هُودٍ وصالِحٍ    وأغرب ما لاقاهُ عمرو بن مرثدِ"
  },
  {
   "verse_index": 4,
   "sadr": "وقال لقد سَبَّحْتُ دهرًا مهلِّلًا",
   "ajuz": "وأسْهَرْتُ بالتَّأْذينِ أعْيُنَ هُجَّدِ",
   "text": "وقال لقد سَبَّحْتُ دهرًا مهلِّلًا    وأسْهَرْتُ بالتَّأْذينِ أعْيُنَ هُجَّدِ"
  },
  {
   "verse_index": 5,
   "sadr": "أَيُذْبَحُ بين المُسلمينِ مُؤَذِّنٌ",
   "ajuz": "مقيمٌ على دِينِ النَّبيِّ مُحَمَّدِ",
   "text": "أَيُذْبَحُ بين المُسلمينِ مُؤَذِّنٌ    مقيمٌ على دِينِ النَّبيِّ مُحَمَّدِ"
  },
  {
   "verse_index": 6,
   "sadr": "فَقُلْتُ له: يا ديكُ إنَّكَ صادِقٌ",
   "ajuz": "وإنَّك فيما قُلت غَيْرُ مُفَنَّدِ",
   "text": "فَقُلْتُ له: يا ديكُ إنَّكَ صادِقٌ    وإنَّك فيما قُلت غَيْرُ مُفَنَّدِ"
  },
  {
   "verse_index": 7,
   "sadr": "ولا ذَنْبَ للأَضْيافِ إنْ نالكَ الرَّدى",
   "ajuz": "فإنَّ المَنايا للديوكِ بمرصَدِ",
   "text": "ولا ذَنْبَ للأَضْيافِ إنْ نالكَ الرَّدى    فإنَّ المَنايا للديوكِ بمرصَدِ"
  }
 ],
