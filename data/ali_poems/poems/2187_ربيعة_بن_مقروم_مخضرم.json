 "verses": [
  {
   "verse_index": 1,
   "sadr": "بانَتْ سُعادُ فأَمْسى القَلبُ مَعْمُودَا",
   "ajuz": "وأَخْلَفَتْكَ ابنَةُ الحُرِّ المَوَاعِيدَا",
   "text": "بانَتْ سُعادُ فأَمْسى القَلبُ مَعْمُودَا    وأَخْلَفَتْكَ ابنَةُ الحُرِّ المَوَاعِيدَا"
  },
  {
   "verse_index": 2,
   "sadr": "كأَنَّها ظَبْيَةٌ بِكْرٌ أَطَاعَ لها",
   "ajuz": "مِن حَوْمَلٍ تَلَعَاتُ الجَوِّ أَوْ أُودَا",
   "text": "كأَنَّها ظَبْيَةٌ بِكْرٌ أَطَاعَ لها    مِن حَوْمَلٍ تَلَعَاتُ الجَوِّ أَوْ أُودَا"
  },
  {
   "verse_index": 3,
   "sadr": "قامَتْ تُرِيكَ غَدَاة البَيْنِ مُنْسَدِلاً",
   "ajuz": "تَخالُهُ فَوْقَ مَتْنَيْها العَناقِيدَا",
   "text": "قامَتْ تُرِيكَ غَدَاة البَيْنِ مُنْسَدِلاً    تَخالُهُ فَوْقَ مَتْنَيْها العَناقِيدَا"
  },
  {
   "verse_index": 4,
   "sadr": "وبارِداً طَيِّباً عَذْباً مُقَبَّلُهُ",
   "ajuz": "مُخيَّفاً نَبْتُهُ بالظِّلمِ مَشْهُودَا",
   "text": "وبارِداً طَيِّباً عَذْباً مُقَبَّلُهُ    مُخيَّفاً نَبْتُهُ بالظِّلمِ مَشْهُودَا"
  },
  {
   "verse_index": 5,
   "sadr": "وجَسْرَةٍ حَرَجٍ تَدْمَى مَنَاسِمُها",
   "ajuz": "أَعْمَلْتُها بِيَ حتَّى تَقْطَعَ البِيدَا",
   "text": "وجَسْرَةٍ حَرَجٍ تَدْمَى مَنَاسِمُها    أَعْمَلْتُها بِيَ حتَّى تَقْطَعَ البِيدَا"
  },
  {
   "verse_index": 6,
   "sadr": "كَلَّفْتُها، فَرَأَتْ حقًّا تَكَلُّفَهُ",
   "ajuz": "وَدِيقَةً كأَجِيجِ النَّارِ صَيْخُودَا",
   "text": "كَلَّفْتُها، فَرَأَتْ حقًّا تَكَلُّفَهُ    وَدِيقَةً كأَجِيجِ النَّارِ صَيْخُودَا"
  },
  {
   "verse_index": 7,
   "sadr": "في مَهْمهٍ قَذَفٍ يُخْشَى الهلاَكُ بهِ",
   "ajuz": "أَصْدَاؤُهُ ما تَنِي بالليلِ تَغْرِيدَا",
   "text": "في مَهْمهٍ قَذَفٍ يُخْشَى الهلاَكُ بهِ    أَصْدَاؤُهُ ما تَنِي بالليلِ تَغْرِيدَا"
  },
  {
   "verse_index": 8,
   "sadr": "لمّا تَشَكَّتْ إِليَّ الأَيْنَ قُلتُ لها",
   "ajuz": "لا تَسْتَرِيحِينَ ما لم أَلْقَ مَسْعُودَا",
   "text": "لمّا تَشَكَّتْ إِليَّ الأَيْنَ قُلتُ لها    لا تَسْتَرِيحِينَ ما لم أَلْقَ مَسْعُودَا"
  },
  {
   "verse_index": 9,
   "sadr": "ما لم أُلاقِ امْرَأً جَزْلاً مَواهِبُهُ",
   "ajuz": "سَهْلَ الفِنَاءِ رَحِيبَ الباعِ محمُودَا",
   "text": "ما لم أُلاقِ امْرَأً جَزْلاً مَواهِبُهُ    سَهْلَ الفِنَاءِ رَحِيبَ الباعِ محمُودَا"
  },
  {
   "verse_index": 10,
   "sadr": "وقد سَمِعْتُ بقومٍ يُحْمَدُونَ فلمْ",
   "ajuz": "أَسمعْ بمثلِكَ لاَ حِلْماً ولا جُودَا",
   "text": "وقد سَمِعْتُ بقومٍ يُحْمَدُونَ فلمْ    أَسمعْ بمثلِكَ لاَ حِلْماً ولا جُودَا"
  },
  {
   "verse_index": 11,
   "sadr": "ولا عَفَافاً ولا صَبْراً لِنائِبةٍ",
   "ajuz": "وما أُنَبِّيءُ عنكَ الباطِلَ السِّيدَا",
   "text": "ولا عَفَافاً ولا صَبْراً لِنائِبةٍ    وما أُنَبِّيءُ عنكَ الباطِلَ السِّيدَا"
  },
  {
   "verse_index": 12,
   "sadr": "لا حِلْمُكَ الْحِلْمُ مَوْجُودٌ عليهِ، وَلا",
   "ajuz": "يُلْفَى عَطَاؤُكَ في الأَقوام مَنْكُودَا",
   "text": "لا حِلْمُكَ الْحِلْمُ مَوْجُودٌ عليهِ، وَلا    يُلْفَى عَطَاؤُكَ في الأَقوام مَنْكُودَا"
  },
  {
   "verse_index": 13,
   "sadr": "وقد سَبَقْتَ بِغاياتِ الجِيادِ وقد",
   "ajuz": "أَشْبَهْتَ آباءَكَ الصِّيدَ الصَّنادِيدَا",
   "text": "وقد سَبَقْتَ بِغاياتِ الجِيادِ وقد    أَشْبَهْتَ آباءَكَ الصِّيدَ الصَّنادِيدَا"
  },
  {
   "verse_index": 14,
   "sadr": "هذا ثَنَائي بما أَوْلَيْتَ مِنْ حَسَنٍ",
   "ajuz": "لا زِلْتَ عَوْضُ قَرِيرِ العَيْنِ مَحْسُودَا",
   "text": "هذا ثَنَائي بما أَوْلَيْتَ مِنْ حَسَنٍ    لا زِلْتَ عَوْضُ قَرِيرِ العَيْنِ مَحْسُودَا"
  }
