 "verses": [
  {
   "verse_index": 1,
   "sadr": "عوجوا ، فحيّوا لنُعمٍ دمنة الدّارِ،",
   "ajuz": "ماذا تُحَيّون من نُؤيٍ وأحجارِ؟",
   "text": "عوجوا ، فحيّوا لنُعمٍ دمنة الدّارِ،    ماذا تُحَيّون من نُؤيٍ وأحجارِ؟"
  },
  {
   "verse_index": 2,
   "sadr": "أقوى ، وأقفر من نُعمٍ، وغيّرَه",
   "ajuz": "هُوجُ الرّياح بهابي التُّرب، موّارِ",
   "text": "أقوى ، وأقفر من نُعمٍ، وغيّرَه    هُوجُ الرّياح بهابي التُّرب، موّارِ"
  },
  {
   "verse_index": 3,
   "sadr": "وقفت فيها، سراة اليوم، أسألها",
   "ajuz": "عن آل نُعْمٍ، أموناً، عبر أسفارِ",
   "text": "وقفت فيها، سراة اليوم، أسألها    عن آل نُعْمٍ، أموناً، عبر أسفارِ"
  },
  {
   "verse_index": 4,
   "sadr": "فاستعجمَتْ دارُ نُعْمٍ ، ما تُكلّمنا،",
   "ajuz": "والدّارُ ، لو كلّمتنا ، ذات أخبارِ",
   "text": "فاستعجمَتْ دارُ نُعْمٍ ، ما تُكلّمنا،    والدّارُ ، لو كلّمتنا ، ذات أخبارِ"
  },
  {
   "verse_index": 5,
   "sadr": "فما وجدتُ بها شيئاً ألوذُ به،",
   "ajuz": "إلا الثُّمام وإلا موقد النّارِ",
   "text": "فما وجدتُ بها شيئاً ألوذُ به،    إلا الثُّمام وإلا موقد النّارِ"
  },
  {
   "verse_index": 6,
   "sadr": "وقد أراني ونُعماً لاهيين بها،",
   "ajuz": "والدّهرُ والعيشُ لم يهمم بإمرارِ",
   "text": "وقد أراني ونُعماً لاهيين بها،    والدّهرُ والعيشُ لم يهمم بإمرارِ"
  },
  {
   "verse_index": 7,
   "sadr": "أيام تُخْبرني نُعْمٌ وأُخبرها،",
   "ajuz": "ما أكتمُ الناس من حاجي وأسراري",
   "text": "أيام تُخْبرني نُعْمٌ وأُخبرها،    ما أكتمُ الناس من حاجي وأسراري"
  },
  {
   "verse_index": 8,
   "sadr": "لولا حبائلُ من نُعْمٍ علقت بها،",
   "ajuz": "لأقْصر القلبُ عنها أي إقْصارِ",
   "text": "لولا حبائلُ من نُعْمٍ علقت بها،    لأقْصر القلبُ عنها أي إقْصارِ"
  },
  {
   "verse_index": 9,
   "sadr": "فإن أفاق ، لقد طالت عمايتُه؛",
   "ajuz": "والمرءُ يُخْلِقُ طوراً بعد أطوارِ",
   "text": "فإن أفاق ، لقد طالت عمايتُه؛    والمرءُ يُخْلِقُ طوراً بعد أطوارِ"
  },
  {
   "verse_index": 10,
   "sadr": "نُبّئتُ نُعماً ، على الهجرانِ ، عاتبةً؛",
   "ajuz": "سقياً ورعياً لذاك العاتبِ الزّاري",
   "text": "نُبّئتُ نُعماً ، على الهجرانِ ، عاتبةً؛    سقياً ورعياً لذاك العاتبِ الزّاري"
  },
  {
   "verse_index": 11,
   "sadr": "رأيتُ نعماً وأصحابي على عجلٍ ،",
   "ajuz": "والعيسُ، للبينِ، قد شُدّتْ بأكوارِ",
   "text": "رأيتُ نعماً وأصحابي على عجلٍ ،    والعيسُ، للبينِ، قد شُدّتْ بأكوارِ"
  },
  {
   "verse_index": 12,
   "sadr": "فريع قلبي ، وكانت نظرة ٌ عرضت",
   "ajuz": "حَيناً ، وتوفيق أقدارٍ لأقدارِ",
   "text": "فريع قلبي ، وكانت نظرة ٌ عرضت    حَيناً ، وتوفيق أقدارٍ لأقدارِ"
  },
  {
   "verse_index": 13,
   "sadr": "بيضاءُ كالشمسِ وافت يوم أسعدها،",
   "ajuz": "لم تؤذ أهلاً، ولم تُفحش على جارِ",
   "text": "بيضاءُ كالشمسِ وافت يوم أسعدها،    لم تؤذ أهلاً، ولم تُفحش على جارِ"
  },
  {
   "verse_index": 14,
   "sadr": "تلوثُ بعد افتضالِ البُرْدِ مئزرها،",
   "ajuz": "لوثاً ، على مثلِ دعصِ الرّملة الهاري",
   "text": "تلوثُ بعد افتضالِ البُرْدِ مئزرها،    لوثاً ، على مثلِ دعصِ الرّملة الهاري"
  },
  {
   "verse_index": 15,
   "sadr": "و الطّيبُ يزداد طيباً أن يكون بها ،",
