  },
  {
   "verse_index": 3,
   "sadr": "أنْتَ كالشَّمْسِ والرِّجَال نُجُومٌ",
   "ajuz": "لَا يُرَى ضَوؤُهَا مَعَ الإشْرَاقِ",
