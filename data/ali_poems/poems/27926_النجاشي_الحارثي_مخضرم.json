  {
   "verse_index": 1,
   "sadr": "تَما ابْنَ قَيْسٍ وَحَارِثٍ وَيَزِيد",
   "ajuz": "أنْتَ واللَّهِ رَأسُ أهْلِ الْعِرَاقِ",
   "text": "تَما ابْنَ قَيْسٍ وَحَارِثٍ وَيَزِيد    أنْتَ واللَّهِ رَأسُ أهْلِ الْعِرَاقِ"
  },
  {
   "verse_index": 2,
   "sadr": "أنْتَ وَاللهِ حَيَّةٌ تَنْفُثُ السُّـ",
   "ajuz": "ـمَّ قَلِيلٌ فِيهَا غَنَاءُ الرَّاقِي",
