  {
   "verse_index": 1,
   "sadr": "منَّيْتَنِي بِشْراً وبشْرٌ فتًى\t",
   "ajuz": "لايَشْتَرِي الحمْدَ بإِعْطاءِ",
   "text": "منَّيْتَنِي بِشْراً وبشْرٌ فتًى\t    لايَشْتَرِي الحمْدَ بإِعْطاءِ"
  },
  {
   "verse_index": 2,
   "sadr": "عِلْج بعلْج مِنْ بَنِي «دابِقٍ»\t",
   "ajuz": "صاحب تقْديرٍ وإِبْقَاءِ",
   "text": "عِلْج بعلْج مِنْ بَنِي «دابِقٍ»\t    صاحب تقْديرٍ وإِبْقَاءِ"
  },
  {
   "verse_index": 3,
   "sadr": "في نفْسه شُغْلٌ وفي بيْته\t",
   "ajuz": "فُضُوحُ إِخْوانٍ وآباء",
   "text": "في نفْسه شُغْلٌ وفي بيْته\t    فُضُوحُ إِخْوانٍ وآباء"
  },
  {
   "verse_index": 4,
   "sadr": "يا بشْرُ ما بالُ التي وقفتْ\t",
   "ajuz": "بالْفتْح تبْكي بيْن أعْداء",
   "text": "يا بشْرُ ما بالُ التي وقفتْ\t    بالْفتْح تبْكي بيْن أعْداء"
  },
  {
   "verse_index": 5,
   "sadr": "يا بشْرُحمَّامُ بني يشْكُرٍ\t",
   "ajuz": "حدَّثني عنْهما بأشْياء",
   "text": "يا بشْرُحمَّامُ بني يشْكُرٍ\t    حدَّثني عنْهما بأشْياء"
