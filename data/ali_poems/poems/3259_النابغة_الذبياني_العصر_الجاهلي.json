  {
   "verse_index": 1,
   "sadr": "أبقَيتَ للعبسيَّ فضلاً ونعمةً،",
   "ajuz": "ومَحْمدةً من باقياتِ المحامدِ",
   "text": "أبقَيتَ للعبسيَّ فضلاً ونعمةً،    ومَحْمدةً من باقياتِ المحامدِ"
  },
  {
   "verse_index": 2,
   "sadr": "حِباءُ شقيقٍ فوقَ أعظَمُ قبرهِ،",
   "ajuz": "وما كان يُحبي قبلهُ قبرُ وافدِ",
   "text": "حِباءُ شقيقٍ فوقَ أعظَمُ قبرهِ،    وما كان يُحبي قبلهُ قبرُ وافدِ"
  },
  {
   "verse_index": 3,
   "sadr": "أتى أهلَهُ منهُ حِباءٌ ونعمةٌ،",
   "ajuz": "ورُبّ امرئٍ يسعى لآخرَ قاعدِ",
   "text": "أتى أهلَهُ منهُ حِباءٌ ونعمةٌ،    ورُبّ امرئٍ يسعى لآخرَ قاعدِ"
  }
 ],
