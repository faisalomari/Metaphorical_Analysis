   "text": "أضحى بأَخْزَى حالةٍ بينهم\t    وكلُّهم في عيشة رَغْد"
  },
  {
   "verse_index": 5,
   "sadr": "وكلهم يَصْدِمُه عامدا",
   "ajuz": "أو تائهَ اللُّبِّ بلا عمد",
   "text": "وكلهم يَصْدِمُه عامدا    أو تائهَ اللُّبِّ بلا عمد"
  },
  {
   "verse_index": 6,
   "sadr": "والبائسُ المسكِينُ مستسْلِمٌ\t",
   "ajuz": "أذلُّ للمكروه من عبْدِ",
   "text": "والبائسُ المسكِينُ مستسْلِمٌ\t    أذلُّ للمكروه من عبْدِ"
  },
  {
   "verse_index": 7,
   "sadr": "وما اشْتهى ذاك ولكنَّه\t",
