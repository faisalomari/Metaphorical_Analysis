   "text": "رأيتُ حمَّالا مُبينَ العمى\t    يعثر بالأكْم، وفي الوَهْدِ"
  },
  {
   "verse_index": 2,
   "sadr": "مُحتَمِلًا ثِقْلا على رأْسه\t",
   "ajuz": "تضعُفُ عنه قُوة ُ الجلْدِ",
   "text": "مُحتَمِلًا ثِقْلا على رأْسه\t    تضعُفُ عنه قُوة ُ الجلْدِ"
  },
  {
   "verse_index": 3,
   "sadr": "بين جِمَالات وأشباهِها\t",
   "ajuz": "من بَشَر نامُوا عن المجْدِ",
   "text": "بين جِمَالات وأشباهِها\t    من بَشَر نامُوا عن المجْدِ"
  },
  {
   "verse_index": 4,
   "sadr": "أضحى بأَخْزَى حالةٍ بينهم\t",
