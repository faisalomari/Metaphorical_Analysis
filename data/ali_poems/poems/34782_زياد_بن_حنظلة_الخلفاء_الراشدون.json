   "text": "فَطَمْنَا بِهِ الرُّومَ العَرِيضَةَ بَعْدَهُ    عَنِ الشَّامِ ما أَرْسَى هُنَاكَ سَنِيرُ"
  },
  {
   "verse_index": 5,
   "sadr": "فَوَلَّتْ جُمُوعُ الرُّومِ تَتْبَعُ إَِثْرَهُ",
   "ajuz": "تَكَادُ مِنَ الذُّعْرِ الشَّدِيدِ تَطِيرُ",
   "text": "فَوَلَّتْ جُمُوعُ الرُّومِ تَتْبَعُ إَِثْرَهُ    تَكَادُ مِنَ الذُّعْرِ الشَّدِيدِ تَطِيرُ"
  },
  {
   "verse_index": 6,
   "sadr": "وَغُودِرَ صَرْعَى فِي المـَكَرِّ كَثِيرُهُ",
