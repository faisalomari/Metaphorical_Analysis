 "verses": [
  {
   "verse_index": 1,
   "sadr": "وَنَحْنُ تَرَكْنَا أَرْطَبونَ مُطَرَّدًا",
   "ajuz": "إلى المـَسْجِدِ الأَقْصَى وَفِيهِ حُسُورُ",
   "text": "وَنَحْنُ تَرَكْنَا أَرْطَبونَ مُطَرَّدًا    إلى المـَسْجِدِ الأَقْصَى وَفِيهِ حُسُورُ"
  },
  {
   "verse_index": 2,
   "sadr": "عَشِيَّةَ أَجْنادِينَ لَمَّا تَتَابَعُوا",
   "ajuz": "وَقَامَتْ عَلَيْهِمْ بِالعَزَاءِ سُتُورُ",
   "text": "عَشِيَّةَ أَجْنادِينَ لَمَّا تَتَابَعُوا    وَقَامَتْ عَلَيْهِمْ بِالعَزَاءِ سُتُورُ"
  },
  {
   "verse_index": 3,
   "sadr": "عَطَفْنَا لَهُ تَحْتَ الغُبَارِ بِطَعْنَةٍ",
   "ajuz": "لَهَا نَشَجٌ نَائِي الشَّهِيقِ غَزِيرُ",
   "text": "عَطَفْنَا لَهُ تَحْتَ الغُبَارِ بِطَعْنَةٍ    لَهَا نَشَجٌ نَائِي الشَّهِيقِ غَزِيرُ"
  },
  {
   "verse_index": 4,
   "sadr": "فَطَمْنَا بِهِ الرُّومَ العَرِيضَةَ بَعْدَهُ",
