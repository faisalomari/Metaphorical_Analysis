 "verses": [
  {
   "verse_index": 1,
   "sadr": "مولاتُنا يا غلامُ مبتكِرَه",
   "ajuz": "فباكِرِ الكَأْسَ لي بِلا نَظِرَه",
   "text": "مولاتُنا يا غلامُ مبتكِرَه    فباكِرِ الكَأْسَ لي بِلا نَظِرَه"
  },
  {
   "verse_index": 2,
   "sadr": "غَدَتْ إلى اللَّهوِ والمُجُونِ على",
   "ajuz": "أنَّ الفَتاةَ الحييةُ الخَفِرَه",
   "text": "غَدَتْ إلى اللَّهوِ والمُجُونِ على    أنَّ الفَتاةَ الحييةُ الخَفِرَه"
  },
  {
   "verse_index": 3,
   "sadr": "لِحِبِّها لاعِجٌ وبي حُرَقٌ",
   "ajuz": "مطويَّةٌ في الحَشَا ومُنْتَشِرَه",
   "text": "لِحِبِّها لاعِجٌ وبي حُرَقٌ    مطويَّةٌ في الحَشَا ومُنْتَشِرَه"
  },
  {
   "verse_index": 4,
   "sadr": "ما ذُقْتُ منها سِوى مُقَبَّلِها",
   "ajuz": "وضَمِّ تِلْكَ الفُروعِ مُنْحَدِرَه",
   "text": "ما ذُقْتُ منها سِوى مُقَبَّلِها    وضَمِّ تِلْكَ الفُروعِ مُنْحَدِرَه"
  },
  {
   "verse_index": 5,
   "sadr": "وانْتَهَرَتْني فَمُتُّ مِنْ فَرَقٍ",
   "ajuz": "يا حُسْنَها في الرِّضا ومُنْتَهِرَه",
   "text": "وانْتَهَرَتْني فَمُتُّ مِنْ فَرَقٍ    يا حُسْنَها في الرِّضا ومُنْتَهِرَه"
  },
  {
   "verse_index": 6,
   "sadr": "ثُم انثَنَتْ سَوْرَةُ الخُمارِ بِنا",
   "ajuz": "خِلالَ تِلْكَ الغَدائِرِ الخمِرَه",
   "text": "ثُم انثَنَتْ سَوْرَةُ الخُمارِ بِنا    خِلالَ تِلْكَ الغَدائِرِ الخمِرَه"
  },
  {
   "verse_index": 7,
   "sadr": "وليْلَةٍ أشْرَفَتْ بكَلْكَلِها",
   "ajuz": "عليَّ كالطيلَسان مُعتجره",
   "text": "وليْلَةٍ أشْرَفَتْ بكَلْكَلِها    عليَّ كالطيلَسان مُعتجره"
  },
  {
   "verse_index": 8,
   "sadr": "فَتَقْتُ دَيْجُورَها إلى قَمَرٍ",
   "ajuz": "أثْوابُهُ بالعَفافِ مُسْتَتِرَه",
   "text": "فَتَقْتُ دَيْجُورَها إلى قَمَرٍ    أثْوابُهُ بالعَفافِ مُسْتَتِرَه"
  },
  {
   "verse_index": 9,
   "sadr": "عُجْ عَبَراتِ المُدامِ نحويَ من",
   "ajuz": "عَشْرٍ وعشْرينَ واثنَتي عَشَرَه",
   "text": "عُجْ عَبَراتِ المُدامِ نحويَ من    عَشْرٍ وعشْرينَ واثنَتي عَشَرَه"
  },
  {
   "verse_index": 10,
   "sadr": "قَدْ ذَكَرَ النَّاسُ عَن قيامَتِهِمْ",
   "ajuz": "ذكرى بعَقْلي ما أصْبحتْ نَفِره",
   "text": "قَدْ ذَكَرَ النَّاسُ عَن قيامَتِهِمْ    ذكرى بعَقْلي ما أصْبحتْ نَفِره"
  },
  {
   "verse_index": 11,
   "sadr": "مَعْرِفَتي بالصَّوابِ معْرِفَةٌ",
   "ajuz": "غَرَّاءُ إمَّا عَرَفْتُمُ النَّكِرَه",
   "text": "مَعْرِفَتي بالصَّوابِ معْرِفَةٌ    غَرَّاءُ إمَّا عَرَفْتُمُ النَّكِرَه"
  },
  {
   "verse_index": 12,
   "sadr": "يا عَجَبًا من أبي الخَبِيثِ ومن",
   "ajuz": "سُروجِه في البكائِرِ الدَّثِرَه",
   "text": "يا عَجَبًا من أبي الخَبِيثِ ومن    سُروجِه في البكائِرِ الدَّثِرَه"
  },
  {
   "verse_index": 13,
   "sadr": "يَحْمِلُ رأْسًا تَنبو المَعاوِلُ عن",
   "ajuz": "صَفْحَتِهِ والجلامِدُ الوَعِرَه",
   "text": "يَحْمِلُ رأْسًا تَنبو المَعاوِلُ عن    صَفْحَتِهِ والجلامِدُ الوَعِرَه"
  },
  {
   "verse_index": 14,
   "sadr": "لو البِغالُ الصُّلْبُ ارْتَقَتْ سَنَدًا",
   "ajuz": "فيه لمدّتْ قوائمًا خَدِرَه",
   "text": "لو البِغالُ الصُّلْبُ ارْتَقَتْ سَنَدًا    فيه لمدّتْ قوائمًا خَدِرَه"
  },
  {
   "verse_index": 15,
   "sadr": "وما المَجانيقُ فيهِ مُغْنِيةٌ",
   "ajuz": "ألْفٌ تَسامى وألْفُ منكَدِره",
   "text": "وما المَجانيقُ فيهِ مُغْنِيةٌ    ألْفٌ تَسامى وألْفُ منكَدِره"
  },
  {
   "verse_index": 16,
   "sadr": "انْظُرْ إلى مَوْضِعِ المقصِّ من الها",
   "ajuz": "مة، تلكَ الصَّبيحة العَجِرَه",
   "text": "انْظُرْ إلى مَوْضِعِ المقصِّ من الها    مة، تلكَ الصَّبيحة العَجِرَه"
  },
  {
   "verse_index": 17,
   "sadr": "فلو أخَذْتُم لها المَطارِقَ حرّا",
   "ajuz": "نيَّةً صَنْعَةَ اليدِ الخَبِرَه",
   "text": "فلو أخَذْتُم لها المَطارِقَ حرّا    نيَّةً صَنْعَةَ اليدِ الخَبِرَه"
  },
  {
   "verse_index": 18,
   "sadr": "إذَنْ لراحَتْ أكُفُّ جلَّتِهِم",
   "ajuz": "كَليلَةً والأَداةُ مُنْكَسِرَه",
   "text": "إذَنْ لراحَتْ أكُفُّ جلَّتِهِم    كَليلَةً والأَداةُ مُنْكَسِرَه"
  },
  {
   "verse_index": 19,
   "sadr": "كم طَرَبَاتٍ أفْسَدْتَهُنَّ وكم",
   "ajuz": "صَفْوَةِ عَيشٍ غادَرْتَها كَدِرَه",
   "text": "كم طَرَبَاتٍ أفْسَدْتَهُنَّ وكم    صَفْوَةِ عَيشٍ غادَرْتَها كَدِرَه"
  },
  {
   "verse_index": 20,
   "sadr": "وكم إذا ما رَأَوْكَ يا مَلَكَ المَوْ",
   "ajuz": "تِ لهم من أنامِلٍ خَصِرَه",
   "text": "وكم إذا ما رَأَوْكَ يا مَلَكَ المَوْ    تِ لهم من أنامِلٍ خَصِرَه"
  },
  {
   "verse_index": 21,
   "sadr": "وكمْ لهم دَعْوَةٌ عَليك وكم",
   "ajuz": "قَذْفَة أمِّ شنعاءَ مُشْتَهِرَه",
   "text": "وكمْ لهم دَعْوَةٌ عَليك وكم    قَذْفَة أمِّ شنعاءَ مُشْتَهِرَه"
  },
  {
   "verse_index": 22,
   "sadr": "كريمةٍ لُؤْمُكَ اسْتَخَفَّ بها",
   "ajuz": "فنالها بالمَثالِبِ الْأشِرَه",
   "text": "كريمةٍ لُؤْمُكَ اسْتَخَفَّ بها    فنالها بالمَثالِبِ الْأشِرَه"
  },
  {
   "verse_index": 23,
   "sadr": "قِفُوا على رَحْلِهِ تَرَوْا عَجَبًا:",
   "ajuz": "بالجَهْلِ يحكي طرائِفَ البُصَرَه",
   "text": "قِفُوا على رَحْلِهِ تَرَوْا عَجَبًا:    بالجَهْلِ يحكي طرائِفَ البُصَرَه"
  },
  {
   "verse_index": 24,
   "sadr": "يا كلَّ مَنْيٍ وكُلَّ طالِعَةٍ",
   "ajuz": "نَحْسٍ، ويا كُلَّ ساعَةٍ عَسِرَه",
   "text": "يا كلَّ مَنْيٍ وكُلَّ طالِعَةٍ    نَحْسٍ، ويا كُلَّ ساعَةٍ عَسِرَه"
  },
  {
   "verse_index": 25,
   "sadr": "سُبْحانَ مَنْ يُمْسِكُ السَّماءَ عَلى الأرْضِ",
   "ajuz": "وفيها أخْلاقُك القَذرَه",
   "text": "سُبْحانَ مَنْ يُمْسِكُ السَّماءَ عَلى الأرْضِ    وفيها أخْلاقُك القَذرَه"
  }
 ],
