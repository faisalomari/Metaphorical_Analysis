 "verses": [
  {
   "verse_index": 1,
   "sadr": "رَيْبُ دَهْرٍ أَصَمَّ دُونَ العِتَابِ",
   "ajuz": "مُرْصِدٌ بالأَوْجَالِ والأَوْصَابِ",
   "text": "رَيْبُ دَهْرٍ أَصَمَّ دُونَ العِتَابِ    مُرْصِدٌ بالأَوْجَالِ والأَوْصَابِ"
  },
  {
   "verse_index": 2,
   "sadr": "جَفَّ دَرُّ الدَّنيا فَقدْ أصبَحَتْ تَكـ",
   "ajuz": "ـتَالُ أَروَاحَنَا بغيرِ حِسَابِ",
   "text": "جَفَّ دَرُّ الدَّنيا فَقدْ أصبَحَتْ تَكـ    ـتَالُ أَروَاحَنَا بغيرِ حِسَابِ"
  },
  {
   "verse_index": 3,
   "sadr": "لَوْ بَدَتْ سافِراً أُهِينَتْ ولكنْ",
   "ajuz": "شَعَفَ الخَلْقَ حُسْنُهَا في النِّقَابِ",
   "text": "لَوْ بَدَتْ سافِراً أُهِينَتْ ولكنْ    شَعَفَ الخَلْقَ حُسْنُهَا في النِّقَابِ"
  },
  {
   "verse_index": 4,
   "sadr": "إِنْ رَيْبَ الزَّمان يُحسِنُ أَنْ يُهْـ",
   "ajuz": "ـدِي الرَّزَايا إِلى ذَوِي الأَحْسَابِ",
   "text": "إِنْ رَيْبَ الزَّمان يُحسِنُ أَنْ يُهْـ    ـدِي الرَّزَايا إِلى ذَوِي الأَحْسَابِ"
  },
  {
   "verse_index": 5,
   "sadr": "فَلِهذا يَجِفُّ بَعْدَ اخضرارٍ",
   "ajuz": "قبلَ رَوْضِ الوِهَادِ رَوْضُ الرَّوابي",
   "text": "فَلِهذا يَجِفُّ بَعْدَ اخضرارٍ    قبلَ رَوْضِ الوِهَادِ رَوْضُ الرَّوابي"
  },
  {
   "verse_index": 6,
   "sadr": "لَمْ تَدُرْ عَيْنُه عنِ الحُمْسِ حتَّى",
   "ajuz": "ضَعْضَعتْ رُكْنَ حِمْيَرَ الأَربَابِ",
   "text": "لَمْ تَدُرْ عَيْنُه عنِ الحُمْسِ حتَّى    ضَعْضَعتْ رُكْنَ حِمْيَرَ الأَربَابِ"
  },
  {
   "verse_index": 7,
   "sadr": "بَطَشَتْ مِنهمْ بِلُؤْلُؤَة ِ الغَوَّا",
   "ajuz": "صِ حُسْناً ودُمْيَة ِ المِحْرَابِ",
   "text": "بَطَشَتْ مِنهمْ بِلُؤْلُؤَة ِ الغَوَّا    صِ حُسْناً ودُمْيَة ِ المِحْرَابِ"
  },
  {
   "verse_index": 8,
   "sadr": "بالصَّريحِ الصَّريحِ والأَرْوَعِ الأَرْ",
   "ajuz": "وَعِ مِنْهُمْ وباللُّبَابِ اللُّبَابِ",
   "text": "بالصَّريحِ الصَّريحِ والأَرْوَعِ الأَرْ    وَعِ مِنْهُمْ وباللُّبَابِ اللُّبَابِ"
  },
  {
   "verse_index": 9,
   "sadr": "ذَهبَتْ يا مُحمَّدُ الغُرُّ مِنْ أَيّا",
   "ajuz": "مِكَ الواضحاتِ أَيَّ ذَهَابِ!",
   "text": "ذَهبَتْ يا مُحمَّدُ الغُرُّ مِنْ أَيّا    مِكَ الواضحاتِ أَيَّ ذَهَابِ!"
  },
  {
   "verse_index": 10,
   "sadr": "عَبَّسَ اللَّحْدُ والثَّرَى مِنْكَ وَجْهَاً",
   "ajuz": "غَيْرَ ما عَابِس ولا قَطَّابِ",
   "text": "عَبَّسَ اللَّحْدُ والثَّرَى مِنْكَ وَجْهَاً    غَيْرَ ما عَابِس ولا قَطَّابِ"
  },
  {
   "verse_index": 11,
   "sadr": "أطفَأَ اللَّحْدُ والثَّرَى لُبَّكَ المُسْـ",
   "ajuz": "ـرَجَ في وقتِ ظُلْمَةِ الألبَابِ",
   "text": "أطفَأَ اللَّحْدُ والثَّرَى لُبَّكَ المُسْـ    ـرَجَ في وقتِ ظُلْمَةِ الألبَابِ"
  },
  {
   "verse_index": 12,
   "sadr": "وتَبَدَّلتَ مَنْزِلاً ظاهِرَ الجَدْ",
   "ajuz": "بِ يُسَمَّى مُقَطِّعَ الأَسبَابِ",
   "text": "وتَبَدَّلتَ مَنْزِلاً ظاهِرَ الجَدْ    بِ يُسَمَّى مُقَطِّعَ الأَسبَابِ"
  },
  {
   "verse_index": 13,
   "sadr": "مَنْزِلاً مُوحِشاً وإِنْ كانَ مَعْـ",
   "ajuz": "ـمُوراً بحِلِّ الصَّدِيقِ والأحبابِ",
   "text": "مَنْزِلاً مُوحِشاً وإِنْ كانَ مَعْـ    ـمُوراً بحِلِّ الصَّدِيقِ والأحبابِ"
  },
  {
   "verse_index": 14,
   "sadr": "يا شِهَاباً خَبا لآلِ عُبَيْدِ اللَّـ",
   "ajuz": "ـهِ أعزِزْ بِفَقْدِ هذا الشِّهَابِ!",
   "text": "يا شِهَاباً خَبا لآلِ عُبَيْدِ اللَّـ    ـهِ أعزِزْ بِفَقْدِ هذا الشِّهَابِ!"
  },
  {
   "verse_index": 15,
   "sadr": "زَهْرَة ٌ غَضَّة ٌ تَفتَّقَ عَنها الـ",
   "ajuz": "ـمَجْدُ في مَنْبِتٍ أَنِيقِ الجَنَابِ",
   "text": "زَهْرَة ٌ غَضَّة ٌ تَفتَّقَ عَنها الـ    ـمَجْدُ في مَنْبِتٍ أَنِيقِ الجَنَابِ"
  },
  {
   "verse_index": 16,
   "sadr": "خُلُقٌ كالمُدَام أو كَرُضَابِ المِسْـ",
   "ajuz": "ـكِ أَوْ كالعَبِيرِ أَوْ كالمُلابِ",
   "text": "خُلُقٌ كالمُدَام أو كَرُضَابِ المِسْـ    ـكِ أَوْ كالعَبِيرِ أَوْ كالمُلابِ"
  },
  {
   "verse_index": 17,
   "sadr": "وحَياً ناهِيكَ في غيْرِ عِيٍّ",
   "ajuz": "وصِباً مُشْرِقٌ بغيرِ تَصَابِ",
   "text": "وحَياً ناهِيكَ في غيْرِ عِيٍّ    وصِباً مُشْرِقٌ بغيرِ تَصَابِ"
  },
  {
   "verse_index": 18,
   "sadr": "أنزَلَتْهُ الأَيَّامُ عن ظَهْرِهَا مِن",
   "ajuz": "بَعْدِ إِثباتِ رِجْلِهِ في الرِّكابِ",
   "text": "أنزَلَتْهُ الأَيَّامُ عن ظَهْرِهَا مِن    بَعْدِ إِثباتِ رِجْلِهِ في الرِّكابِ"
  },
  {
   "verse_index": 19,
   "sadr": "حِينَ سَامَى الشَّبَابَ واغتدَتِ الدُّنـ",
   "ajuz": "ـيا عليهِ مَفْتُوحَة َ الأبوابِ",
   "text": "حِينَ سَامَى الشَّبَابَ واغتدَتِ الدُّنـ    ـيا عليهِ مَفْتُوحَة َ الأبوابِ"
  },
  {
   "verse_index": 20,
   "sadr": "وحَكى الصَّارِمَ المُحَلَّى سِوى أَنَّ",
   "ajuz": "(م) حُلَاهُ جَوَاهِرُ الآدَابِ",
   "text": "وحَكى الصَّارِمَ المُحَلَّى سِوى أَنَّ    (م) حُلَاهُ جَوَاهِرُ الآدَابِ"
  },
  {
   "verse_index": 21,
   "sadr": "وهْوَ غَضُّ الآرَاءِ والحَزْمِ خِرْقٌ",
   "ajuz": "ثُمَّ غَضُّ النَّوَالِ غَضُّ الشَّبَابِ",
   "text": "وهْوَ غَضُّ الآرَاءِ والحَزْمِ خِرْقٌ    ثُمَّ غَضُّ النَّوَالِ غَضُّ الشَّبَابِ"
  },
  {
   "verse_index": 22,
   "sadr": "قَصَدتْ نحوَهُ المَنِيَّة ُ حتَّى",
   "ajuz": "وهَبتْ حُسنَ وجْهِهِ للتُّرابِ",
   "text": "قَصَدتْ نحوَهُ المَنِيَّة ُ حتَّى    وهَبتْ حُسنَ وجْهِهِ للتُّرابِ"
  }
