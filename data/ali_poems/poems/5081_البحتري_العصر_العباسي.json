 "verses": [
  {
   "verse_index": 1,
   "sadr": "مَا لها أُوْلِعَتْ بِقَطْعِ الوِدَادِ",
   "ajuz": "كلّ يومٍ تَروعُني بالبِعادِ!؟",
   "text": "مَا لها أُوْلِعَتْ بِقَطْعِ الوِدَادِ    كلّ يومٍ تَروعُني بالبِعادِ!؟"
  },
  {
   "verse_index": 2,
   "sadr": "مَا عَلِمْتُ النّوى ولا الشّوْقَ حّتّى",
   "ajuz": "أَشْرَقَتْ لي الخُدُورُ فوقَ النّجادِ",
   "text": "مَا عَلِمْتُ النّوى ولا الشّوْقَ حّتّى    أَشْرَقَتْ لي الخُدُورُ فوقَ النّجادِ"
  },
  {
   "verse_index": 3,
   "sadr": "فَوَقَفْنا على الطُّلولِ يفيضُ ال",
   "ajuz": "لُؤْلُؤُ الرّطْبُ مِنْ عُيُونٍ صَوَادِ",
   "text": "فَوَقَفْنا على الطُّلولِ يفيضُ ال    لُؤْلُؤُ الرّطْبُ مِنْ عُيُونٍ صَوَادِ"
  },
  {
   "verse_index": 4,
   "sadr": "في رِيَاضٍ قَدِ اسْتَعَارَ لها الوَبْ",
   "ajuz": "لُ رِداءً مِن ابْتِسَامِ ((سُعادِ))",
   "text": "في رِيَاضٍ قَدِ اسْتَعَارَ لها الوَبْ    لُ رِداءً مِن ابْتِسَامِ ((سُعادِ))"
  },
  {
   "verse_index": 5,
   "sadr": "وَ((سُعَادٌ)) غَرَّاءُ فَرْعَاءُ تَسْقي",
   "ajuz": "كَ عُقَارًا مِنَ الثّنايا البُرادِ",
   "text": "وَ((سُعَادٌ)) غَرَّاءُ فَرْعَاءُ تَسْقي    كَ عُقَارًا مِنَ الثّنايا البُرادِ"
  },
  {
   "verse_index": 6,
   "sadr": "نَكَرَتْني: فَقُلْتُ: لا تَنْكِريني",
   "ajuz": "لمْ أَحُلْ عَنْ خَلائِقي واعْتِيَادي",
   "text": "نَكَرَتْني: فَقُلْتُ: لا تَنْكِريني    لمْ أَحُلْ عَنْ خَلائِقي واعْتِيَادي"
  },
  {
   "verse_index": 7,
   "sadr": "إِنْ تَرَيْني تَرَى حُسَامًا صَقيلًا",
   "ajuz": "مَشْرَفِيًّا مِنَ السّيُوفِ الحِدادِ",
   "text": "إِنْ تَرَيْني تَرَى حُسَامًا صَقيلًا    مَشْرَفِيًّا مِنَ السّيُوفِ الحِدادِ"
  },
  {
   "verse_index": 8,
   "sadr": "ثانيَ اللّيلِ، ثالثَ البيدِ والسّيْ",
   "ajuz": "رِ: نَديمَ النُّجُومِ، تِرْبَ السُّهَادِ",
   "text": "ثانيَ اللّيلِ، ثالثَ البيدِ والسّيْ    رِ: نَديمَ النُّجُومِ، تِرْبَ السُّهَادِ"
  },
  {
   "verse_index": 9,
   "sadr": "كُلَّمَ ((الخِضْرُ)) لي فَصَيَّرَني بَعْ",
   "ajuz": "دَكِ عَيْنًا على عِيَارِ البِلادِ",
   "text": "كُلَّمَ ((الخِضْرُ)) لي فَصَيَّرَني بَعْ    دَكِ عَيْنًا على عِيَارِ البِلادِ"
  },
  {
   "verse_index": 10,
   "sadr": "لَيْلَة بالشّآمِ ثُمَّتْ بالأهْ",
   "ajuz": "وَازِ يومًا، وَلَيْلَةً بالسّوادِ",
   "text": "لَيْلَة بالشّآمِ ثُمَّتْ بالأهْ    وَازِ يومًا، وَلَيْلَةً بالسّوادِ"
  },
  {
   "verse_index": 11,
   "sadr": "وَطَني حَيْثُ حَطَّتِ العيسُ رَحْلي",
   "ajuz": "وَذِرَاعي الوِسَادُ وهو مِهادِي",
   "text": "وَطَني حَيْثُ حَطَّتِ العيسُ رَحْلي    وَذِرَاعي الوِسَادُ وهو مِهادِي"
  },
  {
   "verse_index": 12,
   "sadr": "لي مِنَ الشّعْرِ نَخْوَةٌ واعْتِزازٌ",
   "ajuz": "وَهُجُومٌ على الأمُورِ الشّدادِ",
   "text": "لي مِنَ الشّعْرِ نَخْوَةٌ واعْتِزازٌ    وَهُجُومٌ على الأمُورِ الشّدادِ"
  },
  {
   "verse_index": 13,
   "sadr": "فَإذا مَا بَنَيْتُ بَيْتًا تَبَخْتَرْ",
   "ajuz": "تُ كَأنّي بَنَيْتُ ((ذاتَ العِمادِ))",
   "text": "فَإذا مَا بَنَيْتُ بَيْتًا تَبَخْتَرْ    تُ كَأنّي بَنَيْتُ ((ذاتَ العِمادِ))"
  },
  {
   "verse_index": 14,
   "sadr": "أَوْ كَأَنّي أَحُوكُ حَوكَ ((زِيادٍ))",
   "ajuz": "أَوْ كَأنّي ((أَبو دُؤادِ الإيَادي))",
   "text": "أَوْ كَأَنّي أَحُوكُ حَوكَ ((زِيادٍ))    أَوْ كَأنّي ((أَبو دُؤادِ الإيَادي))"
  },
  {
   "verse_index": 15,
   "sadr": "لي مُعينانِ: هِمَّةٌ واعْتِزامُ",
   "ajuz": "تلك منْ طَارِفِي وذا مِنْ تِلادي",
   "text": "لي مُعينانِ: هِمَّةٌ واعْتِزامُ    تلك منْ طَارِفِي وذا مِنْ تِلادي"
  },
  {
   "verse_index": 16,
   "sadr": "لي نَديمانِ: كَوْكَبٌ وَظَلامٌ",
   "ajuz": "لا يَخونَانِ صُحْبَتي وَوِدَادي",
   "text": "لي نَديمانِ: كَوْكَبٌ وَظَلامٌ    لا يَخونَانِ صُحْبَتي وَوِدَادي"
  },
  {
   "verse_index": 17,
   "sadr": "لِي مِنَ الدّهْرِ كُلَّ يَوْمٍ عَناءٌ",
   "ajuz": "فُرْقَتِي مَعْشَرِي وَقِلَّةُ زَادِي",
   "text": "لِي مِنَ الدّهْرِ كُلَّ يَوْمٍ عَناءٌ    فُرْقَتِي مَعْشَرِي وَقِلَّةُ زَادِي"
  },
  {
   "verse_index": 18,
   "sadr": "مَا حَديثي إلّا حَديثُ ((كُلَيْبٍ))",
   "ajuz": "وَ((بُجَيْرٍ)) و((الحَارثِ بْنِ عُبَادِ))",
   "text": "مَا حَديثي إلّا حَديثُ ((كُلَيْبٍ))    وَ((بُجَيْرٍ)) و((الحَارثِ بْنِ عُبَادِ))"
  }
