   "text": "فاستوسقوا وتبينوا سبل الهدى    ودعوا النجيَّ فليس حين تناج"
  },
  {
   "verse_index": 16,
   "sadr": "يا رُبَّ ناكث بيعتين تَركته",
   "ajuz": "وخضاب لحيته دم الأَوداج",
   "text": "يا رُبَّ ناكث بيعتين تَركته    وخضاب لحيته دم الأَوداج"
  },
  {
   "verse_index": 17,
   "sadr": "إِن العدو إِذا رموك رميتهم",
