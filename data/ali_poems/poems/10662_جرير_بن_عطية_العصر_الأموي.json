 "verses": [
  {
   "verse_index": 1,
   "sadr": "هاج الهوى لفؤادك المهتاج",
   "ajuz": "فانظر بِتُوضِحَ باكر الأَحداج",
   "text": "هاج الهوى لفؤادك المهتاج    فانظر بِتُوضِحَ باكر الأَحداج"
  },
  {
   "verse_index": 2,
   "sadr": "هذا هوى شعف الفؤاد مُبَرِّحٌ",
   "ajuz": "ونَوًى تَقَاذَفُ غير ذات خِلاج",
   "text": "هذا هوى شعف الفؤاد مُبَرِّحٌ    ونَوًى تَقَاذَفُ غير ذات خِلاج"
  },
  {
   "verse_index": 3,
   "sadr": "إِن الغراب بما كرهتَ لَمُولَعٌ",
   "ajuz": "بنوى الأَحبة دائم التَّشحَاج",
   "text": "إِن الغراب بما كرهتَ لَمُولَعٌ    بنوى الأَحبة دائم التَّشحَاج"
  },
  {
   "verse_index": 4,
   "sadr": "ليت الغراب غداة ينعب بالنوى",
   "ajuz": "كان الغراب مُقطَّع الأَوداج",
   "text": "ليت الغراب غداة ينعب بالنوى    كان الغراب مُقطَّع الأَوداج"
  },
  {
   "verse_index": 5,
   "sadr": "ولقد علمتِ بأَن سِرَّكِ عندنا",
   "ajuz": "بين الجوانح مُوثَقُ الأَشراج",
   "text": "ولقد علمتِ بأَن سِرَّكِ عندنا    بين الجوانح مُوثَقُ الأَشراج"
  },
  {
   "verse_index": 6,
   "sadr": "ولقد رمينك يوم رحن بأَعين",
   "ajuz": "ينظرن من خلل الستور سواجي",
   "text": "ولقد رمينك يوم رحن بأَعين    ينظرن من خلل الستور سواجي"
  },
  {
   "verse_index": 7,
   "sadr": "وبمنطق شعف الفؤاد كأَنه",
   "ajuz": "عَسَلٌ يَجُدْنَ به بغير مزاج",
   "text": "وبمنطق شعف الفؤاد كأَنه    عَسَلٌ يَجُدْنَ به بغير مزاج"
  },
  {
   "verse_index": 8,
   "sadr": "قل للجبان إِذا تأَخر سرجه",
   "ajuz": "هل أَنت من شَرَكِ المنية ناج",
   "text": "قل للجبان إِذا تأَخر سرجه    هل أَنت من شَرَكِ المنية ناج"
  },
  {
   "verse_index": 9,
   "sadr": "فَتَعَلَّقَنْ ببنات نعش هاربًا",
   "ajuz": "أَو بالبحور وشدة الأَمواج",
   "text": "فَتَعَلَّقَنْ ببنات نعش هاربًا    أَو بالبحور وشدة الأَمواج"
  },
  {
   "verse_index": 10,
   "sadr": "مَنْ سَدَّ مُطَّلَعَ النفاق عليهم",
   "ajuz": "أَم من يصول كصولة الحجاج",
   "text": "مَنْ سَدَّ مُطَّلَعَ النفاق عليهم    أَم من يصول كصولة الحجاج"
  },
  {
   "verse_index": 11,
   "sadr": "أَم من يغار على النساء حفيظة",
   "ajuz": "إِذ لا يثقن بغيرة الأَزواج",
   "text": "أَم من يغار على النساء حفيظة    إِذ لا يثقن بغيرة الأَزواج"
  },
  {
   "verse_index": 12,
   "sadr": "إِن ابن يوسف فاعلموا وتيقنوا",
   "ajuz": "ماضي البصيرة واضح المنهاج",
   "text": "إِن ابن يوسف فاعلموا وتيقنوا    ماضي البصيرة واضح المنهاج"
  },
  {
   "verse_index": 13,
   "sadr": "ماضٍ على الغَمرات يُمْضِي همه",
   "ajuz": "والليل مختلف الطرائق داج",
   "text": "ماضٍ على الغَمرات يُمْضِي همه    والليل مختلف الطرائق داج"
  },
  {
   "verse_index": 14,
   "sadr": "مَنع الرُّشا وأَراكم سُبُل الهدى",
   "ajuz": "واللصَّ نكله عن الإِدلاج",
   "text": "مَنع الرُّشا وأَراكم سُبُل الهدى    واللصَّ نكله عن الإِدلاج"
  },
  {
   "verse_index": 15,
   "sadr": "فاستوسقوا وتبينوا سبل الهدى",
