 "verses": [
  {
   "verse_index": 1,
   "sadr": "وَمِيْنَاسَُ قَتْلًا يَوْمَ جَاءَ بِجَمْعِهِ",
   "ajuz": "فَصَادَفَهُ مِنَّا قِرَاعٌ مُؤَزَّرُ",
   "text": "وَمِيْنَاسَُ قَتْلًا يَوْمَ جَاءَ بِجَمْعِهِ    فَصَادَفَهُ مِنَّا قِرَاعٌ مُؤَزَّرُ"
  },
  {
   "verse_index": 2,
   "sadr": "فَوَلَّتْ فُلولًا بِالفَضاءِ جُمُوعُهُ",
   "ajuz": "وَنَازَعَهُ مِنَّا سِنَانٌ مُذَكَّرُ",
   "text": "فَوَلَّتْ فُلولًا بِالفَضاءِ جُمُوعُهُ    وَنَازَعَهُ مِنَّا سِنَانٌ مُذَكَّرُ"
  },
  {
   "verse_index": 3,
   "sadr": "تَضَمَّنَهُ لَمَّا تَرَاخَتْ خُيُولُهُ",
   "ajuz": "مُناخٌ لَدَيْهِ عَسْكَرٌ ثُمَّ عَسْكَرُ",
   "text": "تَضَمَّنَهُ لَمَّا تَرَاخَتْ خُيُولُهُ    مُناخٌ لَدَيْهِ عَسْكَرٌ ثُمَّ عَسْكَرُ"
  },
  {
   "verse_index": 4,
   "sadr": "وَغُودِرَ ذَاكَ الجَمْعُ تَعْلُو وُجُوهَهُمْ",
   "ajuz": "دِقَاقُ الحَصَا وَالسَّافِيَاءُ المـُغَبَّرُ",
   "text": "وَغُودِرَ ذَاكَ الجَمْعُ تَعْلُو وُجُوهَهُمْ    دِقَاقُ الحَصَا وَالسَّافِيَاءُ المـُغَبَّرُ"
  }
