 "verses": [
  {
   "verse_index": 1,
   "sadr": "تَعَلَّقَ رُوحِي رُوحها قَبْلَ خَلْقِنا",
   "ajuz": "ومن بعدما كُنَّا نِطافًا وفي المَهْدِ",
   "text": "تَعَلَّقَ رُوحِي رُوحها قَبْلَ خَلْقِنا    ومن بعدما كُنَّا نِطافًا وفي المَهْدِ"
  },
  {
   "verse_index": 2,
   "sadr": "فزادَ كَما زِدنا فأَصْبَحَ نامِيًا",
   "ajuz": "فلَيْسَ وإِنْ مُتْنا بمنصرم العَهْدِ",
   "text": "فزادَ كَما زِدنا فأَصْبَحَ نامِيًا    فلَيْسَ وإِنْ مُتْنا بمنصرم العَهْدِ"
  },
  {
   "verse_index": 3,
   "sadr": "ولكِنَّهُ باقٍ على كُلِّ حادِثٍ",
   "ajuz": "وزائِرُنا في ظُلْمَةِ القَبْرِ واللَّحْدِ",
   "text": "ولكِنَّهُ باقٍ على كُلِّ حادِثٍ    وزائِرُنا في ظُلْمَةِ القَبْرِ واللَّحْدِ"
  },
  {
   "verse_index": 4,
   "sadr": "يَكادُ حَبابُ الماءِ يخدش جلدها",
   "ajuz": "إِذا اغتسَلَت بالماءِ مِنْ رِقَّةِ الجِلْدِ",
   "text": "يَكادُ حَبابُ الماءِ يخدش جلدها    إِذا اغتسَلَت بالماءِ مِنْ رِقَّةِ الجِلْدِ"
  },
  {
   "verse_index": 5,
   "sadr": "وإِنِّيَ أَشْتاقُ إِلى رِيْحِ جَيْبها",
   "ajuz": "كما اشتاقَ إدْريسُ إِلى جَنَّةِ الخُلْدِ",
   "text": "وإِنِّيَ أَشْتاقُ إِلى رِيْحِ جَيْبها    كما اشتاقَ إدْريسُ إِلى جَنَّةِ الخُلْدِ"
  },
  {
   "verse_index": 6,
   "sadr": "ولو لَبستْ ثوبًا مِنَ الوَرْدِ خالِصًا",
   "ajuz": "لَخَدَّشَ مِنها جلدها ورَقُ الوَرْدِ",
   "text": "ولو لَبستْ ثوبًا مِنَ الوَرْدِ خالِصًا    لَخَدَّشَ مِنها جلدها ورَقُ الوَرْدِ"
  },
  {
   "verse_index": 7,
   "sadr": "يُثَقِّلها لُبْس الحَريرِ لِلِينِها",
   "ajuz": "وتَشْكُو إلى جاراتِها ثِقَلَ العِقْدِ",
   "text": "يُثَقِّلها لُبْس الحَريرِ لِلِينِها    وتَشْكُو إلى جاراتِها ثِقَلَ العِقْدِ"
  },
  {
   "verse_index": 8,
   "sadr": "وأَرْحَمُ خَدَّيْها إذا ما لَحَظْتُها",
   "ajuz": "حِذارًا لِلَحْظِي أَنْ يؤَثِّرَ في الخَدِّ",
   "text": "وأَرْحَمُ خَدَّيْها إذا ما لَحَظْتُها    حِذارًا لِلَحْظِي أَنْ يؤَثِّرَ في الخَدِّ"
  }
 ],
