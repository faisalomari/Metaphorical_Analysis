 "verses": [
  {
   "verse_index": 1,
   "sadr": "يَا طَلَلَ الحَيِّ جَادَك الطَّلَلُ",
   "ajuz": "مَا لَكَ وَحْشَ العِرَاصِ يا طَلَلُ",
   "text": "يَا طَلَلَ الحَيِّ جَادَك الطَّلَلُ    مَا لَكَ وَحْشَ العِرَاصِ يا طَلَلُ"
  },
  {
   "verse_index": 2,
   "sadr": "لَسْتُ أرى فيكَ مَنْ عَهِدتُ وقدْ",
   "ajuz": "كنتَ لَهمْ موطنًا، فما فَعَلُوا",
   "text": "لَسْتُ أرى فيكَ مَنْ عَهِدتُ وقدْ    كنتَ لَهمْ موطنًا، فما فَعَلُوا"
  },
  {
   "verse_index": 3,
   "sadr": "أَيّامَ حَبْلُ الصَّفاءِ منكَ وَمِنْ",
   "ajuz": "بَهْجَةِ بَيْتِ الأَسْبَابِ متَّصِلُ",
   "text": "أَيّامَ حَبْلُ الصَّفاءِ منكَ وَمِنْ    بَهْجَةِ بَيْتِ الأَسْبَابِ متَّصِلُ"
  },
  {
   "verse_index": 4,
   "sadr": "جَاريةٌ كالمَهَاةِ بَارعَةُ الخد",
   "ajuz": "ديْنِ والخدُّ شَادِنٌ عَطَلُ",
   "text": "جَاريةٌ كالمَهَاةِ بَارعَةُ الخد    ديْنِ والخدُّ شَادِنٌ عَطَلُ"
  },
  {
   "verse_index": 5,
   "sadr": "لَمْ تلْق بؤْسًا ولم تُعَانِ أَذًى",
   "ajuz": "لكنْ عَدَاهَا النّعيمُ والجَذَلُ",
   "text": "لَمْ تلْق بؤْسًا ولم تُعَانِ أَذًى    لكنْ عَدَاهَا النّعيمُ والجَذَلُ"
  },
  {
   "verse_index": 6,
   "sadr": "دَسَّت رَسولًا أَنِ ائْتِنَا رقْدَةَ الـ",
   "ajuz": "ـحَيِّ إذَا مَا عَلِمْتَهُمْ غفَلُوا",
   "text": "دَسَّت رَسولًا أَنِ ائْتِنَا رقْدَةَ الـ    ـحَيِّ إذَا مَا عَلِمْتَهُمْ غفَلُوا"
  },
  {
   "verse_index": 7,
   "sadr": "فجِئْتُ واللّيلُ مُكْتَسٍ سَدَفَ الظـ",
   "ajuz": "ـظلْمةِ وَهْنًا والطُّرْقَ أَخْتَيِلُ",
   "text": "فجِئْتُ واللّيلُ مُكْتَسٍ سَدَفَ الظـ    ـظلْمةِ وَهْنًا والطُّرْقَ أَخْتَيِلُ"
  },
  {
   "verse_index": 8,
   "sadr": "حتّى أَجزتُ الأحْماسَ إنِّي على",
   "ajuz": "أَمْثَالِ هَاتِيكَ حَازمٌ بَطَلُ",
   "text": "حتّى أَجزتُ الأحْماسَ إنِّي على    أَمْثَالِ هَاتِيكَ حَازمٌ بَطَلُ"
  },
  {
   "verse_index": 9,
   "sadr": "فلَم يَرُعْهَا إلَّا قِيَامِي لَدى الـ",
   "ajuz": "ـبَابِ فجاءتْ والمَشْيُ مُنْخَزِلُ",
   "text": "فلَم يَرُعْهَا إلَّا قِيَامِي لَدى الـ    ـبَابِ فجاءتْ والمَشْيُ مُنْخَزِلُ"
  },
  {
   "verse_index": 10,
   "sadr": "تقولُ يَا مَرْحبًا ويَرْعَبُهَا الـ",
   "ajuz": "ـخَوْفُ مِنَ الحَاضِرين والوَجَلُ",
   "text": "تقولُ يَا مَرْحبًا ويَرْعَبُهَا الـ    ـخَوْفُ مِنَ الحَاضِرين والوَجَلُ"
  },
  {
   "verse_index": 11,
   "sadr": "فَأُرْخِيَتْ دُونَنَا وقدْ هدأَ الـ",
   "ajuz": "ـلّيلُ ستورُ الحِجَابِ والكِلَلُ",
   "text": "فَأُرْخِيَتْ دُونَنَا وقدْ هدأَ الـ    ـلّيلُ ستورُ الحِجَابِ والكِلَلُ"
  },
  {
   "verse_index": 12,
   "sadr": "ثمَّ دعتْنِي إلى مُبَارَزَةِ الـ",
   "ajuz": "ـحُبِّ فرُجّتْ من تَحْتِنَا المُثُلُ",
   "text": "ثمَّ دعتْنِي إلى مُبَارَزَةِ الـ    ـحُبِّ فرُجّتْ من تَحْتِنَا المُثُلُ"
  },
  {
   "verse_index": 13,
   "sadr": "فكَان شيءٌ هيْهَاتَ أذكُرُه",
   "ajuz": "إنِّي ضنينٌ بسِرّهَا بَخِلُ",
   "text": "فكَان شيءٌ هيْهَاتَ أذكُرُه    إنِّي ضنينٌ بسِرّهَا بَخِلُ"
  },
  {
   "verse_index": 14,
   "sadr": "فَهَرْولَتْ عنْد ذاك إذْ عَظُمَ الأَ",
   "ajuz": "مْرُ وقالت ودَمْعُها هَطِلُ",
   "text": "فَهَرْولَتْ عنْد ذاك إذْ عَظُمَ الأَ    مْرُ وقالت ودَمْعُها هَطِلُ"
  },
  {
   "verse_index": 15,
   "sadr": "أيْن مِنْ أُمِّي أَفِرُّ إِنْ عَلِمَتْ",
   "ajuz": "أُمِّي بما قَدْ صنَعْتَ يَا رَجُلُ",
   "text": "أيْن مِنْ أُمِّي أَفِرُّ إِنْ عَلِمَتْ    أُمِّي بما قَدْ صنَعْتَ يَا رَجُلُ"
  },
  {
   "verse_index": 16,
   "sadr": "كيْف احتيالي لَها إذَا فَطَنَتْ",
   "ajuz": "ما تنفعُ اليومَ عندهَا العِلَلُ",
   "text": "كيْف احتيالي لَها إذَا فَطَنَتْ    ما تنفعُ اليومَ عندهَا العِلَلُ"
  },
  {
   "verse_index": 17,
   "sadr": "قدْ كان يُجْزِيك لَو قنعتَ بِه",
   "ajuz": "فيمَا فَعلْتَ اللِّزَامُ والقُبَلُ",
   "text": "قدْ كان يُجْزِيك لَو قنعتَ بِه    فيمَا فَعلْتَ اللِّزَامُ والقُبَلُ"
  },
  {
   "verse_index": 18,
   "sadr": "لكنْ أَبَتْ شَقْوتِي فَهاتِ فَمَا",
   "ajuz": "أحتالُ أمْ مَا أَقُول إنْ سَأَلُوا",
   "text": "لكنْ أَبَتْ شَقْوتِي فَهاتِ فَمَا    أحتالُ أمْ مَا أَقُول إنْ سَأَلُوا"
