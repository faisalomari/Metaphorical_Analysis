 "verses": [
  {
   "verse_index": 1,
   "sadr": "لا تفرُغ النَّفْسُ من شُغْل بدُنْياها",
   "ajuz": "رأَيتها لم ينَلْها مَن تمنّاها",
   "text": "لا تفرُغ النَّفْسُ من شُغْل بدُنْياها    رأَيتها لم ينَلْها مَن تمنّاها"
  },
  {
   "verse_index": 2,
   "sadr": "إِنّا لننفَس في دُنْيا مولِّيةٍ",
   "ajuz": "ونحن قد نكتفي منها بأَدْناها",
   "text": "إِنّا لننفَس في دُنْيا مولِّيةٍ    ونحن قد نكتفي منها بأَدْناها"
  },
  {
   "verse_index": 3,
   "sadr": "حذّرتُك الكِبْرَ لا يعلَقْك مِيسَمُه",
   "ajuz": "فإِنه مَلْبَسٌ نازعتَه اللّها",
   "text": "حذّرتُك الكِبْرَ لا يعلَقْك مِيسَمُه    فإِنه مَلْبَسٌ نازعتَه اللّها"
  },
  {
   "verse_index": 4,
   "sadr": "يا بُؤْسَ جِلْدٍ على عَظْمِ مخرَّقةٍ",
   "ajuz": "فيه الخُروقُ إِذا كلّمتَه تاها",
   "text": "يا بُؤْسَ جِلْدٍ على عَظْمِ مخرَّقةٍ    فيه الخُروقُ إِذا كلّمتَه تاها"
  },
  {
   "verse_index": 5,
   "sadr": "يرى عليك له فَضْلًا يبين به",
   "ajuz": "إِن نال في العاجل السُّلْطانَ والجاها",
   "text": "يرى عليك له فَضْلًا يبين به    إِن نال في العاجل السُّلْطانَ والجاها"
  },
  {
   "verse_index": 6,
   "sadr": "مُثنٍ على نَفْسه راضٍ بسِيرتها",
   "ajuz": "كذبتَ يا خادمَ الدُّنْيا ومَوْلاها",
   "text": "مُثنٍ على نَفْسه راضٍ بسِيرتها    كذبتَ يا خادمَ الدُّنْيا ومَوْلاها"
  },
  {
   "verse_index": 7,
   "sadr": "إِنّي لَأَمقُت نَفْسي عند نَخْوتها",
   "ajuz": "فكيف آمَن مَقْتَ اللهِ إِيّاها",
   "text": "إِنّي لَأَمقُت نَفْسي عند نَخْوتها    فكيف آمَن مَقْتَ اللهِ إِيّاها"
  },
  {
   "verse_index": 8,
   "sadr": "أَنتَ اللَّئيمُ الذي لم تعدُ هِمّتُه",
   "ajuz": "إِيثارَ دُنْيا إِذا نادتْه لبّاها",
   "text": "أَنتَ اللَّئيمُ الذي لم تعدُ هِمّتُه    إِيثارَ دُنْيا إِذا نادتْه لبّاها"
  },
  {
   "verse_index": 9,
   "sadr": "يا راكِبَ الذَّنْبِ قد شابتْ مَفارِقُه",
   "ajuz": "أَما تخاف من الأَيّام عُقْباها",
