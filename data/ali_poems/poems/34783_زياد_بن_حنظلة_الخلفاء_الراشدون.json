  {
   "verse_index": 1,
   "sadr": "تَذَكَّرْتُ حَرْبَ الشَّامِ لَمَّا تَطَاوَلَتْ",
   "ajuz": "وَإِذْ نَحْنُ فِي عَامٍ كَثِيرٍ تَزَايُلُهْ",
   "text": "تَذَكَّرْتُ حَرْبَ الشَّامِ لَمَّا تَطَاوَلَتْ    وَإِذْ نَحْنُ فِي عَامٍ كَثِيرٍ تَزَايُلُهْ"
  },
  {
   "verse_index": 2,
   "sadr": "وَإِذْ نَحْنُ فِي أَرْضِ الحِجَازِ وَبَيْنَنَا",
   "ajuz": "مَسِيرَةُ شَهْرٍ بَيْنَهُنَّ بَلَابِلُهْ",
   "text": "وَإِذْ نَحْنُ فِي أَرْضِ الحِجَازِ وَبَيْنَنَا    مَسِيرَةُ شَهْرٍ بَيْنَهُنَّ بَلَابِلُهْ"
  },
  {
   "verse_index": 3,
   "sadr": "وَإِذْ أَرْطَبُونُ الرُّومِ يَحْمِي بِلَادَهُ",
   "ajuz": "يُجَاوِلُهُ قَرْنٌ هُنَاكَ يُسَاجِلُهْ",
   "text": "وَإِذْ أَرْطَبُونُ الرُّومِ يَحْمِي بِلَادَهُ    يُجَاوِلُهُ قَرْنٌ هُنَاكَ يُسَاجِلُهْ"
  },
  {
   "verse_index": 4,
   "sadr": "فَلَمَّا رَأَى الفَارُوقُ أَزْمَانَ فَتْحِهَا",
   "ajuz": "سَمَا بِجُنُودِ اللهِ كَيْمَا يُصَاوِلُهْ",
   "text": "فَلَمَّا رَأَى الفَارُوقُ أَزْمَانَ فَتْحِهَا    سَمَا بِجُنُودِ اللهِ كَيْمَا يُصَاوِلُهْ"
  },
  {
   "verse_index": 5,
   "sadr": "فَلَمَّا أَحَسُّوهُ وَخَافُوا صُوالَهُ",
   "ajuz": "أَتَوْهُ وَقَالُوا أَنْتَ مِمَّن يُوَاصِلُهْ",
   "text": "فَلَمَّا أَحَسُّوهُ وَخَافُوا صُوالَهُ    أَتَوْهُ وَقَالُوا أَنْتَ مِمَّن يُوَاصِلُهْ"
  },
  {
   "verse_index": 6,
   "sadr": "وَأَلْقَتْ إِلَيْهِ الشَّامُ أَفْلَاذَ كِبْدِهَا",
   "ajuz": "وَعَيْشًا خَصِيبًا مَا تُعَدُّ مَآكِلُهْ",
   "text": "وَأَلْقَتْ إِلَيْهِ الشَّامُ أَفْلَاذَ كِبْدِهَا    وَعَيْشًا خَصِيبًا مَا تُعَدُّ مَآكِلُهْ"
  },
  {
   "verse_index": 7,
   "sadr": "أَبَاحَ لَنَا مَا بَيْنَ شَرْقٍ وَمَغْرِبٍ",
   "ajuz": "مَوَارِيثَ أَعْقَابٍ بَنَتْهَا قَرَامِلُهْ",
   "text": "أَبَاحَ لَنَا مَا بَيْنَ شَرْقٍ وَمَغْرِبٍ    مَوَارِيثَ أَعْقَابٍ بَنَتْهَا قَرَامِلُهْ"
  },
  {
   "verse_index": 8,
   "sadr": "وَكَمْ مُثْقَلٍ لَمْ نَضْطَلِعْ بِاحْتِمَالِهِ",
   "ajuz": "تَحَمَّلَ عَنَّا حِينَ شَالَتْ شَوَائِلُهْ",
