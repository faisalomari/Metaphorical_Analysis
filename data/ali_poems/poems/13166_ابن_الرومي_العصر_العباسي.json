 "verses": [
  {
   "verse_index": 1,
   "sadr": "وسميطةٍ صفراءَ دينارية",
   "ajuz": "ثمنا ولونا زفَّها لك حَزْوَرُ",
   "text": "وسميطةٍ صفراءَ دينارية    ثمنا ولونا زفَّها لك حَزْوَرُ"
  },
  {
   "verse_index": 2,
   "sadr": "عَظمتْ فكادت أن تكون إوزة",
   "ajuz": "ونَوتْ فكاد إهابها يتفطّرُ",
   "text": "عَظمتْ فكادت أن تكون إوزة    ونَوتْ فكاد إهابها يتفطّرُ"
  },
  {
   "verse_index": 3,
   "sadr": "طفِقت تجود بذَوْبها جُوذابة\t",
   "ajuz": "قَانَى لبابَ اللوز فيها السكَّر",
   "text": "طفِقت تجود بذَوْبها جُوذابة\t    قَانَى لبابَ اللوز فيها السكَّر"
  },
  {
   "verse_index": 4,
   "sadr": "نِعْمَ السماء هناك ظَلَّ صَبيُها\t",
   "ajuz": "يَهمِي، ونعم الأرض ظلت تمَطر",
   "text": "نِعْمَ السماء هناك ظَلَّ صَبيُها\t    يَهمِي، ونعم الأرض ظلت تمَطر"
  },
  {
   "verse_index": 5,
   "sadr": "يا حسنَها فوق الخِوان، وبنتُها\t",
   "ajuz": "قدامها بصَهيرها يُتَغَرْغَر",
   "text": "يا حسنَها فوق الخِوان، وبنتُها\t    قدامها بصَهيرها يُتَغَرْغَر"
  },
  {
   "verse_index": 6,
   "sadr": "ظلْنا نقشِّر جلدها عن لحمها\t",
   "ajuz": "وكأن تبرا عن لُجيْن يُقشَر",
   "text": "ظلْنا نقشِّر جلدها عن لحمها\t    وكأن تبرا عن لُجيْن يُقشَر"
  },
  {
   "verse_index": 7,
   "sadr": "وتقدّمَتْها قبل ذاك ثَرائد\t",
   "ajuz": "مثل الرياض بمثلهن يُصَدَّر",
   "text": "وتقدّمَتْها قبل ذاك ثَرائد\t    مثل الرياض بمثلهن يُصَدَّر"
  },
  {
   "verse_index": 8,
   "sadr": "ومدقَّقات كلُّهن مزخرف\t",
   "ajuz": "بالبيض منها مُلْسَنٌ ومُدَثَّر",
   "text": "ومدقَّقات كلُّهن مزخرف\t    بالبيض منها مُلْسَنٌ ومُدَثَّر"
  },
  {
   "verse_index": 9,
   "sadr": "وأتتْ قَطائف بعد ذاك لطائف",
   "ajuz": "تَرْضى اللهاةُ بها، ويرضى الحنجر",
   "text": "وأتتْ قَطائف بعد ذاك لطائف    تَرْضى اللهاةُ بها، ويرضى الحنجر"
  },
  {
   "verse_index": 10,
   "sadr": "ضُحُكُ الوجوه من الطَبرزَد فوقها\t",
   "ajuz": "دمع العيون من الدِّهان تُعصَّر",
   "text": "ضُحُكُ الوجوه من الطَبرزَد فوقها\t    دمع العيون من الدِّهان تُعصَّر"
  },
  {
   "verse_index": 11,
   "sadr": "من مالِ ذي فخرٍ كأن بنانه",
   "ajuz": "خُلُجُ الفرات إذا غدت تتفجَّرُ",
   "text": "من مالِ ذي فخرٍ كأن بنانه    خُلُجُ الفرات إذا غدت تتفجَّرُ"
  },
  {
   "verse_index": 12,
   "sadr": "يعطي الكثير فيستقِل كثيره",
   "ajuz": "وقليله من غيره مستكثر",
   "text": "يعطي الكثير فيستقِل كثيره    وقليله من غيره مستكثر"
  },
  {
   "verse_index": 13,
   "sadr": "شمس يحف يمينها وشمالها\t",
   "ajuz": "بدرُ السماء ومشتريها الأزهَر",
   "text": "شمس يحف يمينها وشمالها\t    بدرُ السماء ومشتريها الأزهَر"
  },
  {
   "verse_index": 14,
   "sadr": "لله دَرُّهُمُ ثلاثةُ إخوة",
   "ajuz": "حسنتْ مَناظرهم وطاب المخبَر",
   "text": "لله دَرُّهُمُ ثلاثةُ إخوة    حسنتْ مَناظرهم وطاب المخبَر"
  },
  {
   "verse_index": 15,
   "sadr": "بكر الربيع يزِف أخضر ناضرا",
   "ajuz": "وهمُ أَزفُّ من الربيع وأنضَر",
   "text": "بكر الربيع يزِف أخضر ناضرا    وهمُ أَزفُّ من الربيع وأنضَر"
  },
  {
   "verse_index": 16,
   "sadr": "وطغتْ ثلاثة أبحر فتزاخرت",
   "ajuz": "وهمُ هنالك بالفواضل أزخَر",
   "text": "وطغتْ ثلاثة أبحر فتزاخرت    وهمُ هنالك بالفواضل أزخَر"
  },
  {
   "verse_index": 17,
   "sadr": "عَمِروا على طول الزمان فإنهم\t",
   "ajuz": "نجلٌ بهم يحيا السَّماح ويُعمَر",
   "text": "عَمِروا على طول الزمان فإنهم\t    نجلٌ بهم يحيا السَّماح ويُعمَر"
  },
  {
   "verse_index": 18,
   "sadr": "وأقول بعد مديحهم مستعتبا:",
   "ajuz": "ما للوفاء من الكرام يُؤَخر؟",
   "text": "وأقول بعد مديحهم مستعتبا:    ما للوفاء من الكرام يُؤَخر؟"
  },
  {
   "verse_index": 19,
   "sadr": "قد جاءكم تمر، وأوجب قَسْمَه\t",
   "ajuz": "قربُ المَصيف، فما لنا لا نُتمَر؟!",
   "text": "قد جاءكم تمر، وأوجب قَسْمَه\t    قربُ المَصيف، فما لنا لا نُتمَر؟!"
  },
  {
   "verse_index": 20,
   "sadr": "لاسيما ولنا بذلك موعد",
   "ajuz": "ووفاء موعدكم وفاء يؤثَر",
   "text": "لاسيما ولنا بذلك موعد    ووفاء موعدكم وفاء يؤثَر"
  },
  {
   "verse_index": 21,
   "sadr": "ما حسبكم لُطفا لديكم مُحضَرا\t",
   "ajuz": "عمن لديه به ثناء محضر",
   "text": "ما حسبكم لُطفا لديكم مُحضَرا\t    عمن لديه به ثناء محضر"
  }
