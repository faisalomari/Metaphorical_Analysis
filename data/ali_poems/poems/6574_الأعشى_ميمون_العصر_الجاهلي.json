 "verses": [
  {
   "verse_index": 1,
   "sadr": "خَالَطَ الْقَلْبَ هُمُومٌ وَحَزَنْ",
   "ajuz": "وَادِّكَارٌ بَعْدَ مَا كَانَ اطْمَأَنْ",
   "text": "خَالَطَ الْقَلْبَ هُمُومٌ وَحَزَنْ    وَادِّكَارٌ بَعْدَ مَا كَانَ اطْمَأَنْ"
  },
  {
   "verse_index": 2,
   "sadr": "فَهْوَ مَشْغُوفٌ بِهِنْدٍ هَائِمٌ",
   "ajuz": "يَرْعَوِي حِينًا وَأَحْيَانًا يَحِنْ\t",
   "text": "فَهْوَ مَشْغُوفٌ بِهِنْدٍ هَائِمٌ    يَرْعَوِي حِينًا وَأَحْيَانًا يَحِنْ"
  },
  {
   "verse_index": 3,
   "sadr": "بِلَعُوبٍ طَيِّبٍ أَرْدَانُهَا",
   "ajuz": "رَخْصَةِ الْأَطْرَافِ كَالرِّئْمِ الْأَغَنْ",
   "text": "بِلَعُوبٍ طَيِّبٍ أَرْدَانُهَا    رَخْصَةِ الْأَطْرَافِ كَالرِّئْمِ الْأَغَنْ"
  },
  {
   "verse_index": 4,
   "sadr": "وَهْيَ إِنْ تَقْعُدْ نَقًا مِنْ عَالِجٍ",
   "ajuz": "وَإِذَا قَامَتْ نِيَافًا كَالشَّطَنْ",
   "text": "وَهْيَ إِنْ تَقْعُدْ نَقًا مِنْ عَالِجٍ    وَإِذَا قَامَتْ نِيَافًا كَالشَّطَنْ"
  },
  {
   "verse_index": 5,
   "sadr": "يَنْتَهِي مِنْهَا الْوِشَاحَانِ إِلَى",
   "ajuz": "حُبْلَةٍ وَهْيَ بِمَتْنٍ كَالرَّسَنْ",
   "text": "يَنْتَهِي مِنْهَا الْوِشَاحَانِ إِلَى    حُبْلَةٍ وَهْيَ بِمَتْنٍ كَالرَّسَنْ"
  },
  {
   "verse_index": 6,
   "sadr": "خُلِقَتْ هِنْدٌ لِقَلْبِي فِتْنَةً",
   "ajuz": "هَكَذَا تَعْرِضُ لِلنّاسِ الْفِتَنْ",
   "text": "خُلِقَتْ هِنْدٌ لِقَلْبِي فِتْنَةً    هَكَذَا تَعْرِضُ لِلنّاسِ الْفِتَنْ"
  },
  {
   "verse_index": 7,
   "sadr": "لَا أَرَاهَا فِي خَلَاءٍ مَرَّةً",
   "ajuz": "وَهْيَ فِي ذَاكَ حَيَاءً لَمْ تُزَنْ",
   "text": "لَا أَرَاهَا فِي خَلَاءٍ مَرَّةً    وَهْيَ فِي ذَاكَ حَيَاءً لَمْ تُزَنْ"
  },
  {
   "verse_index": 8,
   "sadr": "ثُمَّ أَرْسَلْتُ إِلَيْهَا أَنَّنِي",
   "ajuz": "مُعْذِرٌ عُذْرِي فَرُدِّيهِ بأَنْ",
   "text": "ثُمَّ أَرْسَلْتُ إِلَيْهَا أَنَّنِي    مُعْذِرٌ عُذْرِي فَرُدِّيهِ بأَنْ"
  },
  {
   "verse_index": 9,
   "sadr": "وَبَدَرْتُ الْقَوْلَ أَنْ حَيَّيْتُهَا",
   "ajuz": "ثُمَّ أَنْشَأْتُ أُفَدِّي وَأُهَنْ",
   "text": "وَبَدَرْتُ الْقَوْلَ أَنْ حَيَّيْتُهَا    ثُمَّ أَنْشَأْتُ أُفَدِّي وَأُهَنْ"
  },
  {
   "verse_index": 10,
   "sadr": "وَأُرَجِّيهَا وَأَخْشَى ذُعْرَهَا",
   "ajuz": "مِثْلَ مَا يُفْعَلُ بِالْقَوْدِ السَّنَنْ",
   "text": "وَأُرَجِّيهَا وَأَخْشَى ذُعْرَهَا    مِثْلَ مَا يُفْعَلُ بِالْقَوْدِ السَّنَنْ"
  },
  {
   "verse_index": 11,
   "sadr": "رُبَّ يَوْمٍ قَدْ تَجُودِينَ لَنَا",
   "ajuz": "بِعَطَايَا لَمْ تُكَدِّرْهَا الْمِنَنْ",
   "text": "رُبَّ يَوْمٍ قَدْ تَجُودِينَ لَنَا    بِعَطَايَا لَمْ تُكَدِّرْهَا الْمِنَنْ"
  },
  {
   "verse_index": 12,
   "sadr": "أَنْتِ سَلْمَى هَمُّ نَفْسِي فَاذْكُرِي",
