   "text": "وَعَلَالٍ وَظِلَالٍ بَارِدٍ    وَفَلِيجِ الْمِسْكِ وَالشَّاهِسْفَرَنْ"
  },
  {
   "verse_index": 14,
   "sadr": "وَطِلَاءٍ خُسْرُوَانِيٍّ إِذَا",
   "ajuz": "ذَاقَهُ الشَّيْخُ تَغَنَّى وَارْجَحَنْ",
   "text": "وَطِلَاءٍ خُسْرُوَانِيٍّ إِذَا    ذَاقَهُ الشَّيْخُ تَغَنَّى وَارْجَحَنْ"
  },
  {
   "verse_index": 15,
   "sadr": "وَطَنَابِيرَ حِسَانٍ صَوْتُهَا",
