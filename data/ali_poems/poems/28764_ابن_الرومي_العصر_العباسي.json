  {
   "verse_index": 1,
   "sadr": "ألْبَسُ حِلْمِي عِنْدَ لُبْسِي لَهُ",
   "ajuz": "حتّى تَرَانِي سَاكِنَ النّبْضِ",
   "text": "ألْبَسُ حِلْمِي عِنْدَ لُبْسِي لَهُ    حتّى تَرَانِي سَاكِنَ النّبْضِ"
  },
  {
   "verse_index": 2,
   "sadr": "كَأنّمَا كَفّايَ قَدْ غُلّتَا",
   "ajuz": "عَنْ حَرَكَاتِ البَسْطِ والقَبْضِ",
   "text": "كَأنّمَا كَفّايَ قَدْ غُلّتَا    عَنْ حَرَكَاتِ البَسْطِ والقَبْضِ"
  },
  {
   "verse_index": 3,
   "sadr": "خوفًا على نِضْوٍ بَرَاهُ البِلَى",
   "ajuz": "فَبَعْضُه يَبْكِي عَلَى بَعْضِ",
   "text": "خوفًا على نِضْوٍ بَرَاهُ البِلَى    فَبَعْضُه يَبْكِي عَلَى بَعْضِ"
  },
  {
   "verse_index": 4,
   "sadr": "أَدِبُّ مَشْيًا وهْو في صَيحَةٍ",
   "ajuz": "يَشْكُو وَيسْتَعْفِي منَ الركْضِ",
   "text": "أَدِبُّ مَشْيًا وهْو في صَيحَةٍ    يَشْكُو وَيسْتَعْفِي منَ الركْضِ"
  },
  {
   "verse_index": 5,
   "sadr": "يَا طَيْلَسَانٌ أَنَا وقْفٌ لَهُ",
   "ajuz": "أرْفُوه بالفَرْضِ وبِالقَرْضِ",
   "text": "يَا طَيْلَسَانٌ أَنَا وقْفٌ لَهُ    أرْفُوه بالفَرْضِ وبِالقَرْضِ"
  },
  {
   "verse_index": 6,
   "sadr": "حَتّى مَتَى أنتَ كَذَا مُبْتَلًى",
   "ajuz": "بِالسُّلّ لَا تَحْيَا ولَا تَقْضِي",
   "text": "حَتّى مَتَى أنتَ كَذَا مُبْتَلًى    بِالسُّلّ لَا تَحْيَا ولَا تَقْضِي"
  },
  {
   "verse_index": 7,
