  },
  {
   "verse_index": 23,
   "sadr": "سرّني، برَّني، رعاني، كفاني",
   "ajuz": "جازَهُ السوءُ، إنه ما أساء",
   "text": "سرّني، برَّني، رعاني، كفاني    جازَهُ السوءُ، إنه ما أساء"
  },
  {
   "verse_index": 24,
   "sadr": "وتخطَّته كلُّ بأساءَ لكنْ",
   "ajuz": "صادمتْ مِن ورائه الأعداء",
   "text": "وتخطَّته كلُّ بأساءَ لكنْ    صادمتْ مِن ورائه الأعداء"
  },
  {
   "verse_index": 25,
   "sadr": "وتعالتْ به سماءُ المعالي",
