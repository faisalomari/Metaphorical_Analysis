 "verses": [
  {
   "verse_index": 1,
   "sadr": "أحمدُ اللَّه نيةً وثناءَ",
   "ajuz": "غُدوةً بل عَشية بل مساءَ",
   "text": "أحمدُ اللَّه نيةً وثناءَ    غُدوةً بل عَشية بل مساءَ"
  },
  {
   "verse_index": 2,
   "sadr": "بلْ جميعا، وبين ذلك، حمدًا",
   "ajuz": "أبديّا يُطبِّقُ الآناءَ",
   "text": "بلْ جميعا، وبين ذلك، حمدًا    أبديّا يُطبِّقُ الآناءَ"
  },
  {
   "verse_index": 3,
   "sadr": "حَمْدَ مُستعظمٍ جلالا عظيما",
   "ajuz": "من مَليكٍ، وشاكرٍ آلاءَ",
   "text": "حَمْدَ مُستعظمٍ جلالا عظيما    من مَليكٍ، وشاكرٍ آلاءَ"
  },
  {
   "verse_index": 4,
   "sadr": "مَلِكٌ يقدحُ الحياة من الموْ",
   "ajuz": "تى، ويَكفي بفضله الأحياء",
   "text": "مَلِكٌ يقدحُ الحياة من الموْ    تى، ويَكفي بفضله الأحياء"
  },
  {
   "verse_index": 5,
   "sadr": "صاغنا ثم قاتنا ووَقانا",
   "ajuz": "بالتي نَتَّقي بها الأَسواء",
   "text": "صاغنا ثم قاتنا ووَقانا    بالتي نَتَّقي بها الأَسواء"
  },
  {
   "verse_index": 6,
   "sadr": "من بناءٍ يَكِنُّنا، ولَبُوسٍ",
   "ajuz": "ودواء يحارب الأدواء",
   "text": "من بناءٍ يَكِنُّنا، ولَبُوسٍ    ودواء يحارب الأدواء"
  },
  {
   "verse_index": 7,
   "sadr": "ثم أهدى لنا الفواكهَ شتى",
   "ajuz": "والتحياتِ، جَلَّ ذاك عطاء!",
   "text": "ثم أهدى لنا الفواكهَ شتى    والتحياتِ، جَلَّ ذاك عطاء!"
  },
  {
   "verse_index": 8,
   "sadr": "عَظُمت تلكمُ الأيادي وجَلَّت",
   "ajuz": "فاذكرِ المَوز، واتركِ الأشياء",
   "text": "عَظُمت تلكمُ الأيادي وجَلَّت    فاذكرِ المَوز، واتركِ الأشياء"
  },
  {
   "verse_index": 9,
   "sadr": "إِنما الموزُ حين تُمْكَنُ منه",
   "ajuz": "كاسمه مُبْدلًا من الميم فاء",
   "text": "إِنما الموزُ حين تُمْكَنُ منه    كاسمه مُبْدلًا من الميم فاء"
  },
  {
   "verse_index": 10,
   "sadr": "وكذا فقدُه العزيزُ علينا",
   "ajuz": "كاسمه مُبْدلا من الزاي تاء",
   "text": "وكذا فقدُه العزيزُ علينا    كاسمه مُبْدلا من الزاي تاء"
  },
  {
   "verse_index": 11,
   "sadr": "فهو الفوزُ مثلما فقدُه المو",
   "ajuz": "تُ، لقد بان فضلُه، لا خفاء",
   "text": "فهو الفوزُ مثلما فقدُه المو    تُ، لقد بان فضلُه، لا خفاء"
  },
  {
   "verse_index": 12,
   "sadr": "ولهذا التأويلِ سَماهُ موزا",
   "ajuz": "مَنْ أفاد المعانيَ الأسماء",
   "text": "ولهذا التأويلِ سَماهُ موزا    مَنْ أفاد المعانيَ الأسماء"
  },
  {
   "verse_index": 13,
   "sadr": "رَبِّ فاجعله لي صبوحا وقَيْلا",
   "ajuz": "وغَبوقا وما أسأتَ الغذاء",
   "text": "رَبِّ فاجعله لي صبوحا وقَيْلا    وغَبوقا وما أسأتَ الغذاء"
  },
  {
   "verse_index": 14,
   "sadr": "وأرى بل أبُتُّ أن جوابي",
   "ajuz": "لا تُغالطْ فقد سألتَ البقاء",
   "text": "وأرى بل أبُتُّ أن جوابي    لا تُغالطْ فقد سألتَ البقاء"
  },
  {
   "verse_index": 15,
   "sadr": "يشهدُ الله إنه لطعامٌ",
   "ajuz": "خُرَّميٌّ يُغازل الأحشاء",
   "text": "يشهدُ الله إنه لطعامٌ    خُرَّميٌّ يُغازل الأحشاء"
  },
  {
   "verse_index": 16,
   "sadr": "نَكهةٌ عذبةٌ، وطعمٌ لذيذٌ",
   "ajuz": "سَاعدا نَعمةً إلى نَعْماءَ",
   "text": "نَكهةٌ عذبةٌ، وطعمٌ لذيذٌ    سَاعدا نَعمةً إلى نَعْماءَ"
  },
  {
   "verse_index": 17,
   "sadr": "وتخالُ انْسرابهُ في مجاريـ",
   "ajuz": "ـه افتراعَ الأبكارِ، والإغفاءَ",
   "text": "وتخالُ انْسرابهُ في مجاريـ    ـه افتراعَ الأبكارِ، والإغفاءَ"
  },
  {
   "verse_index": 18,
   "sadr": "لو تكونُ القلوبُ مأوى طعامٍ",
   "ajuz": "نازَعتْهُ قلوبنا الأحشاء",
   "text": "لو تكونُ القلوبُ مأوى طعامٍ    نازَعتْهُ قلوبنا الأحشاء"
  },
  {
   "verse_index": 19,
   "sadr": "إنني لَلْحقيقُ بالشِّبَع السا",
   "ajuz": "ئغِ من أكلهِ وإن كان ماء",
   "text": "إنني لَلْحقيقُ بالشِّبَع السا    ئغِ من أكلهِ وإن كان ماء"
  },
  {
   "verse_index": 20,
   "sadr": "مِن عطايا أبي محمد المحـ",
   "ajuz": "ـمودِ ظَرفًا وحكمةً وسخاء",
   "text": "مِن عطايا أبي محمد المحـ    ـمودِ ظَرفًا وحكمةً وسخاء"
  },
  {
   "verse_index": 21,
   "sadr": "وجمالاً مُنَمَّقا وجلالا",
   "ajuz": "ووفاءً مُحقَّقا، وصفاء",
   "text": "وجمالاً مُنَمَّقا وجلالا    ووفاءً مُحقَّقا، وصفاء"
  },
  {
   "verse_index": 22,
   "sadr": "ذلك السيدُ الذي قتل اليأ",
   "ajuz": "سَ بأفضاله وأحيا الرجاء",
