 "verses": [
  {
   "verse_index": 1,
   "sadr": "إنِّي كأنِّي، لدى النّعمانِ خبّرَهُ",
   "ajuz": "بعض الأوُدّ حديثاً، غير مكذوبِ",
   "text": "إنِّي كأنِّي، لدى النّعمانِ خبّرَهُ    بعض الأوُدّ حديثاً، غير مكذوبِ"
  },
  {
   "verse_index": 2,
   "sadr": "بأن حصنْاَ وحيّاً من بني أسدٍ،",
   "ajuz": "قاموا، فقالوا: حمانا غيرُ مقروبِ",
   "text": "بأن حصنْاَ وحيّاً من بني أسدٍ،    قاموا، فقالوا: حمانا غيرُ مقروبِ"
  },
  {
   "verse_index": 3,
   "sadr": "ضلّت حلومهم عنهم، وغرّهم",
   "ajuz": "سنُّ المُعَيديّ في رعيٍ وتعزيبِ",
   "text": "ضلّت حلومهم عنهم، وغرّهم    سنُّ المُعَيديّ في رعيٍ وتعزيبِ"
  },
  {
   "verse_index": 4,
   "sadr": "قادَ الجيادَ منَ الجولانِ، قائظةً،",
   "ajuz": "من بينِ مُنعلةٍ تُزجى، ومجنوبِ",
   "text": "قادَ الجيادَ منَ الجولانِ، قائظةً،    من بينِ مُنعلةٍ تُزجى، ومجنوبِ"
  },
  {
   "verse_index": 5,
   "sadr": "حتى استغاثت بأهلِ ((الملحِ))، ما طعمتْ،",
   "ajuz": "في منزلٍ، طعمَ نومٍ غيرَ تأويبِ",
   "text": "حتى استغاثت بأهلِ ((الملحِ))، ما طعمتْ،    في منزلٍ، طعمَ نومٍ غيرَ تأويبِ"
  },
  {
   "verse_index": 6,
   "sadr": "ينضحنَ نضحَ المزادِ الوُفْرِ أتأقَها",
   "ajuz": "شدُّ الرُّواةِ بماء، غيرِ مشروبِ",
   "text": "ينضحنَ نضحَ المزادِ الوُفْرِ أتأقَها    شدُّ الرُّواةِ بماء، غيرِ مشروبِ"
  },
  {
   "verse_index": 7,
   "sadr": "قُبُّ الأياطلِ تردي في أعنّتها،",
   "ajuz": "كالخاضِباتِ منَ الزُّعرِ الظّنابيبِ",
   "text": "قُبُّ الأياطلِ تردي في أعنّتها،    كالخاضِباتِ منَ الزُّعرِ الظّنابيبِ"
  },
  {
   "verse_index": 8,
   "sadr": "شُعْثٌ، عليها مساعيرٌ لحربهمُ،",
   "ajuz": "شُمُّ العرانينِ من مُرْدٍ ومن شيبِ",
   "text": "شُعْثٌ، عليها مساعيرٌ لحربهمُ،    شُمُّ العرانينِ من مُرْدٍ ومن شيبِ"
  },
  {
   "verse_index": 9,
   "sadr": "وما بحصنٍ نُعاسٌ إذ تُؤرّقُهُ",
   "ajuz": "أصواتُ حيٍّ، على الأمرارِ، محروبِ",
   "text": "وما بحصنٍ نُعاسٌ إذ تُؤرّقُهُ    أصواتُ حيٍّ، على الأمرارِ، محروبِ"
  },
  {
   "verse_index": 10,
   "sadr": "ظلّت أقاطيعُ أنعامٍ مُؤبَّلةٍ،",
   "ajuz": "لدى صليبٍ، على الزّوراء، منصوبِ",
   "text": "ظلّت أقاطيعُ أنعامٍ مُؤبَّلةٍ،    لدى صليبٍ، على الزّوراء، منصوبِ"
  },
  {
   "verse_index": 11,
   "sadr": "فإذ وُقيتِ، بحمدِ اللَّهِ، شرّتها،",
   "ajuz": "فانجي، فزارَ، إلى الأطوادِ، فاللُّوبِ",
   "text": "فإذ وُقيتِ، بحمدِ اللَّهِ، شرّتها،    فانجي، فزارَ، إلى الأطوادِ، فاللُّوبِ"
  },
  {
   "verse_index": 12,
   "sadr": "ولا تُلاقي كما لاقتْ بنو أسدٍ،",
   "ajuz": "فقد أصابتهمُ منها بشؤبوبِ",
   "text": "ولا تُلاقي كما لاقتْ بنو أسدٍ،    فقد أصابتهمُ منها بشؤبوبِ"
  },
  {
   "verse_index": 13,
   "sadr": "لم يبقَ غيرُ طريدٍ غيرِ مُنفلتٍ،",
   "ajuz": "وموثقٍ في حبالِ القِد، مسلوبِ",
   "text": "لم يبقَ غيرُ طريدٍ غيرِ مُنفلتٍ،    وموثقٍ في حبالِ القِد، مسلوبِ"
  },
  {
   "verse_index": 14,
   "sadr": "أو حُرةٍ كمهاةِ الرّملِ قد كُبِلَتْ",
   "ajuz": "فوقَ المعاصمِ منها، والعراقيبِ",
   "text": "أو حُرةٍ كمهاةِ الرّملِ قد كُبِلَتْ    فوقَ المعاصمِ منها، والعراقيبِ"
  },
  {
   "verse_index": 15,
   "sadr": "تدعو قُعَيناً وقد عَضّ الحديدُ بها،",
   "ajuz": "عضَّ الثّقاف على صُمّ الأنابيبِ",
   "text": "تدعو قُعَيناً وقد عَضّ الحديدُ بها،    عضَّ الثّقاف على صُمّ الأنابيبِ"
  },
  {
   "verse_index": 16,
   "sadr": "مُستشعرِينَ قدَ الفوا، في ديارهمُ،",
   "ajuz": "دُعاء سوعٍ، ودُعميٍّ، وأيّوبِ",
   "text": "مُستشعرِينَ قدَ الفوا، في ديارهمُ،    دُعاء سوعٍ، ودُعميٍّ، وأيّوبِ"
  }
 ],
