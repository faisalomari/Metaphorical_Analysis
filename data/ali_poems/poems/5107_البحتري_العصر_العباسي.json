   "element": "اشتقاق",
   "subtype": "اشتقاق",
   "theme": "وصف الطبيعة",
   "analysis": "",
   "raw_key": 1396
  },
  {
   "span_text": "وَدَكَّتَيْنِ كَمِثْلِ الشّعْرَيَيْنِ غَدَتْ إحْدَاهُما بِإِزَا الأُخْرى تُسَاميها",
   "verse_index": "30,30,30,30,30,30,30,30",
   "element": "تشبيه",
   "subtype": "تشبيه",
   "theme": "وصف الطبيعة",
   "analysis": "",
   "raw_key": 1397
  },
