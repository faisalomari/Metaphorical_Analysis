   "element": "تشبيه",
   "subtype": "تشبيه غريب",
   "theme": "وصف الطبيعة",
   "analysis": "",
   "raw_key": 1390
  },
  {
   "span_text": "زِينَةً زينَتِها",
   "verse_index": "28,28",
   "element": "اشتقاق",
   "subtype": "اشتقاق",
   "theme": "وصف الطبيعة",
   "analysis": "",
   "raw_key": 1391
  },
  {
   "span_text": "وَزَادَها زِينَةً",
   "verse_index": "28,28",
   "element": "استعارة",
   "subtype": "استعارة فعل",
   "theme": "وصف الطبيعة",
   "analysis": "",
   "raw_key": 1392
  },
  {
   "span_text": "وَزَادَها زِينَةً أَنَّ اسْمَهُ حِينَ يُدعى مِنْ أَسَاميها",
   "verse_index": "28,28,28,28,28,28,28,28",
   "element": "مجاز",
   "subtype": "مجاز عقلي",
   "theme": "وصف الطبيعة",
   "analysis": "",
   "raw_key": 1393
  },
  {
