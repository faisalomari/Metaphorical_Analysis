 "verses": [
  {
   "verse_index": 1,
   "sadr": "أَعَاتِكَ بِنْتَ العَبْشَمِيَّةِ عَاتِكا\t",
   "ajuz": "أَثيبي اٌمْرَأً أَمْسى بِحُبِّكِ هَالِكا",
   "text": "أَعَاتِكَ بِنْتَ العَبْشَمِيَّةِ عَاتِكا\t    أَثيبي اٌمْرَأً أَمْسى بِحُبِّكِ هَالِكا"
  },
  {
   "verse_index": 2,
   "sadr": "بَدَتْ لِيَ في أَتْرابِهَا فَقَتَلْنَنِي\t",
   "ajuz": "كَذَلِكَ يَقْتُلْنَ الرِّجَالَ كَذالِكا",
   "text": "بَدَتْ لِيَ في أَتْرابِهَا فَقَتَلْنَنِي\t    كَذَلِكَ يَقْتُلْنَ الرِّجَالَ كَذالِكا"
  },
  {
   "verse_index": 3,
   "sadr": "نَظَرْنَ إِلَيْنَا بِالْوُجُوهِ كَأَنَّما\t",
   "ajuz": "جَلَوْنَ لَنَا فَوْقَ البِغَالِ السَّبائِكا",
   "text": "نَظَرْنَ إِلَيْنَا بِالْوُجُوهِ كَأَنَّما\t    جَلَوْنَ لَنَا فَوْقَ البِغَالِ السَّبائِكا"
  },
  {
   "verse_index": 4,
   "sadr": "إِذا غَفَلَتْ عَنّا العُيونُ الَّتي تََرَى\t",
   "ajuz": "سَلَكْنَ بِنا حَيْثُ اٌشْتََهَيْنَ المَسالِكا",
   "text": "إِذا غَفَلَتْ عَنّا العُيونُ الَّتي تََرَى\t    سَلَكْنَ بِنا حَيْثُ اٌشْتََهَيْنَ المَسالِكا"
  },
  {
   "verse_index": 5,
   "sadr": "وَقالَتْ لَوَ اٌنّا نَسْتَطيعُ لَزَارَكُمْ\t",
   "ajuz": "طَبِيبَانِ مِنّا عَالِمانِ بِدائِكَا",
   "text": "وَقالَتْ لَوَ اٌنّا نَسْتَطيعُ لَزَارَكُمْ\t    طَبِيبَانِ مِنّا عَالِمانِ بِدائِكَا"
  },
  {
   "verse_index": 6,
   "sadr": "وَلَكِنَّ قَوْمي أَحْدَثوا بَعْدَ عَهْدِنا\t",
   "ajuz": "وَعَهْدِكَ أَضْغَاناً كَلِفْنَ بِشانِكا",
   "text": "وَلَكِنَّ قَوْمي أَحْدَثوا بَعْدَ عَهْدِنا\t    وَعَهْدِكَ أَضْغَاناً كَلِفْنَ بِشانِكا"
  },
  {
   "verse_index": 7,
   "sadr": "تُذَكِّرُني قَتلى بِحَرَّةِ وَاقِمٍ\t",
   "ajuz": "أُصِيبَتْ وَأَرْحاماً قُطِعْنَ شَوَابِكا",
   "text": "تُذَكِّرُني قَتلى بِحَرَّةِ وَاقِمٍ\t    أُصِيبَتْ وَأَرْحاماً قُطِعْنَ شَوَابِكا"
  },
  {
   "verse_index": 8,
   "sadr": "وَقَدْ كانَ قَوْمي قَبْلَ ذاكَ وَقَوْمُها\t",
   "ajuz": "قَدَ اٌوْرَوْا بِها عَوْداً مِنَ المَجدِ تامِكا",
   "text": "وَقَدْ كانَ قَوْمي قَبْلَ ذاكَ وَقَوْمُها\t    قَدَ اٌوْرَوْا بِها عَوْداً مِنَ المَجدِ تامِكا"
  },
  {
   "verse_index": 9,
   "sadr": "هُمُ يَرْتُقُونَ الفَتْقَ بَعدَ اٌنخِراقِهِ\t",
   "ajuz": "بِحِلمٍ وَيَهدُونَ الحَجِيجَ المَنَاسِكا",
   "text": "هُمُ يَرْتُقُونَ الفَتْقَ بَعدَ اٌنخِراقِهِ\t    بِحِلمٍ وَيَهدُونَ الحَجِيجَ المَنَاسِكا"
  },
  {
   "verse_index": 10,
   "sadr": "فَقُطِّعَ أَرْحَامٌ وَفُضَّتْ جَمَاعَةٌ\t",
   "ajuz": "وَعادَتْ رَوَايا الحِلْمِ بَعْدُ رَكائِكا",
   "text": "فَقُطِّعَ أَرْحَامٌ وَفُضَّتْ جَمَاعَةٌ\t    وَعادَتْ رَوَايا الحِلْمِ بَعْدُ رَكائِكا"
  },
  {
   "verse_index": 11,
   "sadr": "فَمَنْ مُبْلِِغٌ عَنِّي خَليلَيَّ آيَةً\t",
   "ajuz": "عُيَيْنَةَ أَعْنِي بِالعِرَاقِ وَمالِكا",
   "text": "فَمَنْ مُبْلِِغٌ عَنِّي خَليلَيَّ آيَةً\t    عُيَيْنَةَ أَعْنِي بِالعِرَاقِ وَمالِكا"
  },
  {
   "verse_index": 12,
   "sadr": "فَهَلْ مِنْ طَبِيبٍ بِالعِرَاقِ لَعَلَّهُ",
   "ajuz": "يُداوِي كَرِيماً هَالِكاً مُتَهَالِكا",
