 "verses": [
  {
   "verse_index": 1,
   "sadr": "يا طَلْعَةً طَلَعَ الحِمامُ عليها",
   "ajuz": "وجنى لها ثَمَرَ الرَّدى بيدَيها",
   "text": "يا طَلْعَةً طَلَعَ الحِمامُ عليها    وجنى لها ثَمَرَ الرَّدى بيدَيها"
  },
  {
   "verse_index": 2,
   "sadr": "رَوَّيْتُ من دمِها الثَّرى ولطالما",
   "ajuz": "رَوَّى الهوى شَفَتَيَّ من شَفَتيْها",
   "text": "رَوَّيْتُ من دمِها الثَّرى ولطالما    رَوَّى الهوى شَفَتَيَّ من شَفَتيْها"
  },
  {
   "verse_index": 3,
   "sadr": "قَدْ باتَ سَيْفي في مَجالِ وشاحِها",
   "ajuz": "ومدامعي تَجْري على خَدَّيْها",
   "text": "قَدْ باتَ سَيْفي في مَجالِ وشاحِها    ومدامعي تَجْري على خَدَّيْها"
  },
  {
   "verse_index": 4,
   "sadr": "فَوَحَقِّ نَعْلَيْها وما وطِئ الحصى",
   "ajuz": "شَيءٌ أعَزُّ عَلَيَّ من نَعْلَيها",
   "text": "فَوَحَقِّ نَعْلَيْها وما وطِئ الحصى    شَيءٌ أعَزُّ عَلَيَّ من نَعْلَيها"
  },
  {
   "verse_index": 5,
   "sadr": "ما كانَ قَتْليها لأنِّي لم أكُنْ",
   "ajuz": "أبْكِي إذا سَقَطَ الغُبارُ عليها",
   "text": "ما كانَ قَتْليها لأنِّي لم أكُنْ    أبْكِي إذا سَقَطَ الغُبارُ عليها"
