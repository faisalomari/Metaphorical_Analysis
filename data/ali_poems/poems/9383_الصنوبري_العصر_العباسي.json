 "verses": [
  {
   "verse_index": 1,
   "sadr": "قد أتانا بطيبهِ آذارُ",
   "ajuz": "وَشَجَتْنَا بشجوِهَا الأطيارُ",
   "text": "قد أتانا بطيبهِ آذارُ    وَشَجَتْنَا بشجوِهَا الأطيارُ"
  },
  {
   "verse_index": 2,
   "sadr": "ما ترى الروضَ كيف يُبدي شُموسًا",
   "ajuz": "طالعاتٍ ما بينها أقمارُ",
   "text": "ما ترى الروضَ كيف يُبدي شُموسًا    طالعاتٍ ما بينها أقمارُ"
  },
  {
   "verse_index": 3,
   "sadr": "إخضرارٌ لم يخلُ منه اصفرارٌ",
   "ajuz": "وابيضاضٌ لم يخلُ منه احمرارُ",
   "text": "إخضرارٌ لم يخلُ منه اصفرارٌ    وابيضاضٌ لم يخلُ منه احمرارُ"
  },
  {
   "verse_index": 4,
   "sadr": "واذا ما الرياضُ جاد عليها الـ",
   "ajuz": "ـقَطْرُ جادتْ بها علينا العُقَارُ",
   "text": "واذا ما الرياضُ جاد عليها الـ    ـقَطْرُ جادتْ بها علينا العُقَارُ"
  },
  {
   "verse_index": 5,
   "sadr": "عاتقٌ في الدّنانِ بكرٌ أدارتْـ",
   "ajuz": "ـها علينا عواتقٌ أبكارُ",
   "text": "عاتقٌ في الدّنانِ بكرٌ أدارتْـ    ـها علينا عواتقٌ أبكارُ"
  },
  {
   "verse_index": 6,
   "sadr": "كلُّ مجدولةٍ يجولُ وشاحانِ",
   "ajuz": "على خصرِها ويشجَى السِّوارُ",
   "text": "كلُّ مجدولةٍ يجولُ وشاحانِ    على خصرِها ويشجَى السِّوارُ"
  },
  {
   "verse_index": 7,
   "sadr": "يُقْطَفُ الياسمينُ من جسمها الرطـ",
   "ajuz": "ـبِ ويُجْنَى من خدِّها الجلنَّارُ",
   "text": "يُقْطَفُ الياسمينُ من جسمها الرطـ    ـبِ ويُجْنَى من خدِّها الجلنَّارُ"
  },
  {
   "verse_index": 8,
   "sadr": "لا أرى القصفَ بالهنيّ هنيًّا",
   "ajuz": "أو تُقَضَّى في عُمْرِهِ الأعمارُ",
   "text": "لا أرى القصفَ بالهنيّ هنيًّا    أو تُقَضَّى في عُمْرِهِ الأعمارُ"
  },
  {
   "verse_index": 9,
   "sadr": "يا نديمي: رأيتَ أحْسَنَ من ذا الز",
   "ajuz": "هرِ بعضٌ يهوى وبعضٌ يَغارُ؟",
   "text": "يا نديمي: رأيتَ أحْسَنَ من ذا الز    هرِ بعضٌ يهوى وبعضٌ يَغارُ؟"
  },
  {
   "verse_index": 10,
   "sadr": "صُوَرٌ لا تزالُ ألوانُها تنبيكَ",
   "ajuz": "عمَّا يُجِنُّه الاضمارُ",
   "text": "صُوَرٌ لا تزالُ ألوانُها تنبيكَ    عمَّا يُجِنُّه الاضمارُ"
  },
  {
   "verse_index": 11,
   "sadr": "يخجلُ الوردُ حين عارضه النر",
   "ajuz": "جسُ من حُسنه وغار البهارُ",
   "text": "يخجلُ الوردُ حين عارضه النر    جسُ من حُسنه وغار البهارُ"
  },
  {
   "verse_index": 12,
   "sadr": "فعلتْ ذاكَ حمرةٌ، وعلتْ ذا",
   "ajuz": "حيرةٌ واعترى البهارَ اصفرارُ",
   "text": "فعلتْ ذاكَ حمرةٌ، وعلتْ ذا    حيرةٌ واعترى البهارَ اصفرارُ"
  },
  {
   "verse_index": 13,
   "sadr": "وغدا الأقحوانُ يضحكُ عُجبًا",
   "ajuz": "عن ثنايا لِثَاتُهُنَّ نُضارُ",
   "text": "وغدا الأقحوانُ يضحكُ عُجبًا    عن ثنايا لِثَاتُهُنَّ نُضارُ"
  },
  {
   "verse_index": 14,
   "sadr": "نمَّ عنه النمّامُ فاستمع السُّو",
   "ajuz": "سَنُ لمّا أُذيعتِ الأسرارُ",
   "text": "نمَّ عنه النمّامُ فاستمع السُّو    سَنُ لمّا أُذيعتِ الأسرارُ"
  },
  {
   "verse_index": 15,
   "sadr": "عندها أبرز الشقيقُ خدودًا",
   "ajuz": "صار فيها من لطْمِهِ آثارُ",
   "text": "عندها أبرز الشقيقُ خدودًا    صار فيها من لطْمِهِ آثارُ"
  },
  {
   "verse_index": 16,
   "sadr": "سُكِبَتْ فوقَها دموعٌ من الطلِّ",
   "ajuz": "كما تُسْكَبُ الدموعُ الغزارُ",
   "text": "سُكِبَتْ فوقَها دموعٌ من الطلِّ    كما تُسْكَبُ الدموعُ الغزارُ"
  },
  {
   "verse_index": 17,
   "sadr": "واكتسى ذا البنفسجُ الغضُّ أثوا",
   "ajuz": "بَ حدادٍ اذ خانه الاصطبارُ",
   "text": "واكتسى ذا البنفسجُ الغضُّ أثوا    بَ حدادٍ اذ خانه الاصطبارُ"
  },
  {
   "verse_index": 18,
   "sadr": "وأضرَّ السَّقامُ بالياسمينِ الـ",
   "ajuz": "ـغضِّ حتى أذابه الاضرارُ",
   "text": "وأضرَّ السَّقامُ بالياسمينِ الـ    ـغضِّ حتى أذابه الاضرارُ"
  },
  {
   "verse_index": 19,
   "sadr": "ثم نادى الخيريّ في سائِر الزَّهـ",
   "ajuz": "ـرِ فوافاه جَحْفَلٌ جَرَّارُ",
   "text": "ثم نادى الخيريّ في سائِر الزَّهـ    ـرِ فوافاه جَحْفَلٌ جَرَّارُ"
  },
  {
   "verse_index": 20,
   "sadr": "فاستجاشوا على محاربةِ النَرْ",
   "ajuz": "جسِ بالخُرَّمِ الذي لا يُبَارُ",
   "text": "فاستجاشوا على محاربةِ النَرْ    جسِ بالخُرَّمِ الذي لا يُبَارُ"
  },
  {
   "verse_index": 21,
   "sadr": "فأتى في جواشنٍ سابغاتٍ",
   "ajuz": "تحت سُجْفٍ من العَجاج تثارُ",
   "text": "فأتى في جواشنٍ سابغاتٍ    تحت سُجْفٍ من العَجاج تثارُ"
  },
  {
   "verse_index": 22,
   "sadr": "ثم لما رأيتُ ذا النرجسَ الغـ",
   "ajuz": "ـضَّ ضعيفًا ما إنْ لديه انتصارُ",
   "text": "ثم لما رأيتُ ذا النرجسَ الغـ    ـضَّ ضعيفًا ما إنْ لديه انتصارُ"
  },
  {
   "verse_index": 23,
   "sadr": "لم أزل أُعملُ التلطُّفَ للور",
   "ajuz": "دِ حِذارًا ان يُغْلَبَ النُوّارُ",
   "text": "لم أزل أُعملُ التلطُّفَ للور    دِ حِذارًا ان يُغْلَبَ النُوّارُ"
  },
  {
   "verse_index": 24,
   "sadr": "فجمعناهما لدى مجلسٍ تصـ",
   "ajuz": "ـخبُ فيه الأطيار والأوتارُ",
   "text": "فجمعناهما لدى مجلسٍ تصـ    ـخبُ فيه الأطيار والأوتارُ"
  },
  {
   "verse_index": 25,
   "sadr": "لو ترى ذا وذا لقُلتَ",
   "ajuz": "خدودٌ تُدْمِنُ اللحظَ نحوها الأبصارُ",
   "text": "لو ترى ذا وذا لقُلتَ    خدودٌ تُدْمِنُ اللحظَ نحوها الأبصارُ"
  },
  {
   "verse_index": 26,
   "sadr": "وأدرنا الكؤوسَ اذ نَغَّمَ الزيـ",
   "ajuz": "ـرُ بشجوٍ وغَرَّدَ المزمارُ",
   "text": "وأدرنا الكؤوسَ اذ نَغَّمَ الزيـ    ـرُ بشجوٍ وغَرَّدَ المزمارُ"
  }
