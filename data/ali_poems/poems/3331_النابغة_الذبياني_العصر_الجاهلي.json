   "text": "زعمَ البوارِحُ أنّ رِحلتنا، غداً،    وبذاكَ خَبّرنا الغُدافُ الأسوَد"
  },
  {
   "verse_index": 4,
   "sadr": "لا مرحباً بغدٍ، ولا أهلاً بهِ،",
   "ajuz": "إن كان تفريقُ الأحبّةِ في غدِ",
   "text": "لا مرحباً بغدٍ، ولا أهلاً بهِ،    إن كان تفريقُ الأحبّةِ في غدِ"
  },
  {
   "verse_index": 5,
   "sadr": "حانَ الرّحيلُ، ولم تُوَدعْ مهدَداً،",
   "ajuz": "والصّبْحُ والإمساءُ منها موعدي",
   "text": "حانَ الرّحيلُ، ولم تُوَدعْ مهدَداً،    والصّبْحُ والإمساءُ منها موعدي"
  },
  {
   "verse_index": 6,
   "sadr": "في إثرِ غانيةٍ رمتكَ بسهمها،",
   "ajuz": "فأصابَ قلبك، غير أن لم تُقْصِدِ",
   "text": "في إثرِ غانيةٍ رمتكَ بسهمها،    فأصابَ قلبك، غير أن لم تُقْصِدِ"
  },
  {
   "verse_index": 7,
   "sadr": "غنيتْ بذلكَ، إذ هُمُ لكَ جيرةٌ،",
   "ajuz": "منها بعطفِ رسالةٍ وتَوَدُّدِ",
   "text": "غنيتْ بذلكَ، إذ هُمُ لكَ جيرةٌ،    منها بعطفِ رسالةٍ وتَوَدُّدِ"
  },
  {
   "verse_index": 8,
   "sadr": "ولقد أصابَتْ قلبهُ من حُبِّها،",
   "ajuz": "عن ظهرِ مرنانٍ، بسهمٍ مُصردِ",
   "text": "ولقد أصابَتْ قلبهُ من حُبِّها،    عن ظهرِ مرنانٍ، بسهمٍ مُصردِ"
  },
  {
   "verse_index": 9,
