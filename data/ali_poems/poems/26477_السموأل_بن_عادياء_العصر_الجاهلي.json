 "verses": [
  {
   "verse_index": 1,
   "sadr": "إذا المَرْءُ لَمْ يَدْنَسْ مِنَ اللُّؤْمِ عِرضُهُ",
   "ajuz": "فَكُلُّ رِداءٍ يَرْتَدِيهِ جَمِيلُ",
   "text": "إذا المَرْءُ لَمْ يَدْنَسْ مِنَ اللُّؤْمِ عِرضُهُ    فَكُلُّ رِداءٍ يَرْتَدِيهِ جَمِيلُ"
  },
  {
   "verse_index": 2,
   "sadr": "وإنْ هُوَ لَمْ يَحْمِلْ على النَّفْسِ ضَيْمَها",
   "ajuz": "فَلَيْسَ إلى حُسْنِ الثَّناءِ سَبِيلُ",
   "text": "وإنْ هُوَ لَمْ يَحْمِلْ على النَّفْسِ ضَيْمَها    فَلَيْسَ إلى حُسْنِ الثَّناءِ سَبِيلُ"
  },
  {
   "verse_index": 3,
   "sadr": "تُعَيِّرُنا أنّا قَلِيلٌ عَدِيدُنا",
   "ajuz": "فَقُلْتُ لَها إنَّ الكِرامَ قَلِيلُ",
   "text": "تُعَيِّرُنا أنّا قَلِيلٌ عَدِيدُنا    فَقُلْتُ لَها إنَّ الكِرامَ قَلِيلُ"
  },
  {
   "verse_index": 4,
   "sadr": "وما قَلَّ مَنْ كانَتْ بَقاياهُ مِثْلَنا",
   "ajuz": "شَبابٌ تَسامَى للعُلا وكُهُولُ",
   "text": "وما قَلَّ مَنْ كانَتْ بَقاياهُ مِثْلَنا    شَبابٌ تَسامَى للعُلا وكُهُولُ"
  },
  {
   "verse_index": 5,
   "sadr": "وما ضَرَّنا أنّا قَلِيلٌ وجارُنا",
   "ajuz": "عَزِيزٌ وجارُ الأكْرَمِينَ ذلِيلُ",
   "text": "وما ضَرَّنا أنّا قَلِيلٌ وجارُنا    عَزِيزٌ وجارُ الأكْرَمِينَ ذلِيلُ"
  },
  {
   "verse_index": 6,
   "sadr": "لَنا جَبَلٌ يَحْتَلُّهُ مَن نُجِيرُهُ",
   "ajuz": "مَنِيعٌ يَرُدُّ الطَّرْفَ وهْوَ كَلِيلُ",
   "text": "لَنا جَبَلٌ يَحْتَلُّهُ مَن نُجِيرُهُ    مَنِيعٌ يَرُدُّ الطَّرْفَ وهْوَ كَلِيلُ"
  },
  {
   "verse_index": 7,
   "sadr": "رَسا أصْلُهُ تَحْتَ الثَّرَى وسَما بِهِ",
   "ajuz": "إلى النَّجْمِ فَرْعٌ لا يُنالُ طويلُ",
   "text": "رَسا أصْلُهُ تَحْتَ الثَّرَى وسَما بِهِ    إلى النَّجْمِ فَرْعٌ لا يُنالُ طويلُ"
  },
  {
   "verse_index": 8,
   "sadr": "هُوَ الأبْلَقُ الفَرْدُ الذي سارَ ذِكرهُ",
   "ajuz": "يَعِزُّ على مَن رامَهُ ويَطُولُ",
   "text": "هُوَ الأبْلَقُ الفَرْدُ الذي سارَ ذِكرهُ    يَعِزُّ على مَن رامَهُ ويَطُولُ"
  },
  {
   "verse_index": 9,
   "sadr": "وإنّا لَقَومٌ لا نَرَى القَتْلَ سُبَّةً",
   "ajuz": "إذا ما رأتْهُ عامِرٌ وسَلُولُ",
   "text": "وإنّا لَقَومٌ لا نَرَى القَتْلَ سُبَّةً    إذا ما رأتْهُ عامِرٌ وسَلُولُ"
  },
  {
   "verse_index": 10,
   "sadr": "يُقَرِّبُ حُبُّ المَوْتِ آجالَنا لَنا",
   "ajuz": "وتكرَهُهُ آجالُهُمْ فَتَطُولُ",
   "text": "يُقَرِّبُ حُبُّ المَوْتِ آجالَنا لَنا    وتكرَهُهُ آجالُهُمْ فَتَطُولُ"
  },
  {
   "verse_index": 11,
   "sadr": "وما ماتَ مِنّا سَيِّدٌ حَتْفَ أنْفِهِ",
   "ajuz": "ولا طُلَّ مِنّا حَيْثُ كانَ قَتِيلُ",
   "text": "وما ماتَ مِنّا سَيِّدٌ حَتْفَ أنْفِهِ    ولا طُلَّ مِنّا حَيْثُ كانَ قَتِيلُ"
  },
  {
   "verse_index": 12,
   "sadr": "تَسِيلُ على حَدِّ السُّيُوفِ نُفُوسُنا",
   "ajuz": "ولَيْسَتْ على غَيْرِ السُّيُوفِ تَسِيلُ",
   "text": "تَسِيلُ على حَدِّ السُّيُوفِ نُفُوسُنا    ولَيْسَتْ على غَيْرِ السُّيُوفِ تَسِيلُ"
  },
  {
   "verse_index": 13,
   "sadr": "صَفَوْنا فَلَم نَكدُرْ وأخْلَصَ سِرَّنا",
   "ajuz": "إناثٌ أطابَتْ حَمْلَنا وفُحُولُ",
   "text": "صَفَوْنا فَلَم نَكدُرْ وأخْلَصَ سِرَّنا    إناثٌ أطابَتْ حَمْلَنا وفُحُولُ"
  },
  {
   "verse_index": 14,
   "sadr": "عَلَوْنا إلى خَيْرِ الظُّهُورِ وحَطَّنا",
   "ajuz": "لِوَقْتٍ إلى خَيْرِ البُطُونِ نُزُولُ",
   "text": "عَلَوْنا إلى خَيْرِ الظُّهُورِ وحَطَّنا    لِوَقْتٍ إلى خَيْرِ البُطُونِ نُزُولُ"
  },
  {
   "verse_index": 15,
   "sadr": "فَنَحنُ كَماءِ المُزْنِ ما في نِصابِنا",
   "ajuz": "كَهامٌ ولا فِينا يُعَدُّ بَخِيلُ",
   "text": "فَنَحنُ كَماءِ المُزْنِ ما في نِصابِنا    كَهامٌ ولا فِينا يُعَدُّ بَخِيلُ"
  },
  {
   "verse_index": 16,
   "sadr": "ونُنْكِرُ إنْ شِئنا على النّاسِ قَوْلَهُمْ",
   "ajuz": "ولا يُنْكِرُونَ القَوْلَ حِينَ نَقُولُ",
   "text": "ونُنْكِرُ إنْ شِئنا على النّاسِ قَوْلَهُمْ    ولا يُنْكِرُونَ القَوْلَ حِينَ نَقُولُ"
  },
  {
   "verse_index": 17,
   "sadr": "إذا سَيِّدٌ مِنّا خَلا قامَ سَيِّدٌ",
   "ajuz": "قَؤُولٌ لِما قالَ الكِرامُ فَعُولُ",
   "text": "إذا سَيِّدٌ مِنّا خَلا قامَ سَيِّدٌ    قَؤُولٌ لِما قالَ الكِرامُ فَعُولُ"
  },
  {
   "verse_index": 18,
   "sadr": "وما أُخْمِدَتْ نارٌ لَنا دُونَ طارِقٍ",
   "ajuz": "ولا ذَمَّنا في النّازِلينَ نَزِيلُ",
   "text": "وما أُخْمِدَتْ نارٌ لَنا دُونَ طارِقٍ    ولا ذَمَّنا في النّازِلينَ نَزِيلُ"
  },
  {
   "verse_index": 19,
   "sadr": "وأيّامُنا مَشهُورَةٌ في عَدُوِّنا",
   "ajuz": "لَها غُرَرٌ مَعْلُومَةٌ وحُجُولُ",
   "text": "وأيّامُنا مَشهُورَةٌ في عَدُوِّنا    لَها غُرَرٌ مَعْلُومَةٌ وحُجُولُ"
  },
  {
   "verse_index": 20,
   "sadr": "وأسْيافُنا في كُلِّ شَرْقٍ ومَغْرِبٍ",
   "ajuz": "بِها مِنْ قِراعِ الدّارِعِينَ فُلُولُ",
   "text": "وأسْيافُنا في كُلِّ شَرْقٍ ومَغْرِبٍ    بِها مِنْ قِراعِ الدّارِعِينَ فُلُولُ"
  },
  {
   "verse_index": 21,
   "sadr": "مُعَوَّدَةٌ أنْ لا تُسَلَّ نِصالُها",
   "ajuz": "فَتُغْمَدَ حَتَّى يُسْتَباحَ قَبيلُ",
   "text": "مُعَوَّدَةٌ أنْ لا تُسَلَّ نِصالُها    فَتُغْمَدَ حَتَّى يُسْتَباحَ قَبيلُ"
  },
  {
   "verse_index": 22,
   "sadr": "سَلِي إنْ جَهَلْتِ النّاسَ عَنّا وعَنْكُمُ",
   "ajuz": "ولَيْسَ سَواءٌ عالِمٌ وجَهُولُ",
   "text": "سَلِي إنْ جَهَلْتِ النّاسَ عَنّا وعَنْكُمُ    ولَيْسَ سَواءٌ عالِمٌ وجَهُولُ"
  },
  {
   "verse_index": 23,
   "sadr": "فإنَّ بَنِي الدّيّانِ قٌطْبٌ لِقَوْمِهِمْ",
   "ajuz": "تَدُورُ رَحاهُمْ حَوْلَهُمْ وتَجُولُ",
