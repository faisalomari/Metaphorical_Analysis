 "verses": [
  {
   "verse_index": 1,
   "sadr": "بِشَاةِ سَعِيدٍ وهْي رُوحٌ بلَا جِسْمِ",
   "ajuz": "تَمَثّلَتِ الأَمْثَالُ فِي شِدَّةِ السُّقْمِ",
   "text": "بِشَاةِ سَعِيدٍ وهْي رُوحٌ بلَا جِسْمِ    تَمَثّلَتِ الأَمْثَالُ فِي شِدَّةِ السُّقْمِ"
  },
  {
   "verse_index": 2,
   "sadr": "يَقُول لِي الإخْوَانُ لمّا طَبَخْتُهَا",
   "ajuz": "أتطْبَخُ شِطْرَنْجًا عِظَامًا بِلَا لَحْمِ",
   "text": "يَقُول لِي الإخْوَانُ لمّا طَبَخْتُهَا    أتطْبَخُ شِطْرَنْجًا عِظَامًا بِلَا لَحْمِ"
  },
  {
   "verse_index": 3,
   "sadr": "فَقُلْت: كُلُوا مِنْها، فَقالُوا تجمُّزًا",
   "ajuz": "أتطعِمُنا نَاوُوسَ قَوْمٍ مِنَ العُجْمِ",
   "text": "فَقُلْت: كُلُوا مِنْها، فَقالُوا تجمُّزًا    أتطعِمُنا نَاوُوسَ قَوْمٍ مِنَ العُجْمِ"
  },
  {
   "verse_index": 4,
   "sadr": "فَقُلت لَهُم: كَانَتْ لدَيْهم أَسيرَةً",
   "ajuz": "ترَى القَتّ فِي أَيْدِي العَدُوّ وفِي الحُلْمِ",
   "text": "فَقُلت لَهُم: كَانَتْ لدَيْهم أَسيرَةً    ترَى القَتّ فِي أَيْدِي العَدُوّ وفِي الحُلْمِ"
  },
  {
   "verse_index": 5,
   "sadr": "وكَمْ قَدْ تَغَنّتْ إذْ تَطَاوَلَ جُوعُهَا",
   "ajuz": "وَلَمْ تَرَ عِنْدَ القَوْمِ شَيْئًا مِن الطّعْمِ:",
   "text": "وكَمْ قَدْ تَغَنّتْ إذْ تَطَاوَلَ جُوعُهَا    وَلَمْ تَرَ عِنْدَ القَوْمِ شَيْئًا مِن الطّعْمِ:"
  },
  {
   "verse_index": 6,
   "sadr": "أَلَا أَيُّهَا الغَضْبَانُ بالله مَا جُرْمِي",
   "ajuz": "إلَيْكَ فَقَدْ أَبْلَيْتَ لَحْمي علَى عَظْمي",
   "text": "أَلَا أَيُّهَا الغَضْبَانُ بالله مَا جُرْمِي    إلَيْكَ فَقَدْ أَبْلَيْتَ لَحْمي علَى عَظْمي"
  }
 ],
