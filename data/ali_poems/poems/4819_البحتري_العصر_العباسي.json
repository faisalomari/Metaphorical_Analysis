 "verses": [
  {
   "verse_index": 1,
   "sadr": "لَوَتْ بِالسَّلامِ بَنَانًا خَضيبا",
   "ajuz": "وَلَحْظًا يشوقُ الفؤادَ الطَّرُوبا",
   "text": "لَوَتْ بِالسَّلامِ بَنَانًا خَضيبا    وَلَحْظًا يشوقُ الفؤادَ الطَّرُوبا"
  },
  {
   "verse_index": 2,
   "sadr": "وَزَارَتْ على عَجَلٍ فاكْتَسى",
   "ajuz": "لِزَوْرَتِها ((أَبْرَقُ الحَزْنِ)) طيبا",
   "text": "وَزَارَتْ على عَجَلٍ فاكْتَسى    لِزَوْرَتِها ((أَبْرَقُ الحَزْنِ)) طيبا"
  },
  {
   "verse_index": 3,
   "sadr": "فكانَ العبيرُ بها وَاشِيًا",
   "ajuz": "وَجَرْسُ الحُلِيِّ عليها رَقيبا",
   "text": "فكانَ العبيرُ بها وَاشِيًا    وَجَرْسُ الحُلِيِّ عليها رَقيبا"
  },
  {
   "verse_index": 4,
   "sadr": "وَلَمْ أَنْسَ لَيْلَتَنَا في العِنَا",
   "ajuz": "قِ لَفَّ الصَّبَا بِقَضيبٍ قَضيبا",
   "text": "وَلَمْ أَنْسَ لَيْلَتَنَا في العِنَا    قِ لَفَّ الصَّبَا بِقَضيبٍ قَضيبا"
  },
  {
   "verse_index": 5,
   "sadr": "سُكُوتٌ يَحرُّ عليهِ الهوى",
   "ajuz": "وشكوى تَهِيجُ البُكا والنَّحيبا",
   "text": "سُكُوتٌ يَحرُّ عليهِ الهوى    وشكوى تَهِيجُ البُكا والنَّحيبا"
  },
  {
   "verse_index": 6,
   "sadr": "كَمَا افْتَنَّتِ الرّيحُ فِي مَرِّها",
   "ajuz": "فَطَوْرًا خُفُوتًا، وَطَوْرًا هُبُوبا",
   "text": "كَمَا افْتَنَّتِ الرّيحُ فِي مَرِّها    فَطَوْرًا خُفُوتًا، وَطَوْرًا هُبُوبا"
  },
  {
   "verse_index": 7,
   "sadr": "عَنَتْ كَبِدي قَسْوةٌ منكِ ما",
   "ajuz": "تَزالُ تُجدِّدُ فيها نُدُوبا",
   "text": "عَنَتْ كَبِدي قَسْوةٌ منكِ ما    تَزالُ تُجدِّدُ فيها نُدُوبا"
  },
  {
   "verse_index": 8,
   "sadr": "وَحُمِّلْتُ عِنْدَكِ ذَنْبَ المَشي",
   "ajuz": "بِ، حَتّى كَأَنّي ابْتَدَعْتُ المَشِيبا",
   "text": "وَحُمِّلْتُ عِنْدَكِ ذَنْبَ المَشي    بِ، حَتّى كَأَنّي ابْتَدَعْتُ المَشِيبا"
  },
  {
   "verse_index": 9,
   "sadr": "وَمَنْ يَطَّلِعْ شَرَفَ الأَرْبَعِي",
   "ajuz": "ن يُحَيِّ مِنَ الشَّيْبِ زَوْرًا غريبا",
   "text": "وَمَنْ يَطَّلِعْ شَرَفَ الأَرْبَعِي    ن يُحَيِّ مِنَ الشَّيْبِ زَوْرًا غريبا"
  },
  {
   "verse_index": 10,
   "sadr": "بَلَوْنا ضَرَائبَ مَنْ قَدْ نَرى",
   "ajuz": "فَما إِنْ رَأَيْنا لِ((فَتْحٍ)) ضَرِيبا",
   "text": "بَلَوْنا ضَرَائبَ مَنْ قَدْ نَرى    فَما إِنْ رَأَيْنا لِ((فَتْحٍ)) ضَرِيبا"
  },
  {
   "verse_index": 11,
   "sadr": "هُوَ المَرْءُ أَبْدَتْ لَهُ الحَادِثا",
   "ajuz": "تُ عَزْمًا وَشِيكًا وَرَأْيًا صَلِيبا",
   "text": "هُوَ المَرْءُ أَبْدَتْ لَهُ الحَادِثا    تُ عَزْمًا وَشِيكًا وَرَأْيًا صَلِيبا"
  },
  {
   "verse_index": 12,
   "sadr": "تَنَقَّل في خُلُقَى سُؤْدُدٍ:",
   "ajuz": "سَمَاحًا مَرُجًّى، وَبَأْسًا مَهِيبا",
   "text": "تَنَقَّل في خُلُقَى سُؤْدُدٍ:    سَمَاحًا مَرُجًّى، وَبَأْسًا مَهِيبا"
  },
  {
   "verse_index": 13,
   "sadr": "فكالسَّيْفِ إنْ جِئْتَهُ صارِخًا،",
   "ajuz": "وكالبحرِ إِنْ جِئتَهُ مَسْتَثيبا",
   "text": "فكالسَّيْفِ إنْ جِئْتَهُ صارِخًا،    وكالبحرِ إِنْ جِئتَهُ مَسْتَثيبا"
  },
  {
   "verse_index": 14,
   "sadr": "فَتًى كَرَّمَ اللهُ أخلاقَهُ",
   "ajuz": "وَأَلْبَسَهُ الحَمْدَ غَضًّا قَشِيبا",
   "text": "فَتًى كَرَّمَ اللهُ أخلاقَهُ    وَأَلْبَسَهُ الحَمْدَ غَضًّا قَشِيبا"
  },
  {
   "verse_index": 15,
   "sadr": "وأعْطاهُ منْ كُلّ فَضْلٍ يُعَدْ",
   "ajuz": "دُ حَظًّا، وَمِنْ كلّ مَجْدٍ نَصيبَا",
   "text": "وأعْطاهُ منْ كُلّ فَضْلٍ يُعَدْ    دُ حَظًّا، وَمِنْ كلّ مَجْدٍ نَصيبَا"
  },
  {
   "verse_index": 16,
   "sadr": "فَدَيْنَاكَ مِنْ أَيّ خَطْبٍ عَرَا،",
   "ajuz": "وَنَائبةٍ أَوْشَكَتْ أَنْ تَنُوبا",
   "text": "فَدَيْنَاكَ مِنْ أَيّ خَطْبٍ عَرَا،    وَنَائبةٍ أَوْشَكَتْ أَنْ تَنُوبا"
  },
  {
   "verse_index": 17,
   "sadr": "وَإِنْ كَانَ رَأْيُكَ قَدْ حَالَ فِيَّ",
   "ajuz": "فَلَقَّيْتَنِي بَعْدَ بِشْرٍ قُطُوبَا",
   "text": "وَإِنْ كَانَ رَأْيُكَ قَدْ حَالَ فِيَّ    فَلَقَّيْتَنِي بَعْدَ بِشْرٍ قُطُوبَا"
  },
  {
   "verse_index": 18,
   "sadr": "وَخَيَّبْتَ أَسْبابيَ النّازِعا",
   "ajuz": "تِ إليك، وَما حَقُّها أَنْ تَخِيبا",
   "text": "وَخَيَّبْتَ أَسْبابيَ النّازِعا    تِ إليك، وَما حَقُّها أَنْ تَخِيبا"
  },
  {
   "verse_index": 19,
   "sadr": "يَرِيبُنِي الشّيءُ تَأْتِي بِهِ",
   "ajuz": "وَأُكْبِرُ قَدْرَكَ أَنْ أَسْتَرِيبا",
   "text": "يَرِيبُنِي الشّيءُ تَأْتِي بِهِ    وَأُكْبِرُ قَدْرَكَ أَنْ أَسْتَرِيبا"
  },
  {
   "verse_index": 20,
   "sadr": "وَأَكْرَهُ أَنْ أَتَمَادَى على",
   "ajuz": "سَبيلِ اغْتِرارٍ فَأَلْقَى شَعُوبَا",
   "text": "وَأَكْرَهُ أَنْ أَتَمَادَى على    سَبيلِ اغْتِرارٍ فَأَلْقَى شَعُوبَا"
  },
  {
   "verse_index": 21,
   "sadr": "أُكَذِّبُ ظَنِّي بِأَنْ قَدْ سَخِطْ",
   "ajuz": "تَ، وَما كنْت أَعْهَدُ ظَنِّي كَذُوبَا",
   "text": "أُكَذِّبُ ظَنِّي بِأَنْ قَدْ سَخِطْ    تَ، وَما كنْت أَعْهَدُ ظَنِّي كَذُوبَا"
  },
  {
   "verse_index": 22,
   "sadr": "ولو لمْ تكنْ ساخطًا لمْ أَكُنْ",
   "ajuz": "أذمُّ الزَّمَانَ وأشْكو الخُطُوبَا",
   "text": "ولو لمْ تكنْ ساخطًا لمْ أَكُنْ    أذمُّ الزَّمَانَ وأشْكو الخُطُوبَا"
  },
  {
   "verse_index": 23,
   "sadr": "ولا بُدَّ منْ لَوْمَةِ أَنْتَحِي",
   "ajuz": "عليك بها مُخْطِئًا أوْ مُصِيبا",
   "text": "ولا بُدَّ منْ لَوْمَةِ أَنْتَحِي    عليك بها مُخْطِئًا أوْ مُصِيبا"
  },
  {
   "verse_index": 24,
   "sadr": "أَيُصْبِحُ وِرْدِي فِي سَاحَتَيْ",
   "ajuz": "ك طَرْقًا، وَمَرْعَايَ مَحْلًا جَدِيبَا",
   "text": "أَيُصْبِحُ وِرْدِي فِي سَاحَتَيْ    ك طَرْقًا، وَمَرْعَايَ مَحْلًا جَدِيبَا"
  },
  {
   "verse_index": 25,
   "sadr": "أَبيعُ الأَحِبَّةَ بَيْعَ السَّوَام،",
   "ajuz": "وَآسَى عليهمْ حبيبًا حَبيبًا",
   "text": "أَبيعُ الأَحِبَّةَ بَيْعَ السَّوَام،    وَآسَى عليهمْ حبيبًا حَبيبًا"
  },
  {
   "verse_index": 26,
   "sadr": "فَفِي كُلِّ يَومٍ لَنا مَوْقِفٌ",
   "ajuz": "يُشَقِّقُ فيهِ الوَدَاعُ الجُيُوبا",
   "text": "فَفِي كُلِّ يَومٍ لَنا مَوْقِفٌ    يُشَقِّقُ فيهِ الوَدَاعُ الجُيُوبا"
  },
  {
   "verse_index": 27,
   "sadr": "وَمَا كَانَ سُخْطُكَ إِلَّا الفِراقَ",
   "ajuz": "أَفَاضَ الدُّمُوعَ وَأَشْجى القُلُوبَا",
   "text": "وَمَا كَانَ سُخْطُكَ إِلَّا الفِراقَ    أَفَاضَ الدُّمُوعَ وَأَشْجى القُلُوبَا"
  },
  {
   "verse_index": 28,
   "sadr": "ولو كنْتُ أَعْرِفُ ذَنْبًا لَمَا",
   "ajuz": "تَخالَجَني الشَّكَُّ فِي أَنْ أَتُوبا",
   "text": "ولو كنْتُ أَعْرِفُ ذَنْبًا لَمَا    تَخالَجَني الشَّكَُّ فِي أَنْ أَتُوبا"
  },
  {
   "verse_index": 29,
   "sadr": "سَأصْبِرُ حَتّى أُلاقِي رِضَا",
   "ajuz": "كَ: إِمّا بَعيدًا، وَإِمّا قَرِيبَا",
   "text": "سَأصْبِرُ حَتّى أُلاقِي رِضَا    كَ: إِمّا بَعيدًا، وَإِمّا قَرِيبَا"
  },
  {
   "verse_index": 30,
   "sadr": "أُرَاقِبُ رَأْيَكَ حَتّى يَصِحُّ،",
   "ajuz": "وَأَنْظُرُ عَطْفَكَ حَتّى يَثُوبَا",
